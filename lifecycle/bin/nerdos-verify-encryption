#!/usr/bin/env python3
"""Prove all persistent storage branches before passwordless desktop login."""
import json
from pathlib import Path
import re
import stat
import subprocess
import sys


def output(*args):
    return subprocess.check_output(args, text=True).strip()


def encrypted_device(source):
    source = source.split('[')[0]
    tree = json.loads(output('lsblk', '--json', '--inverse', '--paths', '--output', 'NAME,TYPE', source))
    def walk(node):
        return node['type'] == 'crypt' or (bool(node.get('children')) and all(walk(n) for n in node['children']))
    return bool(tree['blockdevices']) and all(walk(n) for n in tree['blockdevices'])


def encrypted(path):
    mount = json.loads(output('findmnt', '--json', '--output', 'SOURCE,FSTYPE', '--target', path))['filesystems'][0]
    if mount['fstype'] == 'btrfs':
        # findmnt reports only one member. Prove every Btrfs device rather
        # than allowing an encrypted member to conceal a plaintext member.
        devices = re.findall(r'\bdevid\s+\d+.*?\bpath\s+(/\S+)', output('btrfs', 'filesystem', 'show', '--raw', path))
        return bool(devices) and all(encrypted_device(device) for device in devices)
    return encrypted_device(mount['source'])


def verify():
    for path in ('/', '/home', '/var', '/var/lib/nerdos/secrets'):
        if not encrypted(path):
            raise ValueError(f'{path} is not proven encrypted. Automatic login has been refused.')
    # Include additional administrator-selected persistent service/data mounts.
    mounts = json.loads(output('findmnt', '--json', '--real', '--list', '--output', 'TARGET,FSTYPE,OPTIONS'))['filesystems']
    for mount in mounts:
        target = mount['target']
        if target in ('/boot', '/boot/efi') and mount['fstype'] in ('vfat', 'fat', 'fat32'):
            continue  # The UEFI ESP contains boot code, never personal data.
        if not encrypted(target):
            raise ValueError(f'Persistent mount {target} is not proven encrypted.')
    for row in Path('/proc/swaps').read_text().splitlines()[1:]:
        device = row.split()[0]
        if re.fullmatch(r'/dev/zram[0-9]+', device):
            continue
        if stat.S_ISBLK(Path(device).stat().st_mode):
            safe = encrypted_device(device)
        else:
            safe = encrypted(device)  # swapfile: prove its containing filesystem
        if not safe:
            raise ValueError('Unencrypted persistent swap. Automatic login has been refused.')


if __name__ == '__main__':
    try:
        verify()
    except Exception as error:
        print(error, file=sys.stderr)
        sys.exit(1)
