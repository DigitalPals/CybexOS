#!/usr/bin/env python3
import json
import sys
from cybexos.common import Failure
from cybexos.password import main

try:
    main()
except Failure as error:
    print(json.dumps({'success': False, 'error': str(error)}))
    sys.exit(1)
except Exception:
    print(json.dumps({'success': False, 'error': 'The password change failed. Review your current login and disk passwords before restarting.'}))
    sys.exit(1)
