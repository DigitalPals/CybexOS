#!/usr/bin/env python3
"""Run candidate QML with candidate Qt/Quickshell, outside the live session."""
import os
import json
from pathlib import Path
import shutil
import subprocess
import tempfile
import sys
import argparse
from cybexos.desktop_check import verify_compositor

try:
    parser = argparse.ArgumentParser()
    parser.add_argument('--system', default='/run/current-system')
    args = parser.parse_args()
    share = Path(os.environ['CYBEXOS_UPDATER_SHARE'])
    policy = json.loads((share / 'desktop-compatibility.json').read_text())
    versions = json.loads((share / 'desktop-runtime.json').read_text())
    for component, value in versions.items():
        if '.'.join(value.split('.')[:2]) not in policy[component]:
            raise ValueError(f'{component} {value} is outside the reviewed runtime series. '
                             'Retain the installed generation until this combination is qualified.')
    with tempfile.TemporaryDirectory(prefix='cybexos-desktop-check-') as directory:
        work = Path(directory)
        verify_compositor(args.system, work)
        # __file__ is the updater package; candidate PATH resolves its matching desktop.
        runtime = Path(shutil.which('cybexos-runtime')).resolve().parents[1] / 'share/cybexos/runtime/quickshell'
        target = work / 'shell'
        shutil.copytree(runtime, target)
        shutil.copy(Path(os.environ['CYBEXOS_UPDATER_SHARE']) / 'desktop-smoke/shell.qml', target / 'shell.qml')
        env = dict(os.environ, HOME=str(work), XDG_CONFIG_HOME=str(work / 'config'), XDG_DATA_HOME=str(work / 'data'),
                   XDG_STATE_HOME=str(work / 'state'), XDG_RUNTIME_DIR=str(work / 'run'),
                   QT_QPA_PLATFORM='offscreen', QT_QUICK_BACKEND='software', CYBEXOS_PLUGIN_ROOT=str(work / 'plugins'))
        (work / 'run').mkdir(mode=0o700)
        result = subprocess.run(['qs', '-p', str(target)], env=env, capture_output=True, text=True, timeout=40)
        body = result.stdout + result.stderr
        if 'CYBEXOS_DESKTOP_CHECK_PASS' not in body or any(x in body for x in ('ReferenceError', 'TypeError', 'Failed to load configuration', 'Syntax error', 'Type UserWidgetHost unavailable')):
            raise ValueError('Candidate desktop/plugin API smoke check failed: ' + body[-3000:])
except Exception as error:
    print(str(error), file=sys.stderr)
    sys.exit(1)
