#!/usr/bin/env python3
"""Seed absent personal entry points. Existing files are always user owned."""
import os
from pathlib import Path
import shutil

def initialize(home, defaults, share, proprietary, developer=False):
    def seed(relative, content, mode=0o644):
        path = home / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        try:
            with path.open('x') as stream:
                os.fchmod(stream.fileno(), mode)
                stream.write(content)
        except FileExistsError:
            pass

    seed('.config/kitty/kitty.conf', f'include {defaults}/kitty.conf\n# Personal overrides belong below this line.\n')
    seed('.config/fish/conf.d/cybexos.fish', f'source {defaults}/fish-config.fish\n')
    seed('.config/fastfetch/config.jsonc', (defaults / 'fastfetch.jsonc').read_text())
    seed('.config/voxtype/config.toml', (defaults / 'voxtype.toml').read_text())
    model = home / '.local/share/voxtype/models/ggml-base.bin'
    model.parent.mkdir(parents=True, exist_ok=True)
    if not model.exists() and not model.is_symlink():
        model.symlink_to('/etc/cybexos/models/ggml-base.bin')
    seed('.gitconfig', f'[include]\n  path = {defaults}/gitconfig\n')
    # The shell renders the desktop style's GTK rules (theme_gtk.py) into its
    # theme state; GTK reads them through these personal stylesheets.
    state = Path(os.environ.get('XDG_STATE_HOME') or home / '.local/state') / 'cybexos/theme'
    for version in ('3.0', '4.0'):
        seed(f'.config/gtk-{version}/gtk.css', f'@import url("file://{state}/gtk-{version}.css");\n'
             '/* Personal rules belong below this line. */\n')
    nvim = home / '.config/nvim'
    if developer and not nvim.exists() and not nvim.is_symlink():
        shutil.copytree(defaults / 'nvim', nvim)
        # Store templates are read-only; this becomes personal, editable code.
        for path in [nvim, *nvim.rglob('*')]:
            path.chmod(0o755 if path.is_dir() else 0o644)
    if proprietary:
        (home / '.ssh').mkdir(mode=0o700, exist_ok=True)
        seed('.ssh/config', f'Include {defaults}/ssh.conf\n', 0o600)
    seed('.config/oh-my-posh/EDM115-newline2.omp.json', (defaults / 'prompt.json').read_text())
    seed('.config/user-dirs.dirs', 'XDG_DESKTOP_DIR="$HOME/"\nXDG_DOCUMENTS_DIR="$HOME/Documents"\nXDG_DOWNLOAD_DIR="$HOME/Downloads"\nXDG_PICTURES_DIR="$HOME/Pictures"\nXDG_VIDEOS_DIR="$HOME/Videos"\nXDG_MUSIC_DIR="$HOME/Music"\n')
    for name in ('Code', 'Documents', 'Downloads', 'Pictures', 'Videos', 'Music'):
        (home / name).mkdir(exist_ok=True)
    for base in ('.agents', '.claude', '.codex'):
        slot = home / base / 'skills/cybexos'
        slot.parent.mkdir(parents=True, exist_ok=True)
        # A stable system path follows the selected generation, including rollback.
        if not slot.exists() and not slot.is_symlink():
            slot.symlink_to('/run/current-system/sw/share/cybexos/skill')
        elif not slot.is_symlink() or str(slot.readlink()) != '/run/current-system/sw/share/cybexos/skill':
            print(f'Preserved personal skill at {slot}; vendor skill: {share / "skill"}')


if __name__ == '__main__':
    initialize(Path.home(), Path('/run/current-system/sw/share/cybexos/defaults'),
               Path(os.environ['CYBEXOS_UPDATER_SHARE']), Path('/etc/cybexos/proprietary-enabled').exists(),
               Path('/etc/cybexos/developer-enabled').exists())
