import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Store } from "store.slint";

export component Icon inherits Path {
    in property <string> d;
    in property <brush> tint: Theme.fog;
    in property <length> size: 18px;
    commands: root.d;
    stroke: root.tint;
    // Tabler's line at 1.5 of its 24 units, scaled with the icon; Slint does
    // not scale strokes by the viewbox. Small icons keep one physical pixel.
    stroke-width: max(1phx, root.size * 1.5 / 24);
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    viewbox-width: 24;
    viewbox-height: 24;
    width: root.size;
    height: root.size;
}

// An icon that sits centred in a layout row.
export component SlotIcon inherits Rectangle {
    in property <string> d;
    in property <brush> tint: Theme.fog;
    in property <length> size: 18px;
    width: root.size;
    Icon {
        d: root.d;
        tint: root.tint;
        size: root.size;
    }
}

export component Label inherits Text {
    in property <bool> mono;
    font-family: root.mono ? Theme.mono : Theme.sans;
    color: Theme.ink;
    font-size: 16px;
}

// The uppercase mono kicker above headings and fields.
export component Kicker inherits Text {
    font-family: Theme.mono;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.4px;
    color: Theme.fog;
}

export component Heading inherits Text {
    font-family: Theme.sans;
    font-weight: 700;
    font-size: 50px;
    letter-spacing: -1.2px;
    color: Theme.ink;
    wrap: word-wrap;
}

export component Lead inherits Text {
    font-family: Theme.sans;
    font-size: 19px;
    color: Theme.fog;
    wrap: word-wrap;
}

export component Btn inherits Rectangle {
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    in property <bool> in-sheet;
    in property <bool> keyboard-focus: true;
    in property <string> text;
    in property <string> icon;
    in property <string> kind: "ghost";   // ghost, primary, danger
    in property <bool> enabled: true;
    in property <bool> small;
    in property <bool> icon-right;
    callback clicked;
    property <length> pad: root.small ? 14px : 26px;
    property <color> ink: root.kind == "ghost" ? Theme.ink : Theme.accent-ink;
    height: root.small ? 38px : 52px;
    width: row.preferred-width + 2 * root.pad;
    border-radius: root.small ? 10px : 12px;
    background: root.kind == "primary" ? Theme.accent : root.kind == "danger" ? Theme.red : transparent;
    border-width: 1px;
    border-color: root.kind == "primary" ? Theme.accent : root.kind == "danger" ? Theme.red
        : (touch.has-hover || focus.has-focus) && root.enabled ? Theme.fog : Theme.line-2;
    opacity: root.enabled ? 1 : 0.35;
    if focus.has-focus: Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: parent.border-radius + 4px;
        border-width: 2px;
        border-color: Theme.accent;
    }
    row := HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2;
        width: self.preferred-width;
        height: parent.height;
        spacing: 9px;
        alignment: center;
        if root.icon != "" && !root.icon-right: SlotIcon {
            d: root.icon;
            tint: root.ink;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.ink;
            font-size: root.small ? 14px : 17px;
            font-weight: root.small ? 500 : 700;
            vertical-alignment: center;
        }
        if root.icon != "" && root.icon-right: SlotIcon {
            d: root.icon;
            tint: root.ink;
        }
    }
    // Keyboard focus sits below the pointer area: the topmost element gets
    // the click, so the FocusScope must not cover the TouchArea.
    focus := FocusScope {
        focus-on-tab-navigation: root.keyboard-focus;
        enabled: root.enabled && (root.in-sheet || Store.sheet == "");
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (!event.repeat) { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled && (root.in-sheet || Store.sheet == "");
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
}

export component LinkButton inherits Text {
    in property <bool> enabled: true;
    in property <bool> in-sheet;
    in property <bool> keyboard-focus: true;
    callback clicked;
    color: Theme.accent;
    font-size: 14px;
    font-weight: 500;
    if focus.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.accent;
    }
    focus := FocusScope {
        enabled: root.enabled && (root.in-sheet || Store.sheet == "");
        focus-on-tab-navigation: root.keyboard-focus;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (!event.repeat) { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled && (root.in-sheet || Store.sheet == "");
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

export component Chip inherits Rectangle {
    in property <bool> in-sheet;
    in property <bool> keyboard-focus: true;
    in property <string> text;
    in property <string> icon;
    in property <bool> warn;
    in property <bool> enabled: true;
    callback clicked;
    height: 36px;
    width: root.text == "" ? 36px : row.preferred-width + 28px;
    border-radius: 18px;
    background: Theme.card;
    border-width: 1px;
    border-color: root.warn ? #f2c14e66 : touch.has-hover ? Theme.line-2 : Theme.line;
    opacity: root.enabled ? 1 : 0.55;
    row := HorizontalLayout {
        x: root.text == "" ? (parent.width - self.preferred-width) / 2 : 14px;
        width: self.preferred-width;
        spacing: 8px;
        alignment: center;
        height: parent.height;
        SlotIcon {
            d: root.icon;
            size: 16px;
            tint: root.warn ? Theme.amber : touch.has-hover ? Theme.ink : Theme.fog;
        }
        if root.text != "": Text {
            text: root.text;
            font-size: 14px;
            color: root.warn ? Theme.amber : touch.has-hover ? Theme.ink : Theme.fog;
            vertical-alignment: center;
        }
    }
    if focus.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.accent;
    }
    focus := FocusScope {
        enabled: root.enabled && (root.in-sheet || Store.sheet == "");
        focus-on-tab-navigation: root.keyboard-focus;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (!event.repeat) { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled && (root.in-sheet || Store.sheet == "");
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

export component Card inherits Rectangle {
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: 18px;
}

// A text field: TextInput with placeholder, focus ring and optional caret control.
export component Field inherits Rectangle {
    in property <bool> in-sheet;
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> mono;
    in property <bool> password;
    in property <bool> bad;
    in property <length> right-inset: 0px;
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted();
    callback key(KeyEvent) -> EventResult;
    height: 52px;
    border-radius: 12px;
    background: Theme.bg-deep;
    border-width: 1px;
    border-color: root.bad ? Theme.red : input.has-focus ? Theme.accent : Theme.line-2;
    if input.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: parent.border-radius + 3px;
        border-width: 3px;
        border-color: root.bad ? #ff6b5724 : #60a5fa29;
    }
    if root.text == "": Text {
        x: 16px;
        width: parent.width - 32px - root.right-inset;
        height: parent.height;
        text: root.placeholder;
        color: Theme.faint;
        font-family: root.mono ? Theme.mono : Theme.sans;
        font-size: root.mono ? 17px : 18px;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 16px;
        width: parent.width - 32px - root.right-inset;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        enabled: root.enabled && (root.in-sheet || Store.sheet == "");
        font-family: root.mono ? Theme.mono : Theme.sans;
        font-size: root.mono ? 17px : 18px;
        color: Theme.ink;
        selection-background-color: #60a5fa55;
        selection-foreground-color: Theme.ink;
        input-type: root.password ? InputType.password : InputType.text;
        text <=> root.text;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
        key-pressed(event) => {
            if (event.repeat && event.text == Key.Return) { return accept; }
            return root.key(event);
        }
    }
    public function focus-input() {
        input.focus();
    }
    public function caret() -> int {
        return input.cursor-position-byte-offset;
    }
    public function set-caret(position: int) {
        input.set-selection-offsets(position, position);
    }
}

export component Toggle inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> in-sheet;
    in property <bool> keyboard-focus: true;
    in property <bool> on;
    callback toggled;
    width: 48px;
    height: 28px;
    border-radius: 14px;
    background: root.on ? Theme.accent : Theme.line-2;
    Rectangle {
        x: root.on ? 23px : 3px;
        y: 3px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: root.on ? Theme.accent-ink : Theme.fog;
    }
    if focus.has-focus: Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: 18px;
        border-width: 2px;
        border-color: Theme.accent;
    }
    focus := FocusScope {
        focus-on-tab-navigation: root.keyboard-focus;
        enabled: root.enabled && (root.in-sheet || Store.sheet == "");
        // Space flips the switch; Enter still reaches the screen's Continue.
        key-pressed(event) => {
            if (event.text == " ") {
                if (!event.repeat) { root.toggled(); }
                return accept;
            }
            return reject;
        }
    }
    TouchArea {
        enabled: root.enabled && (root.in-sheet || Store.sheet == "");
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.toggled(); }
    }
}

// Status marks: 0 ok, 1 running, 2 waiting, 3 warning, 4 error.
export component Mark inherits Rectangle {
    in property <int> state;
    in property <int> tick;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: root.state == 0 ? Theme.accent-tint : root.state == 3 ? Theme.amber-tint : root.state == 4 ? Theme.red-tint : transparent;
    border-width: root.state == 1 || root.state == 2 ? 1.5px : 0px;
    border-color: root.state == 1 ? Theme.line-2 : #3b3d43;
    if root.state == 0: Icon {
        d: Icons.check;
        tint: Theme.accent;
        size: 14px;
    }
    if root.state == 1: Rectangle {
        // A static active marker with a 1 Hz step, no continuous animation.
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.accent;
        opacity: Math.mod(root.tick, 2) == 0 ? 1 : 0.45;
    }
    if root.state == 3: Text {
        text: "!";
        color: Theme.amber;
        font-weight: 700;
        font-size: 14px;
    }
    if root.state == 4: Icon {
        d: Icons.close;
        tint: Theme.red;
        size: 13px;
    }
}

export component Tag inherits Rectangle {
    in property <string> text;
    in property <string> tone;   // "", accent, red, amber
    height: 22px;
    width: label.preferred-width + 14px;
    border-radius: 6px;
    background: root.tone == "accent" ? Theme.accent-tint : root.tone == "red" ? Theme.red-tint : root.tone == "amber" ? Theme.amber-tint : Theme.card-2;
    label := Text {
        text: root.text;
        font-family: Theme.mono;
        font-size: 11px;
        font-weight: 500;
        color: root.tone == "accent" ? Theme.accent : root.tone == "red" ? Theme.red : root.tone == "amber" ? Theme.amber : Theme.fog;
        vertical-alignment: center;
    }
}

// A selectable row in sheets and pickers.
export component Row inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> in-sheet;
    in property <bool> keyboard-focus: true;
    in property <bool> selected;
    in property <length> row-height: 54px;
    callback clicked;
    height: root.row-height;
    border-radius: 12px;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.card-2 : transparent;
    border-width: 1px;
    border-color: root.selected ? #60a5fa59 : transparent;
    if focus.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.accent;
    }
    focus := FocusScope {
        enabled: root.enabled && (root.in-sheet || Store.sheet == "");
        focus-on-tab-navigation: root.keyboard-focus;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (!event.repeat) { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled && (root.in-sheet || Store.sheet == "");
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
    @children
}

export component Help inherits Text {
    in property <int> tone;   // 0 neutral, 1 ok, 2 problem, 3 note
    font-size: 13.5px;
    color: root.tone == 1 ? Theme.accent : root.tone == 2 ? Theme.red : root.tone == 3 ? Theme.amber : Theme.faint;
    wrap: word-wrap;
}

export component FieldLabel inherits HorizontalLayout {
    in property <string> text;
    in property <string> aux;
    height: 20px;
    Kicker {
        text: root.text;
        vertical-alignment: center;
    }
    Rectangle { }
    Text {
        text: root.aux;
        color: Theme.faint;
        font-family: Theme.mono;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

// A thin scroll indicator for Flickables (mouse wheel and drag still scroll).
export component ScrollHint inherits Rectangle {
    in property <length> viewport-height;
    in property <length> visible-height;
    in property <length> offset;
    width: 4px;
    property <float> ratio: root.viewport-height > 0 ? min(1, root.visible-height / root.viewport-height) : 1;
    visible: root.ratio < 1;
    Rectangle {
        y: root.viewport-height > root.visible-height ? (-root.offset / (root.viewport-height - root.visible-height)) * (root.visible-height - self.height) : 0;
        height: max(30px, root.visible-height * root.ratio);
        width: 4px;
        border-radius: 2px;
        background: Theme.line-2;
    }
}
