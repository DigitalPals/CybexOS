// Cybex OS installer design tokens. The brand: charcoal, off-white, sky
// blue for focus and primary actions, Space Grotesk for
// UI text and JetBrains Mono for labels and technical values.
// Design reference: installer/ui-reference/index.html.

export global Theme {
    out property <color> bg: #1a1b1e;
    out property <color> bg-deep: #141517;
    out property <color> card: #202125;
    out property <color> card-2: #26272c;
    out property <color> line: #2f3136;
    out property <color> line-2: #3b3d43;
    out property <color> ink: #f3f2ec;
    out property <color> fog: #a6a8a1;
    out property <color> faint: #6e7069;
    out property <color> accent: #60a5fa;
    out property <color> accent-ink: #1a1b1e;
    out property <color> accent-tint: #60a5fa20;
    out property <color> accent-soft: #60a5fa14;
    out property <color> red: #ff6b57;
    out property <color> red-tint: #ff6b5714;
    out property <color> red-line: #ff6b5759;
    out property <color> amber: #f2c14e;
    out property <color> amber-tint: #f2c14e1f;
    out property <color> scrim: #0a0a0b9e;
    out property <color> boot: #0d0d0d;

    out property <string> sans: "Space Grotesk";
    out property <string> mono: "JetBrains Mono";
}
