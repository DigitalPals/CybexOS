[Unit]
Description=Dell XPS Panther Lake IPU7 camera stack
Documentation=https://github.com/DigitalPals/CybexOS/blob/main/docs/xps-2026-hardware.md
After=display-manager.service xps-ipu7-camera-init.service
Requires=xps-ipu7-camera-init.service
Wants=v4l2-relayd@ipu7.service
ConditionPathExistsGlob=/sys/bus/acpi/devices/OVTI08F4:*

[Service]
Type=oneshot
ExecStart=/usr/bin/true
RemainAfterExit=true

[Install]
WantedBy=graphical.target
