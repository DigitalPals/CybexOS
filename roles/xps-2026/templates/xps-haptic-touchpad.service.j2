[Unit]
Description=Restore Dell XPS 2026 haptic touchpad feedback
Documentation=https://github.com/DigitalPals/CybexOS/blob/main/docs/xps-2026-hardware.md
After=systemd-udev-trigger.service
ConditionPathExists=/sys/bus/i2c/devices/i2c-VEN_06CB:00
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/libexec/xps-haptic-touchpad
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
