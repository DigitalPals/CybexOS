[Unit]
Description=Dell XPS 2026 internal-speaker tuning
Documentation=https://github.com/DigitalPals/CybexOS/blob/main/docs/xps-2026-hardware.md
After=pipewire.service wireplumber.service
Requires=pipewire.service
Wants=wireplumber.service
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/xps-speaker-tuning run
ExecStartPost=/usr/local/libexec/xps-speaker-tuning activate
ExecStopPost=/usr/local/libexec/xps-speaker-tuning deactivate
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
