[Unit]
Description=Restore the Dell XPS Panther Lake IPU7 camera after sleep
Documentation=https://github.com/DigitalPals/CybexOS/blob/main/docs/xps-2026-hardware.md
ConditionPathExists=/etc/v4l2-relayd.d/ipu7.conf

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 2
ExecStart=/usr/bin/systemctl restart xps-ipu7-camera-init.service
ExecStart=-/usr/bin/systemctl reset-failed v4l2-relayd@ipu7.service
ExecStart=/usr/bin/systemctl start v4l2-relayd@ipu7.service
