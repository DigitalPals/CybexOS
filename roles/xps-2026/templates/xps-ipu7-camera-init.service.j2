[Unit]
Description=Initialize the Dell XPS Panther Lake IPU7 camera
Documentation=https://github.com/DigitalPals/CybexOS/blob/main/docs/xps-2026-hardware.md
After=systemd-modules-load.service
Before=v4l2-relayd@ipu7.service
PartOf=xps-ipu7-camera.service
ConditionPathExistsGlob=/sys/bus/acpi/devices/OVTI08F4:*
ConditionPathExists=/sys/bus/pci/devices/{{ xps_2026_ipu7_pci_bdf }}
ConditionPathExists=!/var/lib/xps-hardware/ipu7/transaction.in-progress

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/xps-ipu7-camera-init
RemainAfterExit=true
