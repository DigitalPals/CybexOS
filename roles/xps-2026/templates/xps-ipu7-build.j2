#!/usr/bin/bash
set -euo pipefail

readonly bundle_version={{ xps_2026_camera_bundle_version | quote }}
readonly source_dir=/var/cache/xps-ipu7/sources
readonly rpm_dir=/var/cache/xps-ipu7/rpms
readonly output_rpm="$rpm_dir/xps-ipu7-camera-stack.rpm"
readonly output_manifest="$rpm_dir/xps-ipu7-camera-stack.inputs"
readonly output_checksum="$rpm_dir/xps-ipu7-camera-stack.rpm.sha256"
readonly rollback_root="$rpm_dir/rollback"
readonly support_dir=/usr/local/share/xps-2026/camera
readonly dkms_source_root=/usr/src
readonly state_dir=/var/lib/xps-hardware/ipu7
readonly transaction_marker="$state_dir/transaction.in-progress"
readonly committed_identity_file="$state_dir/committed-identity"

verify_sources() {
{% for source in xps_2026_camera_sources %}
  printf '%s  %s\n' \
    '{{ source.checksum | regex_replace('^sha256:', '') }}' \
    "$source_dir/{{ source.name }}-{{ source.commit }}.tar.gz" | sha256sum --check --status
{% endfor %}
}

input_manifest() {
  verify_sources
  {
    printf 'bundle=%s\n' "$bundle_version"
{% for source in xps_2026_camera_sources %}
    printf 'source=%s commit=%s checksum=%s\n' \
      {{ source.name | quote }} {{ source.commit | quote }} {{ source.checksum | quote }}
{% endfor %}
    sha256sum \
      "$0" \
      /usr/local/libexec/xps-ipu7-abi-check \
      /usr/local/libexec/xps-ipu7-userspace-check \
      "$support_dir/xps-ipu7-camera-stack.spec" \
      "$support_dir"/patches/*.patch
  } | sha256sum | awk '{print $1}'
}

dkms_version_for_package_manifest() {
  local package_version=$1 manifest=$2
  [[ $package_version =~ ^[0-9A-Za-z._+~^]+$ ]]
  [[ $manifest =~ ^[[:xdigit:]]{64}$ ]]
  printf '%s.input%s\n' "$package_version" "${manifest:0:16}"
}

dkms_version_for_manifest() {
  dkms_version_for_package_manifest "$bundle_version" "$1"
}

installed_manifest() {
  local manifest_file=/usr/share/xps-ipu7-camera-stack/input-manifest
  [[ -r $manifest_file ]] || return 1
  local manifest
  manifest=$(<"$manifest_file")
  [[ $manifest =~ ^[[:xdigit:]]{64}$ ]] || return 1
  printf '%s\n' "$manifest"
}

installed_identity() {
  local manifest nevra
  if manifest=$(installed_manifest 2>/dev/null); then
    printf 'manifest=%s\n' "$manifest"
    return 0
  fi
  nevra=$(rpm -q --qf '%{NEVRA}' xps-ipu7-camera-stack 2>/dev/null) || return 1
  [[ -n $nevra ]]
  printf 'nevra=%s\n' "$nevra"
}

valid_identity() {
  local identity=${1:-}
  [[ $identity =~ ^manifest=[[:xdigit:]]{64}$ ||
     $identity =~ ^nevra=[^[:cntrl:]]+$ ]]
}

valid_role_target_nevra() {
  local nevra=${1:-} manifest=${2:-}
  [[ $manifest =~ ^[[:xdigit:]]{64}$ ]]
  # Validate a historic role-built RPM without coupling recovery to today's
  # desired bundle_version. RPM versions cannot contain '-', and this role's
  # release is always 1.xps<manifest-prefix> with an optional Fedora dist tag.
  # The exact package name and x86_64 architecture exclude unrelated RPMs.
  [[ $nevra =~ ^xps-ipu7-camera-stack-[0-9A-Za-z._+~^]+-1[.]xps${manifest:0:16}([.][0-9A-Za-z._+~^]+)*[.]x86_64$ ]]
}

cached_target_info() {
  local checksum expected manifest name version release nevra
  [[ -r $output_rpm && -r $output_manifest && -r $output_checksum ]]
  manifest=$(<"$output_manifest")
  [[ $manifest =~ ^[[:xdigit:]]{64}$ ]]
  expected=$(<"$output_checksum")
  [[ $expected =~ ^[[:xdigit:]]{64}$ ]]
  checksum=$(sha256sum "$output_rpm" | awk '{print $1}')
  [[ $checksum == "$expected" ]]
  rpm -K "$output_rpm" >/dev/null
  IFS=$'\t' read -r name version release nevra < <(
    rpm -qp --qf $'%{NAME}\t%{VERSION}\t%{RELEASE}\t%{NEVRA}\n' "$output_rpm"
  )
  [[ $name == xps-ipu7-camera-stack && $version == "$bundle_version" ]]
  [[ $release =~ ^1\.xps${manifest:0:16}([.]|$) ]]
  [[ $nevra == xps-ipu7-camera-stack-* && $nevra != *$'\n'* ]]
  printf 'manifest=%s\n%s\n' "$manifest" "$nevra"
}

cached_target_identity() {
  cached_target_info | sed -n '1p'
}

cached_target_nevra() {
  cached_target_info | sed -n '2p'
}

installed_dkms_version() {
  local manifest hashed package_version
  package_version=$(rpm -q --qf '%{VERSION}' xps-ipu7-camera-stack 2>/dev/null) || return 1
  if manifest=$(installed_manifest 2>/dev/null); then
    # Recovery can run after the role's desired bundle has changed. Derive the
    # source-tree identity from the version of the RPM that is actually
    # installed, never from today's bundle_version.
    hashed=$(dkms_version_for_package_manifest "$package_version" "$manifest")
    if [[ -d $dkms_source_root/ipu7-drivers-$hashed && -d $dkms_source_root/vision-drivers-$hashed ]]; then
      printf '%s\n' "$hashed"
      return 0
    fi
  fi
  # One-time compatibility for a package produced before the input-derived
  # DKMS version was introduced. The next successful build migrates it.
  [[ -d $dkms_source_root/ipu7-drivers-$package_version && -d $dkms_source_root/vision-drivers-$package_version ]] || return 1
  printf '%s\n' "$package_version"
}

snapshot_installed_rpm() {
  local identity snapshot_id manifest checksum cached_nevra installed_nevra snapshot link_tmp old_snapshot old_name
  identity=$(installed_identity) || return 0
  [[ -r $output_rpm && -r $output_checksum ]] || return 0
  checksum=$(sha256sum "$output_rpm" | awk '{print $1}')
  [[ $(<"$output_checksum") == "$checksum" ]] || return 0
  cached_nevra=$(rpm -qp --qf '%{NEVRA}' "$output_rpm" 2>/dev/null || true)
  installed_nevra=$(rpm -q --qf '%{NEVRA}' xps-ipu7-camera-stack 2>/dev/null || true)
  [[ -n $cached_nevra && $cached_nevra == "$installed_nevra" ]] || return 0
  rpm -K "$output_rpm" >/dev/null || return 0
  if [[ $identity == manifest=* ]]; then
    manifest=${identity#manifest=}
    [[ -r $output_manifest && $(<"$output_manifest") == "$manifest" ]] || return 0
  fi

  snapshot_id=$(printf '%s' "$identity" | sha256sum | awk '{print $1}')
  snapshot="$rollback_root/$snapshot_id"
  install -d -m 0755 "$snapshot"
  install -m 0644 "$output_rpm" "$snapshot/xps-ipu7-camera-stack.rpm.new"
  printf '%s\n' "$identity" >"$snapshot/installed-identity.new"
  printf '%s\n' "$cached_nevra" >"$snapshot/nevra.new"
  printf '%s\n' "$checksum" >"$snapshot/rpm.sha256.new"
  mv -f "$snapshot/xps-ipu7-camera-stack.rpm.new" "$snapshot/xps-ipu7-camera-stack.rpm"
  mv -f "$snapshot/installed-identity.new" "$snapshot/installed-identity"
  mv -f "$snapshot/nevra.new" "$snapshot/nevra"
  mv -f "$snapshot/rpm.sha256.new" "$snapshot/rpm.sha256"
  sync -f "$snapshot/xps-ipu7-camera-stack.rpm"
  sync -f "$snapshot"
  link_tmp="$rollback_root/.current.$$"
  ln -s "$snapshot_id" "$link_tmp"
  mv -Tf "$link_tmp" "$rollback_root/current"
  sync -f "$rollback_root"
  for old_snapshot in "$rollback_root"/*; do
    [[ -d $old_snapshot ]] || continue
    old_name=${old_snapshot##*/}
    [[ $old_name =~ ^[[:xdigit:]]{64}$ && $old_name != "$snapshot_id" ]] || continue
    find "$old_snapshot" -depth -delete
  done
}

rollback_rpm() {
  local expected=${1:-} link identity snapshot checksum expected_id cached_nevra
  [[ -L $rollback_root/current ]] || return 1
  link=$(readlink "$rollback_root/current")
  [[ $link =~ ^[[:xdigit:]]{64}$ ]] || return 1
  snapshot="$rollback_root/$link"
  [[ -d $snapshot && -r $snapshot/installed-identity && -r $snapshot/nevra && -r $snapshot/rpm.sha256 ]] || return 1
  identity=$(<"$snapshot/installed-identity")
  valid_identity "$identity" || return 1
  [[ -z $expected || $identity == "$expected" ]] || return 1
  expected_id=$(printf '%s' "$identity" | sha256sum | awk '{print $1}')
  [[ $expected_id == "$link" ]] || return 1
  checksum=$(sha256sum "$snapshot/xps-ipu7-camera-stack.rpm" | awk '{print $1}')
  [[ $(<"$snapshot/rpm.sha256") == "$checksum" ]] || return 1
  rpm -K "$snapshot/xps-ipu7-camera-stack.rpm" >/dev/null
  cached_nevra=$(rpm -qp --qf '%{NEVRA}' "$snapshot/xps-ipu7-camera-stack.rpm" 2>/dev/null || true)
  [[ -n $cached_nevra && $(<"$snapshot/nevra") == "$cached_nevra" ]] || return 1
  printf '%s\n' "$snapshot/xps-ipu7-camera-stack.rpm"
}

rollback_nevra() {
  local expected=${1:-} rpm_path nevra
  rpm_path=$(rollback_rpm "$expected")
  nevra=$(rpm -qp --qf '%{NEVRA}' "$rpm_path")
  [[ $nevra == xps-ipu7-camera-stack-* ]]
  printf '%s\n' "$nevra"
}

prepare_rollback() {
  local expected=${1:-} actual
  valid_identity "$expected"
  actual=$(installed_identity)
  [[ $actual == "$expected" ]]
  # This creates a snapshot when the cache still contains the installed RPM.
  # On an interrupted rerun where the cache already contains the new RPM, the
  # following verification instead requires the durable snapshot made before
  # that cache replacement. A missing or mismatched snapshot is a hard gate.
  snapshot_installed_rpm
  rollback_rpm "$expected" >/dev/null
  printf 'ROLLBACK_READY %s\n' "$expected"
}

verify_transaction_marker() {
  local checksum expected manifest target target_nevra
  local -a lines=()
  [[ -r $transaction_marker ]]
  mapfile -t lines <"$transaction_marker"
  [[ ${lines[4]+present} == present && ${lines[5]+present} != present ]]
  [[ ${lines[0]} == version=1 ]]
  [[ ${lines[1]} == previous=* && ${lines[2]} == target=manifest=* ]]
  [[ ${lines[3]} == target_nevra=xps-ipu7-camera-stack-* ]]
  [[ ${lines[4]} == checksum=* ]]
  valid_identity "${lines[1]#previous=}" || [[ ${lines[1]} == previous=none ]]
  target=${lines[2]#target=}
  target_nevra=${lines[3]#target_nevra=}
  valid_identity "$target"
  manifest=${target#manifest=}
  [[ $target == manifest=* ]]
  valid_role_target_nevra "$target_nevra" "$manifest"
  expected=${lines[4]#checksum=}
  [[ $expected =~ ^[[:xdigit:]]{64}$ ]]
  checksum=$(printf '%s\n' "${lines[@]:0:4}" | sha256sum | awk '{print $1}')
  [[ $checksum == "$expected" ]]
}

transaction_marker_field() {
  local field=$1
  verify_transaction_marker
  sed -n "s/^${field}=//p" "$transaction_marker"
}

transaction_info() {
  local previous previous_nevra=none target target_nevra
  verify_transaction_marker
  previous=$(transaction_marker_field previous)
  target=$(transaction_marker_field target)
  target_nevra=$(transaction_marker_field target_nevra)
  # A prior healthy stack recorded in a transaction is recoverable only while
  # its exact checksummed RPM remains available. This validation deliberately
  # does not depend on service enablement or the currently installed package:
  # either can have changed before an interrupted Ansible invocation resumes.
  if [[ $previous != none ]]; then
    rollback_rpm "$previous" >/dev/null
    previous_nevra=$(rollback_nevra "$previous")
  fi
  printf 'previous=%s\nprevious_nevra=%s\ntarget=%s\ntarget_nevra=%s\n' \
    "$previous" "$previous_nevra" "$target" "$target_nevra"
}

guard_unresolved_build() {
  local inputs=${1:-} marker_target marker_target_nevra
  [[ $inputs =~ ^[[:xdigit:]]{64}$ ]]
  transaction_info >/dev/null
  marker_target=$(transaction_marker_field target)
  marker_target_nevra=$(transaction_marker_field target_nevra)
  [[ $marker_target == "manifest=$inputs" ]] || {
    echo 'CAMERA_TRANSACTION_TARGET_CHANGED: resolve the recorded transaction before rebuilding different inputs' >&2
    return 79
  }
  printf '%s\n' "$marker_target_nevra"
}

begin_transaction() {
  local previous=${1:-} target=${2:-} target_nevra=${3:-}
  local actual current_target current_nevra checksum temporary
  [[ $previous == none ]] || valid_identity "$previous"
  valid_identity "$target"
  [[ $target == manifest=* ]]
  current_target=$(cached_target_identity)
  current_nevra=$(cached_target_nevra)
  [[ $target == "$current_target" && $target_nevra == "$current_nevra" ]]
  if [[ $previous != none ]]; then
    actual=$(installed_identity)
    [[ $actual == "$previous" ]]
  fi
  if [[ -e $transaction_marker ]]; then
    verify_transaction_marker
    [[ $(transaction_marker_field previous) == "$previous" ]]
    [[ $(transaction_marker_field target) == "$target" ]]
    [[ $(transaction_marker_field target_nevra) == "$target_nevra" ]]
    echo "TRANSACTION_CURRENT $target"
    return 0
  fi

  install -d -m 0755 "$state_dir"
  temporary="$state_dir/.transaction.in-progress.$$"
  {
    printf 'version=1\nprevious=%s\ntarget=%s\ntarget_nevra=%s\n' \
      "$previous" "$target" "$target_nevra"
  } >"$temporary"
  checksum=$(sha256sum "$temporary" | awk '{print $1}')
  printf 'checksum=%s\n' "$checksum" >>"$temporary"
  chmod 0644 "$temporary"
  sync -f "$temporary"
  mv -f "$temporary" "$transaction_marker"
  sync -f "$state_dir"
  echo "TRANSACTION_STARTED $target"
}

validate_installed() {
  local kernel module identity dkms_version module_status
  kernel=${2:-$(uname -r)}
  identity=$(installed_identity)
  dkms_version=$(installed_dkms_version)
  rpm -V xps-ipu7-camera-stack
  /usr/local/libexec/xps-ipu7-userspace-check
  "$dkms_source_root/ipu7-drivers-$dkms_version/xps-ipu7-abi-check" "$kernel"
  modinfo -k "$kernel" v4l2loopback >/dev/null
  modinfo -k "$kernel" intel_ipu7_psys >/dev/null
  modinfo -k "$kernel" intel_cvs >/dev/null
  local -a required_modules
  mapfile -t required_modules < <(required_dkms_modules "$kernel")
  for module in "${required_modules[@]}"; do
    module_status=$(dkms status -m "$module" -v "$dkms_version" -k "$kernel" 2>/dev/null || true)
    [[ $module_status =~ :[[:space:]]+installed$ ]]
  done
  printf 'VALID %s dkms=%s kernel=%s\n' "$identity" "$dkms_version" "$kernel"
}

commit_transaction() {
  local expected=${1:-} kernel=${2:-$(uname -r)} actual marker_previous marker_target temporary
  local changed=0
  valid_identity "$expected"
  actual=$(installed_identity)
  [[ $actual == "$expected" ]]
  validate_installed validate-installed "$kernel"
  if [[ -e $transaction_marker ]]; then
    verify_transaction_marker
    marker_previous=$(transaction_marker_field previous)
    marker_target=$(transaction_marker_field target)
    [[ $expected == "$marker_target" || $expected == "$marker_previous" ]]
  fi

  install -d -m 0755 "$state_dir"
  if [[ ! -r $committed_identity_file || $(<"$committed_identity_file") != "$expected" ]]; then
    temporary="$state_dir/.committed-identity.$$"
    printf '%s\n' "$expected" >"$temporary"
    chmod 0644 "$temporary"
    sync -f "$temporary"
    mv -f "$temporary" "$committed_identity_file"
    sync -f "$state_dir"
    changed=1
  fi
  if [[ -e $transaction_marker ]]; then
    unlink "$transaction_marker"
    sync -f "$state_dir"
    changed=1
  fi
  if (( changed )); then
    echo "TRANSACTION_COMMITTED $expected"
  else
    echo "TRANSACTION_CURRENT $expected"
  fi
}

extract_source() {
  local name=$1 commit=$2 destination=$3
  install -d -m 0755 "$destination"
  tar -xzf "$source_dir/${name}-${commit}.tar.gz" --strip-components=1 -C "$destination"
}

build_rpm() {
  install -d -m 0755 "$rpm_dir"
  local inputs rpm_checksum dkms_version marker_target marker_target_nevra
  local transaction_unresolved=false
  inputs=$(input_manifest)
  dkms_version=$(dkms_version_for_manifest "$inputs")
  if [[ -e $transaction_marker ]]; then
    # Never rotate the rollback snapshot or silently switch targets underneath
    # an unresolved package/DKMS transaction. A changed build recipe is itself
    # part of `inputs`, so repository updates also stop here until the exact
    # recorded target commits or the recorded prior identity rolls back.
    marker_target_nevra=$(guard_unresolved_build "$inputs")
    marker_target=$(transaction_marker_field target)
    transaction_unresolved=true
  fi
  if [[ -r $output_rpm ]] &&
     [[ $(rpm -qp --qf '%{VERSION}' "$output_rpm" 2>/dev/null || true) == "$bundle_version" ]] &&
     [[ -r $output_manifest && $(<"$output_manifest") == "$inputs" ]] &&
     [[ -r $output_checksum ]]; then
    rpm_checksum=$(sha256sum "$output_rpm" | awk '{print $1}')
    [[ $(<"$output_checksum") == "$rpm_checksum" ]] || {
      echo 'Cached camera RPM checksum is stale; rebuilding it' >&2
      rpm_checksum=""
    }
  else
    rpm_checksum=""
  fi
  if [[ -n $rpm_checksum ]]; then
    if [[ $transaction_unresolved == true ]]; then
      [[ $(cached_target_identity) == "$marker_target" ]]
      [[ $(cached_target_nevra) == "$marker_target_nevra" ]]
    fi
    echo "CURRENT $output_rpm"
    return 0
  fi

  # Retain the exact cached RPM only when it is provably the package currently
  # installed. A later failed userspace/DKMS refresh can then roll back both
  # halves of the stack instead of merely leaving a mixed installation behind.
  if [[ $transaction_unresolved != true ]]; then
    snapshot_installed_rpm
  fi

  local work stage topdir spec built
  work=$(mktemp -d /var/tmp/xps-ipu7-build.XXXXXX)
  trap "rm -rf -- '$work'" EXIT
  stage="$work/stage"
  topdir="$work/rpmbuild"
  install -d -m 0755 "$stage" "$topdir/SOURCES" "$topdir/SPECS"

{% for source in xps_2026_camera_sources %}
  extract_source {{ source.name | quote }} {{ source.commit | quote }} "$work/{{ source.name }}"
{% endfor %}

  patch --batch --forward -d "$work/ipu7-drivers" -p1 \
    <"$support_dir/patches/0004-ipu7-psys-register-bus.patch"
  patch --batch --forward -d "$work/ipu7-drivers" -p1 \
    <"$support_dir/patches/0005-ipu7-psys-stock-core-layout.patch"
  patch --batch --forward -d "$work/vision-drivers" -p1 \
    <"$support_dir/patches/0003-vision-ptl-cvs-owns-rgb-power.patch"
  patch --batch --forward -d "$work/ipu7-camera-hal" -p1 \
    <"$support_dir/patches/0006-camera-hal-native-cvs-bridge.patch"
  find "$work/ipu7-drivers" "$work/vision-drivers" \
    -type f \( -name '*.orig' -o -name '*.rej' \) -delete

  # Build against only the Panther Lake/ipu75xa Intel binary interface. Keep
  # Intel's redistributable libraries byte-for-byte unchanged in the stage.
  install -d -m 0755 "$stage/usr/lib64/pkgconfig" "$stage/usr/include"
  cp -a "$work/ipu7-camera-bins/lib/"*ipu75xa.so* "$stage/usr/lib64/"
  cp -a "$work/ipu7-camera-bins/include/ipu75xa" "$stage/usr/include/"
  # Fedora's jsoncpp-devel intentionally installs /usr/include/json, while
  # this Intel HAL commit still includes jsoncpp/json/json.h.
  install -d -m 0755 "$stage/usr/include/jsoncpp"
  ln -s /usr/include/json "$stage/usr/include/jsoncpp/json"
  install -m 0644 "$work/ipu7-camera-bins/lib/pkgconfig/ia_imaging-ipu75xa.pc" \
    "$stage/usr/lib64/pkgconfig/"
  sed -i \
    -e "s|^prefix=.*|prefix=$stage/usr|" \
    -e 's|^libdir=.*|libdir=${exec_prefix}/lib64|' \
    "$stage/usr/lib64/pkgconfig/ia_imaging-ipu75xa.pc"

  export PKG_CONFIG_PATH="$stage/usr/lib64/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
  export LIBRARY_PATH="$stage/usr/lib64${LIBRARY_PATH:+:$LIBRARY_PATH}"
  export LD_LIBRARY_PATH="$stage/usr/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export CPATH="$stage/usr/include${CPATH:+:$CPATH}"

  cmake -S "$work/ipu7-camera-hal" -B "$work/ipu7-camera-hal-build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib64 \
    -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DBUILD_CAMHAL_ADAPTOR=ON \
    -DBUILD_CAMHAL_PLUGIN=ON \
    -DIPU_VERSIONS=ipu75xa \
    -DUSE_STATIC_GRAPH=ON \
    -DUSE_STATIC_GRAPH_AUTOGEN=ON \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_PREFIX_PATH="$stage/usr" \
    -DCMAKE_LIBRARY_PATH="$stage/usr/lib64" \
    -DCMAKE_INCLUDE_PATH="$stage/usr/include"
  cmake --build "$work/ipu7-camera-hal-build" --parallel "$(nproc)"
  DESTDIR="$stage" cmake --install "$work/ipu7-camera-hal-build"
  sed -i "s|^prefix=.*|prefix=$stage/usr|" "$stage/usr/lib64/pkgconfig/libcamhal.pc"

  pushd "$work/icamerasrc" >/dev/null
  autoreconf --verbose --force --install
  CHROME_SLIM_CAMHAL=ON ./configure --prefix=/usr --libdir=/usr/lib64
  make --jobs="$(nproc)"
  make DESTDIR="$stage" install
  popd >/dev/null

  # Fedora 44 already supplies and updates the IPU7 base/ISYS driver, ACPI
  # bridge, sensor driver, and firmware. Package only the missing PSYS and CVS
  # DKMS sources; upstream dkms.conf skips base/ISYS for kernels >= 6.17.
  install -d -m 0755 \
    "$stage/usr/src/ipu7-drivers-$dkms_version" \
    "$stage/usr/src/vision-drivers-$dkms_version"
  cp -a "$work/ipu7-drivers/." "$stage/usr/src/ipu7-drivers-$dkms_version/"
  cp -a "$work/vision-drivers/." "$stage/usr/src/vision-drivers-$dkms_version/"
  install -m 0755 /usr/local/libexec/xps-ipu7-abi-check \
    "$stage/usr/src/ipu7-drivers-$dkms_version/xps-ipu7-abi-check"
  install -m 0755 /usr/local/libexec/xps-ipu7-abi-check \
    "$stage/usr/src/vision-drivers-$dkms_version/xps-ipu7-abi-check"
  sed -i "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"$dkms_version\"/" \
    "$stage/usr/src/ipu7-drivers-$dkms_version/dkms.conf"
  sed -i \
    -e 's/^PACKAGE_NAME=.*/PACKAGE_NAME="vision-drivers"/' \
    -e "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"$dkms_version\"/" \
    "$stage/usr/src/vision-drivers-$dkms_version/dkms.conf"
  sed -i 's|^MAKE="|MAKE="./xps-ipu7-abi-check --external-cvs $kernelver \&\& |' \
    "$stage/usr/src/vision-drivers-$dkms_version/dkms.conf"
  printf '\nBUILD_DEPENDS[0]="ipu7-drivers"\n' >> \
    "$stage/usr/src/vision-drivers-$dkms_version/dkms.conf"

  # Development headers and pkg-config files were only build inputs. Runtime
  # consumers need the HAL, its ipu75xa plugin/config, Intel libraries, and
  # icamerasrc. Static archives and libtool metadata are deliberately omitted.
  rm -rf -- "$stage/usr/include" "$stage/usr/lib64/pkgconfig"
  find "$stage" -type f \( -name '*.a' -o -name '*.la' \) -delete

  # Keep the binary package deliberately small, but prove it is a complete
  # runtime. The validator checks every staged HAL/plugin/icamerasrc/IPU75XA
  # ELF with readelf+ldd, rejects dependencies resolved from an older installed
  # camera package, and requires the target OV08X40 config/data set.
  /usr/local/libexec/xps-ipu7-userspace-check --root "$stage"

  install -d -m 0755 "$stage/usr/share/licenses/xps-ipu7-camera-stack"
  install -d -m 0755 "$stage/usr/share/xps-ipu7-camera-stack"
  printf '%s\n' "$inputs" >"$stage/usr/share/xps-ipu7-camera-stack/input-manifest"
  install -m 0644 "$work/ipu7-drivers/LICENSE" \
    "$stage/usr/share/licenses/xps-ipu7-camera-stack/ipu7-drivers-LICENSE"
  install -m 0644 "$work/vision-drivers/LICENSE.txt" \
    "$stage/usr/share/licenses/xps-ipu7-camera-stack/vision-drivers-LICENSE"
  install -m 0644 "$work/ipu7-camera-bins/LICENSE" \
    "$stage/usr/share/licenses/xps-ipu7-camera-stack/ipu7-camera-bins-LICENSE"
  install -m 0644 "$work/ipu7-camera-hal/LICENSE" \
    "$stage/usr/share/licenses/xps-ipu7-camera-stack/ipu7-camera-hal-LICENSE"
  install -m 0644 "$work/icamerasrc/LICENSE" \
    "$stage/usr/share/licenses/xps-ipu7-camera-stack/icamerasrc-LICENSE"

  # Ensure RPM's post-processing cannot strip or otherwise rewrite Intel's
  # binary-only redistributables.
  tar -C "$stage" -czf "$topdir/SOURCES/xps-ipu7-camera-stack.tar.gz" .
  spec="$topdir/SPECS/xps-ipu7-camera-stack.spec"
  sed \
    -e "s/@BUNDLE_VERSION@/$bundle_version/g" \
    -e "s/@DKMS_VERSION@/$dkms_version/g" \
    -e "s/@INPUT_RELEASE@/${inputs:0:16}/g" \
    "$support_dir/xps-ipu7-camera-stack.spec" >"$spec"
  rpmbuild -bb --define "_topdir $topdir" "$spec"
  built=$(find "$topdir/RPMS/x86_64" -maxdepth 1 -type f -name 'xps-ipu7-camera-stack-*.rpm' -print -quit)
  [[ -n $built ]]
  install -m 0644 "$built" "$output_rpm.new"
  mv -f -- "$output_rpm.new" "$output_rpm"
  sha256sum "$output_rpm" | awk '{print $1}' >"$output_checksum.new"
  printf '%s\n' "$inputs" >"$output_manifest.new"
  mv -f "$output_checksum.new" "$output_checksum"
  mv -f "$output_manifest.new" "$output_manifest"
  if [[ $transaction_unresolved == true ]]; then
    [[ $(cached_target_identity) == "$marker_target" ]]
    [[ $(cached_target_nevra) == "$marker_target_nevra" ]]
  fi
  echo "CHANGED $output_rpm"
}

prune_dkms() {
  local module old_version old_tree dkms_version
  local changed=0
  local services_stopped=0
  dkms_version=$(installed_dkms_version)

  # Remove only older xps bundles owned by this role. Ordinarily DKMS still
  # has their RPM-owned source link; the fallback handles an interrupted RPM
  # upgrade which left a provably broken, generated registration behind.
  for module in ipu7-drivers vision-drivers; do
    for old_tree in /var/lib/dkms/"$module"/*.xps*; do
      [[ -d $old_tree ]] || continue
      old_version=${old_tree##*/}
      [[ $old_version == "$dkms_version" ]] && continue
      if (( ! services_stopped )); then
        systemctl stop v4l2-relayd@ipu7.service xps-ipu7-camera.service >/dev/null 2>&1 || true
        services_stopped=1
      fi
      if ! dkms remove -m "$module" -v "$old_version" --all; then
        if [[ -e $old_tree/source ]]; then
          return 1
        fi
        find "$old_tree" -depth -delete
      fi
      changed=1
    done
  done

  if (( changed )); then
    echo 'DKMS_PRUNED'
  else
    echo 'DKMS_PRUNE_CURRENT'
  fi
}

required_dkms_modules() {
  local kernel=$1
  printf '%s\n' ipu7-drivers
  # Keep the native CVS driver and its media bridge when Fedora provides it.
  # The ABI guard additionally verifies its in-tree path and rejects shadowing.
  if [[ $(modinfo -k "$kernel" -F intree intel_cvs 2>/dev/null || true) != Y ]]; then
    printf '%s\n' vision-drivers
  fi
}

camera_modules_loaded() {
  local cvs_taint
  [[ -d /sys/module/intel_ipu7_psys ]] && return 0
  [[ -d /sys/module/intel_cvs ]] || return 1
  # A loaded stock CVS is not replaced by this transaction, so it must not
  # impose a reboot on a first-time PSYS-only installation.
  # Check the in-memory module too: DKMS removal may have restored the native
  # file on disk while an old external CVS remains loaded until reboot.
  cvs_taint=$(cat /sys/module/intel_cvs/taint 2>/dev/null) || return 0
  [[ $cvs_taint == *O* || $(modinfo -F intree intel_cvs 2>/dev/null || true) != Y ]]
}

loaded_transaction_needs_reboot() {
  local changed=$1 transaction_pending=$2 modules_loaded=$3 reboot_satisfied=$4 rollback=$5
  [[ $rollback != true && $modules_loaded == true && $reboot_satisfied != true ]] || return 1
  (( changed )) || [[ $transaction_pending == true ]]
}

reboot_marker_state() {
  local marker=$1 boot_id=$2 dkms_version=$3 line marker_boot marker_dkms
  [[ -r $marker ]] || {
    echo none
    return 0
  }
  line=$(<"$marker")
  [[ $line =~ ^boot_id=([^[:space:]]+)[[:space:]]dkms=([^[:space:]]+)$ ]] || return 1
  marker_boot=${BASH_REMATCH[1]}
  marker_dkms=${BASH_REMATCH[2]}
  [[ $marker_dkms == "$dkms_version" ]] || return 1
  if [[ $marker_boot == "$boot_id" ]]; then
    echo current
  else
    echo previous
  fi
}

write_reboot_marker() {
  local marker=$1 boot_id=$2 dkms_version=$3 temporary
  temporary="${marker}.new.$$"
  printf 'boot_id=%s dkms=%s\n' "$boot_id" "$dkms_version" >"$temporary"
  chmod 0644 "$temporary"
  sync -f "$temporary"
  mv -f "$temporary" "$marker"
  sync -f "${marker%/*}"
}

install_dkms() {
  local kernel module boot_id marker marker_state module_status dkms_version force rollback
  local actual marker_previous marker_target modules_loaded=false reboot_satisfied=false
  local transaction_pending=false
  local changed=0
  local -a required_modules
  kernel=${2:-$(uname -r)}
  force=${3:-false}
  rollback=${4:-false}
  dkms_version=$(installed_dkms_version)
  [[ -d $dkms_source_root/ipu7-drivers-$dkms_version ]]
  [[ -d $dkms_source_root/vision-drivers-$dkms_version ]]

  if [[ -e $transaction_marker ]]; then
    transaction_info >/dev/null
    marker_previous=$(transaction_marker_field previous)
    marker_target=$(transaction_marker_field target)
    actual=$(installed_identity)
    if [[ $actual == "$marker_target" ]]; then
      transaction_pending=true
    elif [[ $rollback == true && $actual == "$marker_previous" ]]; then
      transaction_pending=false
    else
      echo 'CAMERA_TRANSACTION_IDENTITY_MISMATCH: installed RPM is neither the recorded target nor an explicit rollback' >&2
      return 79
    fi
  fi

  # Run this explicitly for a useful Ansible diagnostic. The same check is
  # embedded in the IPU7 DKMS MAKE command, so future automatic rebuilds also
  # stop before compiling against an unreviewed Fedora stock-core layout.
  if ! "$dkms_source_root/ipu7-drivers-$dkms_version/xps-ipu7-abi-check" "$kernel"; then
    echo "IPU7_STOCK_ABI_CHANGED: refusing optional PSYS/CVS installation for $kernel" >&2
    return 78
  fi
  mapfile -t required_modules < <(required_dkms_modules "$kernel")

  # RPM Fusion akmods and DKMS share one locally generated signing key. This
  # makes Secure Boot enrollment a single, explicit owner action.
  /usr/bin/kmodgenca -a >/dev/null
  for module in "${required_modules[@]}"; do
    # Do not pipe `dkms status` into `grep -q` under pipefail: when multiple
    # kernels are installed, grep exits after the first line and DKMS can get
    # SIGPIPE, making an existing registration look absent.
    module_status=$(dkms status -m "$module" -v "$dkms_version" 2>/dev/null || true)
    if [[ -z $module_status ]]; then
      dkms add -m "$module" -v "$dkms_version"
      changed=1
    fi
  done
  # Build both modules before installing either one. This limits a failed
  # forced rollback/rebuild to the existing on-disk module pair.
  if [[ $force == true ]]; then
    for module in "${required_modules[@]}"; do
      dkms build --force -m "$module" -v "$dkms_version" -k "$kernel"
      changed=1
    done
  fi
  for module in "${required_modules[@]}"; do
    module_status=$(dkms status -m "$module" -v "$dkms_version" -k "$kernel" 2>/dev/null || true)
    if [[ $force == true || ! $module_status =~ :[[:space:]]+installed$ ]]; then
      dkms install --force -m "$module" -v "$dkms_version" -k "$kernel"
      changed=1
    fi
  done
  depmod -a "$kernel"

  if mokutil --sb-state 2>/dev/null | grep -qi enabled &&
     ! mokutil --test-key /etc/pki/akmods/certs/public_key.der >/dev/null 2>&1; then
    echo 'MOK_ENROLLMENT_REQUIRED: sudo mokutil --import /etc/pki/akmods/certs/public_key.der' >&2
    return 4
  fi

  marker=/var/lib/xps-hardware/ipu7/reboot-required
  boot_id=$(cat /proc/sys/kernel/random/boot_id)
  if [[ $rollback == true ]]; then
    marker_state=rollback
  else
    marker_state=$(reboot_marker_state "$marker" "$boot_id" "$dkms_version") || {
      echo 'CAMERA_REBOOT_MARKER_INVALID: refusing to discard an unprovable reboot boundary' >&2
      return 79
    }
  fi
  if [[ $marker_state == current && $rollback != true ]]; then
    echo "DKMS_REBOOT_REQUIRED kernel=$kernel dkms=$dkms_version" >&2
    return 5
  fi
  [[ $marker_state != previous ]] || reboot_satisfied=true
  camera_modules_loaded && modules_loaded=true

  # A loaded module cannot be replaced in memory by DKMS. The unresolved
  # transaction flag is as important as this invocation's local `changed`
  # value: after SIGKILL immediately following dkms install, a rerun observes
  # installed registrations (`changed=0`) but still has old modules in memory.
  if loaded_transaction_needs_reboot \
       "$changed" "$transaction_pending" "$modules_loaded" "$reboot_satisfied" "$rollback"; then
    systemctl stop v4l2-relayd@ipu7.service xps-ipu7-camera.service >/dev/null 2>&1 || true
    write_reboot_marker "$marker" "$boot_id" "$dkms_version"
    echo "DKMS_CHANGED kernel=$kernel"
    echo "DKMS_REBOOT_REQUIRED kernel=$kernel dkms=$dkms_version" >&2
    return 5
  fi
  if [[ -e $marker ]]; then
    unlink "$marker"
    sync -f "${marker%/*}"
  fi

  if (( changed )); then
    echo "DKMS_CHANGED kernel=$kernel"
  else
    echo "DKMS_CURRENT kernel=$kernel"
  fi
}

case "${1:-}" in
  build) build_rpm ;;
  installed-identity) installed_identity ;;
  target-identity) cached_target_identity ;;
  target-nevra) cached_target_nevra ;;
  transaction-info) transaction_info ;;
  prepare-rollback) prepare_rollback "${2:-}" ;;
  rollback-rpm) rollback_rpm "${2:-}" ;;
  rollback-nevra) rollback_nevra "${2:-}" ;;
  begin-transaction) begin_transaction "${2:-}" "${3:-}" "${4:-}" ;;
  commit-transaction) commit_transaction "${2:-}" "${3:-$(uname -r)}" ;;
  validate-installed) validate_installed "$@" ;;
  prune-dkms) prune_dkms ;;
  install-dkms) install_dkms "$@" ;;
  install-dkms-force) install_dkms install-dkms "${2:-$(uname -r)}" true true ;;
  *) echo 'Usage: xps-ipu7-build <build|installed-identity|target-{identity,nevra}|transaction-info|prepare-rollback|rollback-{rpm,nevra}|begin-transaction|commit-transaction|validate-installed|prune-dkms|install-dkms[-force] [args...]>' >&2; exit 2 ;;
esac
