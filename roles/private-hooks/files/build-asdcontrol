#!/usr/bin/env bash
set -euo pipefail
source_dir=/var/cache/cybexos-upstream/asdcontrol/source
expected=0ee8bd576d4e93513027d713e688988cb0d827ef
state=/var/lib/cybexos-upstream/asdcontrol
recipe=$(sha256sum "$0" | awk '{print $1}')
[[ $(git -C "$source_dir" rev-parse HEAD) == "$expected" ]] || {
  echo "asdcontrol source revision mismatch" >&2
  exit 1
}
manifest="revision=$expected recipe=$recipe"
if [[ -r $state/manifest && $(<"$state/manifest") == "$manifest" && -x /usr/local/bin/asdcontrol ]]; then
  echo "UNCHANGED: asdcontrol $expected"
  exit 0
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cp -a "$source_dir/." "$work/"
python3 - "$work/asdcontrol.cpp" <<'PY'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
s = p.read_text()
old = 'const int PRO_XDR_DISPLAY_32              = 0x9243;'
new = old + '\nconst int STUDIO_DISPLAY_XDR              = 0x1116;'
if old not in s: raise SystemExit('asdcontrol constant patch context missing')
s = s.replace(old, new, 1)
old = '''supportedDevices.insert ( DeviceId ( APPLE, STUDIO_DISPLAY_27,
                                         "Apple Studio Display (2022, 27\\")", 400, 60000 ) );
}'''
new = '''supportedDevices.insert ( DeviceId ( APPLE, STUDIO_DISPLAY_27,
                                         "Apple Studio Display (2022, 27\\")", 400, 60000 ) );

    supportedDevices.insert ( DeviceId ( APPLE, STUDIO_DISPLAY_XDR,
                                         "Apple Studio Display XDR", 400, 60000 ) );
}'''
if old not in s: raise SystemExit('asdcontrol device patch context missing')
p.write_text(s.replace(old, new, 1))
PY
g++ -O2 "$work/asdcontrol.cpp" -o "$work/asdcontrol"
install -m 0755 "$work/asdcontrol" /usr/local/bin/asdcontrol.new
mv -f /usr/local/bin/asdcontrol.new /usr/local/bin/asdcontrol
mkdir -p "$state"
printf '%s\n' "$manifest" > "$state/manifest.new"
mv -f "$state/manifest.new" "$state/manifest"
[[ ! -e $state/revision ]] || unlink "$state/revision"
restorecon -F /usr/local/bin/asdcontrol 2>/dev/null || true
echo "CHANGED: asdcontrol $expected"
