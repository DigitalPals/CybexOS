#!/usr/bin/env bash
# Session actions shared by Quickshell and other desktop entry points.
# Locking is delegated to one systemd unit, so idle, suspend, and manual lock
# requests cannot accumulate competing hyprlock processes.
set -euo pipefail

action=${1:-}

# The compositor's own answer: true once the ext-session-lock is active.
# logind's LockedHint is not consulted. Nothing in this session sets it, so it
# reads "no" behind a working lock screen, and a stale "yes" would let a
# suspend skip the lock.
locked() {
  [[ $(hyprctl locked 2>/dev/null) == true ]]
}

ensure_locked() {
  local i
  if locked; then
    return 0
  fi

  systemctl --user reset-failed cybexos-session-lock.service >/dev/null 2>&1 || true
  systemctl --user start cybexos-session-lock.service

  # Do not use a fixed sleep: suspend is allowed only after the compositor
  # reports the ext-session-lock active. A failed locker therefore leaves the
  # machine awake and returns an actionable error to the caller.
  for ((i = 0; i < 80; i++)); do
    if locked; then
      return 0
    fi
    if ! systemctl --user is-active --quiet cybexos-session-lock.service; then
      printf 'The lock screen exited before the session was secured.\n' >&2
      return 1
    fi
    sleep 0.1
  done

  # A locker that is still running is left running: it may lock a moment
  # later, and stopping it would unlock the session with nobody at the
  # keyboard. A lid close suspends while this loop waits, so its eight
  # seconds can run out just after resume. Staying locked is the only safe
  # failure; the caller just does not suspend.
  printf 'The lock screen did not secure the session within eight seconds.\n' >&2
  return 1
}

# UPower's aggregate answer, the same source the shell's battery state reads.
# An unknown answer counts as mains power, so it never suspends by mistake.
on_battery() {
  [[ $(busctl --system get-property org.freedesktop.UPower \
    /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null) == 'b true' ]]
}

case $action in
  lock)
    ensure_locked
    ;;
  suspend)
    ensure_locked
    systemctl suspend
    ;;
  idle-suspend)
    # hypridle's suspend step. `on-battery` limits it to battery power, which
    # is checked when the timeout fires rather than when hypridle starts.
    case ${2:-} in
      '') ;;
      on-battery) on_battery || exit 0 ;;
      *)
        printf 'Usage: cybexos-session-action idle-suspend [on-battery]\n' >&2
        exit 2
        ;;
    esac
    ensure_locked
    systemctl suspend
    ;;
  logout)
    hyprctl dispatch exit
    ;;
  reboot)
    systemctl reboot
    ;;
  shutdown)
    systemctl poweroff
    ;;
  *)
    printf 'Usage: cybexos-session-action <lock|suspend|idle-suspend|logout|reboot|shutdown>\n' >&2
    exit 2
    ;;
esac
