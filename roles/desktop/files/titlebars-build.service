[Unit]
Description=Build CybexOS titlebars for the installed Hyprland
After=local-fs.target
ConditionPathExists=/usr/share/cybexos/titlebars/source.json
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/libexec/cybexos-titlebars-install --offline
TimeoutStartSec=15min
Nice=10
UMask=0022
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
