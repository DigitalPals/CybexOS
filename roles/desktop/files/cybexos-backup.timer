[Unit]
Description=Hourly check for a due personal-file backup
PartOf=hyprland-session.target

[Timer]
# The session's keyring and notifications are needed, so checks run only
# while it is active: shortly after login, then every hour. The helper backs
# up at most once a day and only when the destination is reachable, so a
# missed check costs nothing. Calendar times keep the schedule independent
# of whether the last check ran a backup.
OnActiveSec=10min
OnCalendar=hourly
RandomizedDelaySec=10min
AccuracySec=1min

[Install]
WantedBy=hyprland-session.target
