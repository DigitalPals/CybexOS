#!/usr/bin/python3
"""Build the pinned native plugin using only the installed Fedora compositor ABI."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tarfile
import tempfile


def digest(path):
    with Path(path).open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def run(*args, **kwargs):
    # A root build must not accidentally pick up a user's alternate SDK.
    environment = dict(os.environ)
    for key in ('PKG_CONFIG_PATH', 'PKG_CONFIG_LIBDIR', 'CPATH', 'CPLUS_INCLUDE_PATH',
                'CMAKE_PREFIX_PATH', 'CXXFLAGS', 'CPPFLAGS', 'LDFLAGS'):
        environment.pop(key, None)
    environment['PATH'] = '/usr/sbin:/usr/bin:/sbin:/bin'
    return subprocess.run(args, check=True, env=environment, **kwargs)


def output(*args):
    return run(*args, capture_output=True, text=True).stdout.strip()


def installed_identity():
    packages = output('rpm', '-q', '--qf', '%{EVR}.%{ARCH}\n', 'hyprland', 'hyprland-devel').splitlines()
    if len(packages) != 2 or packages[0] != packages[1]:
        raise RuntimeError('hyprland and hyprland-devel must have identical Fedora EVR and architecture')
    # Reject locally modified SDK/binary files as well as mismatched packages.
    run('rpm', '--verify', 'hyprland', 'hyprland-devel', capture_output=True)
    header = Path('/usr/include/hyprland/src/version.h')
    defines = dict(re.findall(r'^#define\s+(\w+)\s+"([^"]+)"', header.read_text(), re.M))
    commit = defines['GIT_COMMIT_HASH']
    if not re.fullmatch('[0-9a-f]{40}', commit):
        raise RuntimeError('Installed Hyprland headers have no full source commit')
    abi = commit + ''.join('_' + short + '_' + defines[name].rsplit('.', 1)[0] for short, name in (
        ('aq', 'AQUAMARINE_VERSION'), ('hu', 'HYPRUTILS_VERSION'), ('hg', 'HYPRGRAPHICS_VERSION'),
        ('hc', 'HYPRCURSOR_VERSION'), ('hlg', 'HYPRLANG_VERSION')))
    # --version does not start a compositor; this build needs no live desktop.
    with tempfile.TemporaryDirectory(prefix='cybexos-titlebars-version.') as runtime:
        version = output('env', 'XDG_RUNTIME_DIR=' + runtime, 'Hyprland', '--version')
    if f'Version ABI string: {abi}' not in version.splitlines():
        raise RuntimeError('Installed Hyprland binary ABI differs from the installed headers')
    notes = output('readelf', '-n', '/usr/bin/Hyprland')
    build_id = re.search(r'Build ID: ([0-9a-f]+)', notes)
    if not build_id:
        raise RuntimeError('Installed Hyprland has no GNU ELF build ID')
    return {'rpm': packages[0], 'abi': abi, 'build_id': build_id[1],
            'binary_sha256': digest('/usr/bin/Hyprland'), 'headers_sha256': digest(header)}


class Installer:
    def __init__(self, root=Path('/')):
        self.root = Path(root)
        self.recipe = self.root / 'usr/share/cybexos/titlebars'
        self.library = self.root / 'usr/lib64/cybexos/titlebars.so'
        self.manifest = self.library.with_suffix('.json')
        self.licenses = self.root / 'usr/share/licenses/cybexos-titlebars'

    def inputs(self):
        pin = json.loads((self.recipe / 'source.json').read_text())
        if not re.fullmatch(r'v[0-9]+\.[0-9]+\.[0-9]+', pin['version']) or not re.fullmatch('[0-9a-f]{40}', pin['commit']) \
                or not re.fullmatch('sha256:[0-9a-f]{64}', pin['checksum']):
            raise RuntimeError('Titlebars requires an explicit release, full source commit and SHA-256')
        return pin

    def invalidate(self):
        self.library.unlink(missing_ok=True)
        self.manifest.unlink(missing_ok=True)

    def healthy(self, identity):
        try:
            saved = json.loads(self.manifest.read_text())
            return (saved['inputs'] == identity and saved['plugin_sha256'] == digest(self.library)
                    and all(saved['licenses'][name] == digest(self.licenses / name)
                            for name in ('LICENSE', 'LICENSE.MIT')))
        except (OSError, ValueError, KeyError):
            return False

    def build(self, offline=False):
        # Serialize service, checkout convergence and package build requests.
        cache = self.root / 'var/cache/cybexos-titlebars'
        cache.mkdir(parents=True, exist_ok=True)
        with (cache / 'build.lock').open('w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                return self._build(offline, cache)
            finally:
                for path in (self.library.with_suffix('.so.new'), self.manifest.with_suffix('.json.new'),
                             self.recipe / '.source.tar.gz.new'):
                    path.unlink(missing_ok=True)

    def _build(self, offline, cache):
        try:
            pin = self.inputs()
            compositor = installed_identity()
            identity = {'source': pin, 'hyprland': compositor,
                        'recipe_sha256': digest(__file__), 'patch_sha256': digest(self.recipe / 'native.patch')}
        except Exception:
            # No valid SDK/recipe means no safe plugin can be made available.
            self.invalidate()
            raise
        if self.healthy(identity):
            print('UNCHANGED: native titlebars ' + pin['version'])
            return
        # A stale build must never remain loadable after a failed rebuild.
        self.invalidate()
        with tempfile.TemporaryDirectory(prefix='.build-', dir=cache) as temporary:
            work = Path(temporary)
            archive = self.recipe / 'source.tar.gz'
            if not archive.is_file() or digest(archive) != pin['checksum'][7:]:
                if offline:
                    raise RuntimeError('Verified cached titlebar source is missing; run checkout convergence to repair it')
                download = work / 'source.tar.gz'
                run('curl', '--fail', '--silent', '--show-error', '--location', '--max-time', '300',
                    'https://codeload.github.com/omacom/omarchy-hyprland-titlebars/tar.gz/' + pin['commit'],
                    '--output', str(download))
                if digest(download) != pin['checksum'][7:]:
                    raise RuntimeError('Titlebar source checksum mismatch')
                shutil.copyfile(download, self.recipe / '.source.tar.gz.new')
                os.chmod(self.recipe / '.source.tar.gz.new', 0o644)
                os.replace(self.recipe / '.source.tar.gz.new', archive)
            source = work / 'source'
            source.mkdir()
            with tarfile.open(archive) as stream:
                # Only normal source files/directories; no external links,
                # devices, absolute names or path traversal in a root build.
                for member in stream.getmembers():
                    name = Path(member.name)
                    if name.is_absolute() or '..' in name.parts or not (member.isfile() or member.isdir()):
                        raise RuntimeError('Unsafe titlebar source archive entry: ' + member.name)
                stream.extractall(source, filter='data')
            children = list(source.iterdir())
            if len(children) != 1 or not children[0].is_dir():
                raise RuntimeError('Unexpected titlebar source archive layout')
            source = children[0]
            run('patch', '--batch', '--fuzz=0', '-p1', '-i', str(self.recipe / 'native.patch'), cwd=source)
            build = work / 'build'
            run('cmake', '-S', str(source), '-B', str(build), '-DCMAKE_BUILD_TYPE=Release',
                '-DCMAKE_CXX_COMPILER=/usr/bin/g++', '-DCYBEXOS_HYPRLAND_BUILD_ID=' + compositor['build_id'])
            run('cmake', '--build', str(build), '--parallel', str(min(os.cpu_count() or 1, 4)))
            candidate = build / 'titlebars.so'
            if candidate.read_bytes()[:4] != b'\x7fELF':
                raise RuntimeError('Native build produced no ELF library')
            # An overlapping RPM transaction must not publish a build for the
            # binary/SDK that was present only at compilation's start.
            if installed_identity() != compositor:
                raise RuntimeError('Hyprland changed during compilation; retry native titlebar build')
            self.library.parent.mkdir(parents=True, exist_ok=True)
            self.licenses.mkdir(parents=True, exist_ok=True)
            saved = {'inputs': identity, 'plugin_sha256': digest(candidate), 'licenses': {}}
            for name in ('LICENSE', 'LICENSE.MIT'):
                shutil.copyfile(source / name, self.licenses / name)
                os.chmod(self.licenses / name, 0o644)
                saved['licenses'][name] = digest(self.licenses / name)
            staged = self.library.with_suffix('.so.new')
            shutil.copyfile(candidate, staged)
            os.chmod(staged, 0o755)
            manifest = self.manifest.with_suffix('.json.new')
            manifest.write_text(json.dumps(saved, sort_keys=True, indent=2) + '\n')
            os.chmod(manifest, 0o644)
            os.replace(staged, self.library)
            os.replace(manifest, self.manifest)
        if shutil.which('restorecon'):
            run('restorecon', '-R', str(self.library.parent), str(self.licenses))
        print('CHANGED: native titlebars ' + pin['version'] + ' for ' + compositor['rpm'])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', type=Path, default=Path('/'), help='stage output below this root; use the host Fedora SDK')
    parser.add_argument('--offline', action='store_true', help='never download source (for boot/update builds)')
    args = parser.parse_args()
    if os.geteuid() != 0 or not args.root.is_absolute():
        parser.error('native titlebar installation requires root and an absolute staging root')
    Installer(args.root).build(args.offline)


if __name__ == '__main__':
    main()
