[Unit]
Description=Rebuild native titlebars after Hyprland or its recipe changes

[Path]
PathChanged=/usr/bin/Hyprland
PathChanged=/usr/share/pkgconfig/hyprland.pc
PathChanged=/usr/include/hyprland/src/version.h
PathChanged=/usr/libexec/cybexos-titlebars-install
PathChanged=/usr/share/cybexos/titlebars/source.json
PathChanged=/usr/share/cybexos/titlebars/native.patch
Unit=cybexos-titlebars-build.service

[Install]
WantedBy=multi-user.target
