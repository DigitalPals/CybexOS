[Unit]
Description=Back up personal files when a daily backup is due
Documentation=man:restic(1)
PartOf=hyprland-session.target
# Nothing to check until backups are set up in Settings or with cybex backup.
ConditionPathExists=%E/cybexos/backup.json

[Service]
Type=oneshot
ExecStart=%h/.local/bin/cybexos-backup scheduled
# A backup must not compete with the session for the processor or the disk.
Nice=10
IOSchedulingClass=idle
