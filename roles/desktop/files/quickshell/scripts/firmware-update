#!/usr/bin/env bash
# Interactive firmware installation; retain fwupd's device and reboot prompts.
set -uo pipefail

finish() {
    local rc=$1
    if (( rc != 0 )); then
        printf '\nFirmware update failed (status %s).\n' "$rc"
    fi
    if [[ -t 0 ]]; then
        read -r -p 'Press Enter to close…' _ || true
    fi
    exit "$rc"
}

# Also prevent duplicate installers after a shell reload.
lock_root=${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/cybexos}
mkdir -p -- "$lock_root" || finish 1
exec 9>"$lock_root/cybexos-firmware.lock" || finish 1
flock -n 9 || { printf 'A firmware updater is already open.\n'; finish 1; }

fwupdmgr refresh
rc=$?
# fwupd uses 2 for a successful command with nothing to do.
(( rc == 0 || rc == 2 )) || finish "$rc"
fwupdmgr update
rc=$?
(( rc != 2 )) || rc=0
finish "$rc"
