#!/usr/bin/env bash
# Quickshell's update entry point. A complete CybexOS installation has
# the verified release updater; a source-tree/Quickshell-only deployment still
# has the durable package backend and must remain able to update the system.
set -euo pipefail

command_name=${1:-}
[[ $# -eq 0 ]] || shift

data_root=${XDG_DATA_HOME:-$HOME/.local/share}/cybexos
config_file=${CYBEXOS_CONFIG_FILE:-/etc/cybexos/config.yml}
release_updater=${CYBEXOS_RELEASE_UPDATE:-$data_root/current/update}
backend=${CYBEXOS_UPDATE_BACKEND:-$HOME/.local/bin/cybexos-update-run}

managed=false
[[ -x $release_updater && -r $config_file ]] && managed=true

case $command_name in
  check)
    if [[ $managed == true ]]; then
      exec "$release_updater" --check --json "$@"
    fi
    printf '%s\n' \
      '{"currentVersion":"","availableVersion":"","channel":"","available":false,"managed":false}'
    ;;
  start)
    if [[ ${1:-} == --system-only ]]; then
      managed=false
      shift
    fi
    if [[ $managed == true ]]; then
      exec "$release_updater" --start --json "$@"
    fi
    [[ -x $backend ]] || {
      printf 'update-client: update backend is unavailable: %s\n' "$backend" >&2
      exit 127
    }
    exec "$backend" start --json --system-unit "$@"
    ;;
  run)
    if [[ $managed == true ]]; then
      exec "$release_updater" "$@"
    fi
    [[ -x $backend ]] || {
      printf 'update-client: update backend is unavailable: %s\n' "$backend" >&2
      exit 127
    }
    exec "$backend" run "$@"
    ;;
  -h|--help|help)
    printf 'usage: update-client check | start | run [--no-flatpak]\n'
    ;;
  *)
    printf 'update-client: unknown command: %s\n' "${command_name:-<empty>}" >&2
    exit 2
    ;;
esac
