#!/usr/bin/env bash
set -euo pipefail

# Hyprland learns its Wayland socket after the user manager has already
# started. Publish the complete session environment before allowing any unit
# in hyprland-session.target to start; otherwise early services can inherit a
# half-updated environment and then remain broken for the whole login.
required_environment=(
  WAYLAND_DISPLAY
  XDG_CURRENT_DESKTOP
  HYPRLAND_INSTANCE_SIGNATURE
)
for variable in "${required_environment[@]}"; do
  if [[ -z ${!variable:-} ]]; then
    printf 'hyprland-session: %s is not set yet\n' "$variable" >&2
    exit 75
  fi
done

runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
mkdir -p "$runtime_dir/cybexos"
exec 9>"$runtime_dir/cybexos/hyprland-session.lock"
flock 9

systemctl --user import-environment "${required_environment[@]}"
dbus-update-activation-environment --systemd "${required_environment[@]}"
systemctl --user start hyprland-session.target

# The portal needs both the imported environment and a live Hyprland socket.
# Keep this ordered after the target start, while retaining the short grace
# period that avoids racing Hyprland's socket initialization.
sleep 1
systemctl --user restart \
  xdg-desktop-portal-hyprland.service xdg-desktop-portal.service

# On NVIDIA systems, show a pending restart, Secure Boot key enrollment or
# driver failure once per boot. The helper exists only where the NVIDIA role
# ran; the delay lets the shell's notification server start. The background
# job must not keep the session lock (fd 9).
nvidia_helper=/usr/local/libexec/cybexos-nvidia
if [[ -x $nvidia_helper ]]; then
  (sleep 10; exec "$nvidia_helper" notify) 9>&- >/dev/null 2>&1 &
fi
