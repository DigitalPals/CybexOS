-- Keep the laptop as the home for workspace 1 and route the remaining
-- numbered workspaces to one active external output. Rules for several
-- possible external descriptions cannot be declared statically: workspace
-- rules are keyed by workspace, so the last declaration would reserve the
-- workspace for that output even when it is disconnected.
--
-- Rebuild the active rule set when the monitor layout changes. With only one
-- output, only workspace 1 is bound and Hyprland can create every other
-- workspace on that output normally. This also makes the lid-closed/XREAL
-- policy work: once eDP-1 is disabled, workspace 1 follows the external.
local previous_workspace_policy = rawget(_G, "__fedora_workspace_policy")
if previous_workspace_policy then
  for _, rule in ipairs(previous_workspace_policy.rules or {}) do
    rule:set_enabled(false)
  end
  for _, subscription in ipairs(previous_workspace_policy.subscriptions or {}) do
    subscription:remove()
  end
end

local workspace_policy = {
  rules = {},
  subscriptions = {},
  signature = nil,
}
_G.__fedora_workspace_policy = workspace_policy

local function preferred_external(monitors)
  local selected = nil
  for _, monitor in ipairs(monitors) do
    if monitor.name ~= "eDP-1" and not monitor.is_mirror then
      if selected == nil
          or monitor.id < selected.id
          or (monitor.id == selected.id and monitor.name < selected.name) then
        selected = monitor
      end
    end
  end
  return selected
end

local function apply_workspace_policy()
  local monitors = hl.get_monitors()
  local internal = nil
  for _, monitor in ipairs(monitors) do
    if monitor.name == "eDP-1" then
      internal = monitor
      break
    end
  end
  local external = preferred_external(monitors)
  local signature = (internal and internal.name or "-")
      .. ":" .. (external and external.name or "-")
  if signature == workspace_policy.signature then return end

  for _, rule in ipairs(workspace_policy.rules) do
    rule:set_enabled(false)
  end
  workspace_policy.rules = {}
  workspace_policy.signature = signature

  local workspace_one_monitor = internal or external
  if workspace_one_monitor then
    table.insert(workspace_policy.rules, hl.workspace_rule({
      workspace = "1",
      monitor = workspace_one_monitor.name,
      default = true,
    }))
  end

  if internal and external then
    for workspace = 2, 10 do
      table.insert(workspace_policy.rules, hl.workspace_rule({
        workspace = tostring(workspace),
        monitor = external.name,
        default = workspace == 2,
      }))
    end
  end
end

table.insert(workspace_policy.subscriptions,
  hl.on("monitor.layout_changed", apply_workspace_policy))
apply_workspace_policy()

hl.env("GDK_SCALE", "2")
{% else %}
-- Portable default: use each connected output's preferred mode and let
-- Hyprland choose its position and scale.
monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })
{% endif %}
