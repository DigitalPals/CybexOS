[Unit]
Description=Voxtype push-to-talk dictation daemon
PartOf=hyprland-session.target
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
# voxtype.toml also asks for on-demand loading, but it is managed only with
# the personal dotfiles. The option is global: it must precede the
# subcommand, which rejects it.
ExecStart=/usr/bin/voxtype --on-demand-loading daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=hyprland-session.target
