$font = JetBrainsMono Nerd Font

general {
  hide_cursor = true
  ignore_empty_input = true
}

animations {
  enabled = true
  bezier = ease, 0.25, 0.1, 0.25, 1.0
  animation = fadeIn, 1, 3, ease
  animation = fadeOut, 1, 3, ease
  animation = inputFieldDots, 1, 2, ease
}

background {
  monitor =
  color = rgba(1a1917ff)
}

label {
  monitor =
  text = $TIME
  color = rgba(f2f0eaff)
  font_size = 84
  font_family = $font
  position = 0, 150
  halign = center
  valign = center
}

label {
  monitor =
  text = cmd[update:60000] date +"%A, %d %B"
  color = rgba(b3afa4ff)
  font_size = 24
  font_family = $font
  position = 0, 85
  halign = center
  valign = center
}

input-field {
  monitor =
  size = 300, 54
  outline_thickness = 2
  dots_size = 0.28
  dots_spacing = 0.22
  dots_center = true
  outer_color = rgba(3a3936ff)
  inner_color = rgba(201e1bd9)
  font_color = rgba(f2f0eaff)
  fade_on_empty = false
  placeholder_text = <span foreground="##b3afa4">Password</span>
  fail_text = <span foreground="##ff8f8f">$PAMFAIL</span>
  check_color = rgba(d3d283ff)
  fail_color = rgba(ff8f8fff)
  rounding = 12
  font_family = $font
  position = 0, -18
  halign = center
  valign = center
}
