general {
  lock_cmd = systemctl --user start cybexos-session-lock.service
  before_sleep_cmd = /usr/local/libexec/cybexos-session-action lock
  after_sleep_cmd = hyprctl eval 'hl.dispatch(hl.dsp.dpms({ action = "on" }))'
  inhibit_sleep = 3
}

listener {
  timeout = 300
  on-timeout = systemctl --user start cybexos-session-lock.service
}

listener {
  timeout = 600
  on-timeout = hyprctl eval 'hl.dispatch(hl.dsp.dpms({ action = "off" }))'
  on-resume = hyprctl eval 'hl.dispatch(hl.dsp.dpms({ action = "on" }))'
}
