[Unit]
Description=Remote Hermes WebUI Quickshell bridge
PartOf=hyprland-session.target

[Service]
Type=simple
Environment=HOME={{ primary_home }}
Environment=PATH={{ primary_home }}/.local/bin:/usr/local/bin:/usr/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 {{ hermes_bridge_executable | default(primary_home + "/.local/libexec/hermes-menubar-bridge") }} --listen 127.0.0.1 --port 9120 --remote-only --state {{ primary_home }}/.local/state/hermes-menubar/conversations.json --remote-auth-state {{ primary_home }}/.local/state/hermes-menubar/remote-webui-auth.json
# The bridge exits cleanly only when asked to stop. A crash is retried quickly
# at first, but the delay grows to 5 minutes so a startup failure (port taken,
# missing python3-websockets, unwritable state) cannot restart it every two
# seconds for the whole session; it still recovers once the cause is fixed.
Restart=on-failure
RestartSec=2
RestartSteps=8
RestartMaxDelaySec=5min
TimeoutStopSec=15

[Install]
WantedBy=hyprland-session.target
