#!/usr/bin/env bash
set -euo pipefail

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export DESKTOP_SESSION=hyprland-quickshell
export DESKTOP_SHELL=quickshell
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland

mkdir -p "$XDG_RUNTIME_DIR" "${XDG_STATE_HOME:-$HOME/.local/state}/hyprland"
printf '%s\n' quickshell > "$XDG_RUNTIME_DIR/desktop-shell"
session_log="${XDG_STATE_HOME:-$HOME/.local/state}/hyprland/session.log"
hypr_config={{ (cybexos_runtime_root + '/hypr/hyprland.lua') | quote }}

# Renaming a fedora-config installation leaves links at the former paths so
# the session that ran the migration keeps working. A new session never uses
# them. Remove this loop once no fedora-config installation remains.
for legacy_path in "$HOME/.config/fedora-config" "$HOME/.local/share/fedora-config" \
    "$HOME/.local/state/fedora-config"; do
  [[ ! -L $legacy_path ]] || rm -f -- "$legacy_path"
done

if [[ ! -f $hypr_config ]]; then
  printf 'CybexOS Hyprland runtime is missing: %s\n' "$hypr_config" >&2
  exit 1
fi

systemctl --user import-environment XDG_SESSION_TYPE XDG_CURRENT_DESKTOP \
  XDG_SESSION_DESKTOP DESKTOP_SESSION DESKTOP_SHELL || true
dbus-update-activation-environment --systemd XDG_SESSION_TYPE \
  XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP DESKTOP_SESSION DESKTOP_SHELL || true

set +e
start-hyprland -- --config "$hypr_config" "$@" >>"$session_log" 2>&1
session_status=$?
systemctl --user stop hyprland-session.target >/dev/null 2>&1 || true
exit "$session_status"
