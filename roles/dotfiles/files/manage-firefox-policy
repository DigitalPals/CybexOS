#!/usr/bin/env python3
"""Add or remove only CybexOS's Firefox policy entry."""

from __future__ import annotations

import json
import os
from pathlib import Path
import sys
import tempfile


POLICY = Path(
    os.environ.get(
        "CYBEXOS_FIREFOX_POLICY",
        "/usr/lib64/firefox/distribution/policies.json",
    )
)
EXTENSION_ID = "{d634138d-c276-4fc8-924b-40a0ea21d284}"
ENTRY = {
    "installation_mode": "force_installed",
    "install_url": (
        "https://addons.mozilla.org/firefox/downloads/latest/"
        "1password-x-password-manager/latest.xpi"
    ),
}


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in {"enable", "disable"}:
        print("Usage: manage-firefox-policy <enable|disable>", file=sys.stderr)
        return 2
    document: dict = {}
    if POLICY.exists():
        try:
            loaded = json.loads(POLICY.read_text())
        except (OSError, json.JSONDecodeError) as error:
            print(f"manage-firefox-policy: refusing invalid existing JSON: {error}", file=sys.stderr)
            return 1
        if not isinstance(loaded, dict):
            print("manage-firefox-policy: existing policy root is not an object", file=sys.stderr)
            return 1
        document = loaded

    policies = document.setdefault("policies", {})
    if not isinstance(policies, dict):
        print("manage-firefox-policy: policies is not an object", file=sys.stderr)
        return 1
    extensions = policies.setdefault("ExtensionSettings", {})
    if not isinstance(extensions, dict):
        print("manage-firefox-policy: ExtensionSettings is not an object", file=sys.stderr)
        return 1

    before = json.dumps(document, sort_keys=True)
    if sys.argv[1] == "enable":
        extensions[EXTENSION_ID] = ENTRY
    else:
        extensions.pop(EXTENSION_ID, None)
        if not extensions:
            policies.pop("ExtensionSettings", None)
        if not policies:
            document.pop("policies", None)
    if json.dumps(document, sort_keys=True) == before:
        return 0

    POLICY.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".policies.", dir=POLICY.parent)
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(document, stream, indent=2, sort_keys=True)
            stream.write("\n")
        os.chmod(temporary, 0o644)
        os.replace(temporary, POLICY)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
