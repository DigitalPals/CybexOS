#!/usr/bin/env bash
set -euo pipefail

# Display brightness, for whichever panel is actually in front of you.
#
# A laptop panel is a sysfs backlight and brightnessctl writes it. An Apple
# Studio Display is not a backlight device at all — it takes brightness over
# USB HID, which is what asdcontrol speaks. Running brightnessctl while a
# Studio Display is the only screen moves the closed laptop panel instead and
# looks like nothing happened, so every caller comes through here rather than
# picking a tool for itself.
#
#   up [step]       raise by step percent (default 5)
#   down [step]     lower by step percent
#   set <percent>   set an absolute percent
#   get             print the current percent, and nothing else
#
# The three writers ping the shell's OSD. `get` stays silent: the shell calls
# it, and pinging the OSD from a read would loop.

usage() {
  printf 'usage: %s up|down [step] | set <percent> | get\n' "${0##*/}" >&2
  exit 2
}

verb=${1:-}
[[ -n $verb ]] || usage

# Apple's HID brightness range, from the device table asdcontrol is built
# with — see roles/private-hooks/files/build-asdcontrol, where every supported
# display maps 0%..100% onto these bounds.
asd_min=400
asd_max=60000

cache=${XDG_RUNTIME_DIR:-/tmp}/brightness-control.hiddev

# The HID nodes detection walks. Overridable so tests/brightness-routing can
# point it at fixtures rather than at whatever is plugged into the machine
# running the suite.
hid_nodes=${BRIGHTNESS_HID_NODES:-"/dev/usb/hiddev* /dev/hiddev*"}

# resolve_device fills both: the node to drive, and the level it read while
# proving that node. They are globals rather than output because a command
# substitution runs in a subshell, which would drop the reading and make every
# `get` pay for a second one.
device=""
raw=""

clamp() {
  local value=$1
  (( value < 0 )) && value=0
  (( value > 100 )) && value=100
  printf '%s' "$value"
}

# Is the screen being looked at an Apple display we can drive at all? The
# tool check comes first: a held key runs this ~40 times a second, and without
# asdcontrol the answer is no before hyprctl and jq are worth starting.
apple_display() {
  local make
  command -v asdcontrol >/dev/null 2>&1 || return 1
  make=$(hyprctl monitors -j 2>/dev/null \
    | jq -r '.[] | select(.focused == true) | .make // ""') || return 1
  grep -qi apple <<<"$make"
}

# Walk every HID device asking which one is a display. This is the expensive
# path — asdcontrol opens each node in turn, ~170ms — so its answer is cached.
detect_device() {
  local device
  # Deliberately unquoted: the value is a list of globs to expand.
  # shellcheck disable=SC2086
  for device in $hid_nodes; do
    [[ -e $device ]] || continue
    if asdcontrol --silent --detect "$device" 2>/dev/null | grep -q SUPPORTED; then
      printf '%s' "$device" >"$cache" 2>/dev/null || true
      printf '%s' "$device"
      return 0
    fi
  done
  rm -f "$cache" 2>/dev/null || true
  return 1
}

# The node to drive. A cached one is confirmed by reading its brightness
# rather than by --detect: the read costs a third as much and a numeric answer
# is the same proof. It has to be proved either way, because writing to a node
# that turned out not to be the display is writing to some other HID device.
resolve_device() {
  local candidate
  if [[ -r $cache ]]; then
    candidate=$(<"$cache")
    if [[ -n $candidate && -e $candidate ]]; then
      raw=$(asdcontrol --silent --brief "$candidate" 2>/dev/null) || raw=""
      if [[ $raw =~ ^[0-9]+$ ]]; then
        device=$candidate
        return 0
      fi
      raw=""
    fi
  fi
  device=$(detect_device) || { device=""; return 1; }
}

# asdcontrol reports the raw HID level, so the percent is ours to compute; it
# accepts a percent on the way in and does the same arithmetic itself.
asd_percent() {
  [[ $raw =~ ^[0-9]+$ ]] || raw=$(asdcontrol --silent --brief "$1" 2>/dev/null) || return 1
  [[ $raw =~ ^[0-9]+$ ]] || return 1
  clamp $(( (raw - asd_min) * 100 / (asd_max - asd_min) ))
}

# Nudge the shell's OSD. Neither backend emits anything watchable — sysfs
# backlight attributes deliver no inotify events and a HID write emits none —
# so the pill is shown, and the percentage re-read, over IPC instead. The
# shell runs by path, so a bare `qs ipc call` reaches nothing; cybexos-runtime
# names the active runtime. Every step is pinged, never rate-limited: a skipped
# last step would leave the pill showing the level before it.
ping_osd() {
  local runtime=${HOME:-}/.local/bin/cybexos-runtime
  [[ -x $runtime ]] && "$runtime" ipc osd brightness >/dev/null 2>&1 || true
}

if apple_display; then
  resolve_device || device=""
fi

case $verb in
up|down)
  step=${2:-5}
  if [[ -n $device ]]; then
    if [[ $verb == up ]]; then
      asdcontrol --silent --brief "$device" "+$step%" >/dev/null
    else
      asdcontrol --silent --brief "$device" -- "-$step%" >/dev/null
    fi
  elif [[ $verb == up ]]; then
    brightnessctl set "$step%+" >/dev/null
  else
    brightnessctl set "$step%-" >/dev/null
  fi
  ping_osd
  ;;
set)
  target=${2:?percent required}
  [[ $target =~ ^[0-9]+$ ]] || usage
  target=$(clamp "$target")
  if [[ -n $device ]]; then
    asdcontrol --silent --brief "$device" "$target%" >/dev/null
  else
    # A sysfs backlight at zero is a black screen with no way back from this
    # control, so the floor there is one percent rather than none. The Apple
    # range has its own floor built in: 0% maps to 400, not to off.
    (( target < 1 )) && target=1
    brightnessctl set "$target%" >/dev/null
  fi
  ping_osd
  ;;
get)
  if [[ -n $device ]]; then
    asd_percent "$device"
  else
    brightnessctl -m 2>/dev/null | head -1 | cut -d, -f4 | tr -d '%'
  fi
  ;;
*)
  usage
  ;;
esac
