PATH={{ primary_home }}/.local/bin{% if features.developer_tools | bool %}:{{ primary_home }}/.npm-global/bin:{{ primary_home }}/Android/Sdk/platform-tools:{{ primary_home }}/Android/Sdk/cmdline-tools/latest/bin{% endif %}:/usr/local/bin:/usr/bin
{% if features.developer_tools | bool %}
ANDROID_HOME={{ primary_home }}/Android/Sdk
ANDROID_SDK_ROOT={{ primary_home }}/Android/Sdk
{% endif %}
EDITOR=nvim
VISUAL=nvim
BROWSER={{ (features.proprietary_apps | bool) | ternary('brave-origin-stable', 'firefox') }}
