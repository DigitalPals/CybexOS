MOZ_ENABLE_WAYLAND=1
QT_QPA_PLATFORM=wayland
{% if features.developer_tools | bool %}
RUSTC_WRAPPER=sccache
CARGO_INCREMENTAL=0
SCCACHE_DIR={{ primary_home }}/.cache/sccache
{% endif %}
