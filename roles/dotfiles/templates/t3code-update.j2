#!/usr/bin/env bash
set -euo pipefail
source /usr/local/libexec/cybexos-common.sh
# A selective converge can deploy this script before the shared library that
# defines the bounded download helper; keep the same limits in that window.
declare -F cybexos_curl >/dev/null || cybexos_curl() {
  curl --connect-timeout 15 --speed-limit 1024 --speed-time 60 \
    --retry 3 --retry-connrefused "$@"
}

install_dir="${XDG_DATA_HOME:-$HOME/.local/share}/t3code-nightly"
appimage="$install_dir/T3-Code-Nightly-x86_64.AppImage"
version_state="$install_dir/version"
digest_state="$install_dir/digest"
api_cache="${XDG_CACHE_HOME:-$HOME/.cache}/cybexos-upstream/t3code/api"
json=$(mktemp)
tmp=""
version_tmp=""
digest_tmp=""
appimage_backup=""
version_backup=""
digest_backup=""
rollback=false
had_appimage=false
had_version=false
had_digest=false
prior_appimage_sha=""
if [[ -x $appimage ]]; then
  had_appimage=true
  prior_appimage_sha=$(sha256sum "$appimage" | awk '{print $1}')
fi
[[ ! -e $version_state ]] || had_version=true
[[ ! -e $digest_state ]] || had_digest=true

cleanup() {
  local rc=$? rollback_ok=true cleanup_path
  trap - EXIT
  set +e
  if (( rc != 0 )) && [[ $rollback == true ]]; then
    if [[ $had_appimage == true ]]; then
      mv -f -- "$appimage_backup" "$appimage" || rollback_ok=false
    else
      rm -f -- "$appimage" || rollback_ok=false
    fi
    if [[ $had_version == true ]]; then
      mv -f -- "$version_backup" "$version_state" || rollback_ok=false
    else
      rm -f -- "$version_state" || rollback_ok=false
    fi
    if [[ $had_digest == true ]]; then
      mv -f -- "$digest_backup" "$digest_state" || rollback_ok=false
    else
      rm -f -- "$digest_state" || rollback_ok=false
    fi
  fi
  for cleanup_path in "$json" "$tmp" "$version_tmp" "$digest_tmp"; do
    [[ -z $cleanup_path ]] || rm -f -- "$cleanup_path"
  done
  if (( rc == 0 )) || [[ $rollback_ok == true ]]; then
    for cleanup_path in "$appimage_backup" "$version_backup" "$digest_backup"; do
      [[ -z $cleanup_path ]] || rm -f -- "$cleanup_path"
    done
  fi
  if (( rc != 0 )) && [[ $had_appimage == true && $rollback_ok == true ]] \
    && [[ -x $appimage ]] && [[ $(sha256sum "$appimage" | awk '{print $1}') == "$prior_appimage_sha" ]]; then
    echo "Previous T3Code nightly retained after update failure" >&2
    exit 75
  fi
  if (( rc != 0 )) && [[ $rollback_ok == false ]]; then
    echo "T3Code nightly rollback failed validation; previous-file backups were retained in $install_dir" >&2
  fi
  exit "$rc"
}
trap cleanup EXIT
gh_api_fetch 'https://api.github.com/repos/pingdotgg/t3code/releases?per_page=30' "$api_cache" "$json"
release=$(jq -ec 'first(.[] | select(.prerelease and (.tag_name | contains("-nightly."))) as $r | $r.assets[] | select(.name | endswith("-x86_64.AppImage")) | {tag:$r.tag_name,url:.browser_download_url,digest:.digest})' "$json")
tag=$(jq -r .tag <<<"$release")
url=$(jq -r .url <<<"$release")
expected=$(jq -r .digest <<<"$release")
expected=${expected#sha256:}
[[ $expected =~ ^[[:xdigit:]]{64}$ ]] || { echo "T3Code nightly asset has no GitHub digest" >&2; exit 1; }
if [[ -x $appimage && -r $version_state && $(<"$version_state") == "$tag" \
   && -r $digest_state && $(<"$digest_state") == "$expected" ]] \
   && verify_sha256 "$appimage" "$expected"; then
  emit_unchanged "T3Code $tag"
  exit 0
fi
mkdir -p "$install_dir"
tmp=$(mktemp "$install_dir/.T3-Code.XXXXXX")
cybexos_curl --fail --location --output "$tmp" "$url"
verify_sha256 "$tmp" "$expected" || { echo "T3Code digest mismatch" >&2; exit 1; }
chmod 0755 "$tmp"
version_tmp="$install_dir/.version.new.$$"
digest_tmp="$install_dir/.digest.new.$$"
printf '%s\n' "$tag" > "$version_tmp"
printf '%s\n' "$expected" > "$digest_tmp"
appimage_backup="$install_dir/.T3-Code.previous.$$"
version_backup="$install_dir/.version.previous.$$"
digest_backup="$install_dir/.digest.previous.$$"
if [[ $had_appimage == true ]]; then
  ln -P -- "$appimage" "$appimage_backup" \
    || cp --reflink=auto --preserve=mode,timestamps -- "$appimage" "$appimage_backup"
fi
[[ $had_version == false ]] || cp -a -- "$version_state" "$version_backup"
[[ $had_digest == false ]] || cp -a -- "$digest_state" "$digest_backup"
rollback=true
mv -f "$tmp" "$appimage"
tmp=""
mv -f "$version_tmp" "$version_state"
version_tmp=""
mv -f "$digest_tmp" "$digest_state"
digest_tmp=""
rollback=false
rm -f -- "$appimage_backup" "$version_backup" "$digest_backup"
emit_changed "T3Code $tag"
