#!/usr/bin/env bash
set -euo pipefail
output=${1:-"$HOME/Downloads/browser-profiles-$(date +%Y%m%d-%H%M%S).tar.age"}
recipient=${AGE_RECIPIENT:-}
[[ -n $recipient ]] || { echo "Set AGE_RECIPIENT to an age public recipient." >&2; exit 2; }
command -v age >/dev/null || { echo "age is required" >&2; exit 1; }

paths=()
for path in .config/mozilla/firefox .mozilla/firefox .config/BraveSoftware/Brave .config/BraveSoftware/Brave-Browser .config/BraveSoftware/Brave-Origin .config/google-chrome; do
  [[ -e $HOME/$path ]] && paths+=("$path")
done
[[ ${paths[0]+set} ]] || { echo "No browser profiles found" >&2; exit 1; }
umask 077
tar -C "$HOME" -cf - "${paths[@]}" | age -r "$recipient" -o "$output"
echo "Encrypted opt-in browser backup: $output"
