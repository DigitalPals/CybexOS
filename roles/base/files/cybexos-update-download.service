[Unit]
Description=Download pending updates without installing them
# Never on battery, and never in the live session. The helper itself waits
# for an unmetered, fully connected network and for no other package work.
ConditionACPower=true
ConditionPathExists=!/run/cybexos-live
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/cybexos-update-download
# The record the desktop reads lives here, world-readable.
StateDirectory=cybexos/update-download
StateDirectoryMode=0755
UMask=0022
# Stay out of the way of whatever the person is doing.
Nice=19
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
TimeoutStartSec=2h
