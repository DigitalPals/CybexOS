#!/usr/bin/python3
"""Fingerprint and security-key sign-in policy for every CybexOS installation.

  cybexos-auth-policy apply            converge the installed policy (both paths)
  cybexos-auth-policy fingerprint on|off   the Settings switch, run through pkexec
  cybexos-auth-policy remove           retire the CybexOS PAM additions (uninstall)

Each command prints one JSON object. The design is in docs/security.md:

- Fingerprints use Fedora's authselect feature with-fingerprint. It adds
  pam_fprintd to system-auth (sudo, Polkit, console login) but never to
  password-auth, so SDDM keeps asking for the password that unlocks GNOME
  Keyring. CybexOS enables the feature once; afterwards authselect's state is
  the person's choice, changed by the Settings switch or authselect itself.
- Security keys: pam_u2f is added as a `sufficient` step to exactly sudo,
  Polkit and the lock screen. authselect's with-pam-u2f would also put it in
  password-auth, where a key touch at SDDM would sign in without the password.
- Every addition is `sufficient` and sits ahead of an otherwise unchanged
  stack, and the key line is `-auth`, so a missing reader, finger, key or
  module falls through to the password. Nothing here can remove pam_unix.
"""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

ORIGIN = 'pam://cybexos'
# One fixed relying party: keys keep working after a hostname change, which
# pam_u2f's default origin (pam://$HOSTNAME) would break. The relative authfile
# is opened as the authenticating user, never as root through their home.
U2F_ARGUMENTS = (f'cue nouserok userpresence=1 origin={ORIGIN} appid={ORIGIN} '
                 'authfile=.config/Yubico/u2f_keys [cue_prompt=Touch your security key]')
U2F_LINE = '-auth      sufficient   pam_u2f.so ' + U2F_ARGUMENTS
# Identifies a line this helper wrote; a person's own pam_u2f line lacks it.
U2F_MARK = 'origin=' + ORIGIN

LOCK_HEADER = '# CybexOS lock screen (hyprlock), written by cybexos-auth-policy.'
LOCK_COMMENT = '''\
# hyprlock reads fingerprints itself through fprintd, beside this stack. It
# therefore uses password-auth, which has no pam_fprintd step to claim the
# reader and hold back the password. See docs/security.md.
'''
LOCK_STACK = 'auth       include      password-auth\n'
POLKIT_HEADER = ('# CybexOS: Polkit\'s own /usr/lib/pam.d/polkit-1 with a security-key step, '
                 'written by cybexos-auth-policy.')
# polkit 127's vendor file, for a system where it cannot be read.
POLKIT_VENDOR_DEFAULT = '''\
#%PAM-1.0

auth       include      system-auth
account    include      system-auth
password   include      system-auth
session    include      system-auth
'''

ADOPTED = 'var/lib/cybexos/authentication/fingerprint-adopted'
FEATURE = 'with-fingerprint'
AUTHSELECT_U2F = ('with-pam-u2f', 'with-pam-u2f-2fa')
FPRINTD_MODULE = 'usr/lib64/security/pam_fprintd.so'


def run(argv):
    """Run a fixed command without a shell; never raises for its exit code."""
    try:
        result = subprocess.run(argv, capture_output=True, text=True, timeout=60, check=False,
                                env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'})
    except (OSError, subprocess.TimeoutExpired) as error:
        return 127, '', str(error)
    return result.returncode, result.stdout, result.stderr


def write(path, text, mode=0o644):
    """Replace a file atomically in its own directory, keeping a regular file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        mode = path.stat().st_mode & 0o777
    descriptor, temporary = tempfile.mkstemp(prefix='.cybexos-', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'w') as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
            os.fchmod(stream.fileno(), mode)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


class Policy:
    def __init__(self, root=Path('/'), runner=None):
        self.root = Path(root)
        self.run = runner or run
        self.changed = []

    def path(self, relative):
        return self.root / relative

    # ── authselect ──────────────────────────────────────────────────────
    def authselect(self):
        """(profile, features) of the managed configuration, or (None, [])."""
        code, output, _ = self.run(['authselect', 'current', '--raw'])
        words = output.split() if code == 0 else []
        return (words[0], words[1:]) if words else (None, [])

    def supports(self, profile):
        code, output, _ = self.run(['authselect', 'list-features', profile])
        return code == 0 and FEATURE in output.split()

    def set_fingerprint(self, enabled):
        profile, features = self.authselect()
        if profile is None:
            raise ValueError('authselect does not manage this system, so CybexOS leaves fingerprint sign-in alone.')
        if (FEATURE in features) == enabled:
            return False
        if enabled and not self.supports(profile):
            raise ValueError(f'The {profile} authselect profile has no fingerprint feature.')
        if enabled and not self.path(FPRINTD_MODULE).is_file():
            raise ValueError('Fingerprint sign-in needs the fprintd-pam package.')
        code, _, error = self.run(['authselect', 'enable-feature' if enabled else 'disable-feature', FEATURE])
        if code != 0:
            raise ValueError('authselect could not change fingerprint sign-in: ' + (error.strip() or 'unknown error'))
        self.changed.append('authselect ' + FEATURE)
        return True

    def adopt_fingerprint(self):
        """Offer fingerprints once. Later runs keep whatever the person chose."""
        marker = self.path(ADOPTED)
        profile, features = self.authselect()
        if profile is None:
            return 'unmanaged'
        if marker.exists():
            return 'enabled' if FEATURE in features else 'disabled'
        # Without the module, pam_fprintd would be a broken line in system-auth;
        # wait for the package rather than recording a choice nobody made.
        if not self.path(FPRINTD_MODULE).is_file():
            return 'unavailable'
        if FEATURE not in features:
            if not self.supports(profile):
                return 'unsupported'
            try:
                self.set_fingerprint(True)
            except ValueError:
                return 'failed'
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.write_text('with-fingerprint enabled by CybexOS; authselect now holds the choice\n')
        return 'enabled'

    # ── PAM files ───────────────────────────────────────────────────────
    def update(self, path, text):
        current = path.read_text() if path.is_file() else None
        if current == text:
            return
        write(path, text)
        self.changed.append(str(path.relative_to(self.root)))
        self.run(['restorecon', str(path)])

    @staticmethod
    def without_ours(text):
        return ''.join(line for line in text.splitlines(keepends=True) if U2F_MARK not in line)

    @staticmethod
    def with_ours(text):
        """Our key step ahead of the first auth line, unless pam_u2f is present.

        A person's own pam_u2f line (perhaps a required second factor) must not
        gain a sufficient key step in front of it, so it disables ours here.
        """
        lines = Policy.without_ours(text).splitlines(keepends=True)
        if any('pam_u2f.so' in line and not line.lstrip().startswith('#') for line in lines):
            return ''.join(lines)
        for index, line in enumerate(lines):
            if line.split()[:1] in (['auth'], ['-auth']):
                return ''.join(lines[:index] + [U2F_LINE + '\n'] + lines[index:])
        return ''.join(lines)

    def polkit_text(self, keys):
        vendor = self.path('usr/lib/pam.d/polkit-1')
        body = vendor.read_text() if vendor.is_file() else POLKIT_VENDOR_DEFAULT
        if body.startswith('#%PAM-1.0\n'):
            body = body[len('#%PAM-1.0\n'):]
        text = '#%PAM-1.0\n' + POLKIT_HEADER + '\n' + body
        return self.with_ours(text) if keys else text

    @staticmethod
    def lock_text(keys):
        return ('#%PAM-1.0\n' + LOCK_HEADER + '\n' + LOCK_COMMENT
                + (U2F_LINE + '\n' if keys else '') + LOCK_STACK)

    def apply_keys(self, keys, lock=True):
        sudo = self.path('etc/pam.d/sudo')
        if sudo.is_file():
            current = sudo.read_text()
            self.update(sudo, self.with_ours(current) if keys else self.without_ours(current))
        polkit = self.path('etc/pam.d/polkit-1')
        if polkit.is_file() and POLKIT_HEADER not in polkit.read_text():
            # An administrator's own override: add or retire only our line.
            current = polkit.read_text()
            self.update(polkit, self.with_ours(current) if keys else self.without_ours(current))
        elif keys:
            # Regenerated from the vendor file on every run, so a Polkit update
            # to its PAM stack is followed rather than shadowed.
            self.update(polkit, self.polkit_text(True))
        elif polkit.is_file():
            polkit.unlink()
            self.changed.append(str(polkit.relative_to(self.root)))
        lock = self.path('etc/pam.d/cybexos-lock') if lock else None
        # A file without the header is the person's own; leave it alone.
        if lock and (not lock.is_file() or LOCK_HEADER in lock.read_text()):
            self.update(lock, self.lock_text(keys))

    def apply(self):
        fingerprint = self.adopt_fingerprint()
        _, features = self.authselect()
        # authselect's own u2f features put pam_u2f into every stack with their
        # own options; adding ours as well would run a second, different step.
        managed = any(feature in features for feature in AUTHSELECT_U2F)
        self.apply_keys(not managed)
        return {'changed': bool(self.changed), 'paths': self.changed, 'fingerprint': fingerprint,
                'securityKeys': 'authselect' if managed else 'cybexos'}

    def remove(self):
        # authselect's fingerprint feature is Fedora's own and stays as chosen;
        # so does the adoption record, should CybexOS be installed again.
        self.apply_keys(False, lock=False)
        lock = self.path('etc/pam.d/cybexos-lock')
        if lock.is_file() and LOCK_HEADER in lock.read_text():
            lock.unlink()
            self.changed.append('etc/pam.d/cybexos-lock')
        return {'changed': bool(self.changed), 'paths': self.changed}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--root', type=Path, default=Path('/'), help=argparse.SUPPRESS)
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('apply')
    commands.add_parser('remove')
    switch = commands.add_parser('fingerprint')
    switch.add_argument('state', choices=('on', 'off'))
    args = parser.parse_args(argv)
    # --root exists for the repository's fixtures. As root (pkexec), only the
    # real system is a valid target: never a tree a caller could prepare.
    if (args.root == Path('/')) != (os.geteuid() == 0):
        print(json.dumps({'success': False, 'error': 'Run as root, on the installed system.'}))
        return 1
    policy = Policy(args.root)
    try:
        if args.command == 'apply':
            result = policy.apply()
        elif args.command == 'remove':
            result = policy.remove()
        else:
            enabled = args.state == 'on'
            policy.set_fingerprint(enabled)
            marker = policy.path(ADOPTED)
            # An explicit choice is final: later installs must not revert it.
            marker.parent.mkdir(parents=True, exist_ok=True)
            marker.write_text(f'with-fingerprint {"enabled" if enabled else "disabled"} in Settings\n')
            result = {'enabled': enabled, 'changed': bool(policy.changed)}
    except (ValueError, OSError) as error:
        print(json.dumps({'success': False, 'error': str(error)}))
        return 1
    print(json.dumps({'success': True, **result}))
    return 0


if __name__ == '__main__':
    sys.exit(main())
