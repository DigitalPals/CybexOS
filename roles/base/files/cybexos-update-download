#!/usr/bin/env bash
# Background update download: Fedora packages into dnf's system cache and
# system Flatpaks into their repository. It never installs or deploys
# anything; the durable updater reuses what is already downloaded when the
# person chooses to update.
#
# Runs as cybexos-update-download.service from its timer, which is off unless
# the person turns on "Download updates automatically" in Settings. The unit
# itself requires AC power; this helper also waits for a fully connected,
# unmetered network and for no other package work, and skips a temporary
# recovery boot whose writes would vanish. A skip changes nothing. A finished
# download publishes one world-readable record for the desktop:
#   {"version":1,"state":"done"|"failed","startedAt":…,"finishedAt":…,
#    "dnfRc":…,"flatpakRc":…}
# A failed download is recorded, not raised: being offline for a while is not
# a broken system, and a failed unit would say otherwise.
set -uo pipefail
umask 022

state_dir=${STATE_DIRECTORY:-/var/lib/cybexos/update-download}
# systemd may pass several state directories; only the first is ours.
state_dir=${state_dir%%:*}
status_file=$state_dir/status.json
cmdline=/proc/cmdline
if [[ ${CYBEXOS_UPDATE_DOWNLOAD_TESTING:-0} == 1 ]]; then
  cmdline=${CYBEXOS_UPDATE_DOWNLOAD_CMDLINE:-$cmdline}
fi

log() { printf 'cybexos-update-download: %s\n' "$*"; }

# One unsigned property of NetworkManager's manager object, or "" when it
# cannot be asked (dnf then finds out about the network itself).
nm_property() {
  busctl --system get-property org.freedesktop.NetworkManager \
    /org/freedesktop/NetworkManager org.freedesktop.NetworkManager "$1" \
    2>/dev/null | awk '$1 == "u" { print $2 }'
}

# Why this is not a good moment, or nothing.
skip_reason() {
  local state metered
  if grep -Eq '(^|[[:space:]])cybexos\.recovery=' "$cmdline" 2>/dev/null; then
    printf 'this boot runs from a recovery point'
    return
  fi
  state=$(nm_property State)
  # 70 is NM_STATE_CONNECTED_GLOBAL.
  if [[ -n $state && $state != 70 ]]; then
    printf 'the network is not fully connected'
    return
  fi
  metered=$(nm_property Metered)
  # 1 and 3 are NM_METERED_YES and NM_METERED_GUESS_YES.
  if [[ $metered == 1 || $metered == 3 ]]; then
    printf 'the network is metered'
    return
  fi
  if [[ -n $(systemctl list-units --plain --no-legend --state=active,activating \
      'cybexos-update-2*.service' 2>/dev/null) ]]; then
    printf 'an update is running'
    return
  fi
  if pgrep -x 'dnf5|dnf|rpm' >/dev/null 2>&1; then
    printf 'other package work is running'
    return
  fi
}

write_record() {
  local state=$1 dnf_rc=$2 flatpak_rc=$3 temporary
  mkdir -p -- "$state_dir" || return 1
  temporary=$(mktemp "$state_dir/.status.XXXXXX") || return 1
  if jq -n --arg state "$state" --argjson startedAt "$started_at" \
      --argjson finishedAt "$(date +%s)" --argjson dnfRc "$dnf_rc" \
      --argjson flatpakRc "$flatpak_rc" \
      '{version: 1, state: $state, startedAt: $startedAt,
        finishedAt: $finishedAt, dnfRc: $dnfRc, flatpakRc: $flatpakRc}' \
      >"$temporary" && chmod 0644 -- "$temporary" \
      && mv -f -- "$temporary" "$status_file"; then
    return 0
  fi
  rm -f -- "$temporary"
  return 1
}

if (($#)); then
  printf 'usage: cybexos-update-download\n' >&2
  exit 2
fi

reason=$(skip_reason)
if [[ -n $reason ]]; then
  # The last record, and what it downloaded, stay as they are.
  log "skipped: $reason"
  exit 0
fi

started_at=$(date +%s)
log 'downloading Fedora packages'
dnf_rc=0
dnf --assumeyes upgrade --downloadonly || dnf_rc=$?
flatpak_rc=0
if command -v flatpak >/dev/null 2>&1; then
  log 'downloading system Flatpaks'
  flatpak update --system --noninteractive --no-deploy || flatpak_rc=$?
fi

state=done
((dnf_rc == 0 && flatpak_rc == 0)) || state=failed
if ! write_record "$state" "$dnf_rc" "$flatpak_rc"; then
  log "could not record the download in $status_file"
  exit 1
fi
log "download $state (dnf $dnf_rc, flatpak $flatpak_rc)"
exit 0
