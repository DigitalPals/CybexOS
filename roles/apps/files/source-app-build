#!/usr/bin/env bash
set -euo pipefail
source /usr/local/libexec/cybexos-common.sh

name=${1:?name required}
[[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || { echo "Invalid application name" >&2; exit 1; }
repo=${2:?repository URL required}
IFS=, read -r -a binaries <<<"${3:?comma separated binaries required}"
for binary in "${binaries[@]}"; do
  [[ $binary =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || { echo "Invalid binary name" >&2; exit 1; }
done
tag=${4:?authorized source tag required}
revision=${5:?authorized source commit required}
build_image=${6:?immutable build container image required}
root="/opt/cybexos-builds/$name"
# Abort a stalled transfer rather than holding the build slot until Ansible's
# async limit, and never wait on a credential prompt nobody can answer.
export GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=60 GIT_TERMINAL_PROMPT=0
mkdir -p "$root/versions" "$root/logs"
[[ $build_image =~ ^.+@sha256:[[:xdigit:]]{64}$ ]] || {
  echo "Source build image must be pinned by sha256 digest" >&2
  exit 1
}

had_existing=false
[[ ! -L $root/current ]] || had_existing=true
work=""
deploy_stage=""
committed=false
change_description=""
new_command_links=()
cleanup() {
  local rc=$?
  trap - EXIT
  set +e
  [[ -z $work || ! -d $work ]] || rm -rf -- "$work"
  [[ -z $deploy_stage || ! -d $deploy_stage ]] || rm -rf -- "$deploy_stage"
  if (( rc != 0 )) && [[ $committed == false ]]; then
    for command_link in "${new_command_links[@]}"; do
      [[ -L $command_link ]] && rm -f -- "$command_link"
    done
  fi
  if (( rc != 0 )) && [[ $committed == true ]]; then
    echo "New $name source build is active, but post-install finalization failed" >&2
    [[ -z $change_description ]] || emit_changed "$change_description"
    exit 0
  fi
  if (( rc != 0 )) && [[ $had_existing == true ]]; then
    echo "Existing $name source build retained after update failure" >&2
    exit 75
  fi
  exit "$rc"
}
trap cleanup EXIT

[[ $revision =~ ^[[:xdigit:]]{40}$ ]] || { echo "Authorized source commit is not a full SHA-1" >&2; exit 1; }

# The authorized inputs identify a requested deployment, not its resolved
# toolchain: Fedora packages in the derived image can move. An intact
# matching deployment needs no network: a routine converge makes no
# remote round trip and an offline one reports no false update failure.
recipe=$(sha256sum "$0" | awk '{print $1}')
manifest="revision=$revision image=$build_image recipe=$recipe"
if [[ -L $root/current && -r $root/current/.cybexos-build ]] \
  && [[ $(<"$root/current/.cybexos-build") == "$manifest" ]]; then
  healthy=true
  for binary in "${binaries[@]}"; do
    [[ -x $root/current/bin/$binary && -x /usr/local/bin/$binary ]] || healthy=false
  done
  if [[ $healthy == true ]]; then
    emit_unchanged "$name $tag ($revision)"
    exit 0
  fi
fi

# Resolve only the inventory-authorized tag and reject a moved tag before clone.
ls_remote=$(timeout 120 git ls-remote --tags "$repo" "refs/tags/$tag" "refs/tags/$tag^{}")
resolved=$(awk -v ref="refs/tags/$tag^{}" '$2 == ref {print $1}' <<<"$ls_remote")
[[ -n $resolved ]] || resolved=$(awk -v ref="refs/tags/$tag" '$2 == ref {print $1}' <<<"$ls_remote")
[[ $resolved == "$revision" ]] || {
  echo "Authorized $repo tag $tag resolved to ${resolved:-nothing}, expected $revision" >&2
  exit 1
}

work=$(mktemp -d "$root/.build.XXXXXX")
timeout 20m git clone --quiet --depth 1 --branch "$tag" "$repo" "$work/src"
cloned=$(git -C "$work/src" rev-parse HEAD)
[[ $cloned == "$revision" ]] || {
  echo "Clone of $repo tag $tag resolved to $cloned, expected $revision; previous version retained" >&2
  exit 1
}

mkdir -p "$work/out"
log="$root/logs/$revision.log"
# The cache stays outside the installed application's version store. Compiler
# dependencies are installed once per pinned base/recipe, rather than once
# per application; Cargo still validates the source and locked dependency graph.
cat >"$work/Containerfile" <<EOF
FROM $build_image
RUN dnf -y install cargo rust gcc gcc-c++ make pkgconf-pkg-config \\
      wayland-devel libxkbcommon-devel libjpeg-turbo-devel libpng-devel \\
      wayland-protocols-devel lz4-devel libgcc libstdc++ && dnf clean all
EOF
builder_key=$(sha256sum "$work/Containerfile" | awk '{print $1}')
builder_tag="localhost/cybexos-source-builder:$builder_key"
cache_root="/var/cache/cybexos-source-builds/$builder_key"
install -d -m 0700 "$cache_root" "$cache_root/registry" "$cache_root/$name-$recipe"
exec {builder_lock_fd}>"$cache_root/builder.lock"
flock "$builder_lock_fd"
if ! podman image exists "$builder_tag"; then
  if ! podman image exists "$build_image"; then
    podman pull "$build_image" >>"$log" 2>&1
  fi
  podman build --pull=never --tag "$builder_tag" -f "$work/Containerfile" "$work" >>"$log" 2>&1
fi
# Capture under the cache lock; a tag can later be replaced or recreated.
# Both metadata and compilation below use this immutable local image ID.
builder_id=$(podman image inspect --format '{{.Id}}' "$builder_tag")
# Podman versions differ on whether inspect prefixes the local ID.
builder_id="sha256:${builder_id#sha256:}"
[[ $builder_id =~ ^sha256:[[:xdigit:]]{64}$ ]] || {
  echo "Builder did not resolve to an immutable image ID" >&2
  exit 1
}
flock -u "$builder_lock_fd"
target_cache="$cache_root/$name-$recipe/${builder_id#sha256:}"
install -d -m 0700 "$target_cache"
# A single target directory must not be relabelled/mutated by parallel builds.
exec {target_lock_fd}>"$cache_root/$name-$recipe.lock"
flock "$target_lock_fd"
if ! podman run --rm --pull=never --network=host \
  -v "$work/src:/src:Z,ro" -v "$work/out:/out:Z" \
  -v "$cache_root/registry:/root/.cargo/registry:z" \
  -v "$target_cache:/build-cache:Z" \
  -e CARGO_TARGET_DIR=/build-cache \
  "${builder_id#sha256:}" bash -euxo pipefail -c '
    cp -a /src /tmp/source
    cd /tmp/source
    rpm -qa --qf "%{NAME}\t%{EPOCHNUM}\t%{VERSION}\t%{RELEASE}\t%{ARCH}\n" | LC_ALL=C sort > /out/packages.tsv
    for tool in rustc cargo gcc g++; do "$tool" --version > "/out/$tool.version"; done
    cargo build --release --locked
    for binary in "$@"; do cp -- "/build-cache/release/$binary" "/out/$binary"; done
  ' -- "${binaries[@]}" >>"$log" 2>&1; then
  echo "Build failed; previous $name remains active. Log: $log" >&2
  exit 1
fi

deployment_key="${revision}-${recipe:0:16}-${builder_id:7:16}"
stage="$root/versions/$deployment_key"
if [[ -e $stage ]]; then
  deployment_key="${deployment_key}.repair-$(date +%s)"
  stage="$root/versions/$deployment_key"
fi
deploy_stage=$stage
mkdir -p "$stage/bin"
for binary in "${binaries[@]}"; do
  candidate="$work/out/$binary"
  [[ -x $candidate ]] || { echo "Build produced no $binary; previous version retained" >&2; exit 1; }
  install -m 0755 "$candidate" "$stage/bin/$binary"
done
printf '%s\n' "$manifest" >"$stage/.cybexos-build"
printf '%s\n' "$builder_id" >"$stage/.cybexos-builder"
# Installed evidence travels with the offline payload; applications.json also
# exports it as a checksum-covered release artifact, outside Podman storage.
python3 - "$work/out" "$stage" "$name" "$repo" "$tag" "$revision" "$build_image" "$recipe" "$builder_id" <<'PYTHON'
import hashlib
import json
from pathlib import Path
import sys

out, stage = map(Path, sys.argv[1:3])
name, repository, tag, revision, base, recipe, builder = sys.argv[3:]
fields = ("name", "epoch", "version", "release", "arch")
packages = []
for line in (out / "packages.tsv").read_text().splitlines():
    values = line.split("\t")
    if len(values) != len(fields) or not all(values):
        raise ValueError("Incomplete builder RPM inventory")
    packages.append(dict(zip(fields, values)))
if not packages:
    raise ValueError("Empty builder RPM inventory")
compilers = {tool: (out / (tool + ".version")).read_text().strip()
             for tool in ("rustc", "cargo", "gcc", "g++")}
if not all(compilers.values()):
    raise ValueError("Incomplete compiler version inventory")
record = {"schema": 1, "name": name, "repository": repository, "tag": tag,
          "revision": revision, "base_image": base, "recipe_sha256": recipe,
          "builder_image_id": builder, "packages": packages, "compilers": compilers,
          "binaries": {path.name: hashlib.sha256(path.read_bytes()).hexdigest()
                       for path in sorted((stage / "bin").iterdir())}}
(stage / ".cybexos-build-provenance.json").write_text(json.dumps(record, indent=2) + "\n")
PYTHON
for binary in "${binaries[@]}"; do
  command_link="/usr/local/bin/$binary"
  if [[ ! -e $command_link && ! -L $command_link ]]; then
    new_command_links+=("$command_link")
  fi
  ln -sfn "$root/current/bin/$binary" "$command_link"
done
atomic_current_swap "$root" "versions/$deployment_key"
deploy_stage=""
committed=true
change_description="built $name $tag ($revision)"
emit_changed "$change_description"
cybexos_restorecon "$root" /usr/local/bin
prune_version_dirs "$root" 3 \
  || echo "Built $name $tag, but could not prune older versions" >&2
if ! find "$root/logs" -maxdepth 1 -type f -name '*.log' -printf '%T@ %p\n' \
  | sort -rn | tail -n +6 | cut -d' ' -f2- | xargs -r -- rm -f --; then
  echo "Built $name $tag, but could not prune older build logs" >&2
fi
