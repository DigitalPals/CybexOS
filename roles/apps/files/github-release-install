#!/usr/bin/env bash
set -euo pipefail
source /usr/local/libexec/cybexos-common.sh

name=${1:?name required}
repo=${2:?owner/repository required}
asset_regex=${3:?asset regex required}
kind=${4:?rpm, archive, archive-auto, binary, or font required}
authorized_tag=${5:-}
authorized_checksum=${6:-}
[[ -n $authorized_tag ]] || {
  echo "GitHub release installer requires an inventory-authorized tag" >&2
  exit 1
}
encoded_tag=$(jq -rn --arg tag "$authorized_tag" '$tag | @uri')
api="https://api.github.com/repos/$repo/releases/tags/$encoded_tag"
cache_root="/var/cache/cybexos-upstream/$name"
state_root="/var/lib/cybexos-upstream/$name"
install_root="/opt/cybexos-apps/$name"
if [[ $kind == font ]]; then
  install_root="/usr/local/share/fonts/$name"
fi
# Serializes dnf/rpm transactions when several installers run concurrently.
dnf_lock="/var/lib/cybexos-upstream/.dnf.lock"

tmp_json=$(mktemp)
stage=""
had_existing=false
committed=false
change_description=""
new_command_links=()
cleanup() {
  local rc=$?
  trap - EXIT
  set +e
  [[ -z $stage || ! -d $stage ]] || rm -rf -- "$stage"
  rm -f "$tmp_json"
  if (( rc != 0 )) && [[ $committed == false ]]; then
    for command_link in "${new_command_links[@]}"; do
      [[ -L $command_link ]] && rm -f -- "$command_link"
    done
  fi
  if (( rc != 0 )) && [[ $committed == true ]]; then
    echo "New $name installation is active, but post-install finalization failed" >&2
    [[ -z $change_description ]] || emit_changed "$change_description"
    exit 0
  fi
  if (( rc != 0 )) && [[ $had_existing == true ]]; then
    echo "Existing $name installation retained after update failure" >&2
    exit 75
  fi
  exit "$rc"
}
trap cleanup EXIT

prune_release_cache() {
  local path retained=0
  while IFS= read -r path; do
    if [[ ${path##*/} == "$safe_tag" ]] || (( retained < 2 )); then
      ((retained += 1))
      continue
    fi
    [[ $path == "$cache_root/"* && $path != "$cache_root/api" ]] || return 1
    rm -rf -- "$path"
  done < <(find "$cache_root" -mindepth 1 -maxdepth 1 -type d ! -name api \
    -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)
}

# installed_matches <manifest> <rpm|archive>
# Succeeds when the recorded installation is exactly <manifest> and intact.
installed_matches() {
  local manifest=$1 mode=$2
  if [[ $mode == rpm ]]; then
    [[ -r $state_root/version && -r $state_root/nevra ]] \
      && [[ $(<"$state_root/version") == "$manifest" ]] \
      && [[ $(rpm -q --qf '%{NEVRA}' "$name" 2>/dev/null || true) == "$(<"$state_root/nevra")" ]]
    return
  fi
  [[ -L $install_root/current && -r $install_root/current/.cybexos-release ]] \
    && [[ $(<"$install_root/current/.cybexos-release") == "$manifest" ]] \
    || return 1
  if [[ $kind == font ]]; then
    [[ -n $(find -L "$install_root/current" -type f \
      \( -iname '*.ttf' -o -iname '*.otf' -o -iname '*.ttc' -o -iname '*.otc' \) \
      -print -quit) ]]
  else
    [[ -x $install_root/current/bin/$name && -x /usr/local/bin/$name ]]
  fi
}

if rpm -q "$name" >/dev/null 2>&1 || [[ -L $install_root/current ]]; then
  had_existing=true
fi
if [[ $kind == rpm ]]; then
  [[ -n $authorized_tag && $authorized_checksum =~ ^sha256:[[:xdigit:]]{64}$ ]] || {
    echo "Root-installed RPM $name requires an inventory-pinned release tag and SHA-256" >&2
    exit 1
  }
fi

# The inventory pin is the complete identity of the payload. When the intact
# installation already records it, converge without a GitHub round trip, so a
# routine run makes no API calls and an offline run reports no false failure.
if [[ $authorized_checksum =~ ^sha256:[[:xdigit:]]{64}$ ]]; then
  authorized_manifest="tag=$authorized_tag checksum=$authorized_checksum"
  if { [[ $kind == rpm || $kind == archive-auto ]] \
         && installed_matches "$authorized_manifest" rpm; } \
     || { [[ $kind != rpm ]] && installed_matches "$authorized_manifest" archive; }; then
    emit_unchanged "$name $authorized_tag"
    exit 0
  fi
fi

gh_api_fetch "$api" "$cache_root/api" "$tmp_json"

release=$(jq -er --arg re "$asset_regex" --arg wanted "$authorized_tag" '
  first(
    (if type == "array" then .[] else . end)
    | select(.draft == false and .prerelease == false)
    | select($wanted == "" or .tag_name == $wanted)
    | . as $release
    | first(.assets[] | select(.name | test($re)))
    | {tag:$release.tag_name,name:.name,url:.browser_download_url,digest:(.digest // "")}
  )
' "$tmp_json") || {
  echo "No stable $repo asset matches $asset_regex" >&2
  exit 1
}

tag=$(jq -r .tag <<<"$release")
asset=$(jq -r .name <<<"$release")
url=$(jq -r .url <<<"$release")
digest=$(jq -r .digest <<<"$release")
safe_tag=$(printf '%s' "$tag" | tr -c 'A-Za-z0-9._+-' _)
mkdir -p "$cache_root/$safe_tag" "$state_root"
download="$cache_root/$safe_tag/$asset"

rpm_mode=false
if [[ $kind == rpm || ( $kind == archive-auto && $asset == *.rpm ) ]]; then
  rpm_mode=true
  [[ -n $authorized_tag && $authorized_checksum =~ ^sha256:[[:xdigit:]]{64}$ ]] || {
    echo "Root-installed RPM $name requires an inventory-pinned release tag and SHA-256" >&2
    exit 1
  }
fi

expected=${authorized_checksum#sha256:}
github_expected=${digest#sha256:}
if [[ -n $expected ]]; then
  if [[ $github_expected =~ ^[[:xdigit:]]{64}$ && $github_expected != "$expected" ]]; then
    echo "Pinned SHA-256 for $name $tag disagrees with GitHub's release digest" >&2
    exit 1
  fi
elif [[ $github_expected =~ ^[[:xdigit:]]{64}$ ]]; then
  expected=$github_expected
else
  # The asset carried no sha256: digest; fall back to a release checksum file.
  checksum_url=$(jq -r --arg tag "$tag" '
    first(
      (if type == "array" then .[] else . end)
      | select(.tag_name == $tag) | .assets[]
      | select(.name | test("^(SHA-256[.]txt|SHA256SUMS([.]txt)?|checksums([.]txt)?)$"; "i"))
      | .browser_download_url
    ) // empty
  ' "$tmp_json")
  [[ -n $checksum_url ]] || {
    echo "Refusing unverified asset $asset: no GitHub digest or release checksum file" >&2
    exit 1
  }
  sums="$cache_root/$safe_tag/checksums.txt"
  cybexos_curl --max-time 60 --fail --silent --show-error --location \
    "$checksum_url" -o "$sums"
  expected=$(awk -v file="$asset" '$0 ~ ("[ */]" file "$") {print $1; exit}' "$sums")
  [[ $expected =~ ^[[:xdigit:]]{64}$ ]] || {
    echo "No SHA-256 entry for $asset in release checksum file" >&2
    exit 1
  }
fi

expected_manifest="tag=$tag checksum=sha256:$expected"
installed_mode=archive
[[ $rpm_mode == false ]] || installed_mode=rpm
if installed_matches "$expected_manifest" "$installed_mode"; then
  emit_unchanged "$name $tag"
  exit 0
fi

if [[ ! -f $download ]]; then
  partial="$download.partial"
  cybexos_curl --fail --location --output "$partial" "$url"
  mv -f "$partial" "$download"
fi

if ! verify_sha256 "$download" "$expected"; then
  # Heal a truncated or stale cached asset once from the authorized URL.
  unlink "$download"
  partial="$download.partial"
  cybexos_curl --fail --location --output "$partial" "$url"
  mv -f "$partial" "$download"
  verify_sha256 "$download" "$expected" || {
    unlink "$download"
    echo "SHA-256 mismatch for $asset after a clean download" >&2
    exit 1
  }
fi

if [[ $rpm_mode == true ]]; then
  asset_name=$(rpm -qp --qf '%{NAME}' "$download")
  asset_nevra=$(rpm -qp --qf '%{NEVRA}' "$download")
  [[ $asset_name == "$name" && -n $asset_nevra ]] || {
    echo "RPM asset $asset does not contain the expected $name package" >&2
    exit 1
  }
  installed_nevra=$(rpm -q --qf '%{NEVRA}' "$name" 2>/dev/null || true)
  dnf_action=install
  [[ $installed_nevra != "$asset_nevra" ]] || dnf_action=reinstall
  flock "$dnf_lock" dnf -y --nogpgcheck "$dnf_action" "$download"
  [[ $(rpm -q --qf '%{NEVRA}' "$name" 2>/dev/null || true) == "$asset_nevra" ]] || {
    echo "Installed $name NEVRA does not match verified asset $asset_nevra" >&2
    exit 1
  }
  committed=true
  change_description="installed $name $tag"
  emit_changed "$change_description"
  if ! {
    printf '%s\n' "$expected_manifest" > "$state_root/version.tmp" \
      && printf '%s\n' "$asset_nevra" > "$state_root/nevra.tmp" \
      && mv -f "$state_root/version.tmp" "$state_root/version" \
      && mv -f "$state_root/nevra.tmp" "$state_root/nevra"
  }; then
    rm -f "$state_root/version.tmp" "$state_root/nevra.tmp"
    echo "Installed $name $tag, but could not persist its convergence manifest" >&2
  fi
  cybexos_restorecon /usr/bin /usr/lib /usr/lib64 /usr/share/applications
  prune_release_cache || echo "Installed $name $tag, but could not prune its release cache" >&2
  exit 0
fi

if [[ $kind == binary ]]; then
  version_key="${safe_tag}-${expected:0:16}"
  version_dir="$install_root/versions/$version_key"
  if [[ -e $version_dir ]]; then
    version_key="${version_key}.repair-$(date +%s)"
    version_dir="$install_root/versions/$version_key"
  fi
  stage=$version_dir
  mkdir -p "$version_dir/bin"
  install -m 0755 "$download" "$version_dir/bin/$name.new"
  mv -f "$version_dir/bin/$name.new" "$version_dir/bin/$name"
  printf '%s\n' "$expected_manifest" >"$version_dir/.cybexos-release"
  command_link="/usr/local/bin/$name"
  if [[ ! -e $command_link && ! -L $command_link ]]; then
    new_command_links+=("$command_link")
  fi
  ln -sfn "$install_root/current/bin/$name" "$command_link"
  atomic_current_swap "$install_root" "versions/$version_key"
  stage=""
  committed=true
  change_description="installed $name $tag"
  emit_changed "$change_description"
  cybexos_restorecon "$install_root" /usr/local/bin
  prune_version_dirs "$install_root" 3 \
    || echo "Installed $name $tag, but could not prune older versions" >&2
  prune_release_cache \
    || echo "Installed $name $tag, but could not prune its release cache" >&2
  exit 0
fi

mkdir -p "$install_root"
version_key="${safe_tag}-${expected:0:16}"
version_dir="$install_root/versions/$version_key"
if [[ -e $version_dir ]]; then
  version_key="${version_key}.repair-$(date +%s)"
  version_dir="$install_root/versions/$version_key"
fi
stage=$(mktemp -d "$install_root/.stage.XXXXXX")
mkdir -p "$stage/payload"
case "$asset" in
  *.tar.gz|*.tgz) tar -xzf "$download" -C "$stage/payload" ;;
  *.tar.xz) tar -xJf "$download" -C "$stage/payload" ;;
  *.zip) unzip -q "$download" -d "$stage/payload" ;;
  *) echo "Unsupported archive: $asset" >&2; exit 1 ;;
esac

candidates=("$name")
if [[ $kind == font ]]; then
  installed_font=$(find "$stage/payload" -type f \
    \( -iname '*.ttf' -o -iname '*.otf' -o -iname '*.ttc' -o -iname '*.otc' \) \
    -print -quit)
  [[ -n $installed_font ]] || {
    echo "Font archive $asset contains no supported font payload" >&2
    exit 1
  }
else
  mkdir -p "$stage/payload/bin"
  for binary in "${candidates[@]}"; do
    found=$(find "$stage/payload" -type f -name "$binary" -perm /111 -not -path '*/bin/*' -print -quit)
    if [[ -z $found ]]; then
      found=$(find "$stage/payload" -type f -name "$binary" -print -quit)
    fi
    [[ -n $found ]] || { echo "Archive contains no $binary executable" >&2; exit 1; }
    chmod 0755 "$found"
    if [[ $found != "$stage/payload/bin/$binary" ]]; then
      relative=$(realpath --relative-to="$stage/payload/bin" "$found")
      ln -s "$relative" "$stage/payload/bin/$binary"
    fi
  done
fi

mkdir -p "$install_root/versions"
printf '%s\n' "$expected_manifest" >"$stage/payload/.cybexos-release"
mv "$stage/payload" "$version_dir"

if [[ $kind != font ]]; then
  for binary in "${candidates[@]}"; do
    command_link="/usr/local/bin/$binary"
    if [[ ! -e $command_link && ! -L $command_link ]]; then
      new_command_links+=("$command_link")
    fi
    ln -sfn "$install_root/current/bin/$binary" "$command_link"
  done
fi
atomic_current_swap "$install_root" "versions/$version_key"
committed=true
change_description="installed $name $tag"
emit_changed "$change_description"
cybexos_restorecon "$install_root" /usr/local/bin
prune_version_dirs "$install_root" 3 \
  || echo "Installed $name $tag, but could not prune older versions" >&2
prune_release_cache \
  || echo "Installed $name $tag, but could not prune its release cache" >&2
