#!/usr/bin/env python3
"""Assemble offline apps using the same pinned installers as the workstation."""
import configparser
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess

import yaml
from application_payload import relativize_seed_links

ROOT = Path(__file__).resolve().parents[1]
BUILD = Path("/home/builder/build")
SEED = Path("/home/cybex-seed")


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def copy_tree(source, target):
    target.parent.mkdir(parents=True, exist_ok=True)
    if source.is_dir() and not source.is_symlink():
        shutil.copytree(source, target, symlinks=True, dirs_exist_ok=True)
    elif source.is_symlink():
        target.symlink_to(os.readlink(source))
    else:
        shutil.copy2(source, target)


# Ansible tasks whose packages the image installs. image/tests checks that
# every other package-installing task in roles/ is excluded deliberately.
PACKAGE_TASKS = (
    ("roles/apps/tasks/packages.yml", {
        "Install signed vendor applications", "Install Steam 32-bit graphics userspace",
    }),
    ("roles/apps/tasks/fonts.yml", {"Install shell and browser fallback fonts"}),
    ("roles/base/tasks/main.yml", {"Install Docker packages when selected"}),
    # Firmware must be available at the first physical boot, before the
    # detected hardware role runs its machine-specific configuration.
    ("roles/xps-2026/tasks/packages.yml", {"Install explicit Panther Lake firmware, media, and regulatory packages"}),
    ("roles/desktop/tasks/main.yml", {"Install stable Hyprland and desktop integration packages",
                                      "Install Fedora fuzzel and matugen rather than COPR variants"}),
)


def package_names():
    """Read package groups from the application and desktop contracts."""
    defaults = yaml.safe_load((ROOT / "roles/apps/defaults/main.yml").read_text())
    baseline = yaml.safe_load((ROOT / "roles/base/defaults/main.yml").read_text())
    packages = list(baseline["base_required_packages"])
    # The workstation skips unavailable optional packages at converge time.
    # The compose has no --ignoremissing, so one Fedora drops fails the build
    # visibly instead of shipping an image that silently lacks it.
    for key in ("apps_required_fedora_packages", "apps_optional_fedora_packages", "apps_omawrite_packages",
                "apps_developer_fedora_packages", "apps_podman_packages", "apps_steam_packages"):
        packages.extend(defaults[key])
    for path, names in PACKAGE_TASKS:
        for task in yaml.safe_load((ROOT / path).read_text()):
            if task.get("name") in names:
                packages.extend(task["ansible.builtin.dnf"]["name"])
    packages += ["tailscale", "java-25-openjdk-devel", "rpmfusion-free-release", "rpmfusion-nonfree-release"]
    return sorted(set(packages)), defaults["apps_flatpaks"] + defaults["apps_steam_flatpaks"]


def application_repositories(repo_directory=Path("/etc/yum.repos.d")):
    """Load every reviewed vendor policy; missing files must stop the build."""
    policies = configparser.ConfigParser(interpolation=None)
    repo_files = [*repo_directory.glob("rpmfusion-*.repo")]
    # Brave Origin is published in the Brave Browser repository. Package
    # names and repository filenames are independent contracts.
    repo_files += [ROOT / "roles/apps/files" / (name + ".repo")
                   for name in ("brave-browser", "1password", "chatgpt", "tailscale")]
    for path in repo_files:
        # ConfigParser.read silently ignores missing files, which otherwise
        # hides a renamed policy until dependency resolution during compose.
        with path.open() as stream:
            policies.read_file(stream, source=str(path))
    for section in list(policies.sections()):
        if not policies[section].getboolean("enabled", fallback=True):
            policies.remove_section(section)
        elif not policies[section].getboolean("gpgcheck", fallback=False):
            raise RuntimeError(f"Unsigned application repository: {section}")
    return policies


def main():
    if os.geteuid() != 0 or Path("/etc/hostname").read_text().strip() != "image-builder":
        raise RuntimeError("Application preparation is only allowed in the disposable image builder")
    environment = dict(os.environ, ANSIBLE_ROLES_PATH=str(ROOT / "roles"),
                       ANSIBLE_LOCAL_TEMP=str(BUILD / "ansible-tmp"))
    run("ansible-playbook", "-i", "localhost,", str(ROOT / "image/applications.yml"),
        "--extra-vars", json.dumps({"primary_user": "cybex-seed", "primary_group": "cybex-seed",
                                    "primary_home": str(SEED), "config_repo": str(ROOT)}), env=environment)
    inventory = yaml.safe_load((ROOT / "inventory/group_vars/all.yml").read_text())
    packages, flatpaks = package_names()
    # The upstream helper already verified these exact inventory digests.
    # Recheck the bytes when admitting them into the compose's local repo.
    repo = BUILD / "repo"
    repo.mkdir(exist_ok=True)
    pinned_rpms = {}
    for app in inventory["github_release_apps"]:
        if app["kind"] != "rpm":
            continue
        matches = list((Path("/var/cache/cybexos-upstream") / app["name"]).rglob("*.rpm"))
        expected = app["checksum"].removeprefix("sha256:")
        matches = [file for file in matches if hashlib.file_digest(file.open("rb"), "sha256").hexdigest() == expected]
        if len(matches) != 1:
            raise RuntimeError(f"Missing verified RPM for {app['name']}")
        file = matches[0]
        shutil.copy2(file, repo / file.name)
        pinned_rpms[file.name] = expected
        packages.append(app["name"])
    (BUILD / "pinned-rpms.json").write_text(json.dumps(pinned_rpms, indent=2) + "\n")

    payload = BUILD / "applications-root"
    payload.mkdir(exist_ok=False)
    # An explicit allowlist prevents builder accounts, keys, caches, logs,
    # container storage and other disposable state from reaching the image.
    for relative in ("opt/cybexos-apps", "opt/cybexos-builds", "usr/local/bin",
                     "usr/local/libexec", "usr/local/share/fonts",
                     "usr/local/share/applications/omawrite.desktop",
                     "usr/share/icons/hicolor/scalable/apps/omawrite.svg"):
        source = Path("/") / relative
        if source.exists():
            copy_tree(source, payload / relative)
    for log_dir in (payload / "opt/cybexos-builds").glob("*/logs"):
        shutil.rmtree(log_dir)
    seed = payload / "usr/share/cybexos/user-seed"
    for relative in (".local/bin", ".local/share/claude", ".local/share/cybexos-user-tools",
                     ".local/share/voxtype", ".local/share/t3code-nightly", ".cargo/bin",
                     ".cargo/env", ".rustup/toolchains", ".rustup/settings.toml", ".rustup/update-hashes",
                     "Android/Sdk", ".config/nvim", ".config/voxtype", ".npm-global"):
        source = SEED / relative
        if source.exists():
            copy_tree(source, seed / relative)
    shutil.rmtree(seed / ".config/nvim/.git")
    # Native installers use absolute HOME links. Relativize only seed-owned
    # links, so the same payload works for every account without downloads.
    relativize_seed_links(seed, SEED)
    android = payload / "usr/local/libexec/cybexos-android-sdk-update"
    android.write_text(android.read_text().replace(f"sdk={SEED}/Android/Sdk", 'sdk="$HOME/Android/Sdk"'))
    # Existing repo definitions keep native RPM updates working after install.
    # Vendor RPM scriptlets can rewrite their installed repo files. Compose
    # from the reviewed definitions that reference our checksum-pinned keys.
    policies = application_repositories()
    with (BUILD / "application-repositories.repo").open("w") as output:
        policies.write(output)
    installed = run("flatpak", "list", "--system", "--app", "--columns=application",
                    capture_output=True, text=True).stdout.splitlines()
    if not set(flatpaks).issubset(installed):
        raise RuntimeError("Incomplete offline Flatpak application payload")
    manifest = {"packages": sorted(set(packages)), "flatpaks": flatpaks,
                "features": inventory["features"], "user_seed": str(SEED)}
    (BUILD / "applications.json").write_text(json.dumps(manifest, indent=2) + "\n")


if __name__ == "__main__":
    main()
