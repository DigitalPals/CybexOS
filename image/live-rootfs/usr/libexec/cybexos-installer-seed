#!/usr/bin/python3
"""Read and validate an unattended CybexOS installation seed.

A seed is `cybexos-seed.yml` at the root of a volume labelled CYBEXOS-SEED
(or cloud-init's CIDATA). The backend mounts it read-only, reads only the
named regular files, and unmounts it again. Validation never prints or
returns a secret: the disk passphrase and the Tailscale auth key are read
from separate files and returned only in `Seed.secrets`.

    cybexos-installer-seed check DIRECTORY   validate a prepared seed folder

`check` validates everything except the disk match, which needs the target
machine's disks. See image/INSTALLER.md for the format and its trade-offs.
"""
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys

import yaml

# Source fixtures exercise this checkout; the live image reads the RPM-owned
# copy of the policy that cybexos-config and the checkout installer share.
# Installed at /usr/libexec the file has only three parents, so the checkout
# layout (image/live-rootfs/usr/libexec) must be tested for, not indexed.
_PARENTS = Path(__file__).resolve().parents
_SOURCE = _PARENTS[3] if len(_PARENTS) > 3 else None
sys.path.insert(0, str(_SOURCE) if _SOURCE and (_SOURCE / 'installation_policy.py').is_file()
                else '/usr/share/cybexos/lib')
from installation_policy import choices as validate_choices  # noqa: E402

LABELS = ('CYBEXOS-SEED', 'CIDATA', 'cidata')
SEED_NAME = 'cybexos-seed.yml'
SEED_LIMIT = 64 * 1024
FILE_LIMIT = 4096
FILE_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]{0,63}')
USERNAME = re.compile(r'[a-z_][a-z0-9_-]{0,30}')
HOSTNAME = re.compile(r'[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?')
# glibc/libxcrypt hashes Anaconda writes as-is: yescrypt (Fedora's default)
# and SHA-512 crypt. `mkpasswd -m yescrypt` or `openssl passwd -6` make them.
PASSWORD_HASH = re.compile(r'\$y\$[./A-Za-z0-9]+\$[./A-Za-z0-9]{1,86}\$[./A-Za-z0-9]{43}'
                           r'|\$6\$(?:rounds=[0-9]{4,9}\$)?[./A-Za-z0-9]{1,16}\$[./A-Za-z0-9]{86}')
SSH_KEY = re.compile(r'(?:ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(?:256|384|521)|'
                     r'sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com)'
                     r' [A-Za-z0-9+/]{16,8192}={0,3}(?: [ -~]{0,200})?')
SIZE = re.compile(r'([0-9]+(?:\.[0-9]+)?)\s*([KMGT]i?B?|B)?', re.IGNORECASE)
UNITS = {'': 1, 'B': 1, 'K': 1000, 'KB': 1000, 'KIB': 1024, 'M': 1000**2, 'MB': 1000**2, 'MIB': 1024**2,
         'G': 1000**3, 'GB': 1000**3, 'GIB': 1024**3, 'T': 1000**4, 'TB': 1000**4, 'TIB': 1024**4}
MATCH_KEYS = ('serial', 'wwn', 'model', 'path', 'min_size', 'max_size')
TOP_KEYS = {'version', 'disk', 'encryption', 'account', 'oem', 'system', 'ssh', 'tailscale', 'config',
            'countdown'}


class SeedError(ValueError):
    """Every problem in a seed, as display-safe sentences without secrets."""

    def __init__(self, errors):
        self.errors = list(errors)
        super().__init__('; '.join(self.errors))


class Seed:
    """A validated seed. `summary` is display-safe; `secrets` is not."""

    def __init__(self, settings, secrets, digest):
        self.settings, self.secrets, self.digest = settings, secrets, digest

    def summary(self):
        settings = self.settings
        return {'digest': self.digest, 'oem': settings['oem'], 'encrypted': settings['encrypted'],
                'match': settings['match'], 'username': settings['username'],
                'full_name': settings['full_name'], 'hostname': settings['hostname'],
                'keyboard': settings['keyboard'], 'locale': settings['locale'],
                'timezone': settings['timezone'], 'passwordless_wheel': settings['passwordless_wheel'],
                'ssh_keys': len(settings['ssh_authorized_keys']), 'ssh_server': settings['ssh_server'],
                'tailscale': settings['tailscale'], 'config': settings['config'],
                'countdown': settings['countdown']}


def parse_size(value):
    if type(value) is int and value > 0:
        return value
    match = SIZE.fullmatch(value.strip()) if isinstance(value, str) else None
    if not match or match[2] and match[2].upper() not in UNITS:
        raise ValueError
    return int(float(match[1]) * UNITS[(match[2] or '').upper()])


def control_free(value):
    return not any(ord(char) < 32 or ord(char) == 127 for char in value)


def parse(text, read_file):
    """Validate seed YAML; read_file(name) returns a referenced file's bytes.

    Raises SeedError listing every problem found.
    """
    errors = []
    try:
        document = yaml.safe_load(text)
    except yaml.YAMLError as error:
        mark = getattr(error, 'problem_mark', None)
        where = f' (line {mark.line + 1})' if mark else ''
        raise SeedError([f'{SEED_NAME} is not valid YAML{where}.']) from None
    if not isinstance(document, dict):
        raise SeedError([f'{SEED_NAME} must contain a mapping of settings.'])
    for key in sorted(set(document) - TOP_KEYS):
        errors.append(f'Unknown setting "{key}".')
    if document.get('version') != 1 or type(document.get('version')) is not int:
        errors.append('Set "version: 1".')

    def section(name, required=False):
        value = document.get(name)
        if value is None:
            if required:
                errors.append(f'The "{name}" section is required.')
            return {}
        if not isinstance(value, dict):
            errors.append(f'"{name}" must be a mapping.')
            return {}
        return value

    def boolean(mapping, key, default, where):
        value = mapping.get(key, default)
        if type(value) is not bool:
            errors.append(f'{where}.{key} must be true or false.')
            return default
        return value

    def unknown(mapping, allowed, where):
        for key in sorted(set(mapping) - set(allowed)):
            errors.append(f'Unknown setting "{where}.{key}".')

    secrets = {}

    def secret_file(mapping, key, where, minimum, maximum):
        name = mapping.get(key)
        if not isinstance(name, str) or not FILE_NAME.fullmatch(name) or name == SEED_NAME:
            errors.append(f'{where}.{key} must name a file at the top of the seed volume.')
            return None
        try:
            raw = read_file(name)
        except (OSError, ValueError) as error:
            errors.append(f'{where}.{key}: {name} {error}' if isinstance(error, ValueError)
                          else f'{where}.{key}: {name} could not be read.')
            return None
        try:
            value = raw.decode('utf-8')
        except UnicodeError:
            errors.append(f'{where}.{key}: {name} must be UTF-8 text.')
            return None
        # One trailing line ending is what an editor adds; it is not part of the secret.
        value = value[:-2] if value.endswith('\r\n') else value[:-1] if value.endswith('\n') else value
        if not minimum <= len(value) <= maximum or not control_free(value):
            errors.append(f'{where}.{key}: {name} must hold {minimum}–{maximum} characters '
                          'on one line, without control characters.')
            return None
        return value

    oem = document.get('oem', False)
    if type(oem) is not bool:
        errors.append('oem must be true or false.')
        oem = False

    disk = section('disk', required=True)
    unknown(disk, ('match', 'erase'), 'disk')
    if disk and disk.get('erase') is not True:
        errors.append('Set "disk.erase: true" to confirm that the matched disk is erased.')
    match = disk.get('match')
    rule = {}
    if not isinstance(match, dict) or not match:
        if disk:
            errors.append('disk.match must name at least one of: ' + ', '.join(MATCH_KEYS) + '.')
    else:
        before = len(errors)
        unknown(match, MATCH_KEYS, 'disk.match')
        for key in ('serial', 'wwn', 'model', 'path'):
            if key in match:
                value = match[key]
                if not isinstance(value, str) or not value.strip() or len(value) > 256 or not control_free(value):
                    errors.append(f'disk.match.{key} must be non-empty text.')
                elif key == 'path' and not re.fullmatch(r'/dev/[A-Za-z0-9/_.:+-]+', value):
                    errors.append('disk.match.path must be a /dev path such as /dev/nvme0n1.')
                else:
                    rule[key] = value.strip()
        for key in ('min_size', 'max_size'):
            if key in match:
                try:
                    rule[key] = parse_size(match[key])
                except (ValueError, TypeError):
                    errors.append(f'disk.match.{key} must be a size such as 500GB or 465GiB.')
        if 'min_size' in rule and 'max_size' in rule and rule['min_size'] > rule['max_size']:
            errors.append('disk.match.min_size is larger than disk.match.max_size.')
        if len(errors) == before and not set(rule) & {'serial', 'wwn', 'model', 'path'}:
            # A size range alone selects whatever disk happens to fit.
            errors.append('disk.match needs serial, wwn, model or path, not only a size.')

    encryption = section('encryption', required=True)
    unknown(encryption, ('enabled', 'passphrase_file'), 'encryption')
    encrypted = boolean(encryption, 'enabled', True, 'encryption') if encryption else True
    if encrypted and encryption:
        passphrase = secret_file(encryption, 'passphrase_file', 'encryption', 12, 512)
        if passphrase is not None:
            secrets['passphrase'] = passphrase
    elif encryption.get('passphrase_file') is not None:
        errors.append('encryption.passphrase_file is only used with "enabled: true".')

    account = section('account', required=not oem)
    username, full_name, passwordless_wheel = '', '', False
    if oem and account:
        errors.append('Remove the "account" section: with "oem: true" the new owner creates the account.')
    elif account:
        # `password` is refused below with its own explanation.
        unknown(account, ('username', 'full_name', 'password', 'password_hash', 'passwordless_sudo'), 'account')
        username = account.get('username', '')
        if not isinstance(username, str) or not USERNAME.fullmatch(username):
            errors.append('account.username must be 1–31 lowercase letters, numbers, underscores or dashes, '
                          'starting with a letter.')
            username = ''
        full_name = account.get('full_name', '')
        if not isinstance(full_name, str) or len(full_name) > 128 or not control_free(full_name) or ':' in full_name:
            errors.append('account.full_name must be at most 128 characters without colons.')
            full_name = ''
        password_hash = account.get('password_hash')
        if 'password' in account:
            errors.append('account.password is not accepted. Use account.password_hash.')
        if not isinstance(password_hash, str) or not PASSWORD_HASH.fullmatch(password_hash):
            errors.append('account.password_hash must be a yescrypt ($y$) or SHA-512 ($6$) password hash.')
        else:
            secrets['password_hash'] = password_hash
        passwordless_wheel = boolean(account, 'passwordless_sudo', False, 'account')

    system = section('system')
    unknown(system, ('keyboard', 'locale', 'timezone', 'hostname'), 'system')
    values = {}
    for key, default, pattern in (('keyboard', 'us', r'[A-Za-z0-9_-]+(?: \([A-Za-z0-9_-]+\))?'),
                                  ('locale', 'en_US.UTF-8', r'[A-Za-z][A-Za-z0-9_@.-]{1,63}'),
                                  ('timezone', 'UTC', r'[A-Za-z0-9_+-]+(?:/[A-Za-z0-9_+-]+){0,3}')):
        value = system.get(key, default)
        if not isinstance(value, str) or not re.fullmatch(pattern, value):
            errors.append(f'system.{key} is not a valid value.')
            value = default
        values[key] = value
    hostname = system.get('hostname', 'cybexos')
    if not isinstance(hostname, str) or not HOSTNAME.fullmatch(hostname):
        errors.append('system.hostname must contain 1–63 letters, numbers or dashes.')
        hostname = 'cybexos'

    ssh = section('ssh')
    unknown(ssh, ('authorized_keys', 'server'), 'ssh')
    keys = ssh.get('authorized_keys', [])
    if not isinstance(keys, list) or len(keys) > 32 or not all(isinstance(key, str) and SSH_KEY.fullmatch(key.strip())
                                                                for key in keys):
        errors.append('ssh.authorized_keys must be a list of up to 32 OpenSSH public keys.')
        keys = []
    keys = [key.strip() for key in keys]
    ssh_server = boolean(ssh, 'server', False, 'ssh')
    if oem and (keys or ssh_server):
        errors.append('SSH settings need an account; they cannot be combined with "oem: true".')

    tailscale = section('tailscale')
    unknown(tailscale, ('auth_key_file',), 'tailscale')
    if tailscale:
        key = secret_file(tailscale, 'auth_key_file', 'tailscale', 16, 512)
        if key is not None:
            if not re.fullmatch(r'tskey-[A-Za-z0-9_-]+', key):
                errors.append('tailscale.auth_key_file must hold a Tailscale auth key (tskey-…).')
            else:
                secrets['tailscale_auth_key'] = key

    try:
        config = validate_choices(document.get('config'))
    except ValueError as error:
        errors.append(str(error) + '.')
        config = {}
    if tailscale and config.get('features', {}).get('tailscale') is False:
        errors.append('A Tailscale auth key needs config.features.tailscale left enabled.')

    countdown = document.get('countdown', 30)
    if type(countdown) is not int or not 10 <= countdown <= 600:
        errors.append('countdown must be a number of seconds from 10 to 600.')
        countdown = 30

    if errors:
        raise SeedError(errors)
    settings = dict(oem=oem, encrypted=encrypted, match=rule, username=username, full_name=full_name,
                    passwordless_wheel=passwordless_wheel, hostname=hostname,
                    ssh_authorized_keys=keys, ssh_server=ssh_server, tailscale='tailscale_auth_key' in secrets,
                    config=config, countdown=countdown, **values)
    digest = hashlib.sha256(text.encode() if isinstance(text, str) else text).hexdigest()
    return Seed(settings, secrets, digest)


def normalized(text):
    return ' '.join(str(text).split()).casefold()


def match_disks(rule, disks, resolve=os.path.realpath):
    """Disks matching every key of the rule. The caller requires exactly one."""
    path = resolve(rule['path']) if 'path' in rule else None
    found = []
    for disk in disks:
        if 'serial' in rule and disk.get('serial', '').strip() != rule['serial']:
            continue
        if 'wwn' in rule and normalized(disk.get('wwn', '')) != normalized(rule['wwn']):
            continue
        if 'model' in rule and normalized(disk.get('model', '')) != normalized(rule['model']):
            continue
        if path is not None and disk.get('path') != path:
            continue
        if 'min_size' in rule and disk.get('size', 0) < rule['min_size']:
            continue
        if 'max_size' in rule and disk.get('size', 0) > rule['max_size']:
            continue
        found.append(disk)
    return found


def select_disk(rule, disks, excluded=(), resolve=os.path.realpath):
    """The one matching disk, or SeedError naming what was found."""
    candidates = [disk for disk in disks if disk.get('path') not in excluded]
    found = match_disks(rule, candidates, resolve)
    if len(found) == 1:
        return found[0]
    available = '; '.join(f"{disk.get('model') or 'Disk'} {disk.get('path')} "
                          f"({disk.get('size', 0) / 1024**3:.0f} GiB, serial {disk.get('serial') or 'not reported'})"
                          for disk in candidates) or 'none'
    if not found:
        raise SeedError([f'No disk matches disk.match. Available disks: {available}.'])
    raise SeedError([f'{len(found)} disks match disk.match; add a serial or wwn so exactly one matches. '
                     f'Available disks: {available}.'])


def read_regular(directory, name, limit):
    """Read a regular, non-symlink file below directory, refusing large ones."""
    descriptor = os.open(directory / name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode):
            raise ValueError('is not a regular file.')
        if info.st_size > limit:
            raise ValueError('is too large.')
        data = os.read(descriptor, limit + 1)
        if len(data) > limit:
            raise ValueError('is too large.')
        return data
    finally:
        os.close(descriptor)


def load_directory(directory):
    try:
        text = read_regular(directory, SEED_NAME, SEED_LIMIT)
    except FileNotFoundError:
        return None
    except ValueError as error:
        raise SeedError([f'{SEED_NAME} {error}']) from None
    try:
        text = text.decode('utf-8')
    except UnicodeError:
        raise SeedError([f'{SEED_NAME} must be UTF-8 text.']) from None
    return parse(text, lambda name: read_regular(directory, name, FILE_LIMIT))


def seed_devices(by_label=Path('/dev/disk/by-label')):
    """Distinct block devices carrying a seed volume label."""
    devices = []
    for label in LABELS:
        link = by_label / label
        if link.exists():
            device = os.path.realpath(link)
            if device not in devices:
                devices.append(device)
    return devices


def parent_disk(device, run=subprocess.run):
    """The whole-disk path holding a seed partition, so it is never a target."""
    try:
        result = run(['lsblk', '--noheadings', '--nodeps', '--output', 'PKNAME', '--', device],
                     check=True, capture_output=True, text=True, timeout=8)
    except (OSError, subprocess.SubprocessError):
        return device
    name = result.stdout.strip()
    return f'/dev/{name}' if re.fullmatch(r'[A-Za-z0-9_-]+', name) else device


def discover(mountpoint, by_label=Path('/dev/disk/by-label'), run=subprocess.run):
    """Mount the one seed volume read-only, read it, and unmount it.

    Returns (seed or None, the seed volume's disk path or None). A volume
    without cybexos-seed.yml (an unrelated cloud-init CIDATA) is not a seed.
    """
    devices = seed_devices(by_label)
    if not devices:
        return None, None
    if len(devices) > 1:
        raise SeedError(['More than one seed volume is attached. Attach only one.'])
    device = devices[0]
    mountpoint.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        run(['mount', '-o', 'ro,nosuid,nodev,noexec', '--', device, str(mountpoint)],
            check=True, capture_output=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        raise SeedError(['The seed volume could not be mounted read-only.']) from None
    try:
        seed = load_directory(mountpoint)
    finally:
        run(['umount', str(mountpoint)], check=False, capture_output=True, timeout=30)
    return seed, parent_disk(device, run)


def main(argv):
    if len(argv) != 2 or argv[0] != 'check':
        print('Usage: cybexos-installer-seed check DIRECTORY', file=sys.stderr)
        return 2
    try:
        seed = load_directory(Path(argv[1]))
    except SeedError as error:
        for message in error.errors:
            print(f'error: {message}', file=sys.stderr)
        return 1
    if seed is None:
        print(f'error: {argv[1]} has no {SEED_NAME}.', file=sys.stderr)
        return 1
    print(json.dumps(seed.summary(), indent=2, sort_keys=True))
    return 0


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
