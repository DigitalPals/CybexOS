#!/usr/bin/python3
"""CybexOS's small Anaconda 44 DBus client. Never partitions disks itself.

Request JSON arrives on stdin; stdout is secret-free NDJSON. Anaconda owns
device discovery, in-memory partition planning, validation, installation and
progress. Only `install` starts its installation task, after plan confirmation.
An unattended seed volume is only ever mounted read-only, read and unmounted.
See image/INSTALLER.md for the versioned upstream interface and test limits.
"""
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import pwd
import re
import secrets
import sys
import subprocess
import time

RUNTIME = Path('/run/cybexos-installer')
RESERVED = {'root', 'liveuser', 'bin', 'daemon', 'adm', 'mail', 'ftp', 'nobody',
            'dbus', 'systemd', 'gdm', 'sddm', 'sshd', 'polkitd', 'chrony'}
GiB = 1024**3
# CybexOS's own minimum, before Anaconda's payload size is considered.
MINIMUM_BYTES = 64 * GiB
# Installing alongside never shrinks another system below its own minimum
# plus this much working space.
OTHER_SYSTEM_MARGIN = 5 * GiB
STORAGE_SERVICE = 'org.fedoraproject.Anaconda.Modules.Storage'
# lsblk file system types that indicate another operating system.
SYSTEM_FILESYSTEMS = {'ntfs': 'Windows', 'BitLocker': 'Windows', 'ext4': 'Linux', 'ext3': 'Linux',
                      'xfs': 'Linux', 'btrfs': 'Linux', 'crypto_LUKS': 'Linux', 'LVM2_member': 'Linux',
                      'apfs': 'macOS', 'hfsplus': 'macOS'}


def load_sibling(name, filename):
    loader = importlib.machinery.SourceFileLoader(name, str(Path(__file__).resolve().with_name(filename)))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


seed_format = load_sibling('cybexos_installer_seed', 'cybexos-installer-seed')


class Invalid(ValueError):
    """A message safe to display; never include secret input in one."""


def plain(value):
    if hasattr(value, 'unpack'):
        return plain(value.unpack())
    if isinstance(value, dict):
        return {key: plain(item) for key, item in value.items()}
    if isinstance(value, (list, tuple)):
        return [plain(item) for item in value]
    return value


def validate_password(value, confirm, what='password'):
    if not isinstance(value, str) or len(value) < 12 or len(value) > 512:
        raise Invalid(f'Use a {what} of 12–512 characters.')
    if any(ord(char) < 32 or ord(char) == 127 for char in value):
        raise Invalid(f'The {what} cannot contain control characters.')
    if value != confirm:
        raise Invalid(f'The {what}s do not match.')


def validate_system(data, choices):
    """Keyboard, language, timezone and computer name from Anaconda's lists."""
    keyboard = data.get('keyboard', '')
    if keyboard not in {item['id'] for item in choices['keyboards']}:
        raise Invalid('Choose an available keyboard layout.')
    locale = data.get('locale', '')
    if locale not in choices['locales']:
        raise Invalid('Choose an available system language.')
    timezone = data.get('timezone', '')
    if timezone not in choices['timezones']:
        raise Invalid('Choose a timezone from the list.')
    hostname = data.get('hostname') or 'cybexos'
    if not isinstance(hostname, str) or not re.fullmatch(r'[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?', hostname):
        raise Invalid('The computer name must contain 1–63 letters, numbers or dashes.')
    return dict(keyboard=keyboard, locale=locale, timezone=timezone, hostname=hostname)


def flag(data, key, default, message):
    value = data.get(key, default)
    if not isinstance(value, bool):
        raise Invalid(message)
    return value


def validate_layout(data):
    """`erase` the whole disk, or install `alongside` its existing systems."""
    layout = data.get('layout', 'erase')
    if layout not in ('erase', 'alongside'):
        raise Invalid('Choose whether to erase the disk or install alongside.')
    shrink = data.get('shrink')
    if layout == 'erase' or shrink is None:
        return layout, None
    if (not isinstance(shrink, dict) or set(shrink) != {'device', 'size'}
            or not isinstance(shrink['device'], str) or not re.fullmatch(r'[A-Za-z0-9_.:/+-]{1,200}', shrink['device'])
            or type(shrink['size']) is not int or shrink['size'] <= 0):
        raise Invalid('The partition size choice is invalid. Review the disk again.')
    return layout, dict(shrink)


def validate_account(data, choices):
    """Interactive choices; the password itself is checked but not returned."""
    oem = flag(data, 'oem', False, 'The new-owner choice is invalid.')
    encrypted = flag(data, 'encrypted', True, 'The encryption choice is invalid.')
    passwordless_wheel = flag(data, 'passwordless_wheel', False, 'The sudo password choice is invalid.')
    username = ''
    if oem:
        # The temporary disk passphrase the new owner replaces at first start.
        if encrypted:
            validate_password(data.get('password', ''), data.get('confirm'), 'passphrase')
    else:
        username = data.get('username', '')
        if not isinstance(username, str) or not re.fullmatch(r'[a-z_][a-z0-9_-]{0,30}', username) or username in RESERVED:
            raise Invalid('Choose a username of 1–31 lowercase letters, numbers, underscores or dashes, starting with a letter.')
        validate_password(data.get('password', ''), data.get('confirm'))
    layout, shrink = validate_layout(data)
    return dict(username=username, full_name='', **validate_system(data, choices),
                encrypted=encrypted, passwordless_wheel=passwordless_wheel, oem=oem,
                layout=layout, shrink=shrink, unattended=False, ssh_authorized_keys=[],
                ssh_server=False, tailscale=False, config={})


def validate_seed(seed, choices):
    """A validated seed as the same account record an interactive plan makes."""
    settings = seed.settings
    if settings['username'] in RESERVED:
        raise Invalid(f'The seed username "{settings["username"]}" is reserved by the system.')
    try:
        system = validate_system(settings, choices)
    except Invalid as error:
        raise Invalid('The seed system settings are not available: ' + str(error)) from None
    secrets_ = {}
    if settings['encrypted']:
        secrets_['passphrase'] = seed.secrets['passphrase']
    if not settings['oem']:
        secrets_['password_hash'] = seed.secrets['password_hash']
    account = dict(username=settings['username'], full_name=settings['full_name'], **system,
                   encrypted=settings['encrypted'], passwordless_wheel=settings['passwordless_wheel'],
                   oem=settings['oem'], layout='erase', shrink=None, unattended=True,
                   ssh_authorized_keys=settings['ssh_authorized_keys'], ssh_server=settings['ssh_server'],
                   tailscale=settings['tailscale'], config=settings['config'])
    return account, secrets_


def disk_systems(disk):
    """Operating systems suggested by a disk's partitions, for the location step."""
    found = []
    for partition in disk.get('partitions', []):
        system = SYSTEM_FILESYSTEMS.get(partition.get('filesystem', ''))
        if system and system not in found:
            found.append(system)
    return found


def required_space(choices):
    return max(MINIMUM_BYTES, int(choices.get('required_bytes', 0)))


def shrink_candidate(analysis):
    """The largest partition Anaconda can shrink, the only one ever offered."""
    candidates = [item for item in analysis.get('partitions', []) if item.get('shrinkable')]
    return max(candidates, key=lambda item: item['size'], default=None)


def alongside_options(analysis, required):
    """What the location step can offer for installing alongside.

    Free space is used when it suffices. Otherwise the largest shrinkable
    partition may be shrunk, never below its minimum plus a working margin.
    """
    free = int(analysis.get('free', 0))
    if free >= required:
        return {'mode': 'free', 'free': free, 'required': required, 'space': free}
    largest = shrink_candidate(analysis)
    if largest is None:
        raise Invalid('This disk has too little free space and no partition CybexOS can shrink. '
                      'Choose Erase disk or another disk.')
    floor = largest['min_size'] + OTHER_SYSTEM_MARGIN
    maximum = free + largest['size'] - floor
    if maximum < required:
        raise Invalid(f'Shrinking {largest["path"]} cannot free the {required // GiB} GiB CybexOS needs. '
                      'Choose Erase disk or another disk.')
    # Start halfway between the minimum and the most that can be taken.
    default = min(maximum, max(required, (required + maximum) // 2))
    partition = {key: largest[key] for key in ('id', 'path', 'size', 'min_size', 'filesystem')}
    return {'mode': 'shrink', 'free': free, 'required': required, 'partition': partition,
            'floor': floor, 'min_space': required, 'max_space': maximum, 'default_space': default}


def alongside_plan(analysis, required, requested):
    """Validate the reviewed choice against a fresh analysis of the disk."""
    options = alongside_options(analysis, required)
    if options['mode'] == 'free':
        if requested is not None:
            raise Invalid('This disk has enough free space; nothing needs to be shrunk. Review the disk again.')
        return {'shrink': None, 'space': options['free']}
    partition = options['partition']
    if requested is None or requested['device'] != partition['id']:
        raise Invalid('Only the largest resizable partition can be shrunk. Review the disk again.')
    if not options['floor'] <= requested['size'] < partition['size']:
        raise Invalid(f'{partition["path"]} cannot be shrunk to that size. Review the disk again.')
    space = options['free'] + partition['size'] - requested['size']
    if space < required:
        raise Invalid(f'CybexOS needs at least {required // GiB} GiB. Shrink {partition["path"]} further.')
    return {'shrink': {'device': partition['id'], 'size': requested['size']}, 'space': space,
            'partition': partition}


def verify_alongside_actions(actions, existing, shrink):
    """Refuse a plan that touches any existing device except the one shrunk.

    Free-space automatic partitioning must only create new devices. Any
    destroy, a format on an existing device, or a resize of anything other
    than the confirmed partition means the plan is not what was reviewed.
    """
    target = shrink['device'] if shrink else None
    for action in actions:
        kind = str(action.get('action-type', '')).lower()
        device = action.get('device-id', '')
        if kind == 'destroy':
            raise Invalid('Anaconda planned to remove an existing partition. Nothing was changed; choose Erase disk or the full installer.')
        if kind == 'resize':
            if device != target:
                raise Invalid('Anaconda planned to resize another partition. Nothing was changed.')
            continue
        if device in existing:
            raise Invalid('Anaconda planned to change an existing partition. Nothing was changed; use the full installer.')


def action_set(actions):
    """Order-free comparison key for Anaconda's planned device actions.

    DeviceTree.GetActions() re-sorts blivet's action list in place, and its
    topological sort reverses the order of independent actions on each call.
    """
    return sorted(json.dumps(action, sort_keys=True) for action in actions)


def fingerprint(disk):
    identity = {key: disk.get(key) for key in ('name', 'path', 'size', 'serial', 'wwn', 'device_id')}
    identity['partitions'] = sorted(disk.get('partitions', []), key=lambda item: item.get('path', ''))
    return hashlib.sha256(json.dumps(identity, sort_keys=True).encode()).hexdigest()


def apply_live_keyboard(layout, run=subprocess.run):
    """Apply only an Anaconda-listed XKB layout to the live user's compositor."""
    match = re.fullmatch(r'([A-Za-z0-9_-]+)(?:\s*\(([A-Za-z0-9_-]+)\))?', layout)
    if not match:
        raise Invalid('This keyboard layout needs the full installer.')
    user = pwd.getpwnam('liveuser')
    command = ['runuser', '-u', 'liveuser', '--', 'env', f'XDG_RUNTIME_DIR=/run/user/{user.pw_uid}']
    instances = json.loads(run(command + ['/usr/bin/hyprctl', '-j', 'instances'],
                               check=True, capture_output=True, text=True).stdout)
    instances = [item for item in instances if Path(f"/proc/{int(item['pid'])}").stat().st_uid == user.pw_uid]
    if len(instances) != 1:
        raise Invalid('The live keyboard could not be applied to a unique desktop session.')
    signature = instances[0]['instance']
    if not re.fullmatch(r'[A-Za-z0-9_.-]+', signature):
        raise Invalid('The live desktop instance is invalid.')
    # The Lua-configured compositor refuses `hyprctl keyword`. Set layout and
    # variant in one evaluation; the validated identifiers are safe Lua strings.
    code = 'hl.config({ input = { kb_layout = %s, kb_variant = %s } })' % (
        json.dumps(match[1]), json.dumps(match[2] or ''))
    result = run(command + [f'HYPRLAND_INSTANCE_SIGNATURE={signature}', '/usr/bin/hyprctl', 'eval', code],
                 capture_output=True, text=True)
    # hyprctl reports a Lua error as output, sometimes with exit status 0.
    if result.returncode != 0 or result.stdout.strip() != 'ok':
        raise Invalid('The live keyboard could not be applied. Choose another layout.')


class State:
    def __init__(self, directory=RUNTIME):
        self.directory = directory

    def read(self):
        try:
            return json.loads((self.directory / 'state.json').read_text())
        except FileNotFoundError:
            return {'phase': 'setup'}

    def write(self, value):
        # No password, password hash, passphrase or raw DBus request belongs here.
        self.directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        temporary = self.directory / ('.state-' + secrets.token_hex(12) + '.tmp')
        with temporary.open('w', encoding='utf-8') as stream:
            os.chmod(temporary, 0o600)
            json.dump(value, stream)
        temporary.replace(self.directory / 'state.json')


def installation_status(store, run=subprocess.run):
    state = store.read()
    if state.get('phase') == 'installing':
        service = run(['systemctl', 'show', 'cybexos-installer-worker.service',
                       '--property=ActiveState', '--value'], capture_output=True, text=True)
        if (time.time() - state.get('worker_queued_at', time.time()) > 30
                and service.stdout.strip() not in ('active', 'activating', 'reloading', 'deactivating')):
            # A killed worker does not prove that Anaconda's storage task stopped.
            # Fail closed: never report success or permit a replacement install.
            state.update(phase='failed-install', message='The installation monitor stopped unexpectedly. Anaconda may still be writing the disk. Keep this session open and inspect the installer diagnostics before restarting.')
            # This status reader never writes: the worker alone owns progress
            # and completion. Its concurrent final update must win this race.
    return public_status(state)


def public_status(state):
    """Never send persisted account, disk plan, or Anaconda text to the browser."""
    allowed = ('setup', 'planning', 'review', 'failed-plan', 'installing', 'complete', 'failed-install')
    phase = state.get('phase') if state.get('phase') in allowed else 'failed-install'
    messages = {
        'installing': 'Anaconda is installing CybexOS. Keep this session open.',
        'complete': 'CybexOS is installed. Restart and remove the installation medium.',
        'failed-install': 'Installation did not finish. Save diagnostics and check the installer logs before restarting.',
    }
    result = {'phase': phase, 'message': messages.get(phase, '')}
    for key in ('step', 'total'):
        if type(state.get(key)) is int and 0 <= state[key] <= 100000:
            result[key] = state[key]
    return result


def diagnostics(store, run=subprocess.run):
    """Export useful status without raw logs, credentials, disk IDs, or usernames."""
    state = store.read()
    service = run(['systemctl', 'show', 'cybexos-installer-worker.service',
                   '--property=ActiveState,SubState,Result', '--no-pager'],
                  capture_output=True, text=True, timeout=10)
    fields = {}
    for line in service.stdout.splitlines():
        key, separator, value = line.partition('=')
        if separator and key in ('ActiveState', 'SubState', 'Result') and re.fullmatch(r'[a-z-]{1,32}', value):
            fields[key] = value
    return {'schema': 1, 'installer': public_status(state), 'worker': fields,
            'backend_ready': Path('/run/anaconda/backend_ready').exists()}


class SeedVolume:
    """Finds the attached seed volume; replaced by a fixture in tests."""

    def __init__(self, directory=RUNTIME):
        self.mountpoint = directory / 'seed'

    def discover(self):
        return seed_format.discover(self.mountpoint)


class Installer:
    def __init__(self, backend, state, emit=lambda event: None, seeds=None):
        self.backend, self.state, self.emit = backend, state, emit
        self.seeds = seeds or SeedVolume(state.directory)

    @property
    def staged(self):
        # Root-only, memory-backed files the target hook copies and deletes.
        return self.state.directory / 'staged'

    def stage(self, name, value):
        self.staged.mkdir(mode=0o700, parents=True, exist_ok=True)
        descriptor = os.open(self.staged / name, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(descriptor, 'w') as stream:
            stream.write(value)

    def clear_staged(self):
        for path in self.staged.glob('*') if self.staged.is_dir() else []:
            path.unlink(missing_ok=True)

    def require_idle(self):
        if self.state.read().get('phase') in ('installing', 'complete', 'failed-install'):
            raise Invalid('Installation has already started. Check its status before leaving this window.')

    def inventory(self):
        return self.backend.inventory()

    def rescan(self):
        self.require_idle()
        # Invalidate every review before the device tree is refreshed.
        self.clear_staged()
        self.state.write({'phase': 'setup'})
        self.backend.rescan()
        return self.inventory()

    def keyboard(self, data):
        self.require_idle()
        layout = data.get('keyboard', '')
        if layout not in {item['id'] for item in self.inventory()['keyboards']}:
            raise Invalid('Choose an available keyboard layout.')
        result = self.backend.keyboard(layout)
        # Changing the active keyboard invalidates any old disk confirmation.
        self.clear_staged()
        self.state.write({'phase': 'setup', 'keyboard': layout})
        return result

    def seed(self):
        """Report an attached unattended seed: its summary, or every problem."""
        self.require_idle()
        try:
            seed, seed_disk = self.seeds.discover()
        except seed_format.SeedError as error:
            return {'found': True, 'valid': False, 'errors': error.errors}
        if seed is None:
            return {'found': False}
        summary = seed.summary()
        if self.cancelled(seed):
            # Reloading the page must not restart a countdown the user stopped.
            return {'found': True, 'valid': False, 'cancelled': True, 'errors': [], 'seed': summary}
        try:
            choices = self.inventory()
            validate_seed(seed, choices)
            disk = seed_format.select_disk(seed.settings['match'], choices['disks'], excluded={seed_disk})
            if disk['size'] < required_space(choices):
                raise Invalid(f'The matched disk {disk["path"]} is smaller than the '
                              f'{required_space(choices) // GiB} GiB CybexOS needs.')
            summary['disk'] = disk
        except seed_format.SeedError as error:
            return {'found': True, 'valid': False, 'errors': error.errors, 'seed': summary}
        except Invalid as error:
            return {'found': True, 'valid': False, 'errors': [str(error)], 'seed': summary}
        return {'found': True, 'valid': True, 'errors': [], 'seed': summary}

    def cancelled(self, seed):
        try:
            return (self.state.directory / 'seed-cancelled').read_text() == seed.digest
        except OSError:
            return False

    def cancel_seed(self, data):
        """Stop an unattended installation; the same seed is not offered again."""
        digest = data.get('seed')
        if not isinstance(digest, str) or not re.fullmatch(r'[0-9a-f]{64}', digest):
            raise Invalid('The seed to cancel is not valid.')
        self.require_idle()
        self.state.directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        (self.state.directory / 'seed-cancelled').write_text(digest)
        return self.reset()

    def alongside(self, data):
        """Free space and the one shrinkable partition for installing alongside."""
        self.require_idle()
        self.clear_staged()
        self.state.write({'phase': 'setup'})  # Any earlier review is invalid now.
        choices = self.inventory()
        disk = next((item for item in choices['disks'] if item['name'] == data.get('disk')), None)
        if disk is None:
            raise Invalid('Select an available installation disk.')
        result = alongside_options(self.backend.alongside(disk), required_space(choices))
        result['systems'] = disk_systems(disk)
        return result

    def plan(self, data):
        self.require_idle()
        self.state.write({'phase': 'planning'})  # Any old confirmation token is invalid now.
        self.clear_staged()
        try:
            choices = self.inventory()
            seed = None
            if 'seed' in data:
                try:
                    seed, seed_disk = self.seeds.discover()
                except seed_format.SeedError as error:
                    raise Invalid('The seed is no longer valid: ' + ' '.join(error.errors)) from None
                if seed is None or not secrets.compare_digest(seed.digest, str(data.get('seed'))):
                    raise Invalid('The seed volume changed. Check it again before installing.')
                if self.cancelled(seed):
                    raise Invalid('This unattended installation was cancelled.')
                account, credentials = validate_seed(seed, choices)
                try:
                    disk = seed_format.select_disk(seed.settings['match'], choices['disks'], excluded={seed_disk})
                except seed_format.SeedError as error:
                    raise Invalid(' '.join(error.errors)) from None
            else:
                account = validate_account(data, choices)
                credentials = {}
                if not account['oem']:
                    credentials['password'] = data['password']
                if account['encrypted']:
                    credentials['passphrase'] = data['password']
                disk = next((item for item in choices['disks'] if item['name'] == data.get('disk')), None)
                if disk is None:
                    raise Invalid('Select an available installation disk. The live medium cannot be selected.')
            required = required_space(choices)
            layout = {'mode': account['layout']}
            existing = set()
            if account['layout'] == 'alongside':
                analysis = self.backend.alongside(disk)
                decision = alongside_plan(analysis, required, account['shrink'])
                account['shrink'] = decision['shrink']
                existing = {disk['name'], *(item['id'] for item in analysis.get('partitions', []))}
                layout.update(space=decision['space'], systems=disk_systems(disk),
                              kept=[item['path'] for item in analysis.get('partitions', [])
                                    if not decision['shrink'] or item['id'] != decision['shrink']['device']])
                if decision['shrink']:
                    partition = decision['partition']
                    layout['resize'] = {'path': partition['path'], 'filesystem': partition['filesystem'],
                                        'from': partition['size'], 'to': decision['shrink']['size']}
            elif disk['size'] < required:
                raise Invalid(f'CybexOS needs a disk with at least {(required + GiB - 1) // GiB} GiB for its included applications.')
            result = self.backend.plan(account, credentials, disk)
            credentials.clear()
            if result.get('errors'):
                raise Invalid('Anaconda rejected the storage layout. Open Advanced storage to review the disk.')
            if account['layout'] == 'alongside':
                verify_alongside_actions(result['actions'], existing, account['shrink'])
            state = dict(phase='review', token=secrets.token_hex(24), created=time.time(),
                         disk=disk, fingerprint=fingerprint(disk), account=account, layout=layout,
                         partitioning=result['partitioning'], actions=result['actions'],
                         warnings=result.get('warnings', []), boot_keyboard=result['boot_keyboard'])
            if seed is not None:
                # The countdown is enforced here as well as shown by the page.
                state.update(seed_digest=seed.digest, countdown=seed.settings['countdown'],
                             countdown_ends=time.time() + seed.settings['countdown'])
                if seed.secrets.get('tailscale_auth_key'):
                    self.stage('tailscale-authkey', seed.secrets['tailscale_auth_key'])
            self.state.write(state)
            return state
        except Exception:
            self.state.write({'phase': 'failed-plan'})
            self.clear_staged()
            raise
        finally:
            data.pop('password', None)
            data.pop('confirm', None)

    def install(self, data):
        state = self.state.read()
        if state.get('phase') != 'review':
            raise Invalid('Review a new installation plan before installing.')
        if not secrets.compare_digest(str(data.get('token', '')), state['token']):
            raise Invalid('This review has expired. Review the disk again.')
        if state.get('layout', {}).get('mode') == 'alongside':
            if data.get('confirmed_disk') != state['disk']['name'] or data.get('alongside_confirmed') is not True:
                raise Invalid('Confirm the disk changes before installing alongside.')
        elif data.get('confirmed_disk') != state['disk']['name'] or data.get('erase_confirmed') is not True:
            raise Invalid('Confirm erasing the selected disk before installing.')
        if time.time() - state['created'] > 1800:
            raise Invalid('This review has expired. Review the disk again.')
        if state['account'].get('unattended') and time.time() < state.get('countdown_ends', 0) - 1:
            raise Invalid('The unattended installation waits for its countdown. Cancel it to stop.')
        current = next((item for item in self.inventory()['disks'] if item['name'] == state['disk']['name']), None)
        if current is None or fingerprint(current) != state['fingerprint']:
            self.state.write({'phase': 'failed-plan'})
            raise Invalid('The selected disk changed. Review the available disks again.')
        # Reject storage edits made by another UI between review and confirmation.
        self.backend.check_plan(state)
        state['phase'] = 'installing'
        state['worker_queued_at'] = time.time()
        state.pop('token')
        self.state.write(state)

        try:
            self.backend.start_install(state)
        except Exception:
            state.update(phase='failed-install', message='The installation worker could not start. Review its status before restarting the installer.')
            self.state.write(state)
            raise
        return public_status(state)

    def worker(self):
        state = self.state.read()
        if state.get('phase') != 'installing' or state.get('task'):
            raise Invalid('No new confirmed installation is queued.')

        def progress(step, total, message):
            # Anaconda's free-form task text can contain paths or user data.
            state.update(step=step, total=total)
            self.state.write(state)
            self.emit({'event': 'progress', 'phase': 'installing', 'step': step,
                       'total': total, 'message': 'Installing CybexOS…'})

        try:
            self.backend.run_install(state, progress, self.state)
            state.update(phase='complete', message='CybexOS is installed. Restart and remove the installation medium.')
        except Exception:
            state.update(phase='failed-install', message='Installation did not finish. Keep this session open and review Anaconda diagnostics before retrying.')
            self.state.write(state)
            raise
        self.state.write(state)
        return state

    def geolocate(self):
        return self.backend.geolocate()

    def reset(self):
        self.require_idle()
        self.backend.reset()
        self.clear_staged()
        self.state.write({'phase': 'setup'})
        return {'phase': 'setup'}


class Anaconda:
    """Adapter for anaconda 44.30, matching anaconda-webui 68's API sequence."""
    def __init__(self):
        # Always discover the installation bus from Anaconda's own root-owned file.
        os.environ.pop('DBUS_ANACONDA_SESSION_ADDRESS', None)
        os.environ.pop('DBUS_STARTER_ADDRESS', None)
        from pyanaconda.core.dbus import AnacondaMessageBus
        from gi.repository import GLib
        self.bus = AnacondaMessageBus()
        self.GLib = GLib

    def proxy(self, module, suffix=''):
        service = 'org.fedoraproject.Anaconda.' + ('Boss' if module == 'Boss' else 'Modules.' + module)
        path = '/' + service.replace('.', '/') + suffix
        return self.bus.get_proxy(service, path)

    def task(self, module, path, result=False, progress=None, timeout=300):
        service = 'org.fedoraproject.Anaconda.' + ('Boss' if module == 'Boss' else 'Modules.' + module)
        task = self.bus.get_proxy(service, path)
        context = self.GLib.MainContext.default()
        stopped = []
        task.Stopped.connect(lambda: stopped.append(True))
        if progress:
            task.ProgressChanged.connect(lambda step, message: progress(step, task.Steps, message))
        task.Start()
        start = time.monotonic()
        while not stopped:
            while context.pending():
                context.iteration(False)
            if time.monotonic() - start > timeout:
                # Never cancel an installation whose filesystem transaction may be active.
                raise Invalid('Anaconda is taking longer than expected. Keep the installer open and check its status.')
            time.sleep(0.05)
        task.Finish()  # Propagates failures; stopped does not mean succeeded.
        return plain(task.GetResult()) if result else None

    def inventory(self):
        selection = self.proxy('Storage', '/DiskSelection')
        viewer = self.proxy('Storage', '/DeviceTree')
        disks = []
        for name in selection.GetUsableDisks():
            device = plain(viewer.GetDeviceData(name))
            if not device.get('is-disk') or device.get('protected'):
                continue
            attrs = device.get('attrs', {})
            partitions = []
            try:
                report = subprocess.run(['lsblk', '--json', '--bytes', '--output',
                                         'PATH,SIZE,TYPE,FSTYPE', '--', device['path']],
                                        check=True, capture_output=True, text=True, timeout=8)
                def visit(nodes):
                    for node in nodes:
                        if node.get('type') == 'part':
                            partitions.append({'path': node.get('path', ''), 'size': node.get('size', 0),
                                               'filesystem': node.get('fstype') or ''})
                        visit(node.get('children', []))
                visit(json.loads(report.stdout).get('blockdevices', []))
            except (OSError, ValueError, TypeError, subprocess.SubprocessError):
                # Anaconda remains the authority for whether this disk is safe to select.
                pass
            disk = dict(name=name, path=device['path'], size=device['size'],
                        model=attrs.get('model') or device.get('description') or name,
                        serial=attrs.get('serial', ''), wwn=attrs.get('wwn', ''),
                        device_id=device.get('device-id', ''), removable=device.get('removable', False),
                        partitions=partitions)
            # A hint for offering "Install alongside"; not part of the identity.
            disk['systems'] = disk_systems(disk)
            disks.append(disk)
        localization = self.proxy('Localization')
        keyboards = plain(localization.GetKeyboardLayouts())
        keyboard_choices = [{'id': item['layout-id'], 'label': item['description']} for item in keyboards]
        # Common locales are only Anaconda's short list of popular choices.
        # Enumerate its supported languages and regional locales so installed
        # translations such as Dutch remain selectable.
        locales = sorted({locale for language in localization.GetLanguages()
                          for locale in localization.GetLocales(language)})
        if localization.Language and localization.Language not in locales:
            locales.append(localization.Language)
        timezone = self.proxy('Timezone')
        timezones = sorted({f'{region}/{city}' for region, cities in plain(timezone.GetAllValidTimezones()).items()
                            for city in cities} | {'UTC'})
        # Anaconda geolocates at startup but applies the result only if it
        # arrives within seconds; a later result is still recorded here.
        detected = plain(timezone.GeolocationResult).get('timezone', '')
        detected = detected if detected in timezones else ''
        selected = detected or timezone.Timezone
        return dict(disks=disks, keyboards=keyboard_choices, locales=locales,
                    locale=localization.Language or 'en_US.UTF-8',
                    keyboard=(list(localization.XLayouts) or ['us'])[0],
                    timezones=timezones, timezone=selected if selected in timezones else 'UTC',
                    detected_timezone=detected,
                    required_bytes=int(self.proxy('Payloads').CalculateRequiredSpace()))

    def geolocate(self):
        """Look up the timezone once the network is up. Selects nothing itself."""
        timezone = self.proxy('Timezone')
        if not plain(timezone.GeolocationResult).get('timezone'):
            # The task waits for networking and returns an empty result on failure.
            self.task('Timezone', timezone.StartGeolocationWithTask(), timeout=90)
        return {'timezone': plain(timezone.GeolocationResult).get('timezone', '')}

    def reset(self):
        self.proxy('Storage').ResetPartitioning()
        self.proxy('Users').Users = []
        self.proxy('Storage', '/DiskSelection').SelectedDisks = []
        initialization = self.proxy('Storage', '/DiskInitialization')
        initialization.InitializationMode = 0
        initialization.DrivesToClear = []
        initialization.DevicesToClear = []

    def rescan(self):
        self.task('Storage', self.proxy('Storage').ScanDevicesWithTask(), timeout=300)

    def keyboard(self, layout):
        localization = self.proxy('Localization')
        localization.XLayouts = [layout]
        localization.VirtualConsoleKeymap = ''
        self.task('Localization', localization.PopulateMissingKeyboardConfigurationWithTask())
        if not localization.VirtualConsoleKeymap:
            raise Invalid('This layout cannot be used at the boot unlock screen.')
        apply_live_keyboard(layout)
        return {'keyboard': layout, 'boot_keyboard': localization.VirtualConsoleKeymap}

    def partitioning(self, path):
        return self.bus.get_proxy(STORAGE_SERVICE, path)

    def alongside(self, disk):
        """Read-only: free space and resize limits from a scratch partitioning.

        anaconda-webui 68's reclaim dialog reads the same limits from an
        AUTOMATIC partitioning's resizable device tree. Nothing is scheduled
        here, and the playground is dropped again afterwards.
        """
        self.reset()
        self.proxy('Storage', '/DiskSelection').SelectedDisks = [disk['name']]
        partitioning = self.partitioning(self.proxy('Storage').CreatePartitioning('AUTOMATIC'))
        tree = self.partitioning(partitioning.GetDeviceTree())
        try:
            partitions = []
            for device_id in tree.GetDevicePartitions(disk['name']):
                data = plain(tree.GetDeviceData(device_id))
                shrinkable = bool(tree.IsDeviceShrinkable(device_id))
                minimum = int(tree.GetDeviceSizeLimits(device_id)[0]) if shrinkable else int(data['size'])
                partitions.append(dict(id=device_id, path=data.get('path', ''), size=int(data['size']),
                                       min_size=minimum, shrinkable=shrinkable,
                                       filesystem=plain(tree.GetFormatData(device_id)).get('type', '')))
            return dict(free=int(tree.GetDiskFreeSpace([disk['name']])), partitions=partitions)
        finally:
            self.reset()

    def plan(self, account, credentials, disk):
        from pyanaconda.core.users import crypt_password
        from pyanaconda.modules.common.structures.user import UserData
        from pyanaconda.modules.common.structures.partitioning import PartitioningRequest
        self.reset()
        users = self.proxy('Users')
        if account['oem']:
            # The new owner creates the only account at first start.
            users.Users = []
        else:
            user = UserData()
            user.name = account['username']
            if account['full_name']:
                user.gecos = account['full_name']
            # A seed provides only a hash; an interactive password is hashed here.
            user.password = credentials.get('password_hash') or crypt_password(credentials['password'])
            user.is_crypted = True
            user.groups = ['wheel']
            users.Users = [UserData.to_structure(user)]
        users.ClearRootPassword()
        users.IsRootAccountLocked = True
        localization = self.proxy('Localization')
        localization.Language = account['locale']
        localization.XLayouts = [account['keyboard']]
        localization.VirtualConsoleKeymap = ''
        self.task('Localization', localization.PopulateMissingKeyboardConfigurationWithTask())
        boot_keyboard = localization.VirtualConsoleKeymap
        if not boot_keyboard:
            raise Invalid('Anaconda could not map this keyboard to the boot unlock screen. Choose another layout.')
        self.proxy('Timezone').SetTimezoneWithPriority(account['timezone'], 90)
        self.proxy('Network').Hostname = account['hostname']
        storage = self.proxy('Storage')
        self.proxy('Storage', '/DiskSelection').SelectedDisks = [disk['name']]
        initialization = self.proxy('Storage', '/DiskInitialization')
        alongside = account['layout'] == 'alongside'
        if alongside:
            # CLEAR_PARTITIONS_NONE: automatic partitioning uses free space only,
            # and no disk label is ever recreated.
            initialization.InitializationMode = 0
            initialization.DrivesToClear = []
            initialization.InitializeLabelsEnabled = False
        else:
            initialization.InitializationMode = 1  # CLEAR_PARTITIONS_ALL; selected disk only.
            initialization.DrivesToClear = [disk['name']]
            initialization.InitializeLabelsEnabled = True
        initialization.DevicesToClear = []
        path = storage.CreatePartitioning('AUTOMATIC')
        partitioning = self.partitioning(path)
        if alongside and account['shrink']:
            # The same call the reclaim dialog makes on this partitioning's tree.
            tree = self.partitioning(partitioning.GetDeviceTree())
            tree.ShrinkDevice(account['shrink']['device'], account['shrink']['size'])
        request = PartitioningRequest.from_structure(partitioning.Request)
        request.partitioning_scheme = 1  # BTRFS
        request.encrypted = account['encrypted']
        request.luks_version = 'luks2'
        partitioning.Request = PartitioningRequest.to_structure(request)
        if account['encrypted']:
            partitioning.SetPassphrase(credentials['passphrase'])
        self.proxy('Storage', '/Bootloader').Drive = ''
        self.task('Storage', partitioning.ConfigureWithTask())
        storage.ApplyPartitioning(path)
        report = self.task('Storage', partitioning.ValidateWithTask(), result=True)
        return dict(partitioning=path, actions=plain(self.proxy('Storage', '/DeviceTree').GetActions()),
                    errors=report.get('error-messages', []), warnings=report.get('warning-messages', []),
                    boot_keyboard=boot_keyboard)

    def check_plan(self, state):
        storage = self.proxy('Storage')
        if storage.AppliedPartitioning != state['partitioning']:
            raise Invalid('The storage plan changed. Review the installation again.')
        if list(self.proxy('Storage', '/DiskSelection').SelectedDisks) != [state['disk']['name']]:
            raise Invalid('The selected storage changed. Review the installation again.')
        actions = plain(self.proxy('Storage', '/DeviceTree').GetActions())
        if action_set(actions) != action_set(state['actions']):
            raise Invalid('The planned disk changes changed. Review the installation again.')
        partitioning = self.partitioning(state['partitioning'])
        report = self.task('Storage', partitioning.ValidateWithTask(), result=True)
        if report.get('error-messages'):
            raise Invalid('Anaconda no longer considers this storage plan valid.')

    def start_install(self, state):
        # The worker is independent of the browser/Cockpit channel. Closing a
        # tab never terminates the monitor or starts a second installation.
        subprocess.run(['/usr/bin/systemd-run', '--unit=cybexos-installer-worker',
                        '--collect', '--property=Type=exec',
                        '/usr/libexec/cybexos-installer-backend', 'worker'],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, check=True)

    def run_install(self, state, progress, store):
        tasks = list(self.proxy('Boss').InstallWithTasks())
        if len(tasks) != 1:
            raise Invalid('This Anaconda version returned an unsupported installation task sequence.')
        state['task'] = tasks[0]
        store.write(state)
        self.task('Boss', tasks[0], progress=progress, timeout=4 * 3600)


def check_live_environment(require_backend=True):
    if os.geteuid() != 0:
        raise Invalid('The installer needs its authorized local administrator connection.')
    cmdline = Path('/proc/cmdline').read_text().split()
    if not Path('/run/cybexos-live').is_file() or not any(item in ('rd.live.image', 'rd.live.image=1') for item in cmdline):
        raise Invalid('Installation is available only from the CybexOS live image.')
    if require_backend and not Path('/run/anaconda/backend_ready').exists():
        raise Invalid('Anaconda is still starting. Try again in a moment.')


def main():
    os.umask(0o077)
    command = sys.argv[1] if len(sys.argv) == 2 else ''
    if command not in ('inventory', 'rescan', 'diagnostics', 'keyboard', 'plan', 'install', 'status', 'geolocate', 'reset', 'advanced',
                       'worker', 'reboot', 'seed', 'alongside', 'cancel-seed'):
        raise Invalid('Unknown installer request.')
    check_live_environment(require_backend=command not in ('status', 'diagnostics', 'reboot'))
    RUNTIME.mkdir(mode=0o700, parents=True, exist_ok=True)
    # Serialize planning and commit. Status remains readable during installation,
    # and a slow geolocation lookup, which changes no selection, never blocks setup.
    lock = (RUNTIME / 'lock').open('a')
    if command not in ('status', 'geolocate'):
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | (0 if command == 'worker' else fcntl.LOCK_NB))
        except BlockingIOError:
            raise Invalid('Another installer operation is still running.') from None
    if command == 'status':
        return installation_status(State())
    if command == 'diagnostics':
        return diagnostics(State())
    if command == 'reboot':
        if State().read().get('phase') != 'complete':
            raise Invalid('Wait for installation to finish before restarting.')
        subprocess.run(['systemctl', 'reboot'], check=True)
        return {'phase': 'complete'}
    if command == 'worker':
        return Installer(Anaconda(), State(), emit).worker()
    raw = sys.stdin.buffer.read(16385)
    if len(raw) > 16384:
        raise Invalid('Installer request is too large.')
    try:
        data = json.loads(raw or b'{}')
    except (ValueError, UnicodeError):
        raise Invalid('Installer request is invalid.') from None
    if not isinstance(data, dict):
        raise Invalid('Installer request is invalid.')
    installer = Installer(Anaconda(), State(), emit)
    if command == 'inventory':
        return installer.inventory()
    if command == 'rescan':
        return installer.rescan()
    if command == 'geolocate':
        return installer.geolocate()
    if command == 'seed':
        return installer.seed()
    if command == 'cancel-seed':
        return installer.cancel_seed(data)
    if command in ('reset', 'advanced'):
        return installer.reset()
    return getattr(installer, command)(data)


def emit(event):
    # The browser may disconnect while Anaconda continues installing. Persisted
    # state still records completion; broken stdout must not abort the monitor.
    try:
        print(json.dumps(event), flush=True)
    except BrokenPipeError:
        pass


if __name__ == '__main__':
    try:
        emit({'event': 'result', 'ok': True, 'data': main()})
    except Invalid as error:
        emit({'event': 'result', 'ok': False, 'error': str(error)})
        sys.exit(1)
    except Exception:
        # Remote errors can include method parameters; do not echo or log them.
        emit({'event': 'result', 'ok': False,
              'error': 'Anaconda could not complete this operation. Open Advanced storage or check the installer diagnostics.'})
        sys.exit(1)
