#!/usr/bin/env bash
set -euo pipefail
# This runs in the writable live overlay, never during image construction.
grep -qw rd.live.image /proc/cmdline || exit 0
touch /run/cybexos-live
if ! id liveuser >/dev/null 2>&1; then
  useradd --create-home --uid 1000 --groups wheel,docker --shell /bin/bash liveuser
  passwd --delete liveuser
fi
install -d /var/lib/AccountsService/users
cat > /var/lib/AccountsService/users/liveuser <<'ACCOUNT'
[User]
Session=hyprland-quickshell
XSession=hyprland-quickshell
SystemAccount=false
ACCOUNT
install -d -m 0755 /etc/cybexos
cat > /etc/cybexos/login.json <<'LOGIN'
{"version":1,"user":"liveuser","autologin":true,"live":true}
LOGIN
printf '%s\n' liveuser > /run/cybexos-live-session
chmod 0644 /etc/cybexos/login.json /run/cybexos-live-session
# The permission exists only in this boot's live overlay. It is explicitly
# removed by the Anaconda post-install script as an additional safeguard.
cat > /etc/sudoers.d/cybexos-live <<'SUDO'
liveuser ALL=(ALL) NOPASSWD: ALL
SUDO
chmod 0440 /etc/sudoers.d/cybexos-live
cat > /etc/polkit-1/rules.d/49-cybexos-live.rules <<'POLKIT'
polkit.addRule(function(action, subject) {
    if (subject.user == "liveuser" && subject.local && subject.active &&
        action.id == "org.fedoraproject.pkexec.liveinst") {
        return polkit.Result.YES;
    }
});
POLKIT
restorecon -RF /home/liveuser /etc/cybexos /var/lib/AccountsService/users /etc/sudoers.d
