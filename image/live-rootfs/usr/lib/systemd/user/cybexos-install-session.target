[Unit]
Description=CybexOS installation session
# Started instead of hyprland-session.target when the live image boots with
# cybexos.install: no shell, dictation, idle daemon or offline app seeding.
# The installer window can still start the full live desktop.
DefaultDependencies=no
BindsTo=graphical-session.target
Wants=graphical-session-pre.target hyprpolkitagent.service cybexos-install-welcome.service
After=graphical-session-pre.target
Before=graphical-session.target
