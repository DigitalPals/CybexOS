#!/usr/bin/env python3
"""Compose with livecd-tools' API so DNF repository signing policy is honored."""
import logging
import configparser
import hashlib
import json
import gc
import os
from pathlib import Path
import shutil
import subprocess
import traceback

import imgcreate
import imgcreate.creator
from imgcreate.dnfinst import DnfLiveCD
import rpm
from boot_branding import brand_boot_menu

logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")
source = Path(__file__).resolve().parent
build = Path("/home/builder/build")
dnf_instances = []


class VerifiedDnf(DnfLiveCD):
    """Add signature enforcement missing from Fedora 44's livecd-tools 31.

    The shipped runInstall explicitly skips signature checks. Keep its image
    construction logic, but verify the downloaded transaction before RPM can
    execute any package scriptlets. Repository policy comes from build.repo.
    """

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        dnf_instances.append(self)

    def addRepository(self, name, url=None, mirrorlist=None):
        policy = configparser.ConfigParser(interpolation=None)
        policy.read(source / "build.repo")
        policy.read(build / "application-repositories.repo")
        for repository_id in policy.sections():
            entry = policy[repository_id]
            repository = super().addRepository(repository_id, entry.get("baseurl"), entry.get("mirrorlist"))
            if entry.get("metalink"):
                repository.metalink = entry["metalink"].replace("$releasever", "44").replace("$basearch", "x86_64")
            repository.gpgcheck = entry.getboolean("gpgcheck")
            repository.repo_gpgcheck = entry.getboolean("repo_gpgcheck", fallback=False)
            repository.skip_if_unavailable = False
            if repository_id == "cybexos-local":
                repository.metadata_expire = 0
            if repository.gpgcheck:
                repository.gpgkey = [key.replace("$releasever", "44").replace("$basearch", "x86_64")
                                     for key in entry["gpgkey"].split()]
            elif repository_id != "cybexos-local":
                raise RuntimeError("Only the locally built RPM may be unsigned")
        return self.repos[name]

    def do_transaction(self, *args, **kwargs):
        for package in self.transaction.install_set:
            if not package.repo.gpgcheck:
                if package.reponame != "cybexos-local":
                    raise RuntimeError(f"Unexpected unsigned package: {package}")
                if package.name != "cybexos-desktop":
                    pinned = json.loads((build / "pinned-rpms.json").read_text())
                    path = Path(package.localPkg())
                    with path.open("rb") as stream:
                        digest = hashlib.file_digest(stream, "sha256").hexdigest()
                    if pinned.get(path.name) != digest:
                        raise RuntimeError(f"Unverified local application RPM: {package}")
                continue
            result, message = self._sig_check_pkg(package)
            if result == 1:
                self._get_key_for_package(package, lambda *_args, **_kwargs: True)
                result, message = self._sig_check_pkg(package)
            if result:
                raise RuntimeError(f"Package signature verification failed: {package}: {message}")
        logging.info("Verified all upstream package signatures before installation")
        # RPM 6 must accept the locally built unsigned artifact. Upstream
        # signatures have already been checked explicitly above.
        rpm.addMacro("_pkgverify_level", "digest")
        return super().do_transaction(*args, **kwargs)


imgcreate.creator.DnfLiveCD = VerifiedDnf
kickstart = imgcreate.read_kickstart(str(build / "live.ks"))
class CybexImageCreator(imgcreate.LiveImageCreator):
    def _configure_bootloader(self, isodir):
        super()._configure_bootloader(isodir)
        brand_boot_menu(isodir, self._instroot)


creator = CybexImageCreator(
    kickstart, "CybexOS-Live-44", fslabel="CYBEXOS-LIVE-44", releasever="44",
    tmpdir=str(build / "tmp"), title="CybexOS", product="CybexOS",
)
compression = os.environ.get("CYBEXOS_IMAGE_COMPRESSION", "xz")
if compression not in ("xz", "zstd"):
    raise ValueError("Unsupported live image compression")
creator.compress_args = compression
logging.info("Live image compression: %s", compression)
try:
    creator.mount(cachedir=str(build / "cache"))
    shutil.copyfile(source / "dracut-live.conf", Path(creator._instroot) / "etc/dracut.conf.d/99-liveos.conf")
    creator.install()
    # Flatpak validates signed OSTree commits during preparation. Copy the
    # complete system installation, including runtimes, before SELinux relabel.
    flatpak_root = Path(creator._instroot) / "var/lib/flatpak"
    flatpak_root.mkdir(parents=True, exist_ok=True)
    subprocess.run(["cp", "-a", "--reflink=auto", "/var/lib/flatpak/.", str(flatpak_root)], check=True)
    vendor_policy = configparser.ConfigParser(interpolation=None)
    vendor_policy.read(build / "application-repositories.repo")
    # RPM Fusion release RPMs already own their repository definitions.
    for section in list(vendor_policy.sections()):
        if section.startswith("rpmfusion-"):
            vendor_policy.remove_section(section)
    for entry in vendor_policy.values():
        for key_url in entry.get("gpgkey", "").split():
            if not key_url.startswith("file:///etc/pki/rpm-gpg/"):
                raise RuntimeError(f"Vendor key is not a reviewed local key: {key_url}")
            key = Path(key_url.removeprefix("file://"))
            shutil.copy2(key, Path(creator._instroot) / "etc/pki/rpm-gpg" / key.name)
    with (Path(creator._instroot) / "etc/yum.repos.d/cybex-applications.repo").open("w") as output:
        vendor_policy.write(output)
    # imgcreate stages its initrd before Kickstart post scripts run. Select
    # the branded theme and rebuild now, while all installed kernels exist.
    subprocess.run(["chroot", creator._instroot, "plymouth-set-default-theme", "cybex"], check=True)
    subprocess.run(["chroot", creator._instroot, "dracut", "--regenerate-all", "--force"], check=True)
    creator.configure()
    applications = json.loads((build / "applications.json").read_text())
    subprocess.run(["rpm", "--root", creator._instroot, "-q", *applications["packages"]], check=True)
    installed_flatpaks = subprocess.check_output([
        "chroot", creator._instroot, "flatpak", "list", "--system", "--app", "--columns=application",
    ], text=True).splitlines()
    if not set(applications["flatpaks"]).issubset(installed_flatpaks):
        raise RuntimeError("Missing offline Flatpak applications")
    # linux-firmware alone does not pull in vendor GPU firmware when weak
    # dependencies are disabled. Fail before publishing an incomplete image.
    subprocess.run([
        "rpm", "--root", creator._instroot, "-q",
        "kernel-core", "kernel-modules-core", "kernel-modules", "kernel-modules-extra",
        "linux-firmware", "amd-gpu-firmware", "intel-gpu-firmware", "nvidia-gpu-firmware",
        "mesa-dri-drivers", "mesa-vulkan-drivers", "mesa-libEGL", "pciutils", "fastfetch",
    ], check=True)
    subprocess.run([
        "chroot", creator._instroot, "/usr/bin/bash", "-euc",
        "for tool in cybex fastfetch anaconda liveinst efibootmgr grubby grub2-mkconfig cryptsetup btrfs mkfs.vfat mkfs.ext4; "
        'do command -v "$tool" >/dev/null || exit 1; done',
    ], check=True)
    for relative in ("", "usr", "etc", "usr/libexec/cybexos-live-setup"):
        metadata = (Path(creator._instroot) / relative).stat()
        if metadata.st_uid != 0 or metadata.st_gid != 0 or metadata.st_mode & 0o022:
            raise RuntimeError(f"Unsafe image ownership or permissions: /{relative}")
    with Path("/home/builder/artifacts/packages.txt").open("w") as manifest:
        subprocess.run(["rpm", "--root", creator._instroot, "-qa", "--qf", "%{NEVRA}\n"],
                       check=True, stdout=manifest)
    creator.unmount()
    creator.package()
except BaseException as error:
    # Exceptions in DNF retain locals (and file handles) through chained
    # tracebacks. Release those frames before livecd-tools unmounts its root.
    chained = error
    while chained is not None:
        traceback.clear_frames(chained.__traceback__)
        chained = chained.__context__
    raise
finally:
    # livecd-tools skips Base.close() when dependency resolution raises. Close
    # those handles before unmounting, so a failed build can clean its mounts.
    for instance in dnf_instances:
        instance.close()
    gc.collect()
    creator.cleanup()
