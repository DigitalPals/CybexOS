    def test_every_package_task_is_in_the_image_or_deliberately_excluded(self):
        # Tasks whose packages reach the image through package_names() by
        # variable, by an explicit name, or as dependencies of those.
        by_contract = {
            ("roles/apps/tasks/packages.yml", "Install the required Fedora and RPM Fusion application packages"),
            ("roles/apps/tasks/packages.yml", "Install the Tailscale package when selected"),
            ("roles/apps/tasks/omawrite.yml", "Install Omawrite build and runtime dependencies"),
            ("roles/apps/tasks/rpmfusion.yml", "Enable RPM Fusion free repository"),
            ("roles/apps/tasks/rpmfusion.yml", "Enable RPM Fusion nonfree repository"),
            ("roles/base/tasks/packages.yml", "Install Fedora baseline packages"),
            ("roles/base/tasks/system-packages.yml", "Install the shared ISO system and desktop package baseline"),
            # Pulled in by plymouth-plugin-script and the live kickstart.
            ("roles/boot/tasks/main.yml", "Install Fedora BGRT and selected Plymouth theme support"),
        }
        excluded = {
            # The first-boot hardware setup applies these on matching models.
            ("roles/xps-2026/tasks/camera.yml", "Install Fedora-native camera runtime and build dependencies"),
            ("roles/xps-2026/tasks/camera.yml", "Install the locally built, RPM-managed IPU7 userspace and DKMS sources"),
            ("roles/xps-2026/tasks/camera.yml", "Reinstall the verified prior camera RPM after a failed refresh"),
            ("roles/xps-2026/tasks/power.yml", "Install XPS 2026 thermal and low-power-mode services"),
            # The NVIDIA driver is built for the installed kernel after boot,
            # only on detected NVIDIA hardware; it is never bundled.
            ("roles/nvidia/tasks/setup.yml", "Install the Fedora akmods and Secure Boot key tools"),
            ("roles/nvidia/tasks/setup.yml", "Install kernel headers for the running kernel when still available"),
            ("roles/nvidia/tasks/setup.yml", "Install the NVIDIA driver, CUDA libraries and VA-API driver"),
        }
        included = {(path, name) for path, names in applications.PACKAGE_TASKS for name in names}

        def install_tasks(tasks):
            for task in tasks or []:
                for key in ("block", "rescue", "always"):
                    yield from install_tasks(task.get(key))
                dnf = task.get("ansible.builtin.dnf") or task.get("dnf")
                if dnf and dnf.get("name") and dnf.get("state", "present") in ("present", "latest"):
                    yield task["name"]

        found = {(str(path.relative_to(ROOT.parent)), name)
                 for path in sorted((ROOT.parent / "roles").glob("*/tasks/*.yml"))
                 for name in install_tasks(yaml.safe_load(path.read_text()))}
        self.assertEqual(found - included - by_contract - excluded, set(),
                         "Add new package tasks to image/applications PACKAGE_TASKS or exclude them here")
        self.assertEqual((included | by_contract | excluded) - found, set(), "Stale task names")

