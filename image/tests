class LiveFileOwnership(unittest.TestCase):
    def test_private_checkout_modes_do_not_leak_into_the_os(self):
        with tempfile.TemporaryDirectory() as temporary:
            base = Path(temporary)
            source, destination = base / "source", base / "root"
            (source / "usr/libexec").mkdir(parents=True)
            (source / "etc/anaconda").mkdir(parents=True)
            (source / "usr/libexec/live-setup").write_text("#!/bin/sh\n")
            (source / "etc/anaconda/alpha.conf").write_text("configuration\n")
            for path in [source, *source.rglob("*")]:
                path.chmod(0o700 if path.is_dir() else 0o600)
            destination.mkdir(mode=0o755)
            before = destination.stat()
            live_install.install_tree(source, destination)
            self.assertEqual(destination.stat().st_uid, before.st_uid)
            self.assertEqual(destination.stat().st_mode, before.st_mode)
            self.assertEqual((destination / "usr/libexec").stat().st_mode & 0o777, 0o755)
            self.assertEqual((destination / "usr/libexec/live-setup").stat().st_mode & 0o777, 0o755)
            self.assertEqual((destination / "etc/anaconda/alpha.conf").stat().st_mode & 0o777, 0o644)


class AccountIsolation(unittest.TestCase):
    def test_new_accounts_get_shared_runtime_and_separate_settings(self):
        with tempfile.TemporaryDirectory() as temporary, patch.dict(os.environ, {}, clear=True):
            base = Path(temporary)
            vendor = base / "vendor"
            (vendor / "bin").mkdir(parents=True)
            (vendor / "bin/tool").write_text("version one")
            (vendor / "runtime").mkdir()
            for name in ("alice", "bob"):
                home = base / name
                user_init.initialize(home, vendor)
                self.assertEqual((home / ".local/share/cybexos/runtime").resolve(), vendor / "runtime")
                self.assertTrue((home / ".config/cybexos/hypr").is_dir())
            settings = base / "alice/.config/cybexos/shell.json"
            settings.write_text('{"themeMode":"light","futureSetting":42}')
            personal_tool = base / "alice/.local/bin/tool"
            personal_tool.unlink()
            personal_tool.write_text("personal tool")
            (vendor / "bin/tool").write_text("version two")
            user_init.initialize(base / "alice", vendor)
            self.assertEqual(personal_tool.read_text(), "personal tool")
            self.assertEqual(settings.read_text(), '{"themeMode":"light","futureSetting":42}')
            self.assertEqual((base / "bob/.local/bin/tool").read_text(), "version two")
            self.assertFalse((base / "bob/.config/cybexos/shell.json").exists())

    def test_existing_runtime_and_dangling_links_are_preserved(self):
        with tempfile.TemporaryDirectory() as temporary, patch.dict(os.environ, {}, clear=True):
            base = Path(temporary)
            vendor = base / "vendor"
            (vendor / "bin").mkdir(parents=True)
            (vendor / "bin/tool").write_text("vendor")
            home = base / "user"
            runtime = home / ".local/share/cybexos/runtime"
            runtime.mkdir(parents=True)
            (runtime / "sentinel").write_text("keep")
            (home / ".local/bin").mkdir(parents=True)
            (home / ".local/bin/tool").symlink_to(base / "missing-personal-target")
            user_init.initialize(home, vendor)
            self.assertFalse(runtime.is_symlink())
            self.assertEqual((runtime / "sentinel").read_text(), "keep")
            self.assertEqual(os.readlink(home / ".local/bin/tool"), str(base / "missing-personal-target"))


class WelcomeTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
        cls.module = load("welcome_app", ROOT / "rootfs/usr/bin/cybexos-welcome")
        cls.app = cls.module.QGuiApplication.instance() or cls.module.QGuiApplication([])

    def test_installed_system_cannot_launch_disk_installer(self):
        backend = self.module.Welcome()
        backend.live = False
        with patch.object(backend.process, "start") as start:
            backend.install()
            start.assert_not_called()

    def test_live_seed_volume_opens_the_installer_once(self):
        with tempfile.TemporaryDirectory() as temporary:
            labels = Path(temporary)
            backend = self.module.Welcome()
            backend.live = True
            with patch.object(backend, "install") as install:
                backend.seed_checks = 0
                backend.seed_timer = self.module.QTimer()
                backend.checkSeed(labels)
                install.assert_not_called()
                (labels / "CYBEXOS-SEED").write_text("")
                backend.checkSeed(labels)
                install.assert_called_once_with()
                self.assertFalse(backend.seed_timer.isActive())
            self.assertTrue(self.module.seed_volume_present(labels))
            (labels / "CYBEXOS-SEED").unlink()
            (labels / "cidata").write_text("")
            self.assertTrue(self.module.seed_volume_present(labels))
            backend = self.module.Welcome()
            backend.live = False
            with patch.object(backend, "refreshSetup"), patch.object(backend, "install") as install:
                backend.startSetup()
                backend.stopSetup()
                install.assert_not_called()

    def test_missing_installer_is_visible_and_does_not_run_a_shell(self):
        backend = self.module.Welcome()
        backend.live = True
        with patch.object(Path, "is_file", return_value=False), patch.object(backend.process, "start") as start:
            backend.install()
            start.assert_not_called()
            self.assertIn("installer is missing", backend.status)

    def backend(self, live=False):
        backend = self.module.Welcome()
        backend.live = live
        # Never reach the shell of the machine running the tests.
        backend.runtime = Path("/nonexistent/cybexos-runtime")
        return backend

    def test_qml_loads_for_live_and_installed_modes(self):
        self.assertEqual(self.module.QML, ROOT / "rootfs/usr/share/cybexos/welcome/Main.qml",
                         "the window is found beside the program, installed or in a checkout")
        self.assertTrue((self.module.QML.parent / "cybex-wordmark.svg").is_file())
        for live in (True, False):
            backend = self.backend(live)
            engine = self.module.QQmlApplicationEngine()
            warnings = []
            engine.warnings.connect(lambda found: warnings.extend(w.toString() for w in found))
            engine.rootContext().setContextProperty("welcome", backend)
            engine.load(self.module.QUrl.fromLocalFile(str(self.module.QML)))
            self.assertTrue(engine.rootObjects(), f"welcome failed to load in live={live}")
            self.assertEqual(warnings, [], f"QML warnings in live={live}")
            window = engine.rootObjects()[0]
            window.close()
            del window
            del engine

    def test_install_mode_opens_the_installer_and_keeps_its_window(self):
        backend = self.backend(live=True)
        backend.install_mode = True
        engine = self.module.QQmlApplicationEngine()
        warnings = []
        engine.warnings.connect(lambda found: warnings.extend(w.toString() for w in found))
        engine.rootContext().setContextProperty("welcome", backend)
        with patch.object(Path, "is_file", return_value=True), patch.object(backend.process, "start") as start:
            engine.load(self.module.QUrl.fromLocalFile(str(self.module.QML)))
            start.assert_called_once_with("/usr/bin/liveinst", ["--nosave=all_ks"])
        self.assertEqual(warnings, [])
        window = engine.rootObjects()[0]
        # There is no desktop behind this window: closing it is refused.
        window.close()
        self.assertTrue(window.property("visible"))
        del window
        del engine

    def test_install_mode_needs_the_live_image_and_guards_its_actions(self):
        self.assertFalse(self.module.Welcome(install_mode=True).install_mode and not Path("/run/cybexos-live").exists())
        for install_mode in (False, True):
            backend = self.backend(live=True)
            backend.install_mode = install_mode
            with patch.object(self.module.QProcess, "startDetached", return_value=(True, 0)) as start, \
                    patch.object(self.module.QGuiApplication, "quit") as quit:
                backend.power("halt")
                backend.power("reboot")
                backend.startDesktop()
            if install_mode:
                self.assertEqual(start.call_args_list, [
                    unittest.mock.call("systemctl", ["reboot"]),
                    unittest.mock.call("systemctl", ["--user", "start", "--no-block", "hyprland-session.target"])])
                quit.assert_called_once_with()
            else:
                start.assert_not_called()
                quit.assert_not_called()

    def test_closing_an_installed_welcome_records_completion(self):
        with tempfile.TemporaryDirectory() as temporary:
            for live, expected in ((True, False), (False, True)):
                backend = self.backend(live)
                backend.marker = Path(temporary) / str(live) / "welcome-complete"
                backend.markComplete()
                self.assertEqual(backend.marker.exists(), expected, f"live={live}")

    def test_buttons_reach_only_known_shell_calls(self):
        self.assertEqual(self.module.Welcome.SHELL_PAGES, {
            "appearance": ["settings", "open", "appearance"],
            "wallpaper": ["wallpaper", "browse"],
            "network": ["settings", "open", "network"],
        })
        backend = self.backend()
        with patch.object(self.module.QProcess, "startDetached", return_value=(True, 0)) as start:
            backend.openSettings("shortcuts")
            start.assert_not_called()
            backend.openSettings("wallpaper")
            start.assert_called_once_with(str(backend.runtime), ["ipc", "wallpaper", "browse"])


class WelcomeWallpaperTests(unittest.TestCase):
    """The wallpaper row against a scripted shell: `calls` records each IPC
    call, and `answer` settles the oldest one."""

    @classmethod
    def setUpClass(cls):
        os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
        cls.module = load("welcome_app", ROOT / "rootfs/usr/bin/cybexos-welcome")
        cls.app = cls.module.QGuiApplication.instance() or cls.module.QGuiApplication([])

    def setUp(self):
        self.backend = self.module.Welcome()
        self.backend.live = False
        self.calls = []
        self.backend.call = lambda arguments, done: self.calls.append((arguments, done))
        self.row_changes = 0
        self.backend.wallpapersChanged.connect(self.count_row_change)

    def tearDown(self):
        self.backend.poll_timer.stop()
        self.backend.retry_timer.stop()

    def count_row_change(self):
        self.row_changes += 1

    def answer(self, ok, output=""):
        arguments, done = self.calls.pop(0)
        done(ok, output if isinstance(output, str) else json.dumps(output))
        return arguments

    @staticmethod
    def item(identifier, **extra):
        return {"id": identifier, "thumb": f"https://th.wallhaven.cc/lg/{identifier[:2]}/{identifier}.jpg",
                "fileName": f"wallhaven-{identifier}.jpg", "width": 3840, "height": 2160, **extra}

    def results(self, items, **state):
        return {"busy": False, "searched": True, "error": "", "items": items,
                "downloading": "", "progress": 0, "downloadError": "", "current": "", **state}

    def test_popular_results_fill_a_row_that_polling_does_not_rebuild(self):
        self.backend.loadWallpapers()
        self.assertEqual(self.answer(True), ["wallpaper", "popular"])
        self.assertEqual(self.answer(True, self.results([], busy=True, searched=False)),
                         ["wallpaper", "results"])
        self.assertEqual(self.backend.wallpaperSource, "loading")
        self.assertTrue(self.backend.poll_timer.isActive(), "a running search is polled")

        self.backend.poll_timer.stop()
        self.backend.poll_results()
        listing = [self.item("qroy2d"), self.item("rdwjj7"),
                   {"id": "evil", "thumb": "https://evil.example/x.jpg", "fileName": "x.jpg"}]
        self.answer(True, self.results(listing, current="wallhaven-rdwjj7.jpg"))
        self.assertEqual(self.backend.wallpaperSource, "online")
        self.assertEqual([entry["key"] for entry in self.backend.wallpapers], ["qroy2d", "rdwjj7"],
                         "only Wallhaven thumbnails are shown")
        self.assertEqual(self.backend.currentFile, "wallhaven-rdwjj7.jpg")
        self.assertFalse(self.backend.poll_timer.isActive(), "a settled listing is not polled")

        self.backend.pickWallpaper("qroy2d")
        self.assertEqual(self.answer(True, "ok"), ["wallpaper", "pick", "qroy2d"])
        self.assertEqual(self.backend.downloadingKey, "qroy2d")
        self.answer(True, self.results(listing, downloading="qroy2d", progress=40))
        self.assertEqual(self.backend.downloadProgress, 40)
        self.assertTrue(self.backend.poll_timer.isActive(), "a download is polled")
        self.backend.poll_timer.stop()
        self.backend.poll_results()
        self.answer(True, self.results(listing, current="wallhaven-qroy2d.jpg"))
        self.assertEqual(self.backend.currentFile, "wallhaven-qroy2d.jpg")
        self.assertEqual(self.backend.downloadingKey, "")
        self.assertEqual(self.row_changes, 1, "progress and picks never rebuild the row")

