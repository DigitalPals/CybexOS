    def test_kickstart_leaves_docker_on_demand_and_resolves_local_names(self):
        source = (ROOT / "live.ks").read_text()
        services = next(line for line in source.splitlines() if line.startswith("services "))
        enabled = services.split("--enabled=", 1)[1].split()[0].split(",")
        self.assertNotIn("docker", enabled)
        self.assertIn("NetworkManager", enabled)
        authselect = next(line for line in source.splitlines() if line.startswith("authselect "))
        self.assertIn("with-mdns4", authselect.split())
        # The live image and its installations offer fingerprints like the
        # workstation's authentication tasks; never a profile-wide u2f feature,
        # which would also reach SDDM's password-auth (docs/security.md).
        self.assertIn("with-fingerprint", authselect.split())
        self.assertFalse(any(word.startswith("with-pam-u2f") for word in authselect.split()))

    def test_offline_seed_is_portable_and_preserves_user_files(self):
        with tempfile.TemporaryDirectory() as temporary, patch.dict(os.environ, {}, clear=True):
            root = Path(temporary)
            vendor = root / "vendor"
            (vendor / "bin").mkdir(parents=True)
            seed = vendor / "user-seed"
            (seed / ".local/bin").mkdir(parents=True)
            (seed / "tools").mkdir()
            binary = seed / "tools/app"
            binary.write_text("offline executable")
            binary.chmod(0o755)
            (seed / ".local/bin/app").symlink_to("../../tools/app")
            for name in ("alice", "bob"):
                home = root / name
                user_init.initialize(home, vendor)
                self.assertEqual((home / ".local/bin/app").read_text(), "offline executable")
                self.assertEqual((home / "tools/app").stat().st_mode & 0o777, 0o755)
                self.assertTrue((home / ".local/bin/cybex").is_symlink())
            personal = root / "alice/tools/app"
            personal.write_text("personal version")
            user_init.initialize(root / "alice", vendor)
            self.assertEqual(personal.read_text(), "personal version")
            self.assertEqual((root / "bob/tools/app").read_text(), "offline executable")
            self.assertEqual(binary.read_text(), "offline executable")

