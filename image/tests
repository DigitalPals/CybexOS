    def test_calls_run_the_runtime_helper_without_blocking(self):
        from PySide6.QtCore import QEventLoop
        backend = self.module.Welcome()
        with tempfile.TemporaryDirectory() as temporary:
            helper = Path(temporary) / "cybexos-runtime"
            helper.write_text('#!/bin/sh\nprintf \'%s\\n\' "$*"\n')
            helper.chmod(0o755)
            backend.runtime = helper
            loop = QEventLoop()
            answers = []
            backend.call(["wallpaper", "list"], lambda ok, output: (answers.append((ok, output)), loop.quit()))
            self.module.QTimer.singleShot(5000, loop.quit)
            loop.exec()
            self.assertEqual(answers, [(True, "ipc wallpaper list")])

            backend.runtime = Path(temporary) / "missing"
            backend.call(["wallpaper", "list"], lambda ok, output: (answers.append((ok, output)), loop.quit()))
            self.module.QTimer.singleShot(5000, loop.quit)
            loop.exec()
            self.assertEqual(answers[-1], (False, ""), "a helper that cannot start still answers")


