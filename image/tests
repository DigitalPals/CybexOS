#!/usr/bin/env python3
"""Behavioral checks for image account isolation and the welcome window."""
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import tempfile
import unittest
from unittest.mock import patch

from application_payload import relativize_seed_links, include_applications

ROOT = Path(__file__).resolve().parent


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


user_init = load("user_init", ROOT / "rootfs/usr/libexec/cybexos-user-init")
live_install = load("live_install", ROOT / "install-live-rootfs")
applications = load("applications", ROOT / "applications")


class OfflineApplications(unittest.TestCase):
    def test_vendor_repository_policy_includes_brave_origin_source(self):
        with tempfile.TemporaryDirectory() as temporary:
            policies = applications.application_repositories(Path(temporary))
        self.assertIn("brave-origin", applications.package_names()[0])
        self.assertIn("brave-browser", policies.sections())
        self.assertTrue(policies["brave-browser"].getboolean("gpgcheck"))
        self.assertIn("brave-browser-rpm-release", policies["brave-browser"]["baseurl"])

    def test_missing_vendor_repository_policy_fails_before_compose(self):
        with tempfile.TemporaryDirectory() as temporary:
            with patch.object(applications, "ROOT", Path(temporary)):
                with self.assertRaises(FileNotFoundError):
                    applications.application_repositories(Path(temporary))

    def test_compose_selects_every_app_including_steam_multilib(self):
        packages, _ = applications.package_names()
        source = (ROOT / "live.ks").read_text()
        result = include_applications(source, packages)
        package_section = result.split("%packages", 1)[1].split("%end", 1)[0].splitlines()
        self.assertTrue(set(packages).issubset(package_section))
        self.assertIn("mesa-dri-drivers.i686", package_section)
        self.assertIn("vulkan-loader.i686", package_section)
        self.assertEqual(source.split("%post", 1)[1], result.split("%post", 1)[1])

    def test_native_and_editor_links_relocate_to_each_users_home(self):
        with tempfile.TemporaryDirectory() as temporary:
            seed = Path(temporary)
            original = Path("/home/disposable-seed")
            (seed / "bin").mkdir()
            (seed / "tools").mkdir()
            (seed / "tools/app").write_text("offline")
            (seed / "bin/app").symlink_to(original / "tools/app")
            (seed / "bin/system").symlink_to("/usr/bin/python3")
            relativize_seed_links(seed, original)
            self.assertEqual(os.readlink(seed / "bin/app"), "../tools/app")
            self.assertEqual((seed / "bin/app").read_text(), "offline")
            self.assertEqual(os.readlink(seed / "bin/system"), "/usr/bin/python3")

    def test_package_contract_contains_all_application_groups(self):
        packages, flatpaks = applications.package_names()
        for package in ("fastfetch", "pinta", "glow", "duf", "steam", "podman", "moby-engine",
                        "brave-origin", "1password", "chatgpt", "tailscale", "java-25-openjdk-devel"):
            self.assertIn(package, packages)
        self.assertIn("org.localsend.localsend_app", flatpaks)
        self.assertIn("com.spotify.Client", flatpaks)
        self.assertIn("net.davidotek.pupgui2", flatpaks)

    def test_offline_seed_is_portable_and_preserves_user_files(self):
        with tempfile.TemporaryDirectory() as temporary, patch.dict(os.environ, {}, clear=True):
            root = Path(temporary)
            vendor = root / "vendor"
            (vendor / "bin").mkdir(parents=True)
            seed = vendor / "user-seed"
            (seed / ".local/bin").mkdir(parents=True)
            (seed / "tools").mkdir()
            binary = seed / "tools/app"
            binary.write_text("offline executable")
            binary.chmod(0o755)
            (seed / ".local/bin/app").symlink_to("../../tools/app")
            for name in ("alice", "bob"):
                home = root / name
                user_init.initialize(home, vendor)
                self.assertEqual((home / ".local/bin/app").read_text(), "offline executable")
                self.assertEqual((home / "tools/app").stat().st_mode & 0o777, 0o755)
                self.assertTrue((home / ".local/bin/cybex").is_symlink())
            personal = root / "alice/tools/app"
            personal.write_text("personal version")
            user_init.initialize(root / "alice", vendor)
            self.assertEqual(personal.read_text(), "personal version")
            self.assertEqual((root / "bob/tools/app").read_text(), "offline executable")
            self.assertEqual(binary.read_text(), "offline executable")

    def test_seed_never_follows_existing_directory_symlinks(self):
        with tempfile.TemporaryDirectory() as temporary:
            root = Path(temporary)
            source = root / "source"
            (source / "tools").mkdir(parents=True)
            (source / "tools/app").write_text("vendor")
            destination = root / "home"
            destination.mkdir()
            external = root / "external"
            external.mkdir()
            (external / "app").write_text("personal")
            (destination / "tools").symlink_to(external)
            user_init.seed_applications(source, destination)
            self.assertEqual((external / "app").read_text(), "personal")


class LiveFileOwnership(unittest.TestCase):
    def test_private_checkout_modes_do_not_leak_into_the_os(self):
        with tempfile.TemporaryDirectory() as temporary:
            base = Path(temporary)
            source, destination = base / "source", base / "root"
            (source / "usr/libexec").mkdir(parents=True)
            (source / "etc/anaconda").mkdir(parents=True)
            (source / "usr/libexec/live-setup").write_text("#!/bin/sh\n")
            (source / "etc/anaconda/alpha.conf").write_text("configuration\n")
            for path in [source, *source.rglob("*")]:
                path.chmod(0o700 if path.is_dir() else 0o600)
            destination.mkdir(mode=0o755)
            before = destination.stat()
            live_install.install_tree(source, destination)
            self.assertEqual(destination.stat().st_uid, before.st_uid)
            self.assertEqual(destination.stat().st_mode, before.st_mode)
            self.assertEqual((destination / "usr/libexec").stat().st_mode & 0o777, 0o755)
            self.assertEqual((destination / "usr/libexec/live-setup").stat().st_mode & 0o777, 0o755)
            self.assertEqual((destination / "etc/anaconda/alpha.conf").stat().st_mode & 0o777, 0o644)


class AccountIsolation(unittest.TestCase):
    def test_new_accounts_get_shared_runtime_and_separate_settings(self):
        with tempfile.TemporaryDirectory() as temporary, patch.dict(os.environ, {}, clear=True):
            base = Path(temporary)
            vendor = base / "vendor"
            (vendor / "bin").mkdir(parents=True)
            (vendor / "bin/tool").write_text("version one")
            (vendor / "runtime").mkdir()
            for name in ("alice", "bob"):
                home = base / name
                user_init.initialize(home, vendor)
                self.assertEqual((home / ".local/share/cybexos/runtime").resolve(), vendor / "runtime")
                self.assertTrue((home / ".config/cybexos/hypr").is_dir())
            settings = base / "alice/.config/cybexos/shell.json"
            settings.write_text('{"themeMode":"light","futureSetting":42}')
            personal_tool = base / "alice/.local/bin/tool"
            personal_tool.unlink()
            personal_tool.write_text("personal tool")
            (vendor / "bin/tool").write_text("version two")
            user_init.initialize(base / "alice", vendor)
            self.assertEqual(personal_tool.read_text(), "personal tool")
            self.assertEqual(settings.read_text(), '{"themeMode":"light","futureSetting":42}')
            self.assertEqual((base / "bob/.local/bin/tool").read_text(), "version two")
            self.assertFalse((base / "bob/.config/cybexos/shell.json").exists())

    def test_existing_runtime_and_dangling_links_are_preserved(self):
        with tempfile.TemporaryDirectory() as temporary, patch.dict(os.environ, {}, clear=True):
            base = Path(temporary)
            vendor = base / "vendor"
            (vendor / "bin").mkdir(parents=True)
            (vendor / "bin/tool").write_text("vendor")
            home = base / "user"
            runtime = home / ".local/share/cybexos/runtime"
            runtime.mkdir(parents=True)
            (runtime / "sentinel").write_text("keep")
            (home / ".local/bin").mkdir(parents=True)
            (home / ".local/bin/tool").symlink_to(base / "missing-personal-target")
            user_init.initialize(home, vendor)
            self.assertFalse(runtime.is_symlink())
            self.assertEqual((runtime / "sentinel").read_text(), "keep")
            self.assertEqual(os.readlink(home / ".local/bin/tool"), str(base / "missing-personal-target"))


class WelcomeTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
        cls.module = load("welcome_app", ROOT / "rootfs/usr/bin/cybexos-welcome")
        cls.app = cls.module.QGuiApplication.instance() or cls.module.QGuiApplication([])

    def test_installed_system_cannot_launch_disk_installer(self):
        backend = self.module.Welcome()
        backend.live = False
        with patch.object(backend.process, "start") as start:
            backend.install()
            start.assert_not_called()

    def test_missing_installer_is_visible_and_does_not_run_a_shell(self):
        backend = self.module.Welcome()
        backend.live = True
        with patch.object(Path, "is_file", return_value=False), patch.object(backend.process, "start") as start:
            backend.install()
            start.assert_not_called()
            self.assertIn("installer is missing", backend.status)

    def test_qml_loads_for_live_and_installed_modes(self):
        for live in (True, False):
            backend = self.module.Welcome()
            backend.live = live
            engine = self.module.QQmlApplicationEngine()
            engine.rootContext().setContextProperty("welcome", backend)
            engine.load(self.module.QUrl.fromLocalFile(str(ROOT / "rootfs/usr/share/cybexos/welcome/Main.qml")))
            self.assertTrue(engine.rootObjects(), f"welcome failed to load in live={live}")
            window = engine.rootObjects()[0]
            window.close()
            del window
            del engine


if __name__ == "__main__":
    unittest.main()
