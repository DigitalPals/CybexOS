#!/usr/bin/env python3
"""Explicit live ISO smoke test. No build, installation or PXE publication."""
import argparse
from pathlib import Path
import signal
import time

from build_support import atomic_json, digest
from vm_testing import TestVM, require_test_iso, run


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('iso', type=Path)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--firmware', choices=('bios', 'uefi'), default='uefi')
    parser.add_argument('--boot-wait', type=int, default=300, help='Bounded readiness timeout, not a fixed startup sleep')
    parser.add_argument('--hold', action='store_true')
    parser.add_argument('--keep-artifacts', action='store_true', help='Retain task-owned disk/logs for unresolved diagnostics')
    parser.add_argument('--execute-vm', action='store_true', help='Required opt-in to starting a VM')
    args = parser.parse_args()
    if not args.execute_vm:
        parser.error('VM execution requires --execute-vm')
    iso = require_test_iso(args.iso)
    vm = TestVM(args.output, args.firmware)
    report = {'iso_sha256': digest(iso), 'firmware': args.firmware, 'status': 'failed'}
    try:
        vm.prepare()
        vm.start(iso)
        vm.wait_ssh(args.boot_wait)
        vm.audit()
        run([*vm.ssh, 'test -f /run/cybexos-live && test -x /usr/bin/liveinst && XDG_RUNTIME_DIR=/run/user/$(id -u) systemctl --user is-active cybexos-welcome.service'])
        report['status'] = 'passed'
        report['checks'] = ['live-boot', 'offline-applications', 'quickshell']
        print('Live desktop smoke check passed. No installation was performed.', flush=True)
        if args.hold:
            print(f"VM ready for interaction: {args.output / 'vm.json'}", flush=True)
            while vm.process.poll() is None:
                time.sleep(1)
    finally:
        if vm.owned:
            try:
                vm.cleanup(args.keep_artifacts)
            except BaseException:
                report['status'] = 'failed'
                raise
            finally:
                atomic_json(args.output / 'live-report.json', report)


if __name__ == '__main__':
    def interrupt(_signum, _frame):
        raise KeyboardInterrupt
    for name in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(name, interrupt)
    main()
