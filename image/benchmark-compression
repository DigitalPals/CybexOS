#!/usr/bin/env python3
"""Compare xz and zstd on identical SquashFS inputs; retain only measurements.

For a live ISO, extract its SquashFS first and pass the directory containing
LiveOS/rootfs.img. Directory workloads are also supported. Extraction timing
is a storage benchmark, not a boot or graphical installation qualification.
"""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import tempfile
import time


def identity(root):
    digest = hashlib.sha256()
    size = files = 0
    for path in sorted(root.rglob('*')):
        relative = path.relative_to(root).as_posix()
        if path.is_symlink():
            value = 'link:' + str(path.readlink())
        elif path.is_file():
            with path.open('rb') as stream:
                value = hashlib.file_digest(stream, 'sha256').hexdigest()
            size += path.stat().st_size
            files += 1
        else:
            continue
        digest.update(json.dumps([relative, value], separators=(',', ':')).encode())
    return {'sha256': digest.hexdigest(), 'bytes': size, 'files': files}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('source', type=Path)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--processors', type=int, default=8)
    parser.add_argument('--runs', type=int, default=3)
    args = parser.parse_args()
    source, output = args.source.resolve(strict=True), args.output.absolute()
    if not source.is_dir() or output.exists() or output.is_relative_to(source):
        parser.error('Use an existing source directory and a new output directory outside it')
    if not 1 <= args.processors <= 256 or not 1 <= args.runs <= 10:
        parser.error('processors must be 1–256 and runs 1–10')
    output.mkdir(parents=True, mode=0o700)
    report = {'source': identity(source), 'processors': args.processors, 'measurements': [],
              'scope': 'SquashFS compression and extraction; not boot or installation time', 'status': 'running'}
    try:
        with tempfile.TemporaryDirectory(prefix='compression-', dir=output) as directory:
            work = Path(directory)
            for attempt in range(args.runs):
                # Alternate order to reduce systematic warm-cache bias.
                for compression in (('xz', 'zstd') if attempt % 2 == 0 else ('zstd', 'xz')):
                    image = work / f'{compression}.squashfs'
                    extracted = work / f'{compression}-root'
                    row = {'compression': compression, 'run': attempt + 1}
                    with (output / f'{compression}-{attempt + 1}.log').open('w') as log:
                        start = time.monotonic()
                        subprocess.run(['mksquashfs', str(source), str(image), '-comp', compression,
                                        '-processors', str(args.processors), '-noappend', '-no-progress'],
                                       stdout=log, stderr=subprocess.STDOUT, check=True)
                        row.update(compress_seconds=time.monotonic() - start, bytes=image.stat().st_size)
                        start = time.monotonic()
                        subprocess.run(['unsquashfs', '-no-progress', '-processors', str(args.processors),
                                        '-d', str(extracted), str(image)], stdout=log, stderr=subprocess.STDOUT, check=True)
                        row['extract_seconds'] = time.monotonic() - start
                    if identity(extracted) != report['source']:
                        raise RuntimeError('Extracted data differs from the source')
                    shutil.rmtree(extracted)
                    image.unlink()
                    report['measurements'].append(row)
                    print(json.dumps(row), flush=True)
            if identity(source) != report['source']:
                raise RuntimeError('Source changed during the comparison')
        report['status'] = 'passed'
    except BaseException as error:
        report.update(status='failed', error=str(error) or type(error).__name__)
        raise
    finally:
        (output / 'measurements.json').write_text(json.dumps(report, indent=2) + '\n')


if __name__ == '__main__':
    main()
