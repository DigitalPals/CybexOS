#!/usr/bin/env python3
"""Apply the same baseline/account/hardware tasks used by checkout installs."""
import argparse
import fcntl
import grp
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import pwd
import signal
import subprocess
import sys
import time
import uuid


PROVISION = Path('/usr/share/cybexos/provision')
CONFIG_TOOL = Path('/usr/libexec/cybexos-config')
LOGIN_PREPARE = Path('/usr/libexec/cybexos-login-prepare')
LOGIN = Path('/etc/cybexos/login.json')


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# A fixed unit also fences an orphaned workload after its caller is killed.
# setsid/double-fork do not escape a systemd cgroup; process groups do.
WORK_UNIT = 'cybexos-provision-work.service'
WORK_CGROUP = Path('/sys/fs/cgroup/system.slice') / WORK_UNIT


def populated():
    try:
        return 'populated 1' in (WORK_CGROUP / 'cgroup.events').read_text().splitlines()
    except FileNotFoundError:
        return False


def require_manager():
    if not Path('/sys/fs/cgroup/cgroup.controllers').is_file():
        raise RuntimeError('Live provisioning requires the systemd cgroup v2 manager')
    subprocess.run(['/usr/bin/systemctl', 'show', '--property=Version', '--value'],
                   check=True, stdout=subprocess.DEVNULL, timeout=30)


def drain_workload():
    """Keep the provisioning lock until the entire previous workload is gone."""
    require_manager()
    try:
        subprocess.run(['/usr/bin/systemctl', 'stop', WORK_UNIT], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    except subprocess.TimeoutExpired:
        pass
    warned = False
    while populated():
        # cgroup.kill includes sub-cgroups and detached descendants atomically.
        # An unkillable kernel task must fence further provisioning/recovery,
        # rather than releasing serialization on an unverified timeout.
        try:
            (WORK_CGROUP / 'cgroup.kill').write_text('1\n')
        except FileNotFoundError:
            continue
        if not warned:
            print('Waiting for the provisioning cgroup to become empty; serialization remains held',
                  file=sys.stderr, flush=True)
            warned = True
        time.sleep(0.1)
    subprocess.run(['/usr/bin/systemctl', 'reset-failed', WORK_UNIT], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)


def drain():
    # Cancellation cannot unwind the lock's context before teardown finishes.
    blocked = {signal.SIGTERM, signal.SIGHUP, signal.SIGINT}
    previous = signal.pthread_sigmask(signal.SIG_BLOCK, blocked)
    try:
        drain_workload()
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous)


def provision_output(identifier, cursor=None):
    """Read a bounded journal batch for this launch, including after collection."""
    command = ['/usr/bin/journalctl', '--boot', '--no-pager', '--output=short-precise',
               '--show-cursor', '--lines=100', 'SYSLOG_IDENTIFIER=' + identifier]
    if cursor:
        command += ['--after-cursor=' + cursor]
    try:
        result = subprocess.run(command, check=True, capture_output=True, text=True, timeout=5)
        output = []
        for line in result.stdout.splitlines(keepends=True):
            if line.startswith('-- cursor: '):
                cursor = line.removeprefix('-- cursor: ').strip()
            else:
                output.append(line)
        # Bound caller output as well as the number of journal entries.
        text = ''.join(output)
        if len(text) > 32768:
            print('[Provisioning journal batch truncated to its last 32768 characters]', flush=True)
        if text:
            print(text[-32768:], end='' if text.endswith('\n') else '\n', flush=True)
    except (OSError, subprocess.SubprocessError) as error:
        # Diagnostic failure must never hide the worker's result or its drain.
        print(f'Provisioning journal unavailable ({identifier}): {error}', file=sys.stderr, flush=True)
    return cursor


def contained(command, *, env, cwd=None, timeout=600):
    # Called only while main owns provision.lock. Drain a preceding caller's
    # abandoned unit before launching anything or changing saved choices.
    drain()
    # Journal snapshots preserve service containment without forwarding caller
    # descriptors to PID 1. --wait still depends on the public manager bus.
    # A fresh identifier prevents the fixed unit's older launches leaking in.
    identifier = 'cybexos-provision-' + uuid.uuid4().hex
    launch = ['/usr/bin/systemd-run', '--system', '--quiet', '--wait', '--collect',
              '--unit=' + WORK_UNIT, '--service-type=exec',
              '--property=ExitType=cgroup', '--property=KillMode=control-group',
              '--property=StandardOutput=journal', '--property=StandardError=journal',
              '--property=SyslogIdentifier=' + identifier,
              '--property=TimeoutStopSec=15s', '--property=SendSIGKILL=yes',
              '--property=RuntimeMaxSec=' + str(timeout) + 's']
    if cwd:
        launch += ['--working-directory=' + str(cwd)]
    launch += ['--setenv=' + key + '=' + value for key, value in env.items()]
    launch += ['--', *command]
    cursor = None
    print(f'Provisioning in {WORK_UNIT} (limit {timeout}s); journal identifier: {identifier}', flush=True)
    try:
        # Poll finite journal snapshots, never an orphanable journal follower.
        # Kill the client on cancellation and let its context reap it. Only
        # drain() establishes that its service and detached descendants stopped.
        with subprocess.Popen(launch, env=env) as client:
            deadline = time.monotonic() + timeout + 60
            try:
                while True:
                    try:
                        result = client.wait(timeout=max(.01, min(15, deadline - time.monotonic())))
                    except subprocess.TimeoutExpired:
                        if time.monotonic() >= deadline:
                            raise subprocess.TimeoutExpired(launch, timeout + 60) from None
                        print(f'Provisioning still running in {WORK_UNIT}', flush=True)
                        cursor = provision_output(identifier, cursor)
                    else:
                        if result:
                            raise subprocess.CalledProcessError(result, launch)
                        break
            finally:
                if client.poll() is None:
                    client.kill()
    finally:
        # A timed-out systemd-run client is not proof that its unit stopped.
        try:
            drain()
        finally:
            provision_output(identifier, cursor)


def interrupted(signum, _frame):
    raise InterruptedError('Provisioning interrupted by signal ' + str(signum))


def encrypted_root():
    """Reuse the boot-time login check; anything unverifiable is unencrypted."""
    try:
        return load('cybexos_login_prepare', LOGIN_PREPARE).encrypted_root() is True
    except (OSError, ImportError, SyntaxError):
        return False


def save_config(settings, text, user):
    try:
        values = settings.parse(text)
    except ValueError as error:
        raise SystemExit(f'The configuration was not saved: {error}') from None
    if values['primary_user'] != user:
        raise SystemExit('The configuration was not saved: it belongs to another account.')
    if values['desktop_autologin'] and not encrypted_root():
        raise SystemExit('The configuration was not saved: automatic login requires a root '
                         'filesystem verified as encrypted.')
    settings.write(settings.render(values))


def record_login(settings):
    """Keep login intent in step with the saved choice, like the finalize role.

    cybexos-login-prepare still verifies root encryption on every boot.
    """
    if not settings.CONFIG.is_file():
        return
    try:
        values = settings.current()
    except ValueError as error:
        print(f'Login policy unchanged: {error}', file=sys.stderr)
        return
    policy = {'version': 1, 'user': values['primary_user'], 'autologin': values['desktop_autologin'], 'live': False}
    try:
        if json.loads(LOGIN.read_text()) == policy:
            return
    except (OSError, ValueError):
        pass
    settings.write(json.dumps(policy) + '\n', LOGIN)


def accounts(entries, selected=None):
    return [entry for entry in entries
            if 1000 <= entry.pw_uid < 65534 and entry.pw_name != 'liveuser'
            and Path(entry.pw_dir).parent == Path('/home')
            and (selected is None or entry.pw_name == selected)]


def configure(account, offline=False, hardware=False, reconcile=False, automatic=False, installer_target=False):
    # Do not inherit a user's callback plugins, Ansible configuration or Python
    # path into a root provisioning process. The payload contains reviewed roles.
    environment = {
        'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'HOME': '/root',
        'LANG': 'C.UTF-8', 'ANSIBLE_CONFIG': str(PROVISION / 'image/provision.cfg'),
        'ANSIBLE_ROLES_PATH': str(PROVISION / 'roles'),
        'ANSIBLE_STDOUT_CALLBACK': 'default', 'ANSIBLE_FORCE_HANDLERS': 'true',
        'ANSIBLE_PIPELINING': 'true', 'ANSIBLE_LOCALHOST_WARNING': 'false',
        'PYTHONDONTWRITEBYTECODE': '1',
    }
    values = {
        'primary_user': account.pw_name, 'primary_home': account.pw_dir,
        'primary_group': grp.getgrgid(account.pw_gid).gr_name,
        'config_repo': str(PROVISION), 'cybexos_offline': offline,
        'cybexos_hardware_only': hardware,
        # Boot-time setup renews a skipped Secure Boot key request only on
        # an explicit cybex repair --hardware.
        'cybexos_hardware_automatic': automatic,
        'cybexos_reconcile': reconcile,
        # Repair is not fresh consent for the selected account. In particular,
        # another account's saved Docker choice must not become its own.
        'cybexos_docker_direct_install': False,
        'start_optional_hardware_services': not offline,
    }
    # Seeding a later non-admin account must not promote it to wheel.
    wheel = grp.getgrnam('wheel')
    values['base_account_groups'] = ['video', 'input'] + (
        ['wheel'] if account.pw_name in wheel.gr_mem or account.pw_gid == wheel.gr_gid else [])
    command = ['/usr/bin/ansible-playbook', '-i', 'localhost,',
               str(PROVISION / 'image/provision.yml')]
    saved = Path('/etc/cybexos/config.yml')
    if saved.is_file():
        command += ['--extra-vars', '@' + str(saved)]
    command += ['--extra-vars', json.dumps(values)]
    if installer_target:
        # Only the explicit, verified Anaconda chroot has no target manager.
        subprocess.run(command, cwd=PROVISION, env=environment, check=True, timeout=2700)
    else:
        contained(command, cwd=PROVISION, env=environment, timeout=600 if reconcile else 2700)


def retire_legacy_fish(account):
    legacy = Path(account.pw_dir) / '.config/fish/conf.d/50-cybex.fish'
    vendor = Path('/usr/share/cybexos/essential-seed/.config/fish/conf.d/50-cybex.fish')
    # Operate as the owner, never as root through user-controlled directories.
    if vendor.is_file():
        subprocess.run(['runuser', '-u', account.pw_name, '--', 'python3', '-c',
                        'import pathlib,sys; p=pathlib.Path(sys.argv[1]); v=pathlib.Path(sys.argv[2]); '
                        'p.unlink() if p.is_file() and not p.is_symlink() and p.read_bytes()==v.read_bytes() else None',
                        str(legacy), str(vendor)], check=True)


def boot_id():
    return Path('/proc/sys/kernel/random/boot_id').read_text().strip()


def read_hardware_status(path):
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) and value.get('state') in ('pending', 'completed', 'failed', 'running') else {}
    except (OSError, ValueError):
        return {}


def write_hardware_status(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(value, sort_keys=True) + '\n')
    temporary.replace(path)


def merge_nvidia(state, reason, nvidia):
    """Fold the NVIDIA role's outcome into the hardware state.

    A restart (driver switch or Secure Boot key enrollment) is pending, so
    the next boot runs setup again and confirms the driver. A failed driver,
    or a key request the user skipped at boot, waits for cybex repair
    --hardware; the open-source driver keeps the desktop running meanwhile.
    """
    nvidia = nvidia if isinstance(nvidia, dict) else {}
    nvidia_state = nvidia.get('state', 'absent')
    detail = str(nvidia.get('reason', ''))
    needs_retry = nvidia_state == 'failed' or (nvidia_state == 'enroll' and nvidia.get('key') == 'skipped')
    if needs_retry and state != 'failed':
        return 'failed', detail or 'NVIDIA driver setup failed; run cybex repair --hardware', nvidia
    if nvidia_state in ('reboot', 'enroll') and state == 'completed':
        # Not "reboot": that word marks the camera transaction's restart.
        return 'pending', detail or 'restart required for the NVIDIA driver', nvidia
    return state, reason, nvidia


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--installer-target', action='store_true',
                        help='Provision the offline Anaconda target chroot without a target systemd')
    parser.add_argument('--drain', action='store_true', help='Wait for abandoned provisioning workers to stop')
    parser.add_argument('--offline', action='store_true')
    parser.add_argument('--hardware', action='store_true')
    parser.add_argument('--reconcile', action='store_true')
    parser.add_argument('--user')
    parser.add_argument('--automatic', action='store_true')
    parser.add_argument('--save-config', action='store_true',
                        help='Validate and save a configuration from standard input, then apply it')
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error('Run as root in the installed system')
    if sum((args.offline, args.hardware, args.reconcile)) > 1:
        parser.error('--offline, --hardware, and --reconcile are mutually exclusive')
    if args.automatic and not args.hardware:
        parser.error('--automatic is only valid for hardware setup')
    if args.save_config and (args.offline or args.hardware or args.reconcile or not args.user):
        parser.error('--save-config applies one account in the running installed system')
    if args.installer_target:
        if not args.offline or args.drain or subprocess.run(
                ['/usr/bin/systemd-detect-virt', '--chroot', '--quiet'], check=False).returncode != 0:
            parser.error('--installer-target requires --offline in a verified installer chroot')
    text = sys.stdin.read() if args.save_config else None
    lock_directory = Path('/run/lock/cybexos')
    lock_directory.mkdir(mode=0o755, exist_ok=True)
    with (lock_directory / 'provision.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for signum in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            signal.signal(signum, interrupted)
        if not args.installer_target:
            drain()
        if args.drain:
            return
        users = accounts(pwd.getpwall(), args.user)
        if args.user and not users:
            parser.error('Select an existing installed desktop account')
        settings = None if args.hardware or args.reconcile else load('cybexos_config', CONFIG_TOOL)
        if args.save_config:
            save_config(settings, text, args.user)
        elif settings and settings.ensure(fresh_account=args.offline):
            # Installation and repair of an older ISO installation record the
            # detected choices before provisioning consumes them.
            print('Recorded the installation choices in /etc/cybexos/config.yml')
        digest = hashlib.sha256()
        for path in sorted(PROVISION.rglob('*')):
            if path.is_file():
                digest.update(str(path.relative_to(PROVISION)).encode())
                digest.update(path.read_bytes())
        saved_config = Path('/etc/cybexos/config.yml')
        if saved_config.is_file():
            digest.update(saved_config.read_bytes())
        identity = digest.hexdigest() + ':' + os.uname().release + ':' + ','.join(user.pw_name for user in users)
        marker = Path('/var/lib/cybexos/hardware-configured')
        unsupported = marker.with_name('hardware-unsupported')
        status_path = marker.with_name('hardware-status.json')
        status = read_hardware_status(status_path) if args.hardware else {}
        this_boot = boot_id() if args.hardware else ''
        same_identity = status.get('identity') == identity
        if args.automatic and unsupported.is_file() and unsupported.read_text() == identity:
            raise SystemExit('Camera setup needs kernel compatibility review; see /var/lib/xps-hardware/ipu7/abi-failed.log. Automatic retry waits for a changed kernel or provisioning payload.')
        if args.automatic and same_identity:
            if status['state'] == 'completed':
                return
            if status['state'] == 'pending' and status.get('boot_id') == this_boot:
                return
            if status['state'] == 'failed' and status.get('boot_id') == this_boot:
                return
            if status.get('resume_boot_id') == this_boot:
                return
        # A legacy marker did not distinguish success from reboot-pending.
        # Validate it once and produce a structured outcome before skipping.
        if args.hardware and users:
            resumed = bool(same_identity and status.get('state') == 'pending' and status.get('boot_id') != this_boot)
            write_hardware_status(status_path, {'version': 1, 'state': 'running', 'identity': identity,
                                                'boot_id': this_boot, 'resume_boot_id': this_boot if resumed else ''})
            marker.with_name('hardware-result.json').unlink(missing_ok=True)
        for account in users:
            try:
                if args.installer_target:
                    configure(account, args.offline, args.hardware, args.reconcile, args.automatic,
                              installer_target=True)
                else:
                    configure(account, args.offline, args.hardware, args.reconcile, args.automatic)
            except subprocess.CalledProcessError:
                diagnostic = Path('/var/lib/xps-hardware/ipu7/abi-failed.log')
                # The hardware role deliberately reuses a cached ABI diagnostic
                # for an unchanged kernel; its timestamp need not be from this run.
                if (args.hardware and diagnostic.is_file()
                        and 'IPU7_STOCK_ABI_CHANGED' in diagnostic.read_text()
                        and os.uname().release in diagnostic.read_text()):
                    unsupported.parent.mkdir(parents=True, exist_ok=True)
                    unsupported.write_text(identity)
                if args.hardware:
                    write_hardware_status(status_path, {'version': 1, 'state': 'failed', 'identity': identity,
                                                        'boot_id': this_boot, 'reason': 'hardware role failed; run cybex repair --hardware'})
                raise
            if args.reconcile:
                # Home traversal keeps the account's privileges and shares the
                # same containment and serialization as baseline convergence.
                contained(['/usr/sbin/runuser', '-u', account.pw_name, '--', '/usr/bin/env', '-i',
                           'HOME=' + account.pw_dir, 'USER=' + account.pw_name,
                           'PATH=/usr/bin:/bin', 'LANG=C.UTF-8', 'PYTHONDONTWRITEBYTECODE=1',
                           '/usr/libexec/cybexos-user-init', '--essential'],
                          env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'HOME': '/root',
                               'LANG': 'C.UTF-8', 'PYTHONDONTWRITEBYTECODE': '1'}, timeout=120)
            if not args.hardware and not args.reconcile:
                retire_legacy_fish(account)
        # The Anaconda target helper decides login intent after verifying encryption.
        if settings and not args.offline:
            record_login(settings)
        if args.hardware and users:
            # The role result is a separate schema, so read it directly.
            try:
                result = json.loads(marker.with_name('hardware-result.json').read_text())
            except (OSError, ValueError):
                result = None
            if not isinstance(result, dict) or not isinstance(result.get('reboot_required'), bool):
                write_hardware_status(status_path, {'version': 1, 'state': 'failed', 'identity': identity,
                                                    'boot_id': this_boot, 'reason': 'hardware role did not report an outcome'})
                raise SystemExit('Hardware role did not report an outcome; run cybex repair --hardware')
            pending_reboot = result['reboot_required']
            preserved = bool(result.get('preserved_previous') and not result.get('camera_ready'))
            state = 'pending' if pending_reboot else 'failed' if preserved else 'completed'
            reason = ('reboot required for camera validation' if pending_reboot else
                      'previous camera stack retained after a failed refresh; run cybex repair --hardware' if preserved else '')
            state, reason, nvidia = merge_nvidia(state, reason, result.get('nvidia'))
            write_hardware_status(status_path, {'version': 1, 'state': state,
                                                'identity': identity, 'boot_id': this_boot,
                                                'reason': reason,
                                                'camera_ready': result.get('camera_ready', False),
                                                'preserved_previous': result.get('preserved_previous', False),
                                                'nvidia_state': nvidia.get('state', 'absent'),
                                                'nvidia_key': nvidia.get('key', '')})
            if state == 'completed':
                pending = marker.with_suffix('.pending')
                pending.write_text(identity)
                pending.replace(marker)
            unsupported.unlink(missing_ok=True)


if __name__ == '__main__':
    main()
