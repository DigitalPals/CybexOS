#!/usr/bin/python3
"""Return an ISO installation to its factory state for a new owner.

  reset    interactive; run through `cybex factory-reset` (sudo)
  finish   at the next boot, from cybexos-first-boot.service

`reset` restores the factory recovery point that the installation took at
its first start, after a typed confirmation. On an encrypted disk it first
replaces every disk passphrase with a temporary handover passphrase. At the
next start, `finish` removes every desktop account and everything in /home,
every other recovery point and set-aside system, and update checkpoints. It
keeps the installation's feature choices and hands the machine to the
new-owner setup. Nothing here can be undone.
"""
import contextlib
import getpass
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import socket
import subprocess
import sys
import time

import yaml

LIBEXEC = Path(__file__).resolve().parent
INSTALLATION = Path('/etc/cybexos/installation.json')
MARKER = 'var/lib/cybexos/factory-reset.json'
TERMINAL = {'committed', 'aborted', 'rolled-back'}


class Failure(Exception):
    """A refusal, shown without a traceback."""


def load(name, filename):
    loader = importlib.machinery.SourceFileLoader(name, str(LIBEXEC / filename))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def snapshot_module():
    return load('cybexos_snapshot', 'cybexos-system-snapshot')


def new_owner_module():
    return load('cybexos_new_owner', 'cybexos-new-owner')


def active_transactions(store):
    found = []
    for path in sorted((store.path / 'transactions').glob('*/transaction.json')):
        try:
            state = json.loads(path.read_text()).get('state')
        except (OSError, ValueError, AttributeError):
            state = 'unreadable'
        if state not in TERMINAL:
            found.append(path.parent.name)
    return found


def preflight(snapshot, installation=INSTALLATION):
    """The factory point to restore, or the reason a reset is not possible."""
    if not installation.is_file():
        raise Failure('Factory reset is available only on a system installed from the CybexOS ISO.')
    layout = snapshot.detect_layout()
    if layout.kind == 'recovery':
        raise Failure('This is a temporary recovery boot. Restart into the installed system first.')
    if not layout.usable:
        raise Failure(f'Factory reset needs the standard Btrfs layout ({layout.message or "not found"}).')
    if layout.pending_reboot:
        raise Failure('A restored recovery point is waiting for a restart. Restart first.')
    with snapshot.opened_store(layout, create=False) as store:
        point = store.factory_point() if store is not None else ''
        if not point:
            raise Failure('This installation has no factory recovery point. It is created at the first '
                          'start after a guided installation from the CybexOS ISO.')
        if active_transactions(store):
            raise Failure('An update has not finished. Let `cybex update` complete or recover it first.')
    return layout, point


class Console:
    def say(self, text=''):
        print(text, flush=True)

    def ask(self, prompt):
        return input(prompt)

    def secret(self, prompt):
        return getpass.getpass(prompt)


WARNING = '''Factory reset returns this computer to the state it was installed in and
prepares it for a new owner. When it restarts, it permanently erases:

  - every user account and everything in /home: documents, settings, keys
  - all other recovery points and replaced systems
  - every change made to the system since installation

Back up anything you want to keep first, for example with: cybex backup now
'''


def confirm(console, hostname):
    console.say(WARNING)
    answer = console.ask(f'To continue, type the computer name ({hostname}) or "erase": ').strip()
    if answer not in (hostname, 'erase'):
        raise Failure('The confirmation did not match. Nothing was changed.')


def handover(console, devices, run, new_owner):
    """The current passphrase (to authorize) and the next owner's temporary one."""
    console.say('\nThis disk is encrypted. The next owner unlocks it once with a temporary')
    console.say('passphrase you choose now, then replaces it with their own password.')
    current = console.secret('Current disk passphrase: ')
    if not all(new_owner.opens(device, current, run) for device in devices):
        raise Failure('That passphrase does not unlock this disk. Nothing was changed.')
    temporary = console.secret('Temporary passphrase for the next owner: ')
    problem = new_owner.validate_password(temporary, console.secret('Confirm the temporary passphrase: '))
    if problem:
        raise Failure(problem.replace('password', 'passphrase') + ' Nothing was changed.')
    return current, temporary


def reset(console=None, run=subprocess.run, snapshot=None, new_owner=None, installation=INSTALLATION,
          hostname=None):
    if os.geteuid() != 0 and os.environ.get('CYBEXOS_FACTORY_RESET_TESTING') != '1':
        raise Failure('Run this through `cybex factory-reset`.')
    snapshot = snapshot or snapshot_module()
    new_owner = new_owner or new_owner_module()
    layout, point = preflight(snapshot, installation)
    if console is None:
        if not sys.stdin.isatty():
            raise Failure('Factory reset asks for a typed confirmation; run it in a terminal.')
        console = Console()
    confirm(console, hostname or socket.gethostname())
    devices = new_owner.luks_devices(run)
    secrets = handover(console, devices, run, new_owner) if devices else None
    console.say('\nResetting. Do not turn the computer off.')
    if secrets:
        for device in devices:
            new_owner.rekey(device, secrets[0], secrets[1], run)
        console.say('The disk now opens with the temporary passphrase.')
    helper = LIBEXEC / 'cybexos-system-snapshot'
    result = run([str(helper), 'restore', point], check=False)
    if result.returncode != 0:
        raise Failure('The factory state could not be restored; see the message above. '
                      + ('The disk passphrase is already the temporary one. ' if secrets else '')
                      + 'Your accounts and files are unchanged.')
    with snapshot.opened_store(layout, create=False) as store:
        # Recorded inside the restored root, so only the reset system acts on it.
        snapshot.atomic_write(store.top / 'root' / MARKER,
                              json.dumps({'version': 1, 'point': point,
                                          'requested': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}) + '\n',
                              0o600)
    console.say('\nThe factory state is ready. The next start erases all accounts and home folders,')
    console.say('then opens the setup for the new owner.')
    if console.ask('Restart now? [Y/n]: ').strip().lower() in ('', 'y', 'yes'):
        run(['systemctl', 'reboot'], check=False)
    return 0


# ---- the next boot ---------------------------------------------------------------

def device_of(path):
    return path.lstat().st_dev


def remove_tree(path, run, device_of=device_of):
    """Delete a directory tree, including Btrfs subvolumes nested in it.

    A nested subvolume (another st_dev) is deleted as a subvolume; anything
    else on another device is refused, never descended into.
    """
    if path.is_symlink() or not path.is_dir():
        path.unlink(missing_ok=True)
        return
    device = device_of(path)
    nested = []
    for directory, names, _files in os.walk(path):
        keep = []
        for name in names:
            child = Path(directory) / name
            if not child.is_symlink() and device_of(child) != device:
                nested.append(child)
            else:
                keep.append(name)
        names[:] = keep
    for child in nested:
        result = run(['btrfs', 'subvolume', 'delete', '--recursive', str(child)], check=False,
                     capture_output=True, timeout=600)
        if result.returncode != 0:
            raise Failure(f'{child} is a mount, not removable data; nothing below it was touched.')
    shutil.rmtree(path)


def wipe_home(home, run, device_of=device_of):
    """Everything in /home goes; /home itself (a subvolume) stays."""
    for entry in sorted(home.iterdir()):
        if not entry.is_symlink() and entry.is_dir() and device_of(entry) != device_of(home):
            result = run(['btrfs', 'subvolume', 'delete', '--recursive', str(entry)], check=False,
                         capture_output=True, timeout=600)
            if result.returncode != 0:
                raise Failure(f'{entry} is a mount, not removable data.')
            continue
        remove_tree(entry, run, device_of)


def desktop_accounts(root):
    rows = [line.split(':') for line in (root / 'etc/passwd').read_text().splitlines() if line.count(':') >= 6]
    return [row[0] for row in rows if 1000 <= int(row[2]) < 65534 and row[5].startswith('/home/')]


def clear_recovery_history(snapshot):
    """Keep only the factory point: every other point holds the old owner's system."""
    layout = snapshot.detect_layout()
    if not layout.usable:
        return
    with snapshot.opened_store(layout, create=False) as store:
        if store is None:
            return
        factory = store.factory_point()
        for point in store.ids():
            if point != factory:
                snapshot.delete_point(store, point)
        running = layout.running.lstrip('/')
        for entry in sorted(store.top.iterdir()):
            if snapshot.REPLACED_PATTERN.match(entry.name) and entry.name != running:
                snapshot.run(['btrfs', 'subvolume', 'delete', '--recursive', str(entry)])
        for directory in (store.replaced, store.path / 'transactions'):
            shutil.rmtree(directory, ignore_errors=True)
        store.replaced.mkdir(parents=True, exist_ok=True)
        if factory:
            snapshot.atomic_write(store.path / 'latest', factory + '\n', 0o600)
        snapshot.regenerate_quietly(layout, store)


def preserved_choices(root, policy):
    """The feature choices of the reset installation, in config.yml's schema."""
    try:
        saved = yaml.safe_load((root / 'etc/cybexos/config.yml').read_text())
    except (OSError, yaml.YAMLError):
        return None, None
    if not isinstance(saved, dict):
        return None, None
    selected = {key: saved[key] for key in policy.CHOICE_BOOLEANS if type(saved.get(key)) is bool}
    features = saved.get('features')
    if isinstance(features, dict):
        selected['features'] = {key: value for key, value in features.items()
                                if key in policy.FEATURES and type(value) is bool}
    wheel = saved.get('passwordless_wheel')
    return policy.choices(selected), wheel if type(wheel) is bool else None


def installation_policy():
    sys.path.insert(0, '/usr/share/cybexos/lib')
    import installation_policy as policy
    return policy


def write(path, text, mode=0o644):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name('.' + path.name + '.factory-reset')
    temporary.write_text(text)
    temporary.chmod(mode)
    temporary.replace(path)


def finish(root=Path('/'), run=subprocess.run, snapshot=None, policy=None, device_of=device_of):
    """Complete a reset in the restored root; returns whether one was pending."""
    marker = root / MARKER
    if not marker.is_file():
        return False
    snapshot = snapshot or snapshot_module()
    policy = policy or installation_policy()
    clear_recovery_history(snapshot)
    wipe_home(root / 'home', run, device_of)
    for name in desktop_accounts(root):
        # Exit 12 only reports that the (already removed) home was missing.
        run(['userdel', '--force', '--remove', name], check=False, capture_output=True, timeout=120)
        for leftover in (root / 'var/lib/AccountsService/users' / name, root / 'var/lib/systemd/linger' / name):
            leftover.unlink(missing_ok=True)
    cybexos = root / 'etc/cybexos'
    choices, wheel = preserved_choices(root, policy)
    if choices is not None:
        write(cybexos / 'install-choices.json', json.dumps({'version': 1, 'choices': choices}, sort_keys=True) + '\n')
    try:
        previous = json.loads((cybexos / 'oem.json').read_text())
    except (OSError, ValueError):
        previous = {}
    if wheel is None:
        wheel = previous.get('passwordless_wheel', False) is True
    write(cybexos / 'oem.json', json.dumps({'version': 1, 'passwordless_wheel': wheel}) + '\n')
    write(cybexos / 'login.json', json.dumps({'version': 1, 'user': '', 'autologin': False, 'live': False}) + '\n')
    (cybexos / 'config.yml').unlink(missing_ok=True)
    for leftover in [root / 'etc/sudoers.d/10-wheel-nopasswd', root / 'etc/sddm.conf',
                     root / 'var/lib/sddm/state.conf', *sorted((root / 'etc/ssh').glob('ssh_host_*'))]:
        leftover.unlink(missing_ok=True)
    shutil.rmtree(root / 'var/lib/cybexos/first-boot', ignore_errors=True)
    try:
        details = json.loads((cybexos / 'installation.json').read_text())
    except (OSError, ValueError):
        details = {}
    details.update(username='', autologin=False, oem=True,
                   factoryReset=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()))
    write(cybexos / 'installation.json', json.dumps(details) + '\n')
    marker.unlink()
    run(['restorecon', '-RF', '/etc/cybexos', '/home', '/var/lib/cybexos'], check=False, timeout=300)
    return True


def main(argv):
    if argv not in (['reset'], ['finish']):
        print('Usage: cybexos-factory-reset reset|finish', file=sys.stderr)
        return 2
    os.umask(0o077)
    try:
        if argv == ['finish']:
            finish()
            return 0
        return reset()
    except Failure as error:
        print(f'cybex factory-reset: {error}', file=sys.stderr)
        return 1
    except (KeyboardInterrupt, EOFError):
        print('\nCancelled.', file=sys.stderr)
        return 1


if __name__ == '__main__':
    with contextlib.suppress(BrokenPipeError):
        sys.exit(main(sys.argv[1:]))
