#!/usr/bin/env bash
set -euo pipefail
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland
export DESKTOP_SESSION=hyprland-quickshell DESKTOP_SHELL=quickshell
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM=wayland
# Wayland applications reach IBus through the input-method protocol;
# XWayland applications need its XIM server.
export XMODIFIERS=@im=ibus
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/Android/Sdk/platform-tools:$HOME/Android/Sdk/cmdline-tools/latest/bin:/usr/local/bin:/usr/bin"
export XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export ANDROID_HOME="$HOME/Android/Sdk" ANDROID_SDK_ROOT="$HOME/Android/Sdk"
/usr/libexec/cybexos-user-init --essential
# A live boot from the "Install CybexOS" entry starts only the installer.
# Hyprland passes this to cybexos-hyprland-session-start.
if [[ -e /run/cybexos-live && -e /run/cybexos-install-mode ]]; then
  export CYBEXOS_SESSION_TARGET=cybexos-install-session.target
else
  export CYBEXOS_SESSION_TARGET=hyprland-session.target
fi
CYBEXOS_XPS_2026=$(python3 -c 'import json,pathlib; p=pathlib.Path("/etc/cybexos/hardware.json"); print("1" if p.is_file() and json.loads(p.read_text()).get("xps_2026") else "0")')
# Units gated on the hardware (external-monitor-toggle.service) read it from
# the user manager, so it is imported with the session environment below.
export CYBEXOS_XPS_2026
# Anaconda writes the system keyboard choice through locale1. Query it on
# every login so the shared image never hardcodes the live account's layout.
keyboard_property() {
  busctl --system get-property org.freedesktop.locale1 /org/freedesktop/locale1 \
    org.freedesktop.locale1 "$1" 2>/dev/null | python3 -c \
    'import shlex,sys; values=shlex.split(sys.stdin.read()); print(values[1] if len(values)>1 else "")'
}
CYBEXOS_KEYBOARD_LAYOUT=$(keyboard_property X11Layout) || true
CYBEXOS_KEYBOARD_VARIANT=$(keyboard_property X11Variant) || true
export CYBEXOS_KEYBOARD_LAYOUT=${CYBEXOS_KEYBOARD_LAYOUT:-us}
export CYBEXOS_KEYBOARD_VARIANT
# NVIDIA session variables, written by the NVIDIA hardware role, apply only
# while the proprietary DRM driver is loaded: a boot that fell back to
# nouveau must not inherit them. Read as data, never sourced.
nvidia_environment=()
if [[ -d /sys/module/nvidia_drm && -r /etc/cybexos/nvidia-session.env ]]; then
  while IFS='=' read -r name value; do
    case $name in
      LIBVA_DRIVER_NAME|__GLX_VENDOR_LIBRARY_NAME|NVD_BACKEND)
        [[ $value =~ ^[A-Za-z0-9_.-]+$ ]] || continue
        export "$name=$value"
        nvidia_environment+=("$name")
        ;;
    esac
  done </etc/cybexos/nvidia-session.env
fi
mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/hyprland"
systemctl --user import-environment XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
  DESKTOP_SESSION DESKTOP_SHELL PATH XDG_DATA_DIRS QT_QPA_PLATFORM MOZ_ENABLE_WAYLAND XMODIFIERS \
  CYBEXOS_XPS_2026 "${nvidia_environment[@]}"
dbus-update-activation-environment --systemd XDG_SESSION_TYPE XDG_CURRENT_DESKTOP \
  XDG_SESSION_DESKTOP DESKTOP_SESSION DESKTOP_SHELL PATH XDG_DATA_DIRS QT_QPA_PLATFORM MOZ_ENABLE_WAYLAND XMODIFIERS \
  CYBEXOS_XPS_2026 "${nvidia_environment[@]}"
session_stop_targets=(hyprland-session.target)
if [[ $CYBEXOS_SESSION_TARGET != hyprland-session.target ]]; then
  session_stop_targets+=("$CYBEXOS_SESSION_TARGET")
fi
trap 'systemctl --user stop "${session_stop_targets[@]}" >/dev/null 2>&1 || true' EXIT
# Launch once: compositor failure ends this login and returns to SDDM's
# password prompt. The watchdog's automatic safe-mode restart bypasses it.
Hyprland --config /usr/share/cybexos/runtime/hypr/hyprland.lua "$@" \
  >>"${XDG_STATE_HOME:-$HOME/.local/state}/hyprland/session.log" 2>&1
