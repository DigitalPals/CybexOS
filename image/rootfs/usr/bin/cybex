#!/usr/bin/env bash
set -euo pipefail
command_name=${1:-help}
[[ $# == 0 ]] || shift
case $command_name in
  welcome) exec /usr/bin/cybexos-welcome "$@" ;;
  configure) exec /usr/libexec/cybexos-config "$@" ;;
  update) exec /usr/share/cybexos/bin/cybexos-update-run run "$@" ;;
  upgrade-system) exec sudo /usr/libexec/cybexos-major-upgrade "$@" ;;
  update-channel) exec /usr/libexec/cybexos-update-channel "$@" ;;
  prepare-apps) exec /usr/libexec/cybexos-user-init --background "$@" ;;
  repair) exec sudo /usr/libexec/cybexos-configure-installed --user "${SUDO_USER:-$USER}" "$@" ;;
  agent) exec /usr/share/cybexos/bin/cybexos-agent "$@" ;;
  webapp) exec /usr/share/cybexos/bin/cybexos-webapp "$@" ;;
  plugin|dev|shell) exec /usr/share/cybexos/bin/cybexos-runtime "$command_name" "$@" ;;
  backup) exec /usr/share/cybexos/bin/cybexos-backup "$@" ;;
  theme) exec /usr/share/cybexos/bin/cybexos-theme "$@" ;;
  version|--version) exec rpm -q cybexos-desktop ;;
  verify|doctor) exec /usr/libexec/cybexos-doctor "$@" ;;
  report) exec /usr/share/cybexos/bin/cybexos-report "$@" ;;
  factory-reset) exec sudo /usr/libexec/cybexos-factory-reset reset "$@" ;;
  uninstall)
    # The desktop is the operating system of an ISO installation; there is no
    # separate workstation layer to remove.
    echo 'cybex uninstall is not available on a CybexOS system installed from the ISO:' >&2
    echo 'the CybexOS desktop is part of the operating system. Use cybex configure to' >&2
    echo 'change installation choices, or reinstall to use a different desktop.' >&2
    exit 2
    ;;
  help|-h|--help)
    cat <<'EOF'
Usage: cybex <command> [options]

Commands:
  welcome       Open the CybexOS welcome window
  configure     Change installation choices and apply them (--check prints them)
  update        Check for and apply CybexOS and system updates
  upgrade-system Prepare, perform, or inspect a supported Fedora major upgrade
  update-channel Inspect or enroll the desktop RPM update channel
  prepare-apps  Prepare the offline applications for this account
  repair        Reapply the installed-system policy to this account
  agent         Launch or choose the default AI coding agent
  webapp        Install, remove, list, or launch web apps
  plugin        Install, update, clone, remove, or configure desktop plugins
  shell         Inspect shell health, enter safe mode, or retry the full desktop
  theme         List, apply, install, export, or remove appearance themes
  dev           Select, inspect, or disable a live development checkout
  backup        Back up, check, or restore personal files (setup, now, status, restore)
  version       Print the installed CybexOS package version
  verify        Check installed-system health (--json for machine-readable output)
  doctor        Alias for verify
  report        Collect a redacted diagnostic bundle for a bug report
  factory-reset Erase all accounts and home folders and prepare for a new owner
EOF
    ;;
  *) echo "Unknown command: $command_name" >&2; exit 2 ;;
esac
