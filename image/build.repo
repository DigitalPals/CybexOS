# The image compose adapter (image/compose) sets $releasever from inventory
# fedora_release in metalink and gpgkey values; livecd-tools substitutes it in
# baseurl. A release literal here would bypass that single source.
[fedora]
name=Fedora $releasever
metalink=https://mirrors.fedoraproject.org/metalink?repo=fedora-$releasever&arch=x86_64
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-$releasever-x86_64

[updates]
name=Fedora $releasever updates
metalink=https://mirrors.fedoraproject.org/metalink?repo=updates-released-f$releasever&arch=x86_64
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-$releasever-x86_64

[fedora-cisco-openh264]
name=Fedora $releasever openh264 (From Cisco)
metalink=https://mirrors.fedoraproject.org/metalink?repo=fedora-cisco-openh264-$releasever&arch=x86_64
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-$releasever-x86_64

[hyprland]
name=Hyprland COPR
baseurl=https://download.copr.fedorainfracloud.org/results/sdegler/hyprland/fedora-$releasever-x86_64/
enabled=1
gpgcheck=1
gpgkey=file:///home/builder/build/hyprland.gpg

[cybexos-local]
name=Locally built private alpha desktop
baseurl=file:///home/builder/build/repo
enabled=1
gpgcheck=0
