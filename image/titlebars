#!/usr/bin/python3
"""Build native titlebars in the disposable Fedora image builder, never on Arch."""
import json
import os
from pathlib import Path
import shutil
import subprocess

import yaml
from titlebars_payload import prepare_recipe

ROOT = Path(__file__).resolve().parents[1]
BUILD = Path('/home/builder/build')


def main():
    if os.geteuid() != 0 or Path('/etc/hostname').read_text().strip() != 'image-builder':
        raise RuntimeError('Native image builds are only allowed in the disposable Fedora image builder')
    # Reuse the checkout repository definition and already verified signing key.
    key = Path('/etc/pki/rpm-gpg/CYBEXOS-sdegler-hyprland-copr.gpg')
    key.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(BUILD / 'hyprland.gpg', key)
    subprocess.run(['rpmkeys', '--import', str(key)], check=True)
    shutil.copyfile(ROOT / 'roles/desktop/templates/hyprland-copr.repo.j2',
                    '/etc/yum.repos.d/_copr:copr.fedorainfracloud.org:sdegler:hyprland.repo')
    tasks = yaml.safe_load((ROOT / 'roles/desktop/tasks/titlebars.yml').read_text())
    packages = next(task['ansible.builtin.dnf']['name'] for task in tasks
                    if task.get('name') == 'Install native titlebar build dependencies')
    subprocess.run(['dnf', 'install', '-y', 'hyprland', *packages], check=True)
    staged = BUILD / 'titlebars-root'
    staged.mkdir(parents=True, exist_ok=False)
    inventory = yaml.safe_load((ROOT / 'inventory/group_vars/all.yml').read_text())
    prepare_recipe(ROOT, staged, inventory)
    subprocess.run([str(staged / 'usr/libexec/cybexos-titlebars-install'), '--root', str(staged)], check=True)
    manifest = json.loads((staged / 'usr/lib64/cybexos/titlebars.json').read_text())
    (BUILD / 'titlebars.json').write_text(json.dumps(manifest, indent=2) + '\n')
    # Caches/locks are builder state, never part of the deliverable.
    shutil.rmtree(staged / 'var')


if __name__ == '__main__':
    main()
