#!/usr/bin/env python3
"""Install live-only files without copying checkout ownership or directory modes."""
from pathlib import Path
import shutil
import sys


def install_tree(source, destination):
    for path in sorted(source.rglob("*")):
        if path.is_symlink():
            raise ValueError(f"Live integration must not contain symlinks: {path}")
        relative = path.relative_to(source)
        target = destination / relative
        if path.is_dir():
            target.mkdir(mode=0o755, parents=True, exist_ok=True)
        elif path.is_file():
            target.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
            shutil.copyfile(path, target)
            executable = relative.parts[:2] in (("usr", "libexec"), ("usr", "bin"))
            target.chmod(0o755 if executable else 0o644)


if __name__ == "__main__":
    install_tree(Path(__file__).with_name("live-rootfs"), Path(sys.argv[1]))
