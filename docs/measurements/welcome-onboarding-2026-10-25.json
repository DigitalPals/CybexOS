      "test": "tests/quickshell/hyprland-lua.test.cjs; the dev shell now provides lua5_5"
    },
    {
      "commit": "d59de42",
      "kind": "onboarding",
      "summary": "publish() checked the status of os.execute(\"mkdir ...\"). Under Hyprland it returns nil, \"No child processes\", ECHILD even on success, so the state was never published",
      "test": "keybindings-lua.test.cjs simulates the reaped status"
    },
    {
      "commit": "5763467",
      "kind": "pre-existing on main, surfaced by the welcome guide",
      "summary": "The Settings input catalog read /usr/share/X11/xkb/rules/evdev.xml, which NixOS lacks. The input snapshot failed, so Settings → Keyboard had no data and the Hello step showed \"Keyboard layout: Not available\"",
      "test": "test_native_input_region.py; the desktop installCheck reads the xkeyboard-config rules"
    },
    {
      "commit": "5763467",
      "kind": "qualification script",
