+// Configuration/theme hooks can replace the complete button set without
+// accumulating duplicates or retaining textures from the previous theme.
+static int clearOmarchyFloatingLuaButtons(lua_State *L) {
+  g_pOmarchyFloatingGlobalState->buttons.clear();
+  for (auto &bar : g_pOmarchyFloatingGlobalState->bars) {
+    if (!bar)
