@@ -0,0 +1,44 @@
+// Cybex OS native compositor build guard. SPDX-License-Identifier: MIT
+#pragma once
+#include <link.h>
+#include <cstring>
+#include <string>
+
+// Read the running executable's mapped ELF notes: a package upgrade can select
+// a new executable while the older compositor is still running.
+static std::string cybexosHyprlandBuildId() {
+  std::string result;
+  dl_iterate_phdr([](dl_phdr_info *info, size_t, void *data) -> int {
+    if (info->dlpi_name && info->dlpi_name[0])
+      return 0;
+    auto &result = *static_cast<std::string *>(data);
+    for (ElfW(Half) i = 0; i < info->dlpi_phnum; ++i) {
+      const auto &segment = info->dlpi_phdr[i];
+      if (segment.p_type != PT_NOTE)
+        continue;
+      const auto *cursor = reinterpret_cast<const unsigned char *>(info->dlpi_addr + segment.p_vaddr);
+      const auto *end = cursor + segment.p_memsz;
+      while (static_cast<size_t>(end - cursor) >= sizeof(ElfW(Nhdr))) {
+        ElfW(Nhdr) note;
+        std::memcpy(&note, cursor, sizeof(note));
+        cursor += sizeof(note);
+        const size_t nameSize = (static_cast<size_t>(note.n_namesz) + 3) & ~size_t{3};
+        const size_t descSize = (static_cast<size_t>(note.n_descsz) + 3) & ~size_t{3};
+        if (nameSize > static_cast<size_t>(end - cursor) || descSize > static_cast<size_t>(end - cursor) - nameSize)
+          break;
+        if (note.n_type == NT_GNU_BUILD_ID && note.n_namesz == 4 && std::memcmp(cursor, "GNU", 4) == 0) {
+          constexpr char hex[] = "0123456789abcdef";
+          const auto *id = cursor + nameSize;
+          for (size_t j = 0; j < note.n_descsz; ++j) {
+            result += hex[id[j] >> 4];
+            result += hex[id[j] & 15];
+          }
+          return 1;
+        }
+        cursor += nameSize + descSize;
+      }
+    }
+    return 1;
+  }, &result);
+  return result; // No build ID is a mismatch too.
+}
