#!/usr/bin/env bash
# Change the session default and move application playback that is already
# running. PipeWire filter-chain internals have no application.name, so they
# deliberately stay attached to their configured physical target.
set -uo pipefail

target=${1:-}
[[ -n $target ]] || {
  echo 'Usage: audio-route <sink-name>' >&2
  exit 2
}

pactl set-default-sink "$target" || exit 1

while IFS= read -r input; do
  [[ -n $input ]] || continue
  pactl move-sink-input "$input" "$target" >/dev/null 2>&1 || true
done < <(
  # The long listing's "Sink Input #" header is translated (Dutch prints
  # "Afvoer-invoer #"), so parse it untranslated.
  LC_ALL=C pactl list sink-inputs 2>/dev/null | awk '
    /^Sink Input #/ { id = substr($3, 2) }
    /^[[:space:]]+application[.]name = / { print id; id = "" }
  '
)
