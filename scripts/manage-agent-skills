#!/usr/bin/env bash
# Adopt and restore CybexOS's user-scoped agent skill discovery slots.
set -euo pipefail
umask 077

usage() {
  cat <<'EOF'
Usage: scripts/manage-agent-skills provision [--home PATH] [--canonical PATH]
       scripts/manage-agent-skills uninstall [--home PATH]
                                   [--name SKILL --backup-root PATH]

Internal lifecycle helper. Provision records each pre-existing cybexos
skill slot once, then points all supported discovery paths at the canonical
skill in the active release. Uninstall restores those recorded objects;
--name and --backup-root select the records of a former skill name.
EOF
}

action=${1:-}
[[ $# -eq 0 ]] || shift
case $action in
  provision|uninstall) ;;
  -h|--help|help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

managed_home=${HOME:-}
canonical=
skill_name=cybexos
backup_root=
while (($#)); do
  case $1 in
    --home)
      shift
      [[ $# -gt 0 ]] || {
        printf 'manage-agent-skills: --home needs a path\n' >&2
        exit 2
      }
      managed_home=$1
      ;;
    --canonical)
      shift
      [[ $# -gt 0 ]] || {
        printf 'manage-agent-skills: --canonical needs a path\n' >&2
        exit 2
      }
      canonical=$1
      ;;
    --name)
      shift
      [[ ${1:-} =~ ^[a-z0-9][a-z0-9-]*$ ]] || {
        printf 'manage-agent-skills: --name needs a skill name\n' >&2
        exit 2
      }
      skill_name=$1
      ;;
    --backup-root)
      shift
      [[ ${1:-} == /* ]] || {
        printf 'manage-agent-skills: --backup-root needs an absolute path\n' >&2
        exit 2
      }
      backup_root=$1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'manage-agent-skills: unknown option %s\n' "$1" >&2
      exit 2
      ;;
  esac
  shift
done

[[ $managed_home == /* && $managed_home != / ]] || {
  printf 'manage-agent-skills: home must be an absolute non-root path\n' >&2
  exit 2
}
canonical=${canonical:-$managed_home/.local/share/cybexos/current/agent-skills/cybexos}
[[ $canonical == /* ]] || {
  printf 'manage-agent-skills: canonical skill must be an absolute path\n' >&2
  exit 2
}

backup_root=${backup_root:-$managed_home/.local/state/cybexos/backups/agent-skills}
slot_names=(agents claude codex)
destinations=(
  "$managed_home/.agents/skills/$skill_name"
  "$managed_home/.claude/skills/$skill_name"
  "$managed_home/.codex/skills/$skill_name"
)

object_exists() {
  [[ -e $1 || -L $1 ]]
}

remove_object() {
  local path=$1
  object_exists "$path" || return 0
  rm -rf -- "$path"
}

if [[ $action == provision && $skill_name != cybexos ]]; then
  printf 'manage-agent-skills: only the cybexos skill can be provisioned\n' >&2
  exit 2
fi

if [[ $action == uninstall ]] && ! object_exists "$backup_root"; then
  printf 'UNCHANGED: CybexOS agent skill discovery slots\n'
  exit 0
fi

if object_exists "$backup_root"; then
  [[ -d $backup_root && ! -L $backup_root ]] || {
    printf 'manage-agent-skills: backup root is not a directory: %s\n' \
      "$backup_root" >&2
    exit 1
  }
else
  mkdir -p -- "$backup_root"
fi
chmod 0700 -- "$backup_root"
exec 9>"$backup_root/.lock"
flock 9

transaction=$(mktemp -d "$backup_root/.transaction.XXXXXX")
transaction_active=true
changed=false
declare -a replacement_started=()
declare -a destination_was_present=()
declare -a transaction_dirs=()
declare -a committed_slots=()

rollback_transaction() {
  local index destination work was_present failed=false slot_dir
  for ((index=${#destinations[@]} - 1; index>=0; index--)); do
    [[ ${replacement_started[index]:-false} == true ]] || continue
    destination=${destinations[index]}
    work=${transaction_dirs[index]}
    was_present=${destination_was_present[index]:-false}
    if [[ $was_present == true ]] && object_exists "$work/before"; then
      if ! remove_object "$destination"; then
        printf 'manage-agent-skills: could not remove partial destination %s\n' \
          "$destination" >&2
        failed=true
        continue
      fi
      if ! mv -T -- "$work/before" "$destination"; then
        printf 'manage-agent-skills: could not restore %s after failure\n' \
          "$destination" >&2
        failed=true
      fi
    elif [[ $was_present != true ]] && ! remove_object "$destination"; then
      printf 'manage-agent-skills: could not remove partial destination %s\n' \
        "$destination" >&2
      failed=true
    fi
  done
  for slot_dir in "${committed_slots[@]}"; do
    if ! remove_object "$slot_dir"; then
      printf 'manage-agent-skills: could not discard incomplete adoption %s\n' \
        "$slot_dir" >&2
      failed=true
    fi
  done
  $failed && return 1
  return 0
}

cleanup() {
  local rc=$? work rollback_succeeded=true
  trap - EXIT INT TERM
  if [[ $transaction_active == true ]] && ! rollback_transaction; then
    rc=125
    rollback_succeeded=false
  fi
  if [[ $rollback_succeeded == true ]]; then
    for work in "${transaction_dirs[@]}"; do
      if [[ -n ${work:-} ]] && ! remove_object "$work"; then
        printf 'manage-agent-skills: could not remove transaction path %s\n' \
          "$work" >&2
        rc=125
      fi
    done
    if ! remove_object "$transaction"; then
      printf 'manage-agent-skills: could not remove transaction path %s\n' \
        "$transaction" >&2
      rc=125
    fi
  else
    printf 'manage-agent-skills: retained transaction data for recovery: %s\n' \
      "$transaction" >&2
  fi
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

validate_slot() {
  local slot_dir=$1 destination=$2 recorded original_count=0 absent_count=0
  [[ -d $slot_dir && ! -L $slot_dir && -f $slot_dir/complete \
      && -f $slot_dir/destination ]] || return 1
  IFS= read -r recorded <"$slot_dir/destination" || return 1
  [[ $recorded == "$destination" ]] || return 1
  object_exists "$slot_dir/original" && original_count=1
  [[ -f $slot_dir/absent ]] && absent_count=1
  ((original_count + absent_count == 1))
}

test_fail() {
  local point=$1
  [[ ${CYBEXOS_AGENT_SKILLS_TESTING:-0} == 1 \
      && ${CYBEXOS_AGENT_SKILLS_TEST_FAIL:-} == "$point" ]] || return 0
  printf 'manage-agent-skills: injected failure at %s\n' "$point" >&2
  return 97
}

if [[ $action == provision ]]; then
  [[ -d $canonical && -r $canonical/SKILL.md ]] || {
    printf 'manage-agent-skills: canonical skill is unavailable: %s\n' \
      "$canonical" >&2
    exit 1
  }

  # Build every missing first-adoption record before replacing any discovery
  # slot. A failed copy therefore leaves all user objects in place.
  for index in "${!slot_names[@]}"; do
    slot=${slot_names[index]}
    destination=${destinations[index]}
    slot_dir=$backup_root/$slot
    if object_exists "$slot_dir"; then
      validate_slot "$slot_dir" "$destination" || {
        printf 'manage-agent-skills: invalid adoption record: %s\n' \
          "$slot_dir" >&2
        exit 1
      }
      continue
    fi

    staged_slot=$transaction/adopt-$slot
    mkdir -- "$staged_slot"
    printf '%s\n' "$destination" >"$staged_slot/destination"
    if object_exists "$destination"; then
      cp -a -- "$destination" "$staged_slot/original"
    else
      : >"$staged_slot/absent"
    fi
    : >"$staged_slot/complete"
    validate_slot "$staged_slot" "$destination" || {
      printf 'manage-agent-skills: could not validate backup for %s\n' \
        "$destination" >&2
      exit 1
    }
    test_fail "backup:$slot" || exit $?
  done

  # Commit the independent adoption records before taking ownership. They are
  # removed again by the EXIT rollback if any later slot replacement fails.
  for index in "${!slot_names[@]}"; do
    slot=${slot_names[index]}
    staged_slot=$transaction/adopt-$slot
    [[ -d $staged_slot ]] || continue
    slot_dir=$backup_root/$slot
    committed_slots+=("$slot_dir")
    mv -T -- "$staged_slot" "$slot_dir"
    changed=true
  done

  for index in "${!destinations[@]}"; do
    destination=${destinations[index]}
    parent=${destination%/*}
    mkdir -p -- "$parent"
    work=$(mktemp -d "$parent/.cybexos-agent-skill.XXXXXX")
    transaction_dirs[index]=$work
    ln -s -- "$canonical" "$work/desired"

    if [[ -L $destination ]] \
        && [[ $(readlink -- "$destination") == "$canonical" ]]; then
      continue
    fi
    destination_was_present[index]=false
    if object_exists "$destination"; then
      destination_was_present[index]=true
    fi
    replacement_started[index]=true
    if [[ ${destination_was_present[index]} == true ]]; then
      mv -T -- "$destination" "$work/before"
    fi
    test_fail "install:${slot_names[index]}" || exit $?
    mv -T -- "$work/desired" "$destination"
    changed=true
    test_fail "after:${slot_names[index]}" || exit $?
  done
else
  # Stage every recorded original beside its destination first. If any backup
  # is missing or cannot be copied, no currently installed slot is disturbed.
  adopted=false
  for index in "${!slot_names[@]}"; do
    slot=${slot_names[index]}
    destination=${destinations[index]}
    slot_dir=$backup_root/$slot
    object_exists "$slot_dir" || continue
    validate_slot "$slot_dir" "$destination" || {
      printf 'manage-agent-skills: invalid adoption record: %s\n' \
        "$slot_dir" >&2
      exit 1
    }
    adopted=true
    parent=${destination%/*}
    mkdir -p -- "$parent"
    work=$(mktemp -d "$parent/.cybexos-agent-skill.XXXXXX")
    transaction_dirs[index]=$work
    if object_exists "$slot_dir/original"; then
      cp -a -- "$slot_dir/original" "$work/desired"
    else
      : >"$work/restore-absent"
    fi
    test_fail "restore:$slot" || exit $?
  done

  if [[ $adopted == true ]]; then
    for index in "${!slot_names[@]}"; do
      work=${transaction_dirs[index]:-}
      [[ -n $work ]] || continue
      destination=${destinations[index]}
      destination_was_present[index]=false
      if object_exists "$destination"; then
        destination_was_present[index]=true
      fi
      replacement_started[index]=true
      if [[ ${destination_was_present[index]} == true ]]; then
        mv -T -- "$destination" "$work/before"
      fi
      test_fail "install:${slot_names[index]}" || exit $?
      if object_exists "$work/desired"; then
        mv -T -- "$work/desired" "$destination"
      fi
      changed=true
      test_fail "after:${slot_names[index]}" || exit $?
    done
  fi
fi

transaction_active=false
committed_slots=()
for work in "${transaction_dirs[@]}"; do
  if [[ -n ${work:-} ]] && ! remove_object "$work"; then
    printf 'manage-agent-skills: warning: could not remove transaction path %s\n' \
      "$work" >&2
  fi
done
if ! remove_object "$transaction"; then
  printf 'manage-agent-skills: warning: could not remove transaction path %s\n' \
    "$transaction" >&2
fi
trap - EXIT INT TERM

if [[ $changed == true ]]; then
  printf 'CHANGED: %s CybexOS agent skill discovery slots\n' "$action"
else
  printf 'UNCHANGED: CybexOS agent skill discovery slots\n'
fi
