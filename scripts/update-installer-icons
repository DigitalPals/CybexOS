#!/usr/bin/env python3
"""Rebuild the installer's icon paths from a pinned Tabler release.

Only this maintenance command needs the network; the installer embeds the
generated paths. All input names live in installer/kiosk/assets/tabler/icons.json.
"""
import hashlib
import io
import json
from pathlib import Path
import re
import tarfile
import urllib.request

# The release the desktop's subset font uses (scripts/update-tabler-icons).
VERSION = "3.48.0"
SHA256 = "28447dcf6f0bb2b8d92c59a1b3d30900a180de2e97d7db4d267e6320dc68f449"
URL = f"https://registry.npmjs.org/@tabler/icons/-/icons-{VERSION}.tgz"
REPO = Path(__file__).resolve().parents[1]
KIOSK = REPO / "installer/kiosk"
ASSETS = KIOSK / "assets/tabler"
REFERENCE = REPO / "installer/ui-reference/index.html"
# The design reference keeps its shorter keys.
REFERENCE_KEYS = {"close": "x", "ethernet": "eth", "firmware": "fw",
                  "keyboard": "kb", "offline": "off", "terminal": "term"}
REFERENCE_BLOCK = re.compile(
    r"(/\* ── icons: generated by scripts/update-installer-icons ── \*/\nconst P = \{\n).*?(\n\};)", re.S)
ARITY = {"M": 2, "L": 2, "H": 1, "V": 1, "C": 6, "S": 4, "Q": 4, "T": 2, "A": 7, "Z": 0}
TOKEN = re.compile(r"[\s,]*([MLHVCSQTAZ]|[-+]?(?:\d+\.?\d*|\.\d+)(?:e[-+]?\d+)?)", re.I)


def check(name, d):
    """Slint silently draws nothing for a path it cannot parse; fail here instead."""
    if not d.startswith("M"):
        raise ValueError(f"{name}: path does not start with an absolute move")
    commands, pos = [], 0
    while d[pos:].strip(" ,"):
        match = TOKEN.match(d, pos)
        if not match:
            raise ValueError(f"{name}: cannot parse {d[pos:pos + 16]!r}")
        token, pos = match.group(1), match.end()
        if token.isalpha():
            commands.append((token, []))
        else:
            commands[-1][1].append(token)
    for command, values in commands:
        arity = ARITY[command.upper()]
        if (len(values) % arity or not values) if arity else values:
            raise ValueError(f"{name}: {command} has {len(values)} values")
        if command in "Aa" and set(values[3::7] + values[4::7]) - {"0", "1"}:
            raise ValueError(f"{name}: arc flags must be 0 or 1")


def main():
    data = urllib.request.urlopen(URL, timeout=60).read()
    if hashlib.sha256(data).hexdigest() != SHA256:
        raise ValueError("Tabler archive checksum mismatch")
    names = json.loads((ASSETS / "icons.json").read_text())
    with tarfile.open(fileobj=io.BytesIO(data)) as archive:
        def read(name):
            return archive.extractfile("package/" + name).read()

        (ASSETS / "LICENSE").write_bytes(read("LICENSE"))
        nodes = json.loads(read("tabler-nodes-outline.json"))
    unknown = sorted(set(names.values()) - nodes.keys())
    if unknown:
        raise ValueError(f"Unknown Tabler names: {unknown}")
    paths = {}
    for name, tabler in sorted(names.items()):
        paths[name] = []
        for tag, attrs in nodes[tabler]:
            if tag != "path":
                raise ValueError(f"{tabler}: unexpected <{tag}>")
            check(tabler, attrs["d"])
            paths[name].append(attrs["d"])

    slint = "// Generated by scripts/update-installer-icons; do not edit.\n"
    slint += f"// Tabler {VERSION} outline paths on its 24-unit grid, MIT (assets/tabler/LICENSE).\n"
    slint += "export global Icons {\n"
    for name, parts in paths.items():
        slint += f'    out property <string> {name}: "{" ".join(parts)}";\n'
    (KIOSK / "ui/icons.slint").write_text(slint + "}\n")

    entries = ",\n".join(
        f"  {REFERENCE_KEYS.get(name, name)}: '{''.join(f'<path d=\"{d}\"/>' for d in parts)}'"
        for name, parts in paths.items())
    html, count = REFERENCE_BLOCK.subn(lambda m: m.group(1) + entries + m.group(2), REFERENCE.read_text())
    if count != 1:
        raise ValueError("Design reference icon block not found")
    REFERENCE.write_text(html)
    print(f"Wrote {len(paths)} Tabler {VERSION} icons")


if __name__ == "__main__":
    main()
