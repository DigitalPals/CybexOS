#!/usr/bin/env python3
"""Real, disposable UEFI ISO installation tests; never operates on host disks.

Requires qemu-system-x86_64, OVMF and Python pexpect (nix develop).
The returned evidence is only for the actual ISO/source identities observed.
It is not physical hardware or published-channel update qualification.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shlex
import shutil
import socket
import subprocess
import tempfile
import time

import pexpect

PASSWORD = 'Cybexos8!'


def check_installed_identity(media, installed, source):
    """Require the ISO's exact content identity after a bundled test install.

    Development installation locks the bundled directory as a path input. Nix
    preserves its NAR hash but supplies no Git revision to that flake. Record
    this metadata distinction rather than rejecting identical source bytes or
    claiming that the installed flake still carries the medium's Git metadata.
    """
    if (not all(media.get(key) for key in ('version', 'revision', 'narHash'))
            or installed.get('version') != media.get('version')
            or installed.get('narHash') != media.get('narHash')
            or source.get('narHash') != media.get('narHash')):
        raise RuntimeError('Installed product differs from ISO source identity')
    expected_revision = 'uncommitted' if source.get('type') == 'path' else media.get('revision')
    if (installed.get('revision') != expected_revision
            or (source.get('type') != 'path' and source.get('rev') != media.get('revision'))):
        raise RuntimeError('Installed product has unexpected source revision metadata')
    return {'result': 'passed', 'isoRelease': media, 'installedRelease': installed,
            'installedSource': source,
            'scope': 'same exact source NAR; bundled path inputs have no Git revision metadata'
                     if source.get('type') == 'path' else 'same exact source revision and NAR'}


class VM:
    def __init__(self, directory, disk, iso=None):
        self.directory, self.disk, self.iso = directory, disk, iso
        self.process = None
        self.control_directory = None
        self.command_ready = False
        self.firmware = Path(os.environ['CYBEXOS_OVMF'])
        self.vars = directory / 'vars.fd'
        if not self.vars.exists():
            shutil.copyfile(self.firmware / 'OVMF_VARS.fd', self.vars)

    def start(self):
        self.command_ready = False
        # Unix socket names are limited to 108 bytes even when disks/logs live
        # in a deeply nested task directory. Keep only the small control socket
        # in /tmp, and remove it with this VM's process.
        self.control_directory = tempfile.TemporaryDirectory(prefix='ndvm.', dir='/tmp')
        self.qmp = Path(self.control_directory.name) / 'qmp.sock'
        args = ['-no-user-config','-machine','q35','-accel','kvm' if os.access('/dev/kvm',os.R_OK|os.W_OK) else 'tcg,thread=multi',
                '-cpu','host' if os.access('/dev/kvm',os.R_OK|os.W_OK) else 'max', '-m','12288','-smp','4',
                '-drive',f'if=pflash,format=raw,readonly=on,file={self.firmware / "OVMF_CODE.fd"}',
                '-drive',f'if=pflash,format=raw,file={self.vars}',
                '-drive',f'file={self.disk},if=none,id=systemdisk,format=qcow2','-device','virtio-blk-pci,drive=systemdisk,serial=CYBEXOS-QA-DISK',
                '-netdev','user,id=net','-device','virtio-net-pci,netdev=net','-device','virtio-vga',
                # An absolute pointer lets QMP click the installer screen exactly.
                '-device','qemu-xhci','-device','usb-tablet',
                '-display','none','-serial','stdio','-no-reboot', '-qmp',f'unix:{self.qmp},server=on,wait=off']
        if self.iso:
            args += ['-cdrom',str(self.iso),'-boot','d']
        self.process = pexpect.spawn('qemu-system-x86_64',args,encoding='utf-8',timeout=600,maxread=65536)
        self.process.delaybeforesend = 0.05
        # This private, disposable log contains only public QA credentials.
        self.log = (self.directory / 'serial.log').open('a')
        self.process.logfile_read = self.log

    def login(self, live=False, encrypted=False, password=PASSWORD):
        if encrypted:
            self.process.expect(r'(?i)(passphrase for|enter passphrase)',timeout=600)
            self.process.sendline(password)
        # The installation medium has no live account: its serial console is
        # a root shell, used here only to observe the installer services.
        # The medium's autologin banner itself contains "login:".
        index = 1 if live else 0
        self.process.expect(r'root@cybexos-installer' if live else r'login:', timeout=600)
        if index == 0:
            self.process.sendline('cybexqa')
            self.process.expect('Password:');self.process.sendline(password)
        # Fish's terminal capability queries can take seconds on a serial
        # console; wait for the shell before sending administration commands.
        time.sleep(4 if live else 2)
        if not live:
            self.process.sendline('sudo -i')
            index = self.process.expect([r'password for cybexqa:',r'root@'],timeout=60)
            if index == 0:
                self.process.sendline(password)
                self.process.expect(r'root@',timeout=60)
        self.process.sendline('export TERM=dumb; export PS1="CYBEXOS_ROOT> "; stty -echo')
        self.process.expect('CYBEXOS_ROOT> ',timeout=30)
        self.command('true')

    def command(self, script, timeout=1800):
        marker = 'CYBEXOS_QA_' + os.urandom(6).hex()
        command = 'bash -c ' + shlex.quote('printf "\\n' + marker + '_BEGIN\\n"\n(set -e\n' + script + '\n)\nqa_result=$?\nprintf "\\n'+marker+':%s\\n" "$qa_result"')
        self.command_ready = False
        self.process.sendline(command)
        self.process.expect(r'\r*\n'+marker+r'_BEGIN\r*\n',timeout=timeout)
        self.process.expect(r'\r*\n'+marker+r':([0-9]+)\r*\n',timeout=timeout)
        self.command_ready = True
        body=self.process.before
        if self.process.match.group(1) != '0':
            raise RuntimeError('Guest command failed: '+script[:160]+'\n'+body[-4000:])
        return body

    def failure_diagnostics(self):
        """Read bounded diagnostics only when a completed command left a shell.

        Do not inject another command after a broken serial transport, during
        login, or into an installer still running. No credential files, full
        process environments or build logs are collected.
        """
        if not self.command_ready or self.process is None or not self.process.isalive():
            return {'state': 'unavailable', 'reason': 'No authenticated idle serial command transport'}
        if self.iso:
            # The installation medium carries no Python or desktop session.
            script = '''systemctl --failed --no-pager --no-legend || true
systemctl status --no-pager -n 0 cybexos-installerd.service cybexos-installer-ui.service || true
journalctl -b --no-pager -u cybexos-installerd.service -u cybexos-installer-ui.service -n 60 || true'''
            try:
                return {'state': 'collected', 'medium': self.command(script, timeout=120)[-6000:]}
            except Exception as error:
                return {'state': 'failed', 'error': str(error)[-2000:]}
        script = r'''python3 - <<'QA_DIAGNOSTIC'
import json, pwd, shutil, subprocess
from pathlib import Path
output = {}
def run(label, args):
    try:
        result = subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=15)
        output[label] = {'status': result.returncode, 'output': result.stdout[-3000:]}
        return result.stdout
    except Exception as error:
        output[label] = {'error': str(error)}
        return ''
run('updaterStatus', ['cybex', 'update', 'status'])
prefix = ['runuser', '-u', pwd.getpwuid(1000).pw_name, '--', 'env', 'XDG_RUNTIME_DIR=/run/user/1000', 'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus']
environment = run('environment', prefix + ['systemctl', '--user', 'show-environment'])
output.pop('environment')
signature = next((line.split('=', 1)[1] for line in environment.splitlines() if line.startswith('HYPRLAND_INSTANCE_SIGNATURE=')), '')
if signature:
    run('hyprlandConfigErrors', prefix + ['HYPRLAND_INSTANCE_SIGNATURE=' + signature, 'hyprctl', '-j', 'configerrors'])
pid = run('quickshellPid', prefix + ['systemctl', '--user', 'show', 'quickshell.service', '-p', 'MainPID', '--value']).strip()
if pid.isdecimal() and int(pid) > 0:
    try:
        path = next((entry.decode(errors='replace')[5:] for entry in Path('/proc', pid, 'environ').read_bytes().split(b'\0') if entry.startswith(b'PATH=')), '')
        output['quickshellPath'] = path[:3000]
        output['quickshellHelpers'] = {name: shutil.which(name, path=path) for name in ['cybex', 'quickshell-reminder', 'tailscale']}
    except OSError as error:
        output['quickshellPath'] = {'error': str(error)}
invocation = run('quickshellInvocation', prefix + ['systemctl', '--user', 'show', 'quickshell.service', '-p', 'InvocationID', '--value']).strip()
if invocation:
    run('quickshellCurrentWarnings', ['journalctl', '--no-pager', '_SYSTEMD_INVOCATION_ID=' + invocation, '-p', 'warning', '-n', '20'])
run('failedSystemUnits', ['systemctl', '--failed', '--no-pager', '--no-legend'])
run('passwordPam', ['cat', '/etc/pam.d/passwd'])
run('loginPam', ['cat', '/etc/pam.d/sddm'])
run('keyringState', prefix + ['busctl', '--user', 'get-property', 'org.freedesktop.secrets',
    '/org/freedesktop/secrets/collection/login', 'org.freedesktop.Secret.Collection', 'Locked'])
run('keyringJournal', ['journalctl', '--no-pager', '-g', 'gkr-pam|gnome-keyring', '-n', '40'])
print(json.dumps(output))
QA_DIAGNOSTIC'''
        try:
            return {'state': 'collected', 'checks': json.loads(self.command(script, timeout=120).strip())}
        except Exception as error:
            return {'state': 'failed', 'error': str(error)[-2000:]}

    def reboot(self, encrypted, password=PASSWORD):
        self.process.sendline('systemctl reboot')
        self.process.expect(pexpect.EOF, timeout=120)
        self.stop()
        self.iso = None
        self.start()
        self.login(encrypted=encrypted, password=password)

    def login_desktop(self, password=PASSWORD):
        # SDDM has one normal account; its password field has initial focus.
        qmp = socket.socket(socket.AF_UNIX)
        qmp.connect(str(self.qmp))
        stream=qmp.makefile('rwb',buffering=0)
        json.loads(stream.readline())
        def call(execute, arguments=None):
            stream.write((json.dumps({'execute':execute,'arguments':arguments or {}})+'\n').encode())
            while True:
                result=json.loads(stream.readline())
                if 'error' in result:raise RuntimeError(str(result))
                if 'return' in result:return result
        call('qmp_capabilities')
        for char in password:
            key={'-':'minus', '!':'shift-1'}.get(char, 'shift-'+char.lower() if char.isupper() else char)
            call('human-monitor-command',{'command-line':'sendkey '+key})
            time.sleep(.08)
        call('human-monitor-command',{'command-line':'sendkey ret'})
        stream.close();qmp.close()
        self.command('for n in $(seq 1 90); do cybexos-health desktop-required && exit 0; sleep 2; done; exit 1',timeout=240)

    def check_desktop_defaults(self):
        self.command(r'''python3 - <<'QA_DEFAULTS'
import json, pathlib, pwd, subprocess
user = pwd.getpwuid(1000)
prefix = ['runuser', '-u', user.pw_name, '--', 'env', 'XDG_RUNTIME_DIR=/run/user/1000',
          'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus']
environment = subprocess.check_output(prefix + ['systemctl', '--user', 'show-environment'], text=True)
assert 'XCURSOR_THEME=Bibata-Modern-Classic' in environment
assert 'XCURSOR_SIZE=24' in environment
pid = subprocess.check_output(prefix + ['systemctl', '--user', 'show', 'quickshell.service', '-p', 'MainPID', '--value'], text=True).strip()
runtime = dict(part.split('=', 1) for part in pathlib.Path('/proc', pid, 'environ').read_text().split('\0') if '=' in part)
schema_environment = [key + '=' + runtime[key] for key in ('XDG_DATA_DIRS', 'GSETTINGS_SCHEMA_DIR') if key in runtime]
assert subprocess.check_output(prefix + schema_environment + ['gsettings', 'get', 'org.gnome.desktop.interface', 'cursor-theme'], text=True).strip() == "'Bibata-Modern-Classic'"
subprocess.run(['systemctl', 'is-active', '--quiet', 'avahi-daemon.service'], check=True)
subprocess.run(['systemctl', 'is-active', '--quiet', 'firewall.service'], check=True)
assert '5353' in subprocess.check_output(['iptables-save'], text=True)
path = pathlib.Path(user.pw_dir, '.config/cybexos/shell.json')
if path.exists():
    saved = json.loads(path.read_text())
    if 'mods' in saved:
        flags = {entry['id']: entry['on'] for column in saved['mods'].values() for entry in column}
        assert flags['modelusage'] is True
        assert all(flags[key] is False for key in ('hermes', 'remote', 't3', 'gh', 'fusebox'))
print('Bibata desktop/session cursor, local discovery, firewall, and saved widget defaults passed')
QA_DEFAULTS''', timeout=60)

    def password_change(self, encrypted, evidence=None):
        evidence = {} if evidence is None else evidence
        evidence.update(result='running', encrypted=encrypted, roundTrips=0)
        prefix = 'runuser -u cybexqa -- env XDG_RUNTIME_DIR=/run/user/1000 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus '
        self.command('timeout 30 ' + prefix + "sh -c 'printf qa-keyring-value | secret-tool store --label=Qualification cybexos qualification'", timeout=45)
        evidence['keyringStored'] = True
        for current, new in ((PASSWORD, 'Changed8!'), ('Changed8!', PASSWORD)):
            request = json.dumps({'current': current, 'new': new})
            script = 'printf %s ' + shlex.quote(request) + ' | env PKEXEC_UID=1000 cybexos-password-worker'
            result = json.loads(self.command(script, timeout=360).strip())
            if result.get('success') is not True:
                raise RuntimeError('Installed password worker: ' + json.dumps(result))
            evidence['accountChanges'] = evidence.get('accountChanges', 0) + 1
            if encrypted:
                self.command('printf %s ' + shlex.quote(new) + ' | cryptsetup open --test-passphrase --key-file - /dev/vda2\n' +
                             '! printf %s ' + shlex.quote(current) + ' | cryptsetup open --test-passphrase --key-file - /dev/vda2', timeout=90)
            self.command('test ! -e /var/lib/cybexos/password-change.json')
            self.reboot(encrypted, password=new)
            self.login_desktop(password=new)
            self.command('test "$(timeout 20 ' + prefix + 'secret-tool lookup cybexos qualification)" = qa-keyring-value', timeout=35)
            evidence['roundTrips'] += 1
        self.command(prefix + 'secret-tool clear cybexos qualification')
        evidence.update(result='passed', checks=['real packaged worker and PAM',
            'old disk key rejected' if encrypted else 'no disk change',
            'reboot and password desktop login', 'login keyring unlocked with changed password'])
        return evidence

    def qmp_commands(self, *commands):
        """Run QMP commands on the VM's own monitor, in order."""
        with socket.socket(socket.AF_UNIX) as qmp:
            qmp.connect(str(self.qmp))
            with qmp.makefile('rwb', buffering=0) as stream:
                json.loads(stream.readline())
                for command in ({'execute': 'qmp_capabilities'}, *commands):
                    stream.write((json.dumps(command) + '\n').encode())
                    while True:
                        result = json.loads(stream.readline())
                        if 'error' in result:
                            raise RuntimeError(str(result['error']))
                        if 'return' in result:
                            break

    def screenshot(self, path):
        """Capture the actual VM display, never a reconstructed installer screen."""
        from PIL import Image
        path.parent.mkdir(parents=True, exist_ok=True)
        temporary = path.with_suffix('.ppm')
        self.qmp_commands({'execute': 'screendump', 'arguments': {'filename': str(temporary)}})
        try:
            with Image.open(temporary) as display:
                display.save(path)
                return display.size
        finally:
            temporary.unlink(missing_ok=True)

    KEYS = {' ': 'spc', '!': 'shift-1', '-': 'minus', '.': 'dot', '@': 'shift-2', '_': 'shift-minus'}

    def press(self, *keys):
        """Real keyboard input through the VM's PS/2 keyboard."""
        for key in keys:
            self.qmp_commands({'execute': 'human-monitor-command', 'arguments': {'command-line': 'sendkey ' + key}})
            time.sleep(0.12)

    def type_text(self, text):
        self.press(*[self.KEYS.get(c, 'shift-' + c.lower() if c.isupper() else c) for c in text])

    def click(self, x, y, size=(1280, 800)):
        """A real pointer click at canvas coordinates through the USB tablet.

        The screen fits its 1280×800 canvas to the display and centres it, with
        the same zoom rule as cybexos-installer (src/zoom.rs).
        """
        zoom = round(min(max(min(size[0] / 1280, size[1] / 800), 0.8), 3.0), 2)
        px = ((size[0] / zoom - 1280) / 2 + x) * zoom
        py = ((size[1] / zoom - 800) / 2 + y) * zoom
        def axis(value, extent):
            return {'type': 'abs', 'data': {'axis': value, 'value': int(round(extent))}}
        position = [axis('x', px * 32767 / (size[0] - 1)), axis('y', py * 32767 / (size[1] - 1))]
        button = lambda down: {'type': 'btn', 'data': {'down': down, 'button': 'left'}}
        self.qmp_commands({'execute': 'input-send-event', 'arguments': {'events': position}})
        time.sleep(0.2)
        self.qmp_commands({'execute': 'input-send-event', 'arguments': {'events': [button(True)]}},
                          {'execute': 'input-send-event', 'arguments': {'events': [button(False)]}})
        time.sleep(0.3)

    def installer_state(self, timeout=20):
        """The installer service's current snapshot, exactly as the screen receives it."""
        import base64
        raw = self.command(f'cybexos-installerd --client --timeout {timeout} | base64 -w0', timeout=timeout + 60).strip()
        return json.loads(base64.b64decode(raw))

    def installer_request(self, request):
        self.command('cybexos-installerd --client --timeout 5 --request ' + shlex.quote(json.dumps(request)) + ' >/dev/null', timeout=60)

    def wait_installer(self, predicate, what, timeout=600, interval=2):
        deadline = time.monotonic() + timeout
        state = {}
        while time.monotonic() < deadline:
            state = self.installer_state()
            if predicate(state):
                return state
            if state.get('phase') in ('error', 'cancelled'):
                raise RuntimeError(f'Installer stopped while waiting for {what}: ' + str(state.get('error')))
            time.sleep(interval)
        raise RuntimeError(f'Timed out waiting for {what}; last phase {state.get("phase")}, error {state.get("error")!r}')

    def graphical_install(self, encrypted, applications, screenshots=None):
        """Install through the real tty1 screen with real keyboard and pointer input.

        The screen (cybexos-installer) and its state service (cybexos-installerd)
        are the packaged ISO units. The serial console only observes the
        service's snapshots; every choice that matters is made on the screen:
        development consent, navigation, encryption, name, username, both
        passwords and the final erase click. Only QA-only choices without a
        bearing on the screen (serial console, the smaller application set)
        are set through the same service the screen uses.
        """
        evidence = {'result': 'running'}
        shot = lambda name: screenshots and self.screenshot(screenshots / name)
        self.command('systemctl is-active cybexos-installerd.service cybexos-installer-ui.service')
        self.command('test "$(systemctl show cybexos-installer-ui.service -p User --value)" = cybexos-installer')
        # The bracket keeps pgrep -f from matching this command's own shell.
        self.command("! id nixos && ! pgrep -x Hyprland && ! pgrep -f '[q]uickshell' && ! systemctl is-active --quiet display-manager.service")
        evidence['installerOnlyRuntime'] = 'tty1 kiosk as cybexos-installer; no live account, compositor or display manager'
        # The installed QA system keeps a serial console for this harness.
        self.command("mkdir -p /run/systemd/system/cybexos-installerd.service.d\n"
                     "printf '[Service]\\nEnvironment=CYBEXOS_INSTALLER_WORKER_ARGS=--serial-console\\n' > /run/systemd/system/cybexos-installerd.service.d/qa.conf\n"
                     "systemctl daemon-reload\nsystemctl restart cybexos-installerd.service")
        # The restart disconnects the screen; keys sent before it reconnects
        # reach no page. Wait for the service's report of an attached screen.
        state = self.wait_installer(lambda s: s.get('phase') in ('development', 'setup') and s.get('screens', 0) > 0,
                                    'the release checks and the reconnected screen')
        size = self.screenshot(screenshots / 'welcome.png') if screenshots else (1280, 800)
        evidence['display'] = list(size)
        if state['phase'] == 'development':
            self.press('ret')
            state = self.wait_installer(lambda s: s.get('phase') == 'setup', 'development consent')
            evidence['developmentConsent'] = 'Enter on the screen'
        shot('welcome-ready.png')
        if applications == 'minimal':
            self.installer_request({'action': 'draft', 'values': {'apps': {
                'developer': False, 'proprietary': False, 'steam': False, 'docker': False, 'connectedWidgets': False}}})
        self.press('ret')
        state = self.wait_installer(lambda s: s['draft']['screen'] == 'disk', 'the disk step')
        if len([d for d in state['disks'] if d['available']]) == 1 and not state['draft']['disk']:
            raise RuntimeError('The only available disk was not preselected')
        if not encrypted:
            self.click(1169, 291, size)
            state = self.wait_installer(lambda s: s['draft']['encrypted'] is False, 'the encryption switch')
            evidence['encryptionSwitch'] = 'pointer click turned encryption off'
        shot('disk.png')
        self.press('ret')
        state = self.wait_installer(lambda s: s['draft']['screen'] == 'account', 'the account step')
        self.type_text('Cybex QA')
        self.press('ret', 'ctrl-a')
        self.type_text('CybexQA')
        state = self.wait_installer(lambda s: s['draft']['username'] == 'cybexqa', 'the lowercase username')
        if state['draft']['fullName'] != 'Cybex QA':
            raise RuntimeError('The typed name did not reach the installer service: ' + repr(state['draft']['fullName']))
        evidence['lowercaseUsername'] = 'typed CybexQA; the screen kept cybexqa'
        self.press('ret')
        self.type_text(PASSWORD)
        self.press('ret')
        self.type_text(PASSWORD)
        shot('account.png')
        self.press('ret')
        state = self.wait_installer(lambda s: s.get('phase') == 'review' and not s.get('reviewPending'), 'the review')
        plan = state['review']
        expected = {'username': 'cybexqa', 'fullName': 'Cybex QA', 'hostname': 'cybexqa-cybexos', 'encrypted': encrypted, 'disk': '/dev/vda'}
        if {key: plan.get(key) for key in expected} != expected:
            raise RuntimeError('Reviewed plan differs from the screen input: ' + json.dumps(plan))
        evidence['reviewedPlan'] = {key: plan.get(key) for key in ('username', 'fullName', 'hostname', 'timezone', 'keyboard', 'encrypted', 'features')}
        shot('review.png')
        self.click(1024, 755, size)
        self.wait_installer(lambda s: s.get('phase') in ('installing', 'complete'), 'the erase confirmation', timeout=120)
        shot('installing.png')
        state = self.wait_installer(lambda s: s.get('phase') == 'complete', 'installation', timeout=10800, interval=20)
        shot('installation-complete.png')
        evidence.update(result='passed', completed=state.get('result'))
        return evidence

    def stop(self):
        if self.process is not None:
            if self.process.isalive():
                self.process.terminate(force=True)
            self.process.close()
            self.log.close()
            self.process=None
        if self.control_directory is not None:
            self.control_directory.cleanup()
            self.control_directory = None


def wait_state(vm, expected, timeout=2100, previous=None):
    """Observe the real worker; asynchronous acceptance is not completion."""
    script = '''deadline=$((SECONDS + TIMEOUT))
while test "$SECONDS" -lt "$deadline"; do
  read -r state transaction < <(cybex update status | python3 -c 'import json,sys;s=json.load(sys.stdin);print(s["state"],s.get("transaction",""))')
  if test "$transaction" = PREVIOUS; then sleep 2; continue; fi
  case "$state" in
    EXPECTED) cybex update status; exit 0 ;;
    failed|rolled-back) cybex update status; exit 1 ;;
  esac
  sleep 2
done
cybex update status
exit 1'''.replace('TIMEOUT', str(timeout)).replace('EXPECTED', '|'.join(expected)).replace('PREVIOUS', shlex.quote(previous or 'no-previous-transaction'))
    return vm.command(script, timeout=timeout + 30)


def stage_request(vm, scope='local'):
    previous = json.loads(vm.command('cybex update status').strip()).get('transaction')
    vm.command('cybex update stage ' + shlex.quote(scope))
    return previous


def stage(vm, scope='local'):
    previous = stage_request(vm, scope)
    wait_state(vm, ('ready',), previous=previous)
    vm.command('cybex update status > /run/qa-status.json')
    # Parsing directly from the serial console can include prompts; have the
    # guest produce only base64 JSON between the command's completion markers.
    import base64
    payload = vm.command('base64 -w0 /run/qa-status.json').strip()
    return json.loads(base64.b64decode(payload))


def apply(vm, status):
    vm.command('cybex update apply ' + shlex.quote(status['transaction']) + ' ' + shlex.quote(status['reviewToken']))
    wait_state(vm, ('awaiting-boot',), timeout=300)


def authenticated_boot(vm, encrypted):
    vm.reboot(encrypted)
    wait_state(vm, ('awaiting-login',), timeout=180)
    vm.login_desktop()
    vm.command('cybexos-health desktop-required', timeout=180)


def confirm(vm):
    vm.command('cybex update confirm')
    wait_state(vm, ('done',), timeout=180)
    vm.command('test ! -e /var/lib/cybexos/pending.json')


PERSONAL_MODULE = '''{ pkgs, ... }: {
  environment.systemPackages = [ pkgs.hello ];
  environment.etc."cybexos-qualification-generation".text = "baseline";
  networking.wg-quick.interfaces.qualification = {
    autostart = false; address = [ "192.0.2.2/32" ];
    privateKeyFile = "/var/lib/cybexos/secrets/qualification-vpn.key";
  };
  systemd.services.cybexos-qualification-state = {
    wantedBy = [ "multi-user.target" ];
    serviceConfig = { Type = "oneshot"; RemainAfterExit = true; StateDirectory = "cybexos-qualification"; };
    script = "test -e /var/lib/cybexos-qualification/state || printf personal-state > /var/lib/cybexos-qualification/state";
  };
}
'''


def edit_import(vm, filename, text=None):
    """Modify only a task-owned local module and its explicit import."""
    code = '''from pathlib import Path
root = Path('/etc/nixos/local')
path = root / FILENAME
default = root / 'default.nix'
text = default.read_text()
TEXT
'''.replace('FILENAME', repr(filename))
    if text is None:
        action = "default.write_text(text.replace('./' + path.name + ' ', '', 1)); path.unlink()"
    else:
        action = "path.write_text(" + repr(text) + "); default.write_text(text.replace('imports = [ ', 'imports = [ ./' + path.name + ' ', 1))"
    vm.command("python3 - <<'QA'\n" + code.replace('TEXT', action) + '\nQA')


def qualify_lifecycle(vm, encrypted, checks=None):
    """Deploy a personal known-good baseline before testing candidate rollback.

    QA secrets are generated only inside the disposable guest; they do not
    enter a Nix expression, retained evidence or host serial log.
    """
    checks = {} if checks is None else checks
    discovery = json.loads(vm.command('cybex update check', timeout=240).strip())
    if discovery['upstream']['state'] not in ('current', 'available'):
        raise RuntimeError('Cannot qualify independent upstream discovery: ' + json.dumps(discovery))
    if discovery['cybexos']['state'] != 'unavailable' or not discovery['cybexos'].get('error'):
        raise RuntimeError('This development test requires an accurately unavailable vendor channel: ' + json.dumps(discovery))
    before = json.loads(vm.command('''python3 - <<'QA'
from pathlib import Path
import hashlib, json
path = Path('/etc/nixos/flake.lock')
lock = json.loads(path.read_text())
root = lock['nodes'][lock['root']]['inputs']
print(json.dumps({'lockSha256': hashlib.sha256(path.read_bytes()).hexdigest(),
                 **{name: lock['nodes'][root[name]]['locked'] for name in ('nixpkgs', 'cybexos')}}))
QA
''').strip())
    upstream = stage(vm, 'upstream')
    if upstream['inputs']['cybexos'] != before['cybexos']:
        raise RuntimeError('Upstream staging changed the installed Cybex OS identity')
    after_hash = vm.command("sha256sum /etc/nixos/flake.lock | cut -d ' ' -f 1").strip()
    if after_hash != before['lockSha256']:
        raise RuntimeError('Staging changed the working machine lock')
    checks['upstreamWithUnavailableVendor'] = {
        'result': 'passed', 'discovery': discovery, 'transaction': upstream['transaction'],
        'upstreamBefore': before['nixpkgs'], 'upstreamAfter': upstream['inputs']['nixpkgs'],
        'upstreamChanged': before['nixpkgs'] != upstream['inputs']['nixpkgs'], 'applied': False,
        'scope': 'actual independent discovery and complete upstream worker build/validation; candidate remains unapplied; unchanged identity is not changed-package update qualification'}
    edit_import(vm, 'qualification.nix', PERSONAL_MODULE)
    vm.command('''python3 - <<'QA'
from pathlib import Path
import json, os, pwd, base64
secret = Path('/var/lib/cybexos/secrets/qualification-vpn.key')
secret.write_text(base64.b64encode(os.urandom(32)).decode() + '\\n'); secret.chmod(0o600)
user = pwd.getpwnam('cybexqa'); home = Path(user.pw_dir)
plugin = home / '.local/share/cybexos/plugins/personal.qualification'
plugin.mkdir(parents=True)
(plugin / 'manifest.json').write_text(json.dumps({'id':'personal.qualification','name':'Qualification', 'version':'1.0.0','apiVersion':1,'entrypoint':'Widget.qml'}))
(plugin / 'Widget.qml').write_text('import QtQuick\\nText { required property var pluginApi; text: pluginApi.settings.label; Component.onCompleted: console.log("CYBEXOS_QA_PLUGIN_API:" + pluginApi.version + ":" + pluginApi.settings.label) }\\n')
preferences = home / '.config/cybexos/shell.json'
saved = json.loads(preferences.read_text()) if preferences.exists() else {}
saved['reducedMotion'] = True
preferences.write_text(json.dumps(saved))
for path in [plugin, *plugin.rglob('*'), preferences]:
    os.chown(path, user.pw_uid, user.pw_gid)
QA
runuser -u cybexqa -- cybex plugin enable personal.qualification --width 120 --order 2
runuser -u cybexqa -- cybex plugin set personal.qualification label '"persistent-widget"'
runuser -u cybexqa -- sh -c 'printf personal-plugin-state > "$HOME/.local/share/cybexos/plugin-data/personal.qualification/state"'
''')
    baseline = stage(vm)
    apply(vm, baseline)
    authenticated_boot(vm, encrypted)
    confirm(vm)
    checks['personalBaseline'] = {'result': 'passed', 'transaction': baseline['transaction']}
    # Snapshot after the shell has normalized the supported preference schema.
    vm.command('''uid=$(id -u cybexqa)
invocation=$(runuser -u cybexqa -- env XDG_RUNTIME_DIR=/run/user/$uid DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus systemctl --user show quickshell.service -p InvocationID --value)
journalctl --no-pager _SYSTEMD_INVOCATION_ID=$invocation | grep -F 'CYBEXOS_QA_PLUGIN_API:1:persistent-widget'
systemctl is-active cybexos-qualification-state.service
hello --version
test "$(cat /etc/cybexos-qualification-generation)" = baseline
# The lifecycle selects /etc/nixos through an owned working-tree symlink.
# Resolve that root before pure evaluation, matching the staged configuration.
configuration=$(readlink -f /etc/nixos)
test "$(nix eval --raw --no-update-lock-file "path:$configuration#nixosConfigurations.cybexos.config.networking.wg-quick.interfaces.qualification.privateKeyFile")" = /var/lib/cybexos/secrets/qualification-vpn.key
python3 - <<'QA'
from pathlib import Path
import hashlib, json
paths = ['/etc/nixos/local/default.nix', '/etc/nixos/local/qualification.nix',
 '/var/lib/cybexos/secrets/qualification-vpn.key', '/var/lib/cybexos-qualification/state',
 '/home/cybexqa/.config/cybexos/shell.json', '/home/cybexqa/.config/cybexos/plugins.json',
 '/home/cybexqa/.local/share/cybexos/plugins/personal.qualification/manifest.json',
 '/home/cybexqa/.local/share/cybexos/plugins/personal.qualification/Widget.qml',
 '/home/cybexqa/.local/share/cybexos/plugin-data/personal.qualification/state']
Path('/var/lib/cybexos-qualification/hashes.json').write_text(json.dumps({p:hashlib.sha256(Path(p).read_bytes()).hexdigest() for p in paths}))
QA
''')
    preserve = '''python3 - <<'QA'
from pathlib import Path
import hashlib, json
for path, expected in json.loads(Path('/var/lib/cybexos-qualification/hashes.json').read_text()).items():
    assert hashlib.sha256(Path(path).read_bytes()).hexdigest() == expected, 'Personal file changed: ' + path
QA
systemctl is-active cybexos-qualification-state.service
hello --version
cybexos-health desktop-required
'''
    for name, expression in (
        ('evaluationFailure', '{ ... }: throw "intentional qualification evaluation failure"'),
        ('buildFailure', '{ pkgs, ... }: { environment.systemPackages = [ (pkgs.runCommand "cybexos-qualification-build-failure" {} "exit 93") ]; }')):
        vm.command('readlink -f /run/current-system > /run/qa-system-before; sha256sum /etc/nixos/flake.lock > /run/qa-lock-before')
        edit_import(vm, 'qualification-fault.nix', expression)
        previous = stage_request(vm)
        wait_state(vm, ('failed',), previous=previous)
        vm.command('test "$(readlink -f /run/current-system)" = "$(cat /run/qa-system-before)"; sha256sum -c /run/qa-lock-before\ntest ! -e /var/lib/cybexos/pending.json')
        edit_import(vm, 'qualification-fault.nix')
        vm.command(preserve)
        checks[name] = {'result': 'passed'}

    # Kill the actual staging worker during a real build, then let the boot
    # recovery service inspect its durable status. No fabricated pending record.
    edit_import(vm, 'qualification-fault.nix', '{ pkgs, ... }: { environment.systemPackages = [ (pkgs.runCommand "cybexos-qualification-interruption" {} "sleep 300; touch $out") ]; }')
    previous = stage_request(vm)
    wait_state(vm, ('building',), timeout=180, previous=previous)
    vm.command('systemctl kill --kill-whom=all --signal=KILL cybexos-stage@local.service')
    vm.reboot(encrypted)
    wait_state(vm, ('interrupted',), timeout=180)
    vm.login_desktop()
    edit_import(vm, 'qualification-fault.nix')
    vm.command(preserve)
    checks['interruptedStageRecovery'] = {'result': 'passed'}

    edit_import(vm, 'qualification-candidate.nix', '{ ... }: { environment.etc."cybexos-qualification-candidate".text = "candidate"; }')
    candidate = stage(vm)
    apply(vm, candidate)
    authenticated_boot(vm, encrypted)
    confirm(vm)
    # default.nix now intentionally includes the candidate import.
    vm.command(preserve.replace('    assert hashlib', "    if path.endswith('/local/default.nix'): continue\n    assert hashlib"))
    vm.command('test "$(cat /etc/cybexos-qualification-candidate)" = candidate')
    checks['localApplyBootConfirm'] = {'result': 'passed', 'transaction': candidate['transaction']}
    vm.command('cybex update rollback ' + candidate['transaction'])
    wait_state(vm, ('rolled-back',), timeout=180)
    vm.reboot(encrypted)
    vm.login_desktop()
    vm.command(preserve)
    vm.command('test ! -e /etc/cybexos-qualification-candidate\ntest "$(cat /etc/cybexos-qualification-generation)" = baseline\ntest ! -e /var/lib/cybexos/pending.json')
    checks['rollbackAndPersonalPersistence'] = {'result': 'passed'}
    return checks


def qualify(iso, encrypted, base, lifecycle=True, evidence=None, *, interactive=False, applications='minimal', screenshots=None):
    evidence = {} if evidence is None else evidence
    milestones = evidence.setdefault('milestones', {})
    case=base/('encrypted' if encrypted else 'plain');case.mkdir()
    disk=case/'disk.qcow2'
    subprocess.run(['qemu-img','create','-f','qcow2',str(disk),'80G'],check=True,capture_output=True)
    plan={'disk':'/dev/vda','serial':'CYBEXOS-QA-DISK','hostname':'cybexos-qa','username':'cybexqa',
          'timezone':'UTC','locale':'en_US.UTF-8','keyboard':'us','encrypted':encrypted,'autoLogin':False,
          'secureBoot':False,'nvidiaOpen':True,'serialConsole':True,
          'features':{'developer':False,'proprietary':False,'steam':False,'docker':False,'connectedWidgets':False}}
    if applications == 'standard':
        plan.pop('features')
    import base64
    plan64=base64.b64encode(json.dumps(plan).encode()).decode()
    secrets=json.dumps({'password':PASSWORD})
    vm=VM(case,disk,iso)
    try:
        vm.start();vm.login(live=True)
        identity=json.loads(vm.command('cat /etc/cybexos/release.json').strip())
        source_metadata=json.loads(vm.command('nix flake metadata --json \"path:$(cat /etc/cybexos/installer-source)\"', timeout=240).strip())
        if identity['narHash'] != source_metadata['locked']['narHash']:
            raise RuntimeError('ISO release identity differs from its installer source NAR')
        evidence['isoReleaseIdentity'] = identity
        milestones['isoSourceIdentity'] = {'result': 'passed'}
        vm.command(f'printf %s {plan64} | base64 -d > /run/qa-plan.json')
        try:
            if interactive:
                milestones['nativeGuiAssertions'] = vm.graphical_install(encrypted, applications, screenshots)
            else:
                vm.command('systemctl stop cybexos-installer-ui.service cybexos-installerd.service\n'
                           'for n in $(seq 1 30); do pgrep -f "cybexos-install --json-ui" >/dev/null || exit 0; sleep 1; done; exit 1', timeout=90)
                vm.command('cybexos-install --plan-file /run/qa-plan.json --secrets-fd 3 --development-source "$(cat /etc/cybexos/installer-source)" 3< <(printf %s '+shlex.quote(secrets)+')',timeout=10800)
        except RuntimeError as error:
            diagnostics = vm.command('tail -c 6000 /run/cybexos-installer.log 2>/dev/null || true')
            raise RuntimeError(str(error) + '\nInstaller diagnostics (disposable QA guest):\n' + diagnostics) from error
        milestones['installerCompleted'] = {'result': 'passed', 'interface': 'tty1 Slint screen with real QMP keyboard and pointer input' if interactive else 'JSON plan', 'applications': applications}
        vm.process.sendline('systemctl poweroff');vm.process.expect(pexpect.EOF,timeout=90);vm.stop()
        vm.iso=None;vm.start();vm.login(encrypted=encrypted)
        milestones['installedBootAndSerialPasswordLogin'] = {'result': 'passed'}
        vm.command('test -L /etc/nixos && test -e /etc/cybexos/runtime/quickshell/shell.qml')
        installed_identity=json.loads(vm.command('cat /etc/cybexos/release.json').strip())
        installed_source=json.loads(vm.command('''python3 - <<'QA_SOURCE'
import json
from pathlib import Path
lock = json.loads(Path('/etc/nixos/flake.lock').read_text())
print(json.dumps(lock['nodes'][lock['nodes'][lock['root']]['inputs']['cybexos']]['locked']))
QA_SOURCE''').strip())
        milestones['installedSourceIdentity'] = check_installed_identity(identity, installed_identity, installed_source)
        vm.command('cybexos-verify-encryption' if encrypted else '! cybexos-verify-encryption')
        milestones['runtimeEncryption'] = {'result': 'passed', 'encrypted': encrypted}
        vm.command('cybexos-desktop-check')
        milestones['desktopConfigurationCheck'] = {'result': 'passed'}
        vm.login_desktop()
        vm.command('cybexos-health desktop-required',timeout=180)
        vm.check_desktop_defaults()
        if screenshots:
            vm.screenshot(screenshots / 'installed-desktop.png')
        milestones['authenticatedDesktopHealth'] = {'result': 'passed', 'login': 'SDDM password login after disk unlock' if encrypted else 'SDDM password login'}
        vm.password_change(encrypted, milestones.setdefault('sharedPasswordChanges', {}))
        if not lifecycle:
            evidence.update(result='passed', scope='actual ISO install, installed boot/login, encryption; no update application')
        else:
            qualify_lifecycle(vm, encrypted, evidence.setdefault('lifecycle', {}))
            evidence.update(result='passed', scope='actual ISO installation, boot/login, local updater failure/interruption, staged application, trial boot/confirmation and rollback; no signed channel or physical qualification')
        return evidence
    except Exception:
        evidence['failureDiagnostics'] = vm.failure_diagnostics()
        raise
    finally:
        vm.stop()


def main():
    parser=argparse.ArgumentParser();parser.add_argument('iso',type=Path);parser.add_argument('--output',type=Path)
    parser.add_argument('--case', choices=('plain', 'encrypted', 'both'), default='both')
    parser.add_argument('--interactive', action='store_true', help='Install through the real tty1 installer screen with keyboard and pointer input, including the erase click')
    parser.add_argument('--applications', choices=('standard', 'minimal'), default='standard', help='Use shared default application groups or the smaller optional selection')
    parser.add_argument('--work-dir', type=Path, help='Parent for disposable VM files; use task storage rather than a memory-backed /tmp')
    parser.add_argument('--screenshots', type=Path, help='Retain actual VM display captures for UX review')
    parser.add_argument('--scenario', choices=('install', 'lifecycle'), default='lifecycle',
                        help='install stops after actual installed desktop login; lifecycle additionally exercises local deployments and recovery')
    args=parser.parse_args();iso=args.iso.resolve()
    result={'kind':'isolated-installation-evidence','isoSha256':hashlib.file_digest(iso.open('rb'),'sha256').hexdigest(),'checks':{}}
    if args.work_dir:
        args.work_dir.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='cybexos-qualification-', dir=args.work_dir) as temporary:
        for encrypted in ((False,True) if args.case == 'both' else (args.case == 'encrypted',)):
            name='encrypted-install' if encrypted else 'plain-install'
            evidence = result['checks'][name] = {'result': 'running'}
            screenshots = args.screenshots.resolve() / name if args.screenshots else None
            try:qualify(iso,encrypted,Path(temporary), args.scenario == 'lifecycle', evidence,
                        interactive=args.interactive, applications=args.applications, screenshots=screenshots)
            except Exception as error:evidence.update(result='failed', error=str(error))
            if args.output:
                args.output.write_text(json.dumps(result, indent=2) + '\n')
    data=json.dumps(result,indent=2)+'\n'
    if args.output:args.output.write_text(data)
    print(data)
    if any(v['result']!='passed' for v in result['checks'].values()):raise SystemExit(1)


if __name__=='__main__':main()
