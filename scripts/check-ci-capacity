#!/usr/bin/env python3
"""Fail clearly before builds on an undersized disposable qualification runner."""
import argparse
import os
from pathlib import Path
import shutil
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--store', type=Path, default=Path('/nix/store'))
parser.add_argument('--work', type=Path, default=Path(os.environ.get('RUNNER_TEMP', '/tmp')))
parser.add_argument('--store-gib', type=int, default=160)
parser.add_argument('--work-gib', type=int, default=32)
parser.add_argument('--memory-gib', type=int, default=24)
parser.add_argument('--vm', action='store_true', help='Also require usable isolated KVM acceleration')
args = parser.parse_args()
if min(args.store_gib, args.work_gib, args.memory_gib) < 0:
    parser.error('Capacity requirements cannot be negative')

gib = 1024 ** 3
errors = []
same_filesystem = args.store.stat().st_dev == args.work.stat().st_dev
required_store = args.store_gib + (args.work_gib if same_filesystem else 0)
for path, required in ((args.store, required_store), (args.work, args.work_gib)):
    free = shutil.disk_usage(path).free // gib
    if free < required:
        errors.append(f'{path}: {free} GiB free; {required} GiB required')

memory = os.sysconf('SC_PHYS_PAGES') * os.sysconf('SC_PAGE_SIZE')
for path in (Path('/sys/fs/cgroup/memory.max'), Path('/sys/fs/cgroup/memory/memory.limit_in_bytes')):
    try:
        value = path.read_text().strip()
        if value != 'max':
            memory = min(memory, int(value))
    except (OSError, ValueError):
        pass
if memory < args.memory_gib * gib:
    errors.append(f'{memory // gib} GiB available memory; {args.memory_gib} GiB required')
if args.vm and not os.access('/dev/kvm', os.R_OK | os.W_OK):
    errors.append('/dev/kvm is unavailable or inaccessible; VM qualification requires KVM')
if errors:
    sys.exit('NerdOS qualification runner is undersized:\n- ' + '\n- '.join(errors)
             + '\nProvision the disposable nerdos-isolated runner described in docs/releasing.md.')
print('Qualification runner capacity passed: Nix store, disposable work space, memory'
      + (' and KVM' if args.vm else ''))
