#!/usr/bin/env python3
"""Rebuild bundled shell icons. Requires fonttools==4.65.0 in a disposable venv.

Only this maintenance command needs the network/fonttools; the shell loads the
generated fonts locally. All input names live in assets/tabler/aliases.json.
"""
import hashlib
import io
import json
from pathlib import Path
import re
import tarfile
import urllib.request

from fontTools import subset
from fontTools.ttLib import TTFont

VERSION = "3.48.0"
SHA256 = "0525656a825b56735c2e87e83d9906ad1e3c42f400918c5ae245217909cffd42"
URL = f"https://registry.npmjs.org/@tabler/icons-webfont/-/icons-webfont-{VERSION}.tgz"
ROOT = Path(__file__).resolve().parents[1] / "roles/desktop/files/quickshell"
ASSETS = ROOT / "assets/tabler"


def main():
    data = urllib.request.urlopen(URL, timeout=60).read()
    if hashlib.sha256(data).hexdigest() != SHA256:
        raise ValueError("Tabler archive checksum mismatch")
    aliases = json.loads((ASSETS / "aliases.json").read_text())
    wanted = set(aliases.values()) | {"help-circle"}
    glyphs = {name: {} for name in sorted(wanted)}
    with tarfile.open(fileobj=io.BytesIO(data)) as archive:
        def read(name):
            return archive.extractfile("package/" + name).read()

        (ASSETS / "LICENSE").write_bytes(read("LICENSE"))
        stem = "tabler-icons"
        css = read(f"dist/{stem}.css").decode()
        available = dict(re.findall(
            r'\.ti-([\w-]+):before\s*\{\s*content: "\\([0-9a-f]+)";', css))
        if wanted - available.keys():
            raise ValueError(f"Unknown Tabler names: {sorted(wanted - available.keys())}")
        codepoints = []
        for name in sorted(wanted & available.keys()):
            codepoint = int(available[name], 16)
            codepoints.append(codepoint)
            glyphs[name]["outline"] = chr(codepoint)
        font = TTFont(io.BytesIO(read(f"dist/fonts/{stem}.ttf")), recalcTimestamp=False)
        options = subset.Options()
        options.recalc_timestamp = False
        options.name_IDs = [0, 1, 2, 3, 4, 5, 6, 13, 14, 16, 17]
        subsetter = subset.Subsetter(options=options)
        subsetter.populate(unicodes=codepoints)
        subsetter.subset(font)
        # Isolate the bundled subset from any other installed Tabler font.
        family = "Cybex Tabler Outline"
        for record in font["name"].names:
            if record.nameID in (1, 3, 4, 6, 16):
                value = family.replace(" ", "") if record.nameID == 6 else family
                record.string = value.encode(record.getEncoding())
        font.save(ASSETS / "outline.ttf")
        (ASSETS / "filled.ttf").unlink(missing_ok=True)

    generated = "// Generated by scripts/update-tabler-icons; do not edit.\n"
    generated += f"// Tabler {VERSION}, MIT. See assets/tabler/LICENSE.\n"
    generated += "var ALIASES = " + json.dumps(aliases, indent=4) + ";\n\n"
    generated += "var GLYPHS = " + json.dumps(glyphs, indent=4, ensure_ascii=True) + ";\n\n"
    generated += '''// Existing semantic names remain valid for built-ins and plugins.
function canonical(name) {
    var key = String(name || "");
    return Object.prototype.hasOwnProperty.call(ALIASES, key) ? ALIASES[key] : key;
}

function has(name) {
    return Object.prototype.hasOwnProperty.call(GLYPHS, canonical(name));
}

function resolve(name) {
    if (!name) return { outline: "" };
    return has(name) ? GLYPHS[canonical(name)] : GLYPHS["help-circle"];
}

if (typeof module !== "undefined")
    module.exports = { ALIASES: ALIASES, GLYPHS: GLYPHS,
        canonical: canonical, has: has, resolve: resolve };
'''
    (ROOT / "Common/TablerGlyphs.js").write_text(generated)
    print(f"Bundled {len(glyphs)} Tabler icons ({len(aliases)} compatibility names)")


if __name__ == "__main__":
    main()
