#!/usr/bin/bash
set -uo pipefail

readonly virtual_sink=xps_speaker_tuning
readonly output_node=xps_speaker_tuning_output
readonly speaker_pattern='^alsa_output.*sof_sdw.*HiFi__Speaker__sink$'
readonly profile=/etc/nerdos/xps-audio/filter-chain.conf
readonly host=/etc/nerdos/xps-audio/host.conf
readonly speaker_wait_attempts=60
readonly speaker_stable_samples=4
readonly speaker_wait_interval=0.25

matches_hardware() {
  [[ $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) == 'Dell Inc.' ]] || return 1
  case "$(cat /sys/class/dmi/id/product_sku 2>/dev/null)" in
    0DB9|0DBA) ;;
    *) return 1 ;;
  esac
  grep -Eqi 'XPS (14|16)|DA14260|DA16260' /sys/class/dmi/id/product_name 2>/dev/null
}

speaker_sink() {
  local sinks
  sinks=$(pactl list sinks short 2>/dev/null | awk -v pattern="$speaker_pattern" '$2 ~ pattern {print $2}')
  [[ $(wc -w <<<"$sinks") -eq 1 ]] || return 1
  printf '%s\n' "$sinks"
}

wait_for_speaker() {
  local attempt candidate='' current stable=0
  for ((attempt = 1; attempt <= speaker_wait_attempts; attempt++)); do
    current=$(speaker_sink 2>/dev/null || true)
    if [[ -n $current && $current == "$candidate" ]]; then
      stable=$((stable + 1))
    elif [[ -n $current ]]; then
      candidate=$current
      stable=1
    else
      candidate=''
      stable=0
    fi

    if ((stable >= speaker_stable_samples)); then
      printf '%s\n' "$candidate"
      return 0
    fi
    ((attempt == speaker_wait_attempts)) || sleep "$speaker_wait_interval"
  done
  return 1
}

tuning_present() {
  pactl list sinks short 2>/dev/null | awk '{print $2}' | grep -Fxq "$virtual_sink"
}

output_sink() {
  local sink_id
  sink_id=$(pactl list sink-inputs 2>/dev/null | awk -v output="$output_node" '
    /^Sink Input #/ { sink = "" }
    /^[[:space:]]+Sink:/ { sink = $2 }
    index($0, "node.name = \"" output "\"") { print sink; exit }
  ')
  [[ -n $sink_id ]] || return 1
  pactl list sinks short 2>/dev/null | awk -v wanted="$sink_id" '$1 == wanted {print $2; exit}'
}

app_streams() {
  pactl list sink-inputs 2>/dev/null | awk '
    /^Sink Input #/ { id = substr($3, 2) }
    /application[.]name = / {
      app = $0
      sub(/.*application[.]name = "/, "", app)
      sub(/"$/, "", app)
      if (app != "EasyEffects") print id
    }
  '
}

move_apps_to() {
  local target=$1 id
  for id in $(app_streams); do
    pactl move-sink-input "$id" "$target" >/dev/null 2>&1 || true
  done
}

plugin_present() {
  [[ -n ${NERDOS_LSP_LV2:-} && -d $NERDOS_LSP_LV2 ]] &&
    grep -Rqs 'http://lsp-plug.in/plugins/lv2/limiter_stereo' "$NERDOS_LSP_LV2"
}

prepare_runtime_config() {
  local speaker=$1 runtime fragment
  runtime="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/xps-speaker-tuning"
  fragment="$runtime/xps-speaker-tuning.conf.d/90-filter-chain.conf"
  rm -rf -- "$runtime"
  install -d -m 0700 "$runtime/xps-speaker-tuning.conf.d"
  install -m 0600 "$host" "$runtime/xps-speaker-tuning.conf"
  sed "s|@SPEAKER_SINK@|$speaker|g" "$profile" >"$fragment"
  chmod 0600 "$fragment"
  printf '%s\n' "$runtime"
}

activate() {
  local speaker downstream default_sink
  speaker=$(wait_for_speaker) || {
    echo 'The exact internal speaker sink did not become stable; leaving audio unchanged.' >&2
    return 1
  }
  for _ in {1..40}; do
    tuning_present && break
    sleep 0.25
  done
  tuning_present || {
    echo 'The XPS speaker tuning sink did not appear; leaving audio unchanged.' >&2
    return 1
  }
  for _ in {1..20}; do
    downstream=$(output_sink 2>/dev/null || true)
    [[ $downstream == "$speaker" ]] && break
    sleep 0.25
  done
  [[ ${downstream:-} == "$speaker" ]] || {
    echo "Tuning output is linked to ${downstream:-nothing}, not $speaker." >&2
    return 1
  }

  # Keep the filter's virtual master neutral. User controls are deliberately
  # redirected to the underlying physical speaker sink.
  pactl set-sink-volume "$virtual_sink" 100% >/dev/null
  pactl set-sink-mute "$virtual_sink" 0 >/dev/null
  default_sink=$(pactl get-default-sink 2>/dev/null || true)
  if [[ $default_sink == "$speaker" || $default_sink == "$virtual_sink" ]]; then
    pactl set-default-sink "$virtual_sink"
    move_apps_to "$virtual_sink"
  fi
}

deactivate() {
  local speaker default_sink
  speaker=$(speaker_sink 2>/dev/null || true)
  [[ -n $speaker ]] || return 0
  default_sink=$(pactl get-default-sink 2>/dev/null || true)
  if [[ $default_sink == "$virtual_sink" ]]; then
    pactl set-default-sink "$speaker" >/dev/null 2>&1 || true
    move_apps_to "$speaker"
  fi
}

control_sink() {
  local default_sink speaker
  default_sink=$(pactl get-default-sink 2>/dev/null) || return 1
  if [[ $default_sink == "$virtual_sink" ]]; then
    speaker=$(speaker_sink) || return 1
    printf '%s\n' "$speaker"
  else
    printf '%s\n' "$default_sink"
  fi
}

control_volume() {
  local operation=$1 target current next
  target=$(control_sink) || return 1
  case "$operation" in
    up|down)
      current=$(pactl get-sink-volume "$target" 2>/dev/null | awk 'NR == 1 {gsub(/%/, "", $5); print $5}')
      [[ $current =~ ^[0-9]+$ ]] || return 1
      if [[ $operation == up ]]; then
        next=$((current + 5)); ((next > 100)) && next=100
      else
        next=$((current - 5)); ((next < 0)) && next=0
      fi
      pactl set-sink-volume "$target" "${next}%"
      ;;
    mute) pactl set-sink-mute "$target" toggle ;;
    *) return 2 ;;
  esac
}

check_graph() {
  local speaker downstream
  matches_hardware || { echo 'Hardware DMI/SKU does not match.' >&2; return 1; }
  [[ $(grep -Ec 'name = s([0-9]+)_[lr]' "$profile") -eq 26 ]] || {
    echo 'The managed profile does not contain 26 channel biquads.' >&2
    return 1
  }
  plugin_present || { echo 'The LSP stereo limiter is missing.' >&2; return 1; }
  speaker=$(speaker_sink) || { echo 'The internal speaker sink is absent.' >&2; return 3; }
  tuning_present || { echo 'The tuning sink is absent.' >&2; return 1; }
  downstream=$(output_sink 2>/dev/null || true)
  [[ $downstream == "$speaker" ]] || {
    echo "The output reaches ${downstream:-nothing}, not $speaker." >&2
    return 1
  }
  printf 'virtual=%s downstream=%s biquads=26 limiter=present\n' "$virtual_sink" "$speaker"
}

if [[ ${BASH_SOURCE[0]} != "$0" ]]; then
  return 0
fi

action=${1:-check}
case "$action" in
  run)
    matches_hardware || { echo 'XPS 2026 speaker SKU does not match.' >&2; exit 1; }
    plugin_present || { echo 'lsp-plugins-lv2 stereo limiter is missing.' >&2; exit 1; }
    speaker=$(wait_for_speaker) || {
      echo 'The exact internal speaker sink did not become stable within 15 seconds.' >&2
      exit 1
    }
    runtime=$(prepare_runtime_config "$speaker") || exit 1
    export PIPEWIRE_CONFIG_DIR="$runtime"
    exec pipewire -c xps-speaker-tuning.conf
    ;;
  activate) activate ;;
  deactivate) deactivate ;;
  check) check_graph ;;
  downstream) output_sink ;;
  physical) speaker_sink ;;
  control) control_volume "${2:-}" ;;
  *) echo 'Usage: xps-speaker-tuning <run|activate|deactivate|check|downstream|physical|control>' >&2; exit 2 ;;
esac
