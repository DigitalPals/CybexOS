             ("token_size_in_bytes", 12), ("max_capacity", 14)),
    ),
    "ia_gofo_boot_config": (
        276, (("length", 0), ("config_version", 4), ("client_version_support", 8),
              ("pkg_dir", 24), ("subsys_config", 28), ("uc_tile_frequency", 32),
              ("checksum", 36), ("uc_tile_frequency_units", 38), ("padding", 39),
