            ("boot_config_size", 984),
        ),
    ),
    "ipu7_psys_pdata": (
        16,
        (("base", 0), ("ipdata", 8)),
    ),
    "ipu7_auxdrv_data": (
        24, (("isr", 0), ("isr_threaded", 8), ("wake_isr_thread", 16)),
    ),
    "ipu7_syscom_context": (
