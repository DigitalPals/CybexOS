#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
cd -- "$repo_dir"
config_path=${CYBEXOS_CONFIG_FILE:-/etc/cybexos/config.yml}
keep_user_data=false
assume_yes=false

usage() {
  cat <<'EOF'
Usage: cybex uninstall [--keep-user-data] [--yes]

Removes CybexOS-owned services and configuration. Fedora packages and
applications are retained. Existing files backed up before adoption are
restored; namespaced user settings, themes, plugins, and overrides are never
deleted. --keep-user-data also retains the backup and updater state.
EOF
}

while (($#)); do
  case $1 in
    --keep-user-data) keep_user_data=true ;;
    --yes) assume_yes=true ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'uninstall: unknown option %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

# An installation made under the former fedora-config name keeps its saved
# answers in /etc/fedora-config until it is moved to the CybexOS paths. An
# explicit configuration file or a dry run never touches the system.
if [[ -z ${CYBEXOS_CONFIG_FILE:-} ]] && {
      [[ -d /etc/fedora-config && ! -L /etc/fedora-config ]] \
        || [[ -d $HOME/.local/share/fedora-config && ! -L $HOME/.local/share/fedora-config ]]
    }; then
  sudo -n true 2>/dev/null || sudo -v
  sudo "$repo_dir/scripts/migrate-legacy-names"
fi

[[ -r $config_path ]] || {
  printf 'uninstall: saved configuration is missing: %s\n' "$config_path" >&2
  exit 1
}

if [[ $assume_yes == false ]]; then
  read -r -p 'Remove CybexOS-managed desktop configuration? [y/N]: ' answer
  [[ ${answer,,} == y || ${answer,,} == yes ]] || exit 0
fi

# Never remove the updater while its durable worker owns an update. Hold the
# worker's lock for the rest of this process.
update_state_root=${XDG_STATE_HOME:-$HOME/.local/state}/cybexos/update
update_runtime_root=${XDG_RUNTIME_DIR:-$update_state_root/runtime}
mkdir -p -- "$update_runtime_root"
exec 9>"$update_runtime_root/update.lock"
flock -n 9 || {
  echo 'uninstall: a CybexOS update is running; retry after it finishes (cybexos-update-run status).' >&2
  exit 75
}

sudo -v
# Ansible's workers detach from the terminal, where sudo's default tty-scoped
# ticket from `sudo -v` does not apply; ask for the become password unless
# sudo works without a terminal.
become_args=()
setsid -w sudo -n true </dev/null >/dev/null 2>&1 || become_args=(--ask-become-pass)
ansible-playbook uninstall.yml -e "@$config_path" \
  -e "cybexos_keep_user_data=$keep_user_data" "${become_args[@]}"
if [[ $keep_user_data == false ]]; then
  sudo rm -f -- "$config_path"
  sudo rmdir -- /etc/cybexos 2>/dev/null || true
fi
