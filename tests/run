#!/usr/bin/env bash
# Repo checks: everything verifiable from the source tree alone, without
# touching the running machine (that is tests/verify-system). Fast enough to gate
# a deploy — `verify` runs it ahead of the machine checks and `update --full`
# runs it before ansible-playbook. Every stage runs even if an earlier one
# fails; the exit status is nonzero when any of them did. Stages run side by
# side, each in its own process under a hard time limit, so a hung check fails
# its stage instead of wedging the gate and every deploy waiting on it; the
# results are still reported in one fixed order.
set -uo pipefail
export PYTHONDONTWRITEBYTECODE=1

# `wait -n -p` (bash 5.1) is how finished stages are collected.
if ((BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1] < 501)); then
  printf 'tests/run: bash 5.1 or newer is required\n' >&2
  exit 2
fi

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd) || exit 1
cd -- "$repo_root" || exit 1
runner=$repo_root/tests/${BASH_SOURCE[0]##*/}

shell_dir=roles/desktop/files/quickshell
failed_stages=()
test_scratch_dirs=()
# Background jobs this process started (PID → start time in ms), so an
# interrupted or timed-out run stops them instead of leaving them behind.
declare -A live_jobs=()

cleanup_test_scratch() {
  local directory
  for directory in "${test_scratch_dirs[@]}"; do
    [[ $directory == "${TMPDIR:-/tmp}"/cybexos-qml.* ||
       $directory == "${TMPDIR:-/tmp}"/cybexos-tests.* ]] &&
      rm -rf -- "$directory"
  done
}
on_exit() {
  local pid
  for pid in "${!live_jobs[@]}"; do
    kill -TERM "$pid" 2>/dev/null
  done
  # Every job is a timeout(1), which passes the signal on to its whole process
  # group and SIGKILLs it ten seconds later, so this wait is bounded.
  ((${#live_jobs[@]} == 0)) || wait 2>/dev/null
  cleanup_test_scratch
}
trap on_exit EXIT
# Stage workers run in process groups of their own, out of reach of the
# terminal's signals, so every way this run can end has to pass through on_exit.
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Stage workers write to files; they take the terminal decision from the run
# that started them.
if [[ ${1:-} == --stage-worker ]]; then
  color=${CYBEXOS_TESTS_RUN_COLOR:-0}
elif [[ -t 1 ]]; then
  color=1
else
  color=0
fi
export CYBEXOS_TESTS_RUN_COLOR=$color
if [[ $color == 1 ]]; then
  C_GREEN=$'\033[32m' C_RED=$'\033[31m' C_YELLOW=$'\033[33m' C_OFF=$'\033[0m'
else
  C_GREEN='' C_RED='' C_YELLOW='' C_OFF=''
fi

pass() { printf '%sPASS%s  %-11s %s\n' "$C_GREEN" "$C_OFF" "$1" "${2:-}"; }
skip() { printf '%sSKIP%s  %-11s %s\n' "$C_YELLOW" "$C_OFF" "$1" "${2:-}"; }
fail() {
  printf '%sFAIL%s  %-11s %s\n' "$C_RED" "$C_OFF" "$1" "${2:-}"
  failed_stages+=("$1")
}

# Milliseconds since the epoch. EPOCHREALTIME renders its decimal separator
# per locale, so strip everything that is not a digit rather than splitting.
now_ms() { local t=${EPOCHREALTIME:-}; t=${t//[^0-9]/}; printf '%s' "$(( ${t:-0} / 1000 ))"; }
took() { printf '(%d.%02ds)' "$(( $1 / 1000 ))" "$(( $1 % 1000 / 10 ))"; }

# Indented failure excerpt, bounded so one broken file cannot bury the summary.
excerpt() {
  local text=$1 max=${2:-60} n
  n=$(printf '%s\n' "$text" | wc -l)
  printf '%s\n' "$text" | head -n "$max" | sed 's/^/      /'
  ((n > max)) && printf '      … %d more lines\n' "$((n - max))"
  return 0
}

# spawn LIMIT OUTPUT COMMAND... — start COMMAND in the background with a hard
# LIMIT in seconds and all of its output in the file OUTPUT. timeout(1) puts
# the command in its own process group, signals all of it on expiry, and
# SIGKILLs whatever still ignores SIGTERM ten seconds later. Sets spawned_pid.
spawn() {
  local limit=$1 output=$2
  shift 2
  timeout --kill-after=10 "$limit" "$@" >"$output" 2>&1 </dev/null &
  spawned_pid=$!
  live_jobs[$spawned_pid]=$(now_ms)
}

# reap PID... — wait for whichever of these spawned jobs ends first. Sets
# reaped_pid, its exit status reaped_rc, and its runtime reaped_ms. Bash's own
# "Killed" notice for a job goes to /dev/null; the caller reports the job.
reap() {
  reaped_pid='' reaped_rc=0
  wait -n -p reaped_pid "$@" 2>/dev/null || reaped_rc=$?
  [[ -n $reaped_pid && -n ${live_jobs[$reaped_pid]:-} ]] || return 1
  reaped_ms=$(( $(now_ms) - ${live_jobs[$reaped_pid]} ))
  unset 'live_jobs[$reaped_pid]'
}

# reap_into PENDING STATUS RUNTIME — reap one job from the PID → index map
# named PENDING, recording its exit status and runtime under its index.
# shellcheck disable=SC2034 # the status and runtime namerefs write the caller's arrays
reap_into() {
  local -n pending_ref=$1 status_ref=$2 runtime_ref=$3
  reap "${!pending_ref[@]}" || return 1
  status_ref[${pending_ref[$reaped_pid]}]=$reaped_rc
  runtime_ref[${pending_ref[$reaped_pid]}]=$reaped_ms
  unset 'pending_ref[$reaped_pid]'
}

# How many jobs to run side by side: what the run was given with --jobs
# (workers inherit it), else half the CPUs and at most eight. Several stages
# fan out on their own, and a few unit tests assert on wall-clock time.
default_jobs() {
  local cpus
  if [[ ${CYBEXOS_TESTS_RUN_JOBS:-} =~ ^[1-9][0-9]*$ ]]; then
    printf '%d' "$CYBEXOS_TESTS_RUN_JOBS"
    return
  fi
  cpus=$(nproc 2>/dev/null) || cpus=2
  cpus=$((cpus / 2))
  ((cpus > 8)) && cpus=8
  ((cpus < 1)) && cpus=1
  printf '%d' "$cpus"
}

# The qml runtime lifecycle test and the user-widget fixture (Python stage)
# each start a real qs only while no other qs runs, and the lifecycle test
# fails when one is left afterwards. Side by side they would see each other's
# qs: CI would silently skip that coverage or fail spuriously. They share the
# run's CYBEXOS_TESTS_RUN_QS_LOCK file; hold_qs_lock keeps it until the stage's
# worker exits, and qs_lock_fd must not leak into a qs that might outlive it.
qs_lock_fd=''
hold_qs_lock() {
  exec {qs_lock_fd}>>"$CYBEXOS_TESTS_RUN_QS_LOCK" && flock "$qs_lock_fd"
}

# exit_note STATUS RUNTIME_MS LIMIT — how a spawned job ended, for a report.
# timeout(1) exits 124 on expiry, or 137 when it had to use SIGKILL.
exit_note() {
  local rc=$1 runtime_ms=$2 limit=$3
  if ((rc == 124 || (rc == 137 && runtime_ms >= limit * 1000))); then
    printf 'timed out after %ss' "$limit"
  else
    printf 'exited with status %s' "$rc"
  fi
}

# ── Quickshell pure-logic unit tests ────────────────────────────────────────
# `node --test <dir>` does not discover these (the runner tries to load the
# directory as a module), so the files are expanded here instead.
#
# They live here rather than beside the code they test: the Ansible role copies
# the whole shell tree into the vendor runtime, and test files have no
# business in a deployed config directory.
stage_unit_tests() {
  local files=() out rc=0 t0 elapsed passed failed
  shopt -s nullglob
  files=(tests/quickshell/*.test.cjs)
  shopt -u nullglob

  if ((${#files[@]} == 0)); then
    fail 'unit tests' 'no *.test.cjs under tests/quickshell'
    return
  fi
  if ! command -v node >/dev/null 2>&1; then
    fail 'unit tests' 'node not installed (dnf install nodejs24)'
    return
  fi

  t0=$(now_ms)
  # A hung test fails on its own instead of holding the whole run.
  out=$(node --test --test-timeout=60000 "${files[@]}" 2>&1) || rc=$?
  elapsed=$(( $(now_ms) - t0 ))

  passed=$(awk '$2 == "pass" { n = $3 } END { print n + 0 }' <<<"$out")
  failed=$(awk '$2 == "fail" { n = $3 } END { print n + 0 }' <<<"$out")

  if ((rc == 0)); then
    pass 'unit tests' "$passed passing in ${#files[@]} files $(took "$elapsed")"
    return
  fi

  fail 'unit tests' "$failed of $((passed + failed)) failing"
  # The trailing "failing tests:" block holds the assertion diagnostics; fall
  # back to everything when the runner died before printing it.
  if grep -q 'failing tests:' <<<"$out"; then
    excerpt "$(sed -n '/failing tests:/,$p' <<<"$out")"
  else
    excerpt "$out"
  fi
}

# ── Whole-source syntax and playbook parse gate ────────────────────────
stage_source_syntax() {
  local out='' rc=0 t0 elapsed scratch jobs ansible_pid
  local bash_files=() python_files=() node_files=()

  for command in bash python3 node ansible-playbook; do
    if ! command -v "$command" >/dev/null 2>&1; then
      fail 'source syntax' "$command not installed"
      return
    fi
  done

  # Give content searches an explicit root. Some ripgrep builds treat a
  # non-interactive empty stdin as the search input when no path is supplied,
  # which made CI discover zero shell sources despite a complete checkout.
  mapfile -t bash_files < <(rg -l '^#!.*(bash|sh)' -g '!*.j2' . | LC_ALL=C sort)
  mapfile -t python_files < <(
    { rg --files . -g '*.py'; rg -l '^#!.*python' -g '!*.j2' .; } | LC_ALL=C sort -u
  )
  # Model Usage's vendored UsageLogic.js is a QML `.pragma library`, which
  # node cannot parse; tests/model-usage.py runs upstream's own test on it.
  mapfile -t node_files < <(
    rg --files roles assets scripts -g '*.js' -g '*.mjs' -g '*.cjs' \
      -g '!roles/desktop/files/quickshell/ModelUsage/**' 2>/dev/null \
      | LC_ALL=C sort
  )
  if ((${#bash_files[@]} == 0 || ${#python_files[@]} == 0 || ${#node_files[@]} == 0)); then
    fail 'source syntax' 'source discovery unexpectedly returned an empty language set'
    return
  fi

  scratch=$(mktemp -d "${TMPDIR:-/tmp}/cybexos-tests.XXXXXX") || {
    fail 'source syntax' 'could not create a scratch directory'
    return
  }
  test_scratch_dirs+=("$scratch")
  jobs=$(default_jobs)

  t0=$(now_ms)
  # The playbook parse is the slowest single check, so it runs while the
  # sources are checked. bash -n and node --check take one file per process;
  # those fan out too.
  spawn 300 "$scratch/ansible" \
    ansible-playbook -i inventory/hosts.yml site.yml --syntax-check
  ansible_pid=$spawned_pid
  out=$(printf '%s\0' "${bash_files[@]}" | xargs -0 -r -P "$jobs" -n 1 bash -n 2>&1) || rc=1
  if ((rc == 0)); then
    out=$(python3 - "${python_files[@]}" <<'PY' 2>&1
from pathlib import Path
import sys

for name in sys.argv[1:]:
    path = Path(name)
    compile(path.read_text(encoding="utf-8"), str(path), "exec")
PY
) || rc=$?
  fi
  if ((rc == 0)); then
    out=$(printf '%s\0' "${node_files[@]}" \
      | xargs -0 -r -P "$jobs" -n 1 node --check 2>&1) || rc=1
  fi
  if ! reap "$ansible_pid" || ((reaped_rc != 0)); then
    rc=1
    out=${out:+$out$'\n'}$(<"$scratch/ansible")
  fi
  rm -rf -- "$scratch"

  elapsed=$(( $(now_ms) - t0 ))
  if ((rc == 0)); then
    pass 'source syntax' "${#bash_files[@]} shell, ${#python_files[@]} Python, ${#node_files[@]} JS, and Ansible $(took "$elapsed")"
  else
    fail 'source syntax' 'a source file or site.yml failed to parse'
    excerpt "${out:-unknown failure}"
  fi
}

# ── Language-aware static analysis ────────────────────────────────────────
stage_static_analysis() {
  local out rc=0 t0 elapsed
  t0=$(now_ms)
  out=$(tests/static-analysis 2>&1) || rc=$?
  elapsed=$(( $(now_ms) - t0 ))
  if ((rc == 0)); then
    pass 'static lint' "ShellCheck, ansible-lint, yamllint, and Ruff $(took "$elapsed")"
  else
    fail 'static lint' 'language-aware static analysis failed'
    excerpt "${out:-unknown failure}" 100
  fi
}

# ── Hyprland workspace/monitor policy ───────────────────────────────────────────
stage_hyprland_workspaces() {
  local out rc=0 t0 elapsed
  t0=$(now_ms)
  if ! command -v luajit >/dev/null 2>&1; then
    fail 'Hyprland' 'luajit is required for workspace policy fixtures'
    return
  fi
  # A { } group reports only its last status; every command has to count.
  out=$({
    r=0
    bash tests/hyprland-workspaces || r=1
    bash tests/hyprland-features || r=1
    exit "$r"
  } 2>&1) || rc=$?
  elapsed=$(( $(now_ms) - t0 ))

  if ((rc == 0)); then
    pass 'Hyprland' "workspace and optional-feature policy $(took "$elapsed")"
  else
    fail 'Hyprland' 'workspace hotplug policy fixtures failed'
    excerpt "${out:-unknown failure}"
  fi
}

# ── QML static analysis ───────────────────────────────────────────────────
stage_qml_lint() {
  local out rc=0 t0 elapsed

  t0=$(now_ms)
  out=$(tests/qml-lint 2>&1) || rc=$?
  elapsed=$(( $(now_ms) - t0 ))

  if ((rc == 0)); then
    # qml-lint's own success line already carries the file count; reuse it so
    # both stages read the same way.
    pass 'qml lint' "$(sed -e 's/\x1b\[[0-9;]*m//g' -e 's/^PASS  *//' <<<"$out" | tail -n1) $(took "$elapsed")"
  else
    fail 'qml lint' 'qmllint reported errors'
    excerpt "$(sed 's/\x1b\[[0-9;]*m//g' <<<"$out")"
  fi
}

# ── QML JavaScript runtime contracts ───────────────────────────────
stage_qml_runtime() {
  local runner qml_import_path scratch out rc=0 t0 elapsed lifecycle_out lifecycle_rc=0
  runner=$(command -v qmltestrunner-qt6 || command -v qmltestrunner || true)
  if [[ -z $runner ]]; then
    fail 'qml runtime' 'qmltestrunner not installed (dnf install qt6-qtdeclarative-devel)'
    return
  fi
  if ! command -v dbus-run-session >/dev/null 2>&1; then
    fail 'qml runtime' 'dbus-run-session not installed'
    return
  fi

  qml_import_path=$(qtpaths6 --query QT_INSTALL_QML 2>/dev/null \
    || qtpaths --query QT_INSTALL_QML 2>/dev/null || true)
  [[ -d ${qml_import_path:-} ]] || qml_import_path=/usr/lib64/qt6/qml
  scratch=$(mktemp -d "${TMPDIR:-/tmp}/cybexos-qml.XXXXXX") || {
    fail 'qml runtime' 'could not create an isolated runtime directory'
    return
  }
  test_scratch_dirs+=("$scratch")
  mkdir -p "$scratch/home" "$scratch/config" "$scratch/state" "$scratch/runtime"
  chmod 700 "$scratch/runtime"

  t0=$(now_ms)
  out=$(env \
    HOME="$scratch/home" \
    XDG_CONFIG_HOME="$scratch/config" \
    XDG_STATE_HOME="$scratch/state" \
    XDG_RUNTIME_DIR="$scratch/runtime" \
    QT_QPA_PLATFORM=offscreen \
    QT_QUICK_BACKEND=software \
    QS_REDUCED_MOTION=1 \
    dbus-run-session -- "$runner" \
      -input tests/qml \
      -import "$qml_import_path" \
      -import "$shell_dir" \
      -o -,txt 2>&1) || rc=$?

  # Quickshell's core QML plugin is statically linked into `qs`, so generic
  # qmltestrunner can exercise the pure helpers but cannot construct production
  # components. Run that lifecycle smoke test through the real engine only
  # where doing so cannot create a second qs beside the managed desktop shell.
  if ((rc == 0)); then
    if ! hold_qs_lock; then
      rc=1
      out+=$'\ncould not take the lock that keeps real-engine qs tests apart'
    elif pgrep -x qs >/dev/null 2>&1 \
        || systemctl --user is-active --quiet quickshell.service 2>/dev/null; then
      skip 'qml lifecycle' 'active managed shell; real-engine smoke runs in CI'
    elif ! command -v qs >/dev/null 2>&1; then
      rc=1
      out+=$'\nqs is required for real QML component lifecycle coverage'
    else
      mkdir -p "$scratch/shell"
      cp -a "$shell_dir/." "$scratch/shell/"
      cp tests/qml-lifecycle/shell.qml "$scratch/shell/shell.qml"
      lifecycle_out=$(env \
        HOME="$scratch/home" \
        XDG_CONFIG_HOME="$scratch/config" \
        XDG_STATE_HOME="$scratch/state" \
        XDG_RUNTIME_DIR="$scratch/runtime" \
        QT_QPA_PLATFORM=offscreen \
        QT_QUICK_BACKEND=software \
        QS_REDUCED_MOTION=1 \
        timeout --signal=TERM --kill-after=2 15 \
        dbus-run-session -- qs --no-color -v -p "$scratch/shell" 2>&1 \
        {qs_lock_fd}>&-) || lifecycle_rc=$?
      if ((lifecycle_rc != 0 && lifecycle_rc != 143)) \
          || ! grep -q 'LIFECYCLE_RESULT pass' <<<"$lifecycle_out" \
          || grep -q 'LIFECYCLE_FAIL' <<<"$lifecycle_out"; then
        rc=1
        out+=$'\n'
        out+="$lifecycle_out"
      fi
      if pgrep -x qs >/dev/null 2>&1; then
        rc=1
        out+=$'\nreal-engine lifecycle test left an unexpected qs process'
      fi
    fi
  fi
  elapsed=$(( $(now_ms) - t0 ))
  rm -rf -- "$scratch"

  if ((rc == 0)); then
    pass 'qml runtime' "QML helper and component lifecycle contracts $(took "$elapsed")"
  else
    fail 'qml runtime' 'offscreen qmltestrunner checks failed'
    excerpt "${out:-unknown failure}" 100
  fi
}

# ── Custom Ansible callback compatibility ─────────────────────────────────
stage_callback_smoke() {
  local out rc=0 t0 elapsed
  t0=$(now_ms)

  if [[ ! -f tests/callback-smoke.py ]]; then
    fail 'callback' 'tests/callback-smoke.py is missing'
    return
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    fail 'callback' 'python3 not installed'
    return
  fi

  out=$(python3 tests/callback-smoke.py 2>&1) || rc=$?
  elapsed=$(( $(now_ms) - t0 ))
  if ((rc == 0)); then
    pass 'callback' "Ansible stdout compatibility $(took "$elapsed")"
  else
    fail 'callback' 'Ansible stdout compatibility smoke test failed'
    excerpt "${out:-unknown failure}"
  fi
}

# ── Python helper concurrency/error contracts ──────────────────────────
# Independent fixtures, run side by side and each to the end, so one failure
# cannot hide the result of the others.
python_fixtures=(
  # The two Ansible-driven deployment fixtures take longest; start them first.
  cybex-deployment
  quickshell-deployment
  user-plugins
  wallpaper-download
  bluetooth-tool
  firmware-update
  shell-health
  repository-policy
  application-defaults
  login-policy
  session-launcher
  omawrite
  ownership-layering
  plugin-packages
  model-usage
  installer-convergence
  user-adoption
  firefox-policy
  hermes-bridge
  hermes-webui-auth
  hermes-remote-runtime
)
python_fixture_limit=300

stage_python_helpers() {
  local dir index command fixture out='' t0 elapsed jobs failed=()
  local -A pending=()
  local -a status=() runtime=()
  for command in python3 flock timeout; do
    if ! command -v "$command" >/dev/null 2>&1; then
      fail 'Python tests' "$command not installed"
      return
    fi
  done
  dir=$(mktemp -d "${TMPDIR:-/tmp}/cybexos-tests.XXXXXX") || {
    fail 'Python tests' 'could not create a scratch directory'
    return
  }
  test_scratch_dirs+=("$dir")
  jobs=$(default_jobs)

  t0=$(now_ms)
  for index in "${!python_fixtures[@]}"; do
    while ((${#pending[@]} >= jobs)); do
      reap_into pending status runtime || break
    done
    command=(python3 "tests/${python_fixtures[index]}.py")
    if [[ ${python_fixtures[index]} == user-plugins ]]; then
      command=(flock --close "$CYBEXOS_TESTS_RUN_QS_LOCK" "${command[@]}")
    fi
    spawn "$python_fixture_limit" "$dir/$index" "${command[@]}"
    pending[$spawned_pid]=$index
  done
  while ((${#pending[@]})); do
    reap_into pending status runtime || break
  done
  elapsed=$(( $(now_ms) - t0 ))

  # A failing fixture's diagnosis (a traceback, the failed assertion) is at
  # the end of what it printed.
  for index in "${!python_fixtures[@]}"; do
    [[ ${status[index]:-} == 0 ]] && continue
    fixture=${python_fixtures[index]}
    failed+=("$fixture")
    if [[ -z ${status[index]:-} ]]; then
      out+="tests/$fixture.py: lost track of its process"$'\n'
      continue
    fi
    out+="tests/$fixture.py $(exit_note "${status[index]}" "${runtime[index]}" "$python_fixture_limit")"
    if [[ -s $dir/$index ]]; then
      out+=$':\n'$(tail -n 40 -- "$dir/$index")
    fi
    out+=$'\n'
  done
  rm -rf -- "$dir"

  if ((${#failed[@]} == 0)); then
    pass 'Python tests' "${#python_fixtures[@]} helper-isolation and repository-policy fixtures $(took "$elapsed")"
  else
    fail 'Python tests' "${#failed[@]} of ${#python_fixtures[@]} fixtures failed: $(IFS=, ; printf '%s' "${failed[*]}")"
    excerpt "${out%$'\n'}" 120
  fi
}

# ── Quickshell configuration and live migration integration ────────────────
stage_quickshell_integration() {
  local out rc=0 t0 elapsed
  t0=$(now_ms)

  out=$({ r=0; python3 - <<'PY' || r=1
from pathlib import Path

tasks = Path("roles/desktop/tasks/main.yml").read_text()
finalize = Path("roles/finalize/tasks/main.yml").read_text()
autostart = Path("roles/desktop/files/autostart.lua").read_text()
bindings = Path("roles/desktop/files/bindings.lua").read_text()
look = Path("roles/desktop/templates/looknfeel.lua.j2").read_text()
theme = Path("roles/desktop/files/quickshell/Common/Theme.qml").read_text()
live_helpers = Path("tests/lib/quickshell-live").read_text()
snapshot = Path("tests/t3-contract-snapshot").read_text()
login_policy = Path("roles/desktop/files/login/cybexos-login-prepare").read_text()

assert Path("roles/desktop/files/quickshell/shell.qml").is_file()
assert Path("roles/desktop/templates/quickshell.service.j2").is_file()
assert Path("roles/desktop/templates/hyprland-quickshell.j2").is_file()
assert not Path("roles/desktop/files/noctalia").exists()
assert "- quickshell" in tasks
assert "Install tracked Quickshell menubar files" in tasks
assert 'src: "quickshell/{{ item }}"' in tasks
assert "loop: \"{{ quickshell_deploy.install }}\"" in tasks
assert 'stdin: "{{ quickshell_managed_manifest | sort | to_json }}"' in tasks
assert tasks.index("Build the tracked Quickshell source manifest") < tasks.index("Install tracked Quickshell menubar files")
assert "Calculate the content identity of the managed Quickshell tree" in tasks
assert 'digest.update(payload + b"\\0")' in tasks
assert tasks.count('"{{ quickshell_source.digest }}"') == 2
assert tasks.index("Install rendered Hyprland Lua dependencies before their consumers") < tasks.index("Install Hyprland Lua configuration")
lua_install = tasks[tasks.index("Install Hyprland Lua configuration"):tasks.index("Install ordered Hyprland session starter")]
assert lua_install.index("- bindings.lua") < lua_install.index("- hyprland.lua")
assert '(Quickshell.env("QS_REDUCED_MOTION") || "").trim()' in theme
assert "(Type|Reference|Range)Error" in live_helpers
assert 'hl.dsp.global("quickshell:launcherToggle")' in bindings
assert "noctalia" not in autostart.lower()
assert "qs-(bar|bar-popout|launcher|notifications|osd|shortcuts|wallpaper)" in look
assert "hyprland-quickshell.desktop" in login_policy
assert "/etc/cybexos/login.json" in finalize
assert "noctalia-retired-" in finalize
assert "/usr/share/wayland-sessions/hyprland-noctalia.desktop" in finalize
assert "name: noctalia" in finalize
assert "quickshell.service" in finalize
assert "--delete-excluded" in snapshot
assert "--exclude='__pycache__/'" in snapshot
assert "--exclude='*.py[co]'" in snapshot
print("Quickshell configuration and guarded Noctalia migration are wired")
PY
    bash tests/quickshell-deploy-health-fixture || r=1
    exit "$r"
  } 2>&1) || rc=1

  elapsed=$(( $(now_ms) - t0 ))
  if ((rc == 0)); then
    pass 'Quickshell' "configuration and migration integration $(took "$elapsed")"
  else
    fail 'Quickshell' 'configuration or migration integration check failed'
    excerpt "${out:-unknown failure}"
  fi
}

# ── XPS 2026 hardware integration sanity checks ────────────────────────────
stage_xps_hardware() {
  local out rc=0 t0 elapsed biquads search_rc
  local shell_files=(
    roles/xps-2026/files/xps-speaker-tuning
    roles/xps-2026/files/xps-fingerprint-detect
    roles/xps-2026/files/xps-fingerprint-check
    roles/xps-2026/files/camera/xps-ipu7-camera-check
    roles/xps-2026/files/camera/xps-ipu7-camera-init
    roles/xps-2026/files/camera/xps-ipu7-camera-sleep
  )

  t0=$(now_ms)
  for source_file in "${shell_files[@]}"; do
    out=$(bash -n "$source_file" 2>&1) || {
      rc=1
      break
    }
  done

  if ((rc == 0)); then
    out=$(python3 - <<'PY' 2>&1
from pathlib import Path
import os
import subprocess
import tempfile

python_files = (
    Path("roles/xps-2026/files/xps-haptic-touchpad"),
    Path("roles/xps-2026/files/camera/xps-ipu7-abi-check"),
    Path("roles/xps-2026/files/camera/xps-ipu7-userspace-check"),
)
for path in python_files:
    compile(path.read_text(), str(path), "exec")

detector = Path("roles/xps-2026/files/xps-fingerprint-detect").resolve()

def detect(vendor, product_id, product="", driver=""):
    with tempfile.TemporaryDirectory() as temporary:
        devices = Path(temporary) / "devices"
        device = devices / "1-1"
        device.mkdir(parents=True)
        (device / "idVendor").write_text(vendor + "\n")
        (device / "idProduct").write_text(product_id + "\n")
        if product:
            (device / "product").write_text(product + "\n")
        if driver:
            target = Path(temporary) / "drivers" / driver
            target.mkdir(parents=True)
            interface = device / "1-1:1.0"
            interface.mkdir()
            (interface / "driver").symlink_to(target)
        environment = os.environ.copy()
        environment["XPS_USB_DEVICES_PATH"] = str(devices)
        return subprocess.run(
            ["bash", str(detector)], env=environment, capture_output=True
        ).returncode == 0

assert not detect("06cb", "0701", "SVP7500"), "camera bridge detected as reader"
assert not detect("06cb", "9999", "Generic USB", "usbio-bridge"), "driven Synaptics device detected"
assert detect("27c6", "1234"), "unclaimed known-vendor reader not detected"
assert detect("1234", "5678", "Goodix Fingerprint USB Device", "usbhid"), "named reader not detected"

speaker_manager = Path("roles/xps-2026/files/xps-speaker-tuning").read_text()
camera_tasks = Path("roles/xps-2026/tasks/camera.yml").read_text()
camera_role = Path("roles/xps-2026/tasks/main.yml").read_text()
