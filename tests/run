# ── User-scoped agent skill package and lifecycle ────────────────────────
stage_agent_skills() {
  local out rc=0 t0 elapsed command
  for command in bash python3 flock; do
    if ! command -v "$command" >/dev/null 2>&1; then
      fail 'agent skills' "$command not installed"
      return
    fi
  done
  t0=$(now_ms)
  out=$({
    r=0
    python3 tests/agent-skill.py || r=1
    python3 tests/default-agent.py || r=1
    bash tests/agent-skills || r=1
    exit "$r"
  } 2>&1) || rc=$?
  elapsed=$(( $(now_ms) - t0 ))

  if ((rc == 0)); then
    pass 'agent skills' "package, default launcher, and transactional lifecycle $(took "$elapsed")"
  else
    fail 'agent skills' 'package or lifecycle fixture failed'
    excerpt "${out:-unknown failure}"
  fi
}

stage_update_backend() {
  local out rc=0 t0 elapsed command
  for command in bash jq timeout; do
    if ! command -v "$command" >/dev/null 2>&1; then
      fail 'updater' "$command not installed"
      return
    fi
  done
  t0=$(now_ms)
  out=$(bash tests/cybexos-update-run 2>&1) || rc=$?
  if ((rc == 0)); then
    out=$(bash tests/release-update 2>&1) || rc=$?
  fi
  elapsed=$(( $(now_ms) - t0 ))

  if ((rc == 0)); then
    pass 'updater' "durable worker and verified release activation $(took "$elapsed")"
  else
    fail 'updater' 'durable backend fixture failed'
    excerpt "${out:-unknown failure}"
  fi
}

