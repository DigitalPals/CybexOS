# The name each stage reports under, for failures only this runner sees: a
# stage that ran out of time or whose process died.
declare -A stage_labels=(
  [stage_source_syntax]='source syntax'
  [stage_static_analysis]='static lint'
  [stage_unit_tests]='unit tests'
  [stage_hyprland_workspaces]='Hyprland'
  [stage_qml_lint]='qml lint'
  [stage_qml_runtime]='qml runtime'
  [stage_quickshell_integration]='Quickshell'
  [stage_callback_smoke]='callback'
  [stage_python_helpers]='Python tests'
  [stage_xps_hardware]='XPS hardware'
  [stage_plymouth_layout]='Plymouth'
  [stage_agent_skills]='agent skills'
  [stage_update_backend]='updater'
  [stage_screenshot_workflow]='screenshot'
  [stage_brightness_routing]='brightness'
  [stage_system_snapshot]='snapshots'
  [stage_legacy_names]='legacy'
)

# Wall-clock limit per stage in seconds: many times the slowest run seen in CI
# or on a loaded workstation, so only a hang ever reaches it.
declare -A stage_limits=(
  [stage_static_analysis]=600
  [stage_python_helpers]=600
)
stage_limit() { printf '%s' "${stage_limits[$1]:-300}"; }

# One stage per process: the loop at the end starts each stage as
# `tests/run --stage-worker NAME` under its limit and reports what it printed.
if [[ ${1:-} == --stage-worker ]]; then
  stage=${2:-}
  if (($# != 2)) || [[ -z $stage || -z ${stage_labels[$stage]:-} ]]; then
    printf 'tests/run: --stage-worker takes one stage function name\n' >&2
    exit 2
  fi
  # Started by hand rather than by a run: there is nothing to keep apart from.
  if [[ -z ${CYBEXOS_TESTS_RUN_QS_LOCK:-} ]]; then
    CYBEXOS_TESTS_RUN_QS_LOCK=$(mktemp "${TMPDIR:-/tmp}/cybexos-tests.XXXXXX") || exit 1
    test_scratch_dirs+=("$CYBEXOS_TESTS_RUN_QS_LOCK")
  fi
  "$stage"
  ((${#failed_stages[@]} == 0))
  exit
fi

usage() {
  cat <<'EOF'
Usage: tests/run [--quick | --only STAGE...] [--jobs N]
       tests/run --list

Run every required source-tree check; exit nonzero when any stage fails.

  --list        List the stages in the order their results are reported.
  --quick       Run only the short preflight stages.
  --only STAGE  Run just this stage, named as --list prints it; repeatable.
  --jobs N      Run up to N stages, and N jobs within a stage, at once
                (default: half the CPUs, at most eight; 1 runs everything
                one after another).
EOF
}

quick=false
only=()
jobs=''
while (($#)); do
  case $1 in
    --list)
      printf '%d required source-check stages (report order):\n' "${#stages[@]}"
      for stage in "${stages[@]}"; do
        label=${stage#stage_}
        printf '  %s\n' "${label//_/ }"
      done
      exit 0
      ;;
    --quick) quick=true ;;
    --only)
      name=${2:-}
      name=${name,,}
      name=stage_${name#stage_}
      name=${name//[ -]/_}
      if [[ -z ${2:-} || -z ${stage_labels[$name]:-} ]]; then
        printf 'tests/run: --only needs a stage from --list, not "%s"\n' "${2:-}" >&2
        exit 2
      fi
      only+=("$name")
      shift
      ;;
    -j|--jobs)
      if [[ ! ${2:-} =~ ^[1-9][0-9]*$ ]]; then
        printf 'tests/run: --jobs needs a positive number\n' >&2
        exit 2
      fi
      jobs=$2
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'tests/run: unknown argument %s\n' "$1" >&2
      exit 2
      ;;
  esac
  shift
done

if $quick && ((${#only[@]})); then
  printf 'tests/run: choose either --quick or --only\n' >&2
  exit 2
fi
selected_stages=("${stages[@]}")
$quick && selected_stages=("${quick_stages[@]}")
if ((${#only[@]})); then
  selected_stages=()
  for stage in "${stages[@]}"; do
    [[ " ${only[*]} " == *" $stage "* ]] && selected_stages+=("$stage")
  done
fi
jobs=${jobs:-$(default_jobs)}
export CYBEXOS_TESTS_RUN_JOBS=$jobs

run_dir=$(mktemp -d "${TMPDIR:-/tmp}/cybexos-tests.XXXXXX") || {
  printf 'tests/run: could not create a scratch directory\n' >&2
  exit 1
}
test_scratch_dirs+=("$run_dir")
export CYBEXOS_TESTS_RUN_QS_LOCK=$run_dir/qs.lock

# A worker that failed its stage has printed the FAIL line already. Anything
# else it can end with (its time limit, a crash) is reported here instead.
report_stage() {
  local index=$1 rc=$2 runtime_ms=$3 stage output
  stage=${selected_stages[index]}
  output=$run_dir/$index.out
  if ((rc == 0)); then
    cat -- "$output"
  elif ((rc == 1)) && grep -q 'FAIL' -- "$output"; then
    cat -- "$output"
    failed_stages+=("${stage_labels[$stage]}")
  else
    fail "${stage_labels[$stage]}" \
      "stage $(exit_note "$rc" "$runtime_ms" "$(stage_limit "$stage")")"
    [[ -s $output ]] && excerpt "$(<"$output")"
  fi
}

# The longest stages start first so the short ones fill in around them;
# results still come out in the fixed order above, each as soon as every
# stage before it has finished too.
launch_first=(
  stage_python_helpers
  stage_static_analysis
  stage_unit_tests
  stage_qml_lint
  stage_source_syntax
  stage_update_backend
)
launch_order=()
for stage in "${launch_first[@]}"; do
  for index in "${!selected_stages[@]}"; do
    [[ ${selected_stages[index]} == "$stage" ]] && launch_order+=("$index")
  done
done
for index in "${!selected_stages[@]}"; do
  [[ " ${launch_first[*]} " == *" ${selected_stages[index]} "* ]] ||
    launch_order+=("$index")
done

declare -A running=()    # worker PID → index into selected_stages
declare -a stage_rc=() stage_ms=()
next=0
reported=0
while ((reported < ${#selected_stages[@]})); do
  while ((${#running[@]} < jobs && next < ${#launch_order[@]})); do
    index=${launch_order[next]}
    stage=${selected_stages[index]}
    spawn "$(stage_limit "$stage")" "$run_dir/$index.out" \
      "$BASH" "$runner" --stage-worker "$stage"
    running[$spawned_pid]=$index
    next=$((next + 1))
  done
  if ! reap_into running stage_rc stage_ms; then
    printf 'tests/run: lost track of a running stage\n' >&2
    exit 1
  fi
  while ((reported < ${#selected_stages[@]})) && [[ -n ${stage_rc[reported]:-} ]]; do
    report_stage "$reported" "${stage_rc[reported]}" "${stage_ms[reported]}"
    reported=$((reported + 1))
  done
done

# Keep the verdict on the last line: `update` tails this output into its own
# failure report, so the actionable summary has to survive the truncation.
if ((${#failed_stages[@]} > 0)); then
  printf '\n%d of %d repo check stages failed: %s\n' \
    "${#failed_stages[@]}" "${#selected_stages[@]}" \
    "$(IFS=, ; printf '%s' "${failed_stages[*]}")"
  exit 1
fi
exit 0
