print("Python syntax and fingerprint detection fixtures valid")
PY
) || rc=1
  fi

  if ((rc == 0)); then
    out=$(bash -c '
      source roles/xps-2026/files/xps-speaker-tuning
      sleep_calls=0
      speaker_sink() { printf "%s\n" test-speaker; }
      sleep() { sleep_calls=$((sleep_calls + 1)); }
      wait_for_speaker >/dev/null || exit 1
      [[ $sleep_calls -eq $((speaker_stable_samples - 1)) ]] || exit 1

      sleep_calls=0
      speaker_sink() { return 1; }
      if wait_for_speaker >/dev/null; then exit 1; fi
      [[ $sleep_calls -eq $((speaker_wait_attempts - 1)) ]]
    ' 2>&1) || rc=1
  fi

  if ((rc == 0)); then
    out=$(python3 tests/camera-transaction.py 2>&1) || rc=1
  fi

  if ((rc == 0)); then
    out=$(python3 roles/xps-2026/files/camera/xps-ipu7-abi-check --self-test 2>&1) || rc=1
  fi

  biquads=$(grep -Ec 'name = s([0-9]+)_[lr]' roles/xps-2026/files/xps-speaker-filter-chain.conf)
  if ((rc == 0)) && [[ $biquads != 26 ]]; then
    out="speaker profile has $biquads biquads; expected 26"
    rc=1
  fi
  if ((rc == 0)) && ! grep -q 'limiter_stereo' roles/xps-2026/files/xps-speaker-filter-chain.conf; then
    out='speaker profile is missing the stereo limiter'
    rc=1
  fi
  if ((rc == 0)) && ! grep -q 'IPU7_PSYS_ONLY=1' roles/xps-2026/files/camera/patches/0005-ipu7-psys-stock-core-layout.patch; then
    out='camera patch does not enforce stock-core PSYS-only DKMS builds'
    rc=1
  fi
  if ((rc == 0)) && ! grep -q 'xps-ipu7-abi-check.*kernelver' roles/xps-2026/files/camera/patches/0005-ipu7-psys-stock-core-layout.patch; then
    out='camera DKMS build does not enforce the stock-core BTF ABI guard'
    rc=1
  fi
  if ((rc == 0)) && ! grep -q 'intel-ipu7-psys[.]ko' roles/xps-2026/files/camera/xps-ipu7-abi-check; then
    out='camera ABI guard does not yield to a future Fedora-native PSYS module'
    rc=1
  fi
  if ((rc == 0)) && ! grep -q 'xps-ipu7-userspace-check --root' roles/xps-2026/templates/xps-ipu7-build.j2; then
    out='camera package build does not prove staged userspace dependency closure'
    rc=1
  fi
  if ((rc == 0)) && ! grep -q 'ansible.builtin.meta: end_role' roles/xps-2026/tasks/camera.yml; then
    out='optional camera dependency failures are not isolated from the play'
    rc=1
  fi
  if ((rc == 0)); then
    # Only rg's "no match" (1) passes: 0 is a forbidden match, 2 a failed search.
    search_rc=0
    out=$(rg -n 'linux-ptl|fred=on|disable_11be|BUILT_MODULE_NAME.*intel-ipu7(-isys)?"' \
      roles/xps-2026/tasks roles/xps-2026/defaults roles/xps-2026/templates 2>&1) || search_rc=$?
    ((search_rc == 1)) || rc=1
  fi

  elapsed=$(( $(now_ms) - t0 ))
  if ((rc == 0)); then
    pass 'XPS hardware' "scripts, 13-biquad graph, and stock-core camera guard $(took "$elapsed")"
  else
    fail 'XPS hardware' 'static hardware integration check failed'
    excerpt "${out:-unknown failure}"
  fi
}

# ── Plymouth early-KMS/multi-display layout ────────────────────────────────
stage_plymouth_layout() {
  local out rc=0 t0 elapsed
  t0=$(now_ms)

  out=$(python3 - <<'PY' 2>&1
from pathlib import Path
import re

theme = Path("roles/boot/files/cybex.script").read_text()

assert "fun update_layout ()" in theme
assert "new_width = Window.GetWidth();" in theme
assert "new_height = Window.GetHeight();" in theme
assert re.search(
    r"fun refresh_callback \(\)\s*\{\s*update_layout\(\);",
    theme,
), "refresh callback does not follow late display geometry"

# The firmware framebuffer is 2880x1800. Once xe takes over, Plymouth centers
# the 1440x900 internal panel and both Apple-display heads in a 2560x2880
# canvas. Coordinates calculated only against the firmware framebuffer leave
# the logo above the internal panel and clip the password entry at its top.
firmware = (2880, 1800)
heads = ((1440, 900), (2560, 1440), (2560, 2880))
canvas = (max(width for width, _ in heads), max(height for _, height in heads))
origins = tuple(
    ((canvas[0] - width) / 2, (canvas[1] - height) / 2)
    for width, height in heads
)

def centered(canvas_size, item_size):
    return (
        (canvas_size[0] - item_size[0]) / 2,
        (canvas_size[1] - item_size[1]) / 2,
    )

def contained(position, size, origin, viewport):
    return (
        position[0] >= origin[0]
        and position[1] >= origin[1]
        and position[0] + size[0] <= origin[0] + viewport[0]
        and position[1] + size[1] <= origin[1] + viewport[1]
    )

logo_size = (250, 59)
entry_size = (286, 48)
old_logo = centered(firmware, logo_size)
old_entry = (centered(firmware, entry_size)[0], old_logo[1] + logo_size[1] + 40)
assert not contained(old_logo, logo_size, origins[0], heads[0])
assert not contained(old_entry, entry_size, origins[0], heads[0])

new_logo = centered(canvas, logo_size)
new_entry = (centered(canvas, entry_size)[0], new_logo[1] + logo_size[1] + 40)
for origin, viewport in zip(origins, heads):
    assert contained(new_logo, logo_size, origin, viewport)
    assert contained(new_entry, entry_size, origin, viewport)

print("Cybex recenters the LUKS prompt after the early-KMS display handoff")
PY
) || rc=1

  elapsed=$(( $(now_ms) - t0 ))
  if ((rc == 0)); then
    pass 'Plymouth' "late multi-display relayout $(took "$elapsed")"
  else
    fail 'Plymouth' 'early-KMS/multi-display layout check failed'
    excerpt "${out:-unknown failure}"
  fi
}

