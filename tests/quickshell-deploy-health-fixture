#!/usr/bin/env bash
# Exercise healthy deployment and destructive rollback paths in an isolated
# fake home. The production helper accepts this only under a uniquely named,
# current-user-owned temporary root.
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/fedora-config-quickshell-deploy.XXXXXX")
service_pid=''

cleanup() {
  if [[ -n $service_pid ]]; then
    kill "$service_pid" 2>/dev/null || true
    wait "$service_pid" 2>/dev/null || true
  fi
  [[ $scratch == "${TMPDIR:-/tmp}"/fedora-config-quickshell-deploy.* ]] &&
    rm -rf -- "$scratch"
}
trap cleanup EXIT

runtime="$scratch/.local/share/fedora-config/runtime/quickshell"
mkdir -p "$runtime" "$scratch/bin" "$scratch/control"
printf 'known good\n' >"$runtime/shell.qml"
sleep 60 &
service_pid=$!
printf '%s\n' "$service_pid" >"$scratch/control/pid"
printf '1\n' >"$scratch/control/active"

cat >"$scratch/bin/systemctl" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
control=${QS_DEPLOY_FIXTURE_CONTROL:?}
args=" $* "
if [[ $args == *" show "* && $args == *" MainPID "* ]]; then
  cat "$control/pid"
elif [[ $args == *" show "* && $args == *" ControlGroup "* ]]; then
  printf '/fixture/quickshell.service\n'
elif [[ $args == *" show "* && $args == *" InvocationID "* ]]; then
  printf '0123456789abcdef0123456789abcdef\n'
elif [[ $args == *" is-active "* ]]; then
  [[ $(<"$control/active") == 1 ]]
elif [[ $args == *" restart "* || $args == *" start "* ]]; then
  exit 0
elif [[ $args == *" status "* ]]; then
  exit 0
else
  printf 'unexpected systemctl call: %s\n' "$*" >&2
  exit 2
fi
SH

cat >"$scratch/bin/pgrep" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
cat "${QS_DEPLOY_FIXTURE_CONTROL:?}/pid"
SH

cat >"$scratch/bin/qs" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
[[ ${1:-} == ipc && ${2:-} == --pid && ${3:-} == "$(cat "${QS_DEPLOY_FIXTURE_CONTROL:?}/pid")" && ${4:-} == call ]] || exit 2
if grep -q '^broken deployment$' \
    "${QS_DEPLOY_FIXTURE_HOME:?}/.local/share/fedora-config/runtime/quickshell/shell.qml"; then
  exit 1
fi
printf 'ok\n'
SH

cat >"$scratch/bin/journalctl" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf 'fixture journal is clean\n'
SH
chmod 755 "$scratch/bin/"*

export PATH="$scratch/bin:/usr/bin:/bin"
export QS_DEPLOY_FIXTURE_CONTROL="$scratch/control"
export QS_DEPLOY_FIXTURE_HOME="$scratch"
export QUICKSHELL_DEPLOY_TESTING=1
export QUICKSHELL_DEPLOY_TEST_ROOT="$scratch"
export QUICKSHELL_DEPLOY_SETTLE_SECS=0
export QS_LIVE_TIMEOUT=1

helper="$repo_root/tests/quickshell-deploy-health"
"$helper" snapshot "$scratch" healthy-1 >/dev/null
"$helper" verify-or-rollback "$scratch" healthy-1 >/dev/null
python3 - "$scratch/.local/state/fedora-config/quickshell-health.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    health = json.load(stream)
assert health["status"] == "healthy"
assert health["deploymentId"] == "healthy-1"
PY

"$helper" snapshot "$scratch" broken-2 >/dev/null
printf 'broken deployment\n' >"$runtime/shell.qml"
printf 'stale deployment file\n' >"$runtime/stale.qml"
if "$helper" verify-or-rollback "$scratch" broken-2 >/dev/null 2>&1; then
  printf 'broken deployment unexpectedly passed its health check\n' >&2
  exit 1
fi
[[ $(<"$runtime/shell.qml") == 'known good' ]]
[[ ! -e $runtime/stale.qml ]]
python3 - "$scratch/.local/state/fedora-config/quickshell-health.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    health = json.load(stream)
assert health["status"] == "rolled-back"
assert health["deploymentId"] == "broken-2"
PY

# A fresh headless install is healthy without a running graphical shell. Its
# empty pending marker must select the explicit skipped state under errexit.
printf '0\n' >"$scratch/control/active"
rm -f -- "$scratch/.local/state/fedora-config/quickshell-last-good.tar"
"$helper" snapshot "$scratch" headless-3 >/dev/null
"$helper" verify-or-rollback "$scratch" headless-3 >/dev/null
python3 - "$scratch/.local/state/fedora-config/quickshell-health.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    health = json.load(stream)
assert health["status"] == "skipped"
assert health["deploymentId"] == "headless-3"
assert health["detail"] == "No live shell was active before deployment"
PY

printf 'Quickshell deployment health and rollback fixture passed\n'
