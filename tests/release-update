#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
updater=$repo_root/assets/scripts/cybexos-release-update
fixture=$(mktemp -d)
trap 'rm -rf -- "$fixture"' EXIT
mkdir -p "$fixture/bin" "$fixture/source/scripts" "$fixture/data" \
  "$fixture/release/cybexos-1.2.3/tests" \
  "$fixture/release/cybexos-1.2.3/scripts"

printf '0.0.0\n' >"$fixture/source/VERSION"
cp "$repo_root/scripts/semver" "$fixture/source/scripts/semver"
printf '%s\n' '---' 'config_schema_version: 0' 'primary_user: tester' >"$fixture/config.yml"
cp -- "$fixture/config.yml" "$fixture/config.original.yml"
printf '%s\n' '---' >"$fixture/release/cybexos-1.2.3/site.yml"
printf '#!/usr/bin/env bash\n' >"$fixture/release/cybexos-1.2.3/install"
printf '#!/usr/bin/env bash\n' >"$fixture/release/cybexos-1.2.3/verify"
printf '#!/usr/bin/env bash\n' >"$fixture/release/cybexos-1.2.3/tests/run"
cp -a "$repo_root/agent-skills" "$fixture/release/cybexos-1.2.3/"
cp "$repo_root/scripts/manage-agent-skills" \
  "$fixture/release/cybexos-1.2.3/scripts/manage-agent-skills"
chmod 0755 "$fixture/release/cybexos-1.2.3/install" \
  "$fixture/release/cybexos-1.2.3/verify" \
  "$fixture/release/cybexos-1.2.3/tests/run" \
  "$fixture/release/cybexos-1.2.3/scripts/manage-agent-skills"
cp "$repo_root/scripts/migrate-config" \
  "$fixture/release/cybexos-1.2.3/scripts/migrate-config"
cp "$repo_root/scripts/semver" \
  "$fixture/release/cybexos-1.2.3/scripts/semver"
printf '1.2.3\n' >"$fixture/release/cybexos-1.2.3/VERSION"
fedora_release=$(source /etc/os-release; printf '%s' "$VERSION_ID")
jq -n --arg fedora "$fedora_release" --arg architecture "$(uname -m)" \
  '{product:"cybexos",version:"1.2.3",configSchema:1,
    supportedFedora:[$fedora],architectures:[$architecture],minimumUpdater:"0.1.0"}' \
  >"$fixture/release/cybexos-1.2.3/release-manifest.json"
tar --create --zstd --file "$fixture/release.tar.zst" \
  --directory "$fixture/release" cybexos-1.2.3
digest=$(sha256sum "$fixture/release.tar.zst" | awk '{print $1}')

release_json() {
  jq -n --arg digest "sha256:$digest" --argjson immutable "$1" \
    '{tag_name:"v1.2.3",draft:false,prerelease:false,immutable:$immutable,
      assets:[{name:"cybexos-1.2.3.tar.zst",
      browser_download_url:"https://example.invalid/release.tar.zst",digest:$digest}]}' \
    >"$fixture/release.json"
}
release_json true

semver=$repo_root/scripts/semver
$semver validate 1.2.3
$semver validate 1.2.3-beta.1+build.7
! $semver validate 01.2.3
! $semver validate 1.2.3-01
$semver newer 1.2.3 1.2.3-rc.1
! $semver newer 1.2.3-beta.1 1.2.3

cat >"$fixture/bin/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
output=
for ((i=1; i<=$#; i++)); do
  if [[ ${!i} == -o ]]; then ((i++)); output=${!i}; fi
done
[[ -n $output ]]
printf '%s\n' "${@: -3:1}" >>"$MOCK_CURL_LOG"
if [[ -n ${MOCK_CURL_OFFLINE:-} ]]; then
  echo 'curl: (6) Could not resolve host: api.github.com' >&2
  exit 6
fi
if [[ $* == *api.github.com* ]]; then
  cp -- "$MOCK_RELEASE_JSON" "$output"
else
  cp -- "$MOCK_RELEASE_ARCHIVE" "$output"
fi
EOF
cat >"$fixture/bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"$MOCK_GH_LOG"
if [[ $* == 'auth token' && -n ${MOCK_GH_UNAUTHENTICATED:-} ]]; then
  exit 1
fi
if [[ $* == 'release verify v'* && -n ${MOCK_GH_VERIFY_FAIL:-} ]]; then
  echo 'attestation verification failed' >&2
  exit 1
fi
EOF
cat >"$fixture/bin/backend" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
case ${1:-} in
  start)
    printf '%s\n' "$*" >"$MOCK_BACKEND_LOG"
    if [[ ${MOCK_BACKEND_EXISTING:-false} == true ]]; then
      printf '{"id":"20260903-120000-1-1","existing":true}\n'
      exit 3
    fi
    printf '{"id":"20260903-120001-2-2","existing":false}\n'
    ;;
  run)
    printf '%s\n' "$*" >"$MOCK_BACKEND_LOG"
    echo 'package-only run finished'
    ;;
  attach)
    rc=${MOCK_BACKEND_ATTACH_RC:-0}
    ((rc == 0)) || exit "$rc"
    arguments=$(<"$MOCK_BACKEND_LOG")
    repo=$(sed -n 's/.*--repo \([^ ]*\).*/\1/p' <<<"$arguments")
    version=$(sed -n 's/.*--release-version \([^ ]*\).*/\1/p' <<<"$arguments")
    data=$(sed -n 's/.*--release-data-root \([^ ]*\).*/\1/p' <<<"$arguments")
    config=$(sed -n 's/.*--release-config \([^ ]*\).*/\1/p' <<<"$arguments")
    target="$data/releases/$version"
    [[ $repo == "$target" ]] || {
      rm -rf -- "$target"
      mv -- "$repo" "$target"
      repo=$target
    }
    "$repo/scripts/migrate-config" "$config" >"$config.migrated"
    install -m 0644 "$config.migrated" "$config"
    rm -f -- "$config.migrated"
    ln -sfn "releases/$version" "$data/current.new"
    mv -Tf -- "$data/current.new" "$data/current"
    mapfile -t releases < <(
      find "$data/releases" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' |
        "$repo/scripts/semver" sort
    )
    for old in "${releases[@]:3}"; do
      [[ $old == "$version" ]] || rm -rf -- "$data/releases/$old"
    done
    ;;
  *) exit 2 ;;
esac
EOF
cat >"$fixture/bin/sudo" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
exec "$@"
EOF
chmod 0755 "$fixture/bin/curl" "$fixture/bin/gh" "$fixture/bin/backend" \
  "$fixture/bin/sudo"

export PATH="$fixture/bin:$PATH"
export XDG_DATA_HOME="$fixture/data"
export CYBEXOS_SOURCE_DIR="$fixture/source"
export CYBEXOS_CONFIG_FILE="$fixture/config.yml"
export CYBEXOS_UPDATE_BACKEND="$fixture/bin/backend"
export CYBEXOS_GITHUB_REPO=example/cybexos
export MOCK_RELEASE_JSON="$fixture/release.json"
export MOCK_RELEASE_ARCHIVE="$fixture/release.tar.zst"
export MOCK_GH_LOG="$fixture/gh.log"
export MOCK_BACKEND_LOG="$fixture/backend.log"
export MOCK_CURL_LOG="$fixture/curl.log"

check=$($updater --check --json)
[[ $(jq -r .available <<<"$check") == true ]]
[[ $(jq -r .availableVersion <<<"$check") == 1.2.3 ]]

jq '.tag_name = "v01.2.3"' "$fixture/release.json" >"$fixture/release-invalid.json"
mv -- "$fixture/release-invalid.json" "$fixture/release.json"
if $updater --check >/dev/null 2>"$fixture/invalid-semver.err"; then
  echo 'invalid SemVer release tag was accepted' >&2
  exit 1
fi
grep -F 'release tag is not strict SemVer' "$fixture/invalid-semver.err" >/dev/null
release_json true

# SemVer precedence, rather than version-sort punctuation rules, determines
# whether a prerelease is actually newer than the installed source.
jq '.tag_name = "v1.2.3-beta.1" |
    .assets[0].name = "cybexos-1.2.3-beta.1.tar.zst"' \
  "$fixture/release.json" >"$fixture/release-prerelease.json"
mv -- "$fixture/release-prerelease.json" "$fixture/release.json"
printf '1.2.3\n' >"$fixture/source/VERSION"
check=$($updater --check --json)
[[ $(jq -r .available <<<"$check") == false ]]
printf '1.2.2\n' >"$fixture/source/VERSION"
check=$($updater --check --json)
[[ $(jq -r .available <<<"$check") == true ]]

release_json true
printf '0.0.0\n' >"$fixture/source/VERSION"

# The panel-facing start mode returns one JSON record and never attaches. The
# no-release path still launches a privileged durable system unit, while a
# verified project candidate is left exclusively to that worker to promote.
printf '1.2.3\n' >"$fixture/source/VERSION"
machine_packages=$($updater --start --no-flatpak)
[[ $(jq -r .id <<<"$machine_packages") == 20260903-120001-2-2 ]]
[[ $(<"$fixture/backend.log") == 'start --json --system-unit --no-flatpak' ]]
# Firmware is forwarded on every path that forwards the package options.
$updater --start --no-flatpak --firmware >/dev/null
[[ $(<"$fixture/backend.log") == 'start --json --system-unit --no-flatpak --firmware' ]]
: >"$fixture/backend.log"
$updater --firmware >/dev/null
[[ $(<"$fixture/backend.log") == 'run --firmware' ]]
: >"$fixture/backend.log"
$updater --system-only --start --no-flatpak --firmware >/dev/null
[[ $(<"$fixture/backend.log") == 'start --json --system-unit --no-flatpak --firmware' ]]
: >"$fixture/backend.log"
$updater --system-only --firmware >/dev/null
[[ $(<"$fixture/backend.log") == 'run --firmware' ]]
printf '0.0.0\n' >"$fixture/source/VERSION"

machine_release=$($updater --start --no-packages 2>"$fixture/machine-start.err")
[[ $(jq -r .existing <<<"$machine_release") == false ]]
grep -Fx 'Downloading CybexOS 1.2.3...' \
  "$fixture/machine-start.err" >/dev/null
grep -F -- 'start --json --system-unit --full --skip-tests --repo' \
  "$fixture/backend.log" >/dev/null
machine_candidate=$(sed -n 's/.*--repo \([^ ]*\).*/\1/p' \
  "$fixture/backend.log")
[[ $machine_candidate == "$fixture/data/cybexos/releases/.stage.1.2.3."* ]]
[[ -d $machine_candidate ]]
cmp -s "$fixture/config.yml" "$fixture/config.original.yml"
[[ ! -e $fixture/data/cybexos/current ]]
rm -rf -- "$machine_candidate"
$updater --start --no-packages --firmware >/dev/null 2>&1
grep -F -- '--release-config '"$fixture/config.yml"' --no-packages --firmware -- -e' \
  "$fixture/backend.log" >/dev/null
firmware_candidate=$(sed -n 's/.*--repo \([^ ]*\).*/\1/p' "$fixture/backend.log")
[[ $firmware_candidate == "$fixture/data/cybexos/releases/.stage.1.2.3."* ]]
rm -rf -- "$firmware_candidate"

export MOCK_BACKEND_ATTACH_RC=42
if $updater --no-packages >/dev/null 2>"$fixture/apply-failed.err"; then
  echo 'failed release apply was accepted' >&2
  exit 1
fi
cmp -s "$fixture/config.yml" "$fixture/config.original.yml"
[[ ! -e $fixture/data/cybexos/current ]]

# Detaching the client must leave configuration and activation to the durable
# worker instead of attempting either operation in this terminal process.
export MOCK_BACKEND_ATTACH_RC=130
set +e
$updater --no-packages >/dev/null 2>"$fixture/detached.err"
detached_rc=$?
set -e
[[ $detached_rc -eq 130 ]]
cmp -s "$fixture/config.yml" "$fixture/config.original.yml"
[[ ! -e $fixture/data/cybexos/current ]]

# A release transaction never attaches to an unrelated active worker.
unset MOCK_BACKEND_ATTACH_RC
export MOCK_BACKEND_EXISTING=true
set +e
$updater --no-packages >/dev/null 2>"$fixture/existing.err"
existing_rc=$?
set -e
[[ $existing_rc -eq 75 ]]
grep -F 'another update is active' "$fixture/existing.err" >/dev/null
cmp -s "$fixture/config.yml" "$fixture/config.original.yml"
[[ ! -e $fixture/data/cybexos/current ]]
unset MOCK_BACKEND_EXISTING

# A staged candidate is untrusted cache: the next attempt must replace it from
# the newly verified archive instead of accepting locally modified contents.
mkdir -p "$fixture/data/cybexos/releases/1.2.3"
touch "$fixture/data/cybexos/releases/1.2.3/UNTRUSTED"
mkdir -p "$fixture/data/cybexos/releases/1.2.3-beta.1" \
  "$fixture/data/cybexos/releases/1.2.2" \
  "$fixture/data/cybexos/releases/1.2.1" \
  "$fixture/data/cybexos/releases/not-a-version"
$updater --no-packages >/dev/null
[[ -d $fixture/data/cybexos/releases/1.2.3 ]]
[[ ! -e $fixture/data/cybexos/releases/1.2.3/UNTRUSTED ]]
[[ -d $fixture/data/cybexos/releases/1.2.3-beta.1 ]]
[[ -d $fixture/data/cybexos/releases/1.2.2 ]]
[[ ! -e $fixture/data/cybexos/releases/1.2.1 ]]
[[ -d $fixture/data/cybexos/releases/not-a-version ]]
[[ $(readlink "$fixture/data/cybexos/current") == releases/1.2.3 ]]
[[ $(python3 -c 'import sys,yaml; print(yaml.safe_load(open(sys.argv[1]))["config_schema_version"])' "$fixture/config.yml") == 1 ]]
grep -F -- 'start --json --system-unit --full --skip-tests --repo' "$fixture/backend.log" >/dev/null
grep -F -- '--release-version 1.2.3 --release-data-root' "$fixture/backend.log" >/dev/null
grep -F -- '--no-packages -- -e' "$fixture/backend.log" >/dev/null
grep -F -- 'release verify v1.2.3 --repo example/cybexos' "$fixture/gh.log" >/dev/null
grep -F -- 'release verify-asset v1.2.3' "$fixture/gh.log" >/dev/null

# GitHub, gh, or a bad candidate must never block Fedora and Flatpak updates.
# An unauthenticated gh is detected before the archive is downloaded, and the
# package-only run carries the reason for the panel.
no_stage() {
  [[ -z $(find "$fixture/data/cybexos/releases" -maxdepth 1 -name '.stage.*') ]]
}
# Earlier detached/failed attaches deliberately leave worker-owned stages.
find "$fixture/data/cybexos/releases" -maxdepth 1 -name '.stage.*' -exec rm -rf -- {} +
export MOCK_GH_UNAUTHENTICATED=1
check=$($updater --check --json)
[[ $(jq -r .available <<<"$check") == true ]]
jq -e '.projectError | test("gh auth login")' <<<"$check" >/dev/null
: >"$MOCK_CURL_LOG"
fallback_start=$($updater --start --no-flatpak 2>"$fixture/fallback-start.err")
[[ $(<"$fixture/backend.log") == 'start --json --system-unit --no-flatpak' ]]
[[ $(jq -r .id <<<"$fallback_start") == 20260903-120001-2-2 ]]
jq -e '.projectError | test("gh auth login")' <<<"$fallback_start" >/dev/null
! grep -Fq 'example.invalid/release.tar.zst' "$MOCK_CURL_LOG"
no_stage
set +e
$updater --no-flatpak >"$fixture/fallback-run.out" 2>"$fixture/fallback-run.err"
fallback_run_rc=$?
set -e
[[ $fallback_run_rc -eq 69 ]]
[[ $(<"$fixture/backend.log") == 'run --no-flatpak' ]]
grep -Fx 'package-only run finished' "$fixture/fallback-run.out" >/dev/null
grep -F 'system packages were updated, but CybexOS was not' \
  "$fixture/fallback-run.err" >/dev/null
# A release-only request has nothing to fall back to.
set +e
$updater --no-packages >/dev/null 2>"$fixture/release-only.err"
release_only_rc=$?
set -e
[[ $release_only_rc -eq 1 ]]
grep -F 'gh auth login' "$fixture/release-only.err" >/dev/null
# gh treats a token in the environment as a login.
GH_TOKEN=fixture-token $updater --check --json | jq -e '.projectError == ""' >/dev/null
unset MOCK_GH_UNAUTHENTICATED

# Offline: the check keeps curl's own error last for the panel, while an
# update still starts the package-only worker.
export MOCK_CURL_OFFLINE=1
set +e
$updater --check >/dev/null 2>"$fixture/offline-check.err"
offline_check_rc=$?
set -e
[[ $offline_check_rc -ne 0 ]]
[[ $(tail -n 1 "$fixture/offline-check.err") \
    == 'curl: (6) Could not resolve host: api.github.com' ]]
offline_start=$($updater --start 2>/dev/null)
jq -e '.projectError | test("could not fetch")' <<<"$offline_start" >/dev/null
[[ $(<"$fixture/backend.log") == 'start --json --system-unit' ]]
unset MOCK_CURL_OFFLINE

# A failed attestation or an incompatible candidate is refused, its stage is
# removed, and the package update still runs.
export MOCK_GH_VERIFY_FAIL=1
verify_start=$($updater --start 2>/dev/null)
jq -e '.projectError | test("could not verify")' <<<"$verify_start" >/dev/null
[[ $(<"$fixture/backend.log") == 'start --json --system-unit' ]]
no_stage
unset MOCK_GH_VERIFY_FAIL
printf '%s\n' '---' 'config_schema_version: 2' 'primary_user: tester' >"$fixture/config.yml"
incompatible_start=$($updater --start 2>/dev/null)
jq -e '.projectError | test("incompatible")' <<<"$incompatible_start" >/dev/null
[[ $(<"$fixture/backend.log") == 'start --json --system-unit' ]]
no_stage
cp -- "$fixture/config.original.yml" "$fixture/config.yml"

release_json false
if $updater --check >/dev/null 2>"$fixture/mutable.err"; then
  echo 'mutable release was accepted' >&2
  exit 1
fi
grep -F 'refusing mutable GitHub release' "$fixture/mutable.err" >/dev/null

echo 'GitHub releases are compatibility-checked, verified, staged, and activated after apply; package updates never depend on GitHub'
