#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'Fedora VM convergence assertion failed: %s\n' "$*" >&2
  exit 1
}

assert_content() {
  local path=$1 expected=$2
  [[ -f $path ]] || fail "$path was removed"
  [[ $(<"$path") == "$expected" ]] || fail "$path was modified"
}

assert_system_enabled() {
  systemctl is-enabled --quiet "$1" || {
    systemctl is-enabled "$1" >&2 || true
    fail "$1 is not enabled"
  }
}

for unit in NetworkManager.service firewalld.service bluetooth.service \
  gdm.service; do
  assert_system_enabled "$unit"
done

for unit in thermald.service intel_lpmd.service xps-haptic-touchpad.service \
  xps-ipu7-camera.service; do
  systemctl is-enabled --quiet "$unit" 2>/dev/null &&
    fail "$unit was enabled on generic hardware"
done

for path in /etc/tuned/profiles/xps-performance /usr/local/share/xps-2026; do
  [[ ! -e $path ]] || fail "$path was installed on generic hardware"
done
grep -q '^performance=xps-performance$' /etc/tuned/ppd.conf &&
  fail 'the XPS performance mapping was installed on generic hardware'

user_id=$(id -u fedora)
for unit in quickshell.service hypridle.service hyprpolkitagent.service; do
  sudo -u fedora env XDG_RUNTIME_DIR="/run/user/$user_id" \
    systemctl --user is-enabled --quiet "$unit" ||
    fail "$unit is not enabled for fedora"
done

[[ -x /usr/local/libexec/cybexos-system-snapshot ]] || fail 'snapshot helper is not executable'
[[ -x /usr/local/libexec/cybexos-session-action ]] || fail 'session action helper is not executable'
[[ -r /usr/local/libexec/cybexos-common.sh ]] || fail 'shared installer helper is missing'
[[ -x /home/fedora/.local/bin/cybexos-agent ]] || fail 'default AI agent helper is missing'
runtime=/home/fedora/.local/share/cybexos/runtime
[[ -f $runtime/quickshell/shell.qml ]] || fail 'vendor shell.qml is missing'
[[ -f $runtime/hypr/hyprland.lua ]] || fail 'vendor Hyprland entry point is missing'
[[ -f /home/fedora/.config/systemd/user/cybexos-session-lock.service ]] || fail 'lock unit is missing'
[[ -f /usr/share/wayland-sessions/hyprland-quickshell.desktop ]] || fail 'GDM session is missing'
[[ $(plymouth-set-default-theme) == bgrt ]] || fail 'BGRT is not the selected Plymouth theme'

assert_content /home/fedora/.config/hypr/bindings.lua 'original Hyprland bindings'
assert_content /home/fedora/.config/quickshell/shell.qml 'original Quickshell root'
assert_content /home/fedora/.config/cybexos/shell.json 'original shell settings'
assert_content /home/fedora/.config/cybexos/hypr/user.lua 'original user override'
assert_content /home/fedora/.local/share/cybexos/themes/personal.theme 'original user theme'
assert_content /home/fedora/.local/share/cybexos/plugins/personal.qml 'original user plugin'
assert_content /home/fedora/.local/bin/sccache 'original sccache helper'
assert_content /home/fedora/.config/distrobox/distrobox.conf 'original Distrobox configuration'
assert_content /home/fedora/.config/noctalia/config.json 'original Noctalia configuration'
assert_content /home/fedora/.local/state/noctalia/state.json 'original Noctalia state'
assert_content /home/fedora/.cache/noctalia/cache 'original Noctalia cache'
assert_content /usr/local/bin/awww 'original awww command'
assert_content /usr/local/bin/awww-daemon 'original awww daemon'
assert_content /usr/local/bin/wayfreeze 'original wayfreeze command'
assert_content /usr/local/bin/hyprland-noctalia 'original Noctalia launcher'
assert_content /usr/share/wayland-sessions/hyprland-noctalia.desktop 'original Noctalia session'

agent_skill=/home/fedora/.local/share/cybexos/current/agent-skills/cybexos
[[ -r $agent_skill/SKILL.md ]] || fail 'canonical CybexOS skill is missing'
for root in .agents .claude .codex; do
  discovery=/home/fedora/$root/skills/cybexos
  [[ -L $discovery ]] || fail "$discovery is not a symlink"
  [[ $(readlink -- "$discovery") == "$agent_skill" ]] ||
    fail "$discovery does not name the active-release skill"
  [[ $(readlink -f -- "$discovery") == $(readlink -f -- "$agent_skill") ]] ||
    fail "$discovery does not resolve to the active-release skill"
  [[ -f /home/fedora/.local/state/cybexos/backups/agent-skills/${root#.}/complete ]] ||
    fail "$root skill adoption record is missing"
done
assert_content /home/fedora/.agents/skills/unrelated/SKILL.md \
  'unrelated agents skill'
assert_content /home/fedora/.claude/skills/unrelated/SKILL.md \
  'unrelated claude skill'
assert_content /home/fedora/.codex/skills/unrelated/SKILL.md \
  'unrelated codex skill'

[[ $(firewall-cmd --get-default-zone) == cybexos ]] ||
  fail 'CybexOS is not the active default firewall zone'
while IFS=: read -r uuid type; do
  case "$type" in
    802-3-ethernet|802-11-wireless)
      [[ $(nmcli -g connection.zone connection show "$uuid") == cybexos ]] ||
        fail "$uuid is not bound to the CybexOS firewall zone"
      ;;
  esac
done < <(nmcli -t -f UUID,TYPE connection show)
if find "$runtime/quickshell" \
    \( -type d -name __pycache__ -o -type f -name '*.py[co]' \) -print -quit |
    grep -q .; then
  fail 'generated Python bytecode leaked into the deployed shell'
fi
if grep -Eq '(^|/)__pycache__/|\.py[co]$' \
    /home/fedora/.local/state/cybexos/quickshell-manifest.txt; then
  fail 'generated Python bytecode leaked into the managed shell manifest'
fi

for key in sleep-inactive-ac-timeout sleep-inactive-battery-timeout; do
  value=$(sudo -u fedora env HOME=/home/fedora dbus-run-session \
    gsettings get org.gnome.settings-daemon.plugins.power "$key")
  [[ $value == 0 ]] || fail "$key is $value instead of 0"
done

python3 - <<'PY' || fail 'headless Quickshell deployment health is invalid'
import json
from pathlib import Path

health = json.loads(Path(
    "/home/fedora/.local/state/cybexos/quickshell-health.json"
).read_text(encoding="utf-8"))
assert health["status"] == "skipped", health
assert health["detail"] == "No live shell was active before deployment", health
PY

printf 'Fedora VM rendered configuration and service assertions passed\n'
