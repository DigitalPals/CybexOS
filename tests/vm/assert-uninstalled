#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'Fedora VM uninstall assertion failed: %s\n' "$*" >&2
  exit 1
}

assert_content() {
  local path=$1 expected=$2
  [[ -f $path ]] || fail "$path was not restored"
  [[ $(<"$path") == "$expected" ]] || fail "$path did not retain its original content"
}

assert_content /home/fedora/.config/hypr/bindings.lua 'original Hyprland bindings'
assert_content /home/fedora/.config/quickshell/shell.qml 'original Quickshell root'
assert_content /home/fedora/.config/cybexos/shell.json \
  '{"wall":"~/Pictures/personal-wallpaper.jpg","fixture":"original shell settings"}'
assert_content /home/fedora/.config/cybexos/hypr/user.lua 'original user override'
assert_content /home/fedora/.local/share/cybexos/themes/personal.theme 'original user theme'
assert_content /home/fedora/.local/share/cybexos/plugins/personal.qml 'original user plugin'
assert_content /home/fedora/.local/bin/spotify 'original Spotify helper'
assert_content /home/fedora/.config/systemd/user/quickshell.service 'original user unit'
assert_content /etc/gdm/custom.conf $'[daemon]\n# original GDM configuration'
assert_content /etc/sddm.conf $'[Theme]\nCurrent=original'
assert_content /etc/pam.d/sddm-autologin '# original SDDM autologin PAM'
assert_content /etc/systemd/system/sddm.service.d/50-cybexos.conf '# original SDDM drop-in'
assert_content /etc/systemd/system/sddm.service.d/99-personal.conf '# original personal drop-in'
assert_content /etc/cybexos/login.json '{"original":true}'
[[ $(readlink /etc/systemd/system/display-manager.service) == \
  /etc/systemd/system/cybexos-original-display-manager.service ]] ||
  fail 'the previous display manager selection was not restored'
assert_content /etc/sudoers.d/10-wheel-nopasswd '# original sudo policy'
assert_content /etc/polkit-1/rules.d/49-wheel-local.rules '// original Polkit policy'
assert_content /home/fedora/.local/bin/sccache 'original sccache helper'
assert_content /home/fedora/.config/distrobox/distrobox.conf 'original Distrobox configuration'
assert_content /home/fedora/.config/noctalia/config.json 'original Noctalia configuration'
assert_content /home/fedora/.local/state/noctalia/state.json 'original Noctalia state'
assert_content /home/fedora/.cache/noctalia/cache 'original Noctalia cache'
assert_content /usr/local/bin/awww 'original awww command'
assert_content /usr/local/bin/awww-daemon 'original awww daemon'
assert_content /usr/local/bin/wayfreeze 'original wayfreeze command'
assert_content /usr/local/bin/hyprland-noctalia 'original Noctalia launcher'
assert_content /usr/share/wayland-sessions/hyprland-noctalia.desktop 'original Noctalia session'
[[ -f /home/fedora/.agents/skills/cybexos \
    && ! -L /home/fedora/.agents/skills/cybexos ]] ||
  fail 'original agents skill file was not restored'
assert_content /home/fedora/.agents/skills/cybexos \
  'original agents skill'
[[ -d /home/fedora/.claude/skills/cybexos \
    && ! -L /home/fedora/.claude/skills/cybexos ]] ||
  fail 'original Claude skill directory was not restored'
assert_content /home/fedora/.claude/skills/cybexos/nested/value \
  'original claude skill'
[[ -L /home/fedora/.codex/skills/cybexos ]] ||
  fail 'original Codex skill symlink was not restored'
[[ $(readlink -- /home/fedora/.codex/skills/cybexos) \
    == /home/fedora/original-codex-skill ]] ||
  fail 'original Codex skill symlink text changed'
assert_content /home/fedora/.agents/skills/unrelated/SKILL.md \
  'unrelated agents skill'
assert_content /home/fedora/.claude/skills/unrelated/SKILL.md \
  'unrelated claude skill'
assert_content /home/fedora/.codex/skills/unrelated/SKILL.md \
  'unrelated codex skill'
[[ ! -e /var/lib/AccountsService/users/fedora ]] ||
  fail 'an AccountsService record created by CybexOS remains after uninstall'

for path in \
  /usr/local/bin/hyprland-quickshell \
  /usr/share/wayland-sessions/hyprland-quickshell.desktop \
  /usr/local/libexec/cybexos-session-action \
  /usr/libexec/cybexos-login-prepare \
  /usr/local/libexec/cybexos-system-snapshot \
  /etc/grub.d/42_cybexos_recovery \
  /etc/kernel/install.d/95-cybexos-recovery.install \
  /etc/systemd/system/cybexos-recovery-refresh.service \
  /usr/lib/dracut/modules.d/90cybexos-recovery \
  /etc/dracut.conf.d/90-cybexos-recovery.conf \
  /boot/grub2/cybexos-recovery.cfg \
  /etc/sysctl.d/60-cybexos-hardening.conf \
  /home/fedora/.config/hypr/features.lua \
  /home/fedora/.local/share/cybexos/runtime \
  /home/fedora/.local/bin/cybex \
  /home/fedora/.local/bin/cybexos-agent \
  /home/fedora/.local/state/cybexos \
  /var/lib/cybexos; do
  [[ ! -e $path && ! -L $path ]] || fail "$path remains after uninstall"
done

! grep -qF '42_cybexos_recovery' /boot/grub2/grub.cfg ||
  fail 'grub.cfg still sources the recovery submenu after uninstall'
initramfs_listing=$(lsinitrd "/boot/initramfs-$(uname -r).img")
! grep -q cybexos-recovery <<<"$initramfs_listing" ||
  fail 'the initramfs still carries the recovery overlay module after uninstall'

for unit in quickshell.service hypridle.service hyprpolkitagent.service; do
  [[ ! -L /home/fedora/.config/systemd/user/hyprland-session.target.wants/$unit ]] \
    || fail "$unit remains enabled after uninstall"
done

[[ -f /etc/tuned/ppd.conf ]] || fail 'the Fedora TuneD PPD configuration was removed'
grep -q '^performance=xps-performance$' /etc/tuned/ppd.conf &&
  fail 'the XPS TuneD mapping remains on generic hardware'

[[ $(firewall-cmd --get-default-zone) == home ]] ||
  fail 'the first-adoption default firewall zone was not restored'
while IFS=: read -r uuid type; do
  case "$type" in
    802-3-ethernet|802-11-wireless)
      [[ $(nmcli -g connection.zone connection show "$uuid") == work ]] ||
        fail "$uuid did not regain its first-adoption firewall zone"
      ;;
  esac
done < <(nmcli -t -f UUID,TYPE connection show)
firewall-cmd --permanent --get-zones | tr ' ' '\n' | grep -Fxq cybexos &&
  fail 'the CybexOS firewall zone remains after uninstall'

printf 'Fedora VM uninstall restored adopted files and removed project state\n'
