#!/usr/bin/env bash
set -uo pipefail
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=tests/lib/quickshell-live
source "$repo_root/tests/lib/quickshell-live"

usage() {
  printf 'Usage: tests/verify-system [--require-hyprland]\n'
  printf 'Run non-destructive checks against the installed CybexOS system.\n'
}

require_hyprland=false
while (($#)); do
  case $1 in
    --require-hyprland) require_hyprland=true ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'verify-system: unknown argument %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
failures=0
warnings=0
quickshell_live_safe=false
verify_scratch_dirs=()

cleanup_verify() {
  local directory
  if $quickshell_live_safe; then
    qs_live_end >/dev/null 2>&1 || true
    quickshell_live_safe=false
  fi
  for directory in "${verify_scratch_dirs[@]}"; do
    [[ $directory == "${TMPDIR:-/tmp}"/cybexos-manifest.* ]] &&
      rm -rf -- "$directory"
  done
}
trap cleanup_verify EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

inventory_host=${CYBEXOS_INVENTORY_HOST:-workstation}
config_file=${CYBEXOS_CONFIG_FILE:-/etc/cybexos/config.yml}
if ! command -v ansible-inventory >/dev/null 2>&1; then
  printf 'FAIL  ansible-inventory is required to read the machine contract (dnf install ansible-core)\n' >&2
  exit 2
fi
if ! command -v jq >/dev/null 2>&1; then
  printf 'FAIL  jq is required to read the machine contract\n' >&2
  exit 2
fi
inventory_args=(-i "$repo_root/inventory/hosts.yml" --host "$inventory_host")
[[ -r $config_file ]] && inventory_args+=(--extra-vars "@$config_file")
if ! inventory_json=$(ansible-inventory "${inventory_args[@]}"); then
  printf 'FAIL  could not resolve inventory host %q from inventory/hosts.yml\n' "$inventory_host" >&2
  exit 2
fi
# ansible-inventory leaves group-variable templates unrendered. Resolve only
# the known compatibility alias; arbitrary values still fail validation.
inventory_json=$(jq '
  if .desktop_autologin == "{{ gdm_autologin | default(false) }}" then
    .desktop_autologin = (if has("gdm_autologin") then .gdm_autologin else false end)
  else . end
' <<<"$inventory_json")
if ! jq -e '
  (.fedora_release | type == "string") and
  (.machine_hostname | type == "string") and
  (.machine_timezone | type == "string") and
  (.primary_user | type == "string") and
  (.primary_home | type == "string") and
  (.desktop_autologin | type == "boolean") and
  (.plymouth_theme | type == "string") and
  (.rust_toolchain | type == "string") and
  (.claude_code_version | type == "string") and
  (.opencode_version | type == "string") and
  (.codex_cli_version | type == "string") and
  (.distrobox_images | type == "array") and
  (.firewall_zone | type == "string") and
  (.firewall_ports | type == "array") and
  (.features | type == "object") and
  (.config_schema_version == 1) and
  (.manage_system_identity | type == "boolean") and
  (.manage_personal_dotfiles | type == "boolean")
' >/dev/null <<<"$inventory_json"; then
  printf 'FAIL  inventory host %q lacks one or more verifier contract fields\n' "$inventory_host" >&2
  exit 2
fi

fedora_release=$(jq -r .fedora_release <<<"$inventory_json")
machine_hostname=$(jq -r .machine_hostname <<<"$inventory_json")
machine_timezone=$(jq -r .machine_timezone <<<"$inventory_json")
regional_locale=$(jq -r .regional_locale <<<"$inventory_json")
primary_user=$(jq -r .primary_user <<<"$inventory_json")
primary_home=$(jq -r .primary_home <<<"$inventory_json")
rust_toolchain=$(jq -r .rust_toolchain <<<"$inventory_json")
claude_code_version=$(jq -r .claude_code_version <<<"$inventory_json")
opencode_version=$(jq -r .opencode_version <<<"$inventory_json")
codex_cli_version=$(jq -r .codex_cli_version <<<"$inventory_json")
distrobox_images_json=$(jq -c .distrobox_images <<<"$inventory_json")
firewall_zone=$(jq -r .firewall_zone <<<"$inventory_json")
manage_system_identity=$(jq -r .manage_system_identity <<<"$inventory_json")
manage_personal_dotfiles=$(jq -r .manage_personal_dotfiles <<<"$inventory_json")
desktop_autologin=$(jq -r .desktop_autologin <<<"$inventory_json")
docker_sudoless=$(jq -r '.docker_sudoless // false' <<<"$inventory_json")
plymouth_theme=$(jq -r .plymouth_theme <<<"$inventory_json")
feature_enabled() { jq -e --arg name "$1" '.features[$name] == true' >/dev/null <<<"$inventory_json"; }

pass() { printf '\033[32mPASS\033[0m  %s\n' "$*"; }
fail() { printf '\033[31mFAIL\033[0m  %s\n' "$*"; failures=$((failures + 1)); }
warn() { printf '\033[33mWARN\033[0m  %s\n' "$*"; warnings=$((warnings + 1)); }
skip() { printf '\033[36mSKIP\033[0m  %s\n' "$*"; }
check() {
  local label=$1; shift
  if "$@" >/dev/null 2>&1; then pass "$label"; else fail "$label"; fi
}
check_diagnostic() {
  local label=$1 output
  shift
  if output=$("$@" 2>&1); then
    pass "$label"
  else
    fail "$label"
    sed 's/^/      /' <<<"$output"
  fi
}
command_exists() { command -v "$1" >/dev/null 2>&1; }
unit_enabled() { systemctl is-enabled --quiet "$1"; }
unit_active() { systemctl is-active --quiet "$1"; }
user_unit_active() { systemctl --user is-active --quiet "$1"; }

agent_skill_link_valid() {
  local path=$1 canonical=$2 resolved canonical_resolved
  [[ -L $path && $(readlink -- "$path") == "$canonical" ]] || return 1
  resolved=$(readlink -f -- "$path") || return 1
  canonical_resolved=$(readlink -f -- "$canonical") || return 1
  [[ $resolved == "$canonical_resolved" && -r $resolved/SKILL.md ]]
}

root_evidence_available=true
root_command=()
if ((EUID != 0)); then
  if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    root_command=(sudo -n)
  elif [[ -t 0 && -t 2 ]] && command -v sudo >/dev/null 2>&1 && sudo -v; then
    root_command=(sudo)
  else
    root_evidence_available=false
    warn 'root-only evidence is unavailable; authenticate with sudo or run as root for those checks'
  fi
fi
run_as_root() { "${root_command[@]}" "$@"; }
check_root() {
  local label=$1
  shift
  if ! $root_evidence_available; then
    warn "$label (root-only evidence not readable)"
  elif run_as_root "$@" >/dev/null 2>&1; then
    pass "$label"
  else
    fail "$label"
  fi
}

check_managed_quickshell_tree() {
  local deployed="$primary_home/.local/share/cybexos/runtime/quickshell" scratch expected actual
  scratch=$(mktemp -d "${TMPDIR:-/tmp}/cybexos-manifest.XXXXXX") || return 1
  verify_scratch_dirs+=("$scratch")
  expected="$scratch/expected"
  actual="$scratch/actual"
  # Match the role's source manifest: cached and intentional untracked files,
  # including symlinks, while respecting ignored generated artifacts.
  {
    if git -C "$repo_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      git -C "$repo_root" ls-files -z --cached --others --exclude-standard -- \
          roles/desktop/files/quickshell |
        while IFS= read -r -d '' source_path; do
          if [[ -f "$repo_root/$source_path" || -L "$repo_root/$source_path" ]]; then
            printf '%s\n' "${source_path#roles/desktop/files/quickshell/}"
          fi
        done
    else
      find "$repo_root/roles/desktop/files/quickshell" \
        \( -type d -name __pycache__ -prune \) -o \
        \( -type f -o -type l \) ! -name '*.py[co]' -printf '%P\n'
    fi
  } | LC_ALL=C sort >"$expected" || {
      rm -rf -- "$scratch"
      return 1
    }
  [[ -s $expected ]] || {
    printf 'source manifest unexpectedly contains no files\n' >&2
    rm -rf -- "$scratch"
    return 1
  }
  if [[ -d $deployed ]]; then
    # The running shell's Python helpers write __pycache__ into the runtime
    # tree; the deployment treats those as inert and clears them only with a
    # real deployment, so they are not unmanaged files.
    find "$deployed" \( -type d -name __pycache__ -prune \) -o \
      \( -type f -o -type l \) -printf '%P\n' | LC_ALL=C sort >"$actual"
  else
    printf 'deployed directory is missing: %s\n' "$deployed" >&2
    rm -rf -- "$scratch"
    return 1
  fi
  if cmp -s "$expected" "$actual"; then
    rm -rf -- "$scratch"
    return 0
  fi
  printf 'source-only managed files:\n' >&2
  comm -23 "$expected" "$actual" | sed 's/^/  /' >&2
  printf 'stale or unmanaged deployed files:\n' >&2
  comm -13 "$expected" "$actual" | sed 's/^/  /' >&2
  rm -rf -- "$scratch"
  return 1
}

printf '%s\n' 'CybexOS automated verification'
printf 'Contract: inventory host %s (%s, Fedora %s, user %s)\n' \
  "$inventory_host" "$machine_hostname" "$fedora_release" "$primary_user"
check "verifier runs as $primary_user" test "$(id -un)" = "$primary_user"
check "HOME is $primary_home" test "$HOME" = "$primary_home"
check "Fedora $fedora_release" bash -c '. /etc/os-release; [[ $ID == fedora && $VERSION_ID == "$1" ]]' _ "$fedora_release"
if [[ $manage_system_identity == true ]]; then
  check "hostname is $machine_hostname" test "$(hostnamectl --static 2>/dev/null)" = "$machine_hostname"
  check "timezone is $machine_timezone" test "$(timedatectl show -p Timezone --value 2>/dev/null)" = "$machine_timezone"
else
  skip 'hostname and timezone are not managed by this installation'
fi
check 'SELinux is enforcing' test "$(getenforce 2>/dev/null)" = Enforcing
check "Fish is $primary_user login shell" bash -c '[[ $(getent passwd "$1" | cut -d: -f7) == /usr/bin/fish ]]' _ "$primary_user"
if [[ $manage_personal_dotfiles == true ]]; then
  check 'Fish prompt resolves the Fedora OS icon' fish -lic 'test "$POSH_OS_ICON" = ""'
else
  skip 'opinionated Fish prompt is not managed by this installation'
fi
required_groups=(wheel video input)
feature_enabled docker && [[ $docker_sudoless == true ]] && required_groups+=(docker)
check "$primary_user is in required groups (${required_groups[*]})" bash -c '
  groups=$(id -nG "$1") || exit
  shift
  for group in "$@"; do grep -qw "$group" <<<"$groups" || exit 1; done
' _ "$primary_user" "${required_groups[@]}"
if [[ $docker_sudoless != true ]]; then
  # The account database, not this process: a session opened before the
  # revocation keeps its old supplementary groups until the next login.
  check "$primary_user has no root-equivalent docker group access" bash -c \
    '! id -nG "$1" | grep -qw docker' _ "$primary_user"
fi
check 'user lingering is enabled' test -e "/var/lib/systemd/linger/$primary_user"

for unit in NetworkManager firewalld bluetooth avahi-daemon cups; do
  check "$unit is enabled" unit_enabled "$unit.service"
done
if feature_enabled docker; then
  # Socket activation starts dockerd on the first client request.
  check 'docker socket activation is enabled' unit_enabled docker.socket
  check 'docker is not started at boot' bash -c '! systemctl is-enabled --quiet docker.service'
else
  check 'docker is disabled while the feature is off' bash -c \
    '! systemctl is-enabled --quiet docker.socket && ! systemctl is-enabled --quiet docker.service'
fi
if feature_enabled tailscale; then
  check 'Tailscale package is installed' rpm -q tailscale
  check 'tailscaled is enabled' unit_enabled tailscaled.service
  check 'tailscaled is active' unit_active tailscaled.service
else
  check 'Tailscale package is absent while disabled' bash -c '! rpm -q tailscale'
  check 'tailscaled is disabled while the feature is off' bash -c '! systemctl is-enabled --quiet tailscaled.service'
  check 'tailscaled is inactive while the feature is off' bash -c '! systemctl is-active --quiet tailscaled.service'
fi
check 'weekly TRIM is enabled' unit_enabled fstrim.timer
if [[ $(findmnt --noheadings --output FSTYPE --target / 2>/dev/null | xargs) == btrfs ]]; then
  check 'weekly Btrfs scrub is enabled' unit_enabled cybexos-btrfs-scrub.timer
  check 'transactional Btrfs recovery helper is installed' \
    test -x /usr/local/libexec/cybexos-system-snapshot
else
  check 'Btrfs scrub is disabled on a non-Btrfs root' bash -c '! systemctl is-enabled --quiet cybexos-btrfs-scrub.timer'
fi
check 'zram is active' bash -c 'swapon --show=NAME | grep -q zram'

declare -A expected_sysctl=(
  [kernel.kptr_restrict]=2 [kernel.dmesg_restrict]=1
  [kernel.perf_event_paranoid]=3 [kernel.yama.ptrace_scope]=1
  [vm.mmap_min_addr]=65536 [net.ipv4.icmp_echo_ignore_broadcasts]=1
  [net.ipv4.conf.all.accept_redirects]=0 [net.ipv4.conf.default.accept_redirects]=0
  [net.ipv6.conf.all.accept_redirects]=0 [net.ipv6.conf.default.accept_redirects]=0
)
for key in "${!expected_sysctl[@]}"; do
  value=$(sysctl -n "$key" 2>/dev/null || true)
  [[ $value == "${expected_sysctl[$key]}" ]] && pass "sysctl $key" || fail "sysctl $key=${value:-missing}, expected ${expected_sysctl[$key]}"
done
bpf=$(sysctl -n kernel.unprivileged_bpf_disabled 2>/dev/null || true)
[[ $bpf =~ ^[12]$ ]] && pass 'Fedora unprivileged BPF restriction retained' || fail "unprivileged BPF restriction is ${bpf:-missing}"
rp=$(sysctl -n net.ipv4.conf.default.rp_filter 2>/dev/null || true)
[[ $rp == 2 ]] && pass 'Fedora reverse-path filtering policy retained' || warn "default rp_filter is $rp; no override is installed by this playbook"
swappiness=$(sysctl -n vm.swappiness 2>/dev/null || true)
[[ $swappiness =~ ^[0-9]+$ && $swappiness -ge 60 ]] \
  && pass 'Fedora zram-oriented swappiness retained' || warn "swappiness is ${swappiness:-missing}"

if command_exists firewall-cmd && unit_active firewalld.service; then
  zone=$(firewall-cmd --get-default-zone 2>/dev/null || true)
  [[ $zone == "$firewall_zone" ]] && pass "$firewall_zone is the default firewall zone" || fail "default firewall zone is ${zone:-missing}, expected $firewall_zone"
  ports=$(firewall-cmd --permanent --zone="$firewall_zone" --list-ports 2>/dev/null | tr ' ' '\n' | sort | tr '\n' ' ')
  expected=$(jq -r '
    . as $root
    | if $root.features.local_network_services then
        $root.firewall_ports[]
        | select((.feature == null) or ($root.features[.feature] == true))
        | "\(.port)/\(.protocol)"
      else empty end
  ' <<<"$inventory_json" | sort | tr '\n' ' ')
  [[ $ports == "$expected" ]] && pass 'firewall exposes only declared ports' || fail "firewall ports differ: $ports"
  services=$(firewall-cmd --permanent --zone="$firewall_zone" --list-services 2>/dev/null || true)
  [[ -z $services ]] && pass 'firewall has no broad service exceptions' || fail "unexpected firewall services: $services"
  interfaces=$(firewall-cmd --permanent --zone="$firewall_zone" --list-interfaces 2>/dev/null || true)
  if feature_enabled tailscale; then
    grep -qw tailscale0 <<<"$interfaces" && pass "tailscale0 is trusted in $firewall_zone zone" || fail "tailscale0 is absent from $firewall_zone zone"
  elif grep -qw tailscale0 <<<"$interfaces"; then
    fail "tailscale0 is present despite features.tailscale=false"
  else
    pass 'tailscale0 is absent while Tailscale is disabled'
  fi
  while IFS=: read -r device type state; do
    case "$type:$state" in
      ethernet:connected|wifi:connected)
        assigned=$(firewall-cmd --get-zone-of-interface="$device" 2>/dev/null || true)
        [[ $assigned == "$firewall_zone" ]] && pass "$device is bound to $firewall_zone zone" || fail "$device is bound to ${assigned:-no zone}"
        ;;
    esac
  done < <(LC_ALL=C nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null)
  while IFS=: read -r uuid type; do
    case "$type" in
      802-3-ethernet|802-11-wireless)
        assigned=$(nmcli -g connection.zone connection show "$uuid" 2>/dev/null || true)
        [[ $assigned == "$firewall_zone" ]] && pass "$uuid profile is bound to $firewall_zone zone" \
          || fail "$uuid profile is bound to ${assigned:-no zone}"
        ;;
    esac
  done < <(nmcli -t -f UUID,TYPE connection show 2>/dev/null)
else
  fail 'firewalld is active and queryable'
fi

cmdline=$(</proc/cmdline)
if grep -Eq 'iwlwifi[.]disable_11be|(^| )fred=on|xe[.](enable_guc|force_probe)|enable_panel_replay|enable_psr' <<<"$cmdline"; then
  fail "obsolete XPS kernel workaround is present: $cmdline"
else
  pass 'no obsolete XPS kernel workarounds'
fi
if command_exists mokutil; then
  mokutil --sb-state >/dev/null 2>&1 && pass 'Secure Boot state is readable' || warn 'Secure Boot state could not be read'
fi
for forbidden in xps-bios-fan-control mic-led-sync tlp; do
  systemctl list-unit-files "$forbidden.service" --no-legend 2>/dev/null | grep -q . \
    && fail "excluded unit exists: $forbidden" || pass "excluded unit absent: $forbidden"
done

product_sku=$(tr -d '[:space:]' </sys/class/dmi/id/product_sku 2>/dev/null || true)
xps_2026=false
if [[ $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) == 'Dell Inc.' ]] &&
   [[ $product_sku == 0DB9 || $product_sku == 0DBA ]] &&
   grep -Pqi '(XPS (14|16)|DA14260|DA16260)' /sys/class/dmi/id/product_name &&
   grep -Pqi '(Intel.*(Ultra|X7)|Panther Lake)' /proc/cpuinfo; then
  xps_2026=true
fi

if $xps_2026; then
  pass "precise XPS 2026 hardware gate (SKU $product_sku)"
  check 'Intel graphics uses the xe driver' bash -c "lspci -k | grep -A4 -Ei 'VGA|Display' | grep -q 'Kernel driver in use: xe'"
  check 'Intel Wi-Fi uses iwlwifi' bash -c "lspci -k | grep -A4 -Ei 'Network|Wireless' | grep -q 'Kernel driver in use: iwlwifi'"
  check 'thermald is enabled for XPS hardware' unit_enabled thermald.service
  check 'thermald is active for XPS hardware' unit_active thermald.service

  panel_product=""
  for edid in /sys/class/drm/card*-eDP-*/edid; do
    [[ -r $edid ]] || continue
    panel_product=$(od -An -tx1 -j8 -N2 "$edid" | tr -d '[:space:]')
    break
  done
  if [[ $panel_product == 30e4 ]]; then
    check_root 'every boot entry enables the XPS OLED VESA backlight path' bash -c '
      grubby --info=ALL | awk '\''
        /^args=/ {
          seen=1
          if ($0 !~ /(^|[ "])xe[.]enable_dpcd_backlight=1([ "]|$)/)
            bad=1
          if ($0 ~ /(^|[ "])i915[.]enable_dpcd_backlight([= "]|$)/)
            bad=1
        }
        END { exit (!seen || bad) }
      '\''
    '
    if grep -Eq '(^| )xe[.]enable_dpcd_backlight=1( |$)' <<<"$cmdline"; then
      pass 'XPS OLED VESA backlight path is active in this boot'
      check_root 'xe loaded the requested DPCD backlight mode' \
        grep -qx '1' /sys/module/xe/parameters/enable_dpcd_backlight
    else
      warn 'XPS OLED VESA backlight path is configured and awaits reboot'
    fi
  else
    skip "XPS OLED backlight quirk not needed (EDID ${panel_product:-unavailable})"
  fi

  check 'XPS performance TuneD profile is installed' \
    test -r /etc/tuned/profiles/xps-performance/tuned.conf
  check 'desktop Performance maps to the XPS TuneD profile' \
    grep -qx 'performance=xps-performance' /etc/tuned/ppd.conf
  check 'XPS performance TuneD profile is discoverable' \
    tuned-adm profile_info xps-performance

  panther_packages=(
    alsa-sof-firmware linux-firmware cirrus-audio-firmware
    intel-audio-firmware intel-gpu-firmware intel-vsc-firmware
    iwlwifi-mld-firmware libva-intel-media-driver libvpl intel-vpl-gpu-rt
    wireless-regdb pipewire-module-filter-chain-lv2 lsp-plugins-lv2
  )
  check 'explicit Panther Lake media/firmware RPMs' rpm -q "${panther_packages[@]}"

  check 'XPS speaker tuning user unit is enabled' systemctl --user is-enabled --quiet xps-speaker-tuning.service
  check 'XPS speaker tuning user unit is active' user_unit_active xps-speaker-tuning.service
  check '13-biquad/limiter graph targets only the internal speaker' /usr/local/libexec/xps-speaker-tuning check
  check 'desktop volume controls resolve the tuned physical sink' \
    grep -q '/usr/local/libexec/xps-speaker-tuning control' "$HOME/.local/share/cybexos/runtime/hypr/bindings.lua"

  if [[ -e /sys/bus/i2c/devices/i2c-VEN_06CB:00 ]]; then
    check_root 'XPS touchpad is visible to libinput' bash -c \
      "libinput list-devices | grep -Eqi 'Touchpad|06CB'"
    check 'XPS haptic touchpad service is enabled' unit_enabled xps-haptic-touchpad.service
    check 'XPS haptic touchpad service is active' unit_active xps-haptic-touchpad.service
    check_root 'XPS haptic configuration/readback probe' \
      /usr/local/libexec/xps-haptic-touchpad --check
    check 'XPS haptic controller power rules retained' \
      grep -q 'i2c_designware[.]0.*power/control.*on' /etc/udev/rules.d/80-xps-haptic-touchpad.rules
  else
    skip 'Synaptics 06CB haptic controller absent; touchpad-specific checks'
  fi

  fingerprint_detector="$repo_root/roles/xps-2026/files/xps-fingerprint-detect"
  if fingerprint_device=$(bash "$fingerprint_detector" 2>/dev/null); then
    pass "physical fingerprint-reader gate ($fingerprint_device)"
    check 'Fedora fingerprint support RPMs' rpm -q libfprint fprintd fprintd-pam
    check_diagnostic 'libfprint-supported device and Fedora PAM integration' \
      /usr/local/libexec/xps-fingerprint-check "$primary_user"
  else
    if lsusb -d 06cb:0701 2>/dev/null | grep -q .; then
      pass 'Synaptics SVP7500 camera bridge is not treated as a fingerprint reader'
    fi
    skip 'no physical fingerprint reader; fingerprint package/PAM checks'
  fi

  has_ovti08f4=false
  [[ -e /sys/bus/acpi/devices/OVTI08F4:00 || -e /sys/bus/acpi/devices/OVTI08F4:01 ]] && has_ovti08f4=true
  has_ipu7=false
  ipu7_bdf=$(lspci -Dn -d 8086:b05d 2>/dev/null | awk 'NR == 1 {print $1}')
  [[ -n $ipu7_bdf ]] && has_ipu7=true
  if $has_ovti08f4 && $has_ipu7; then
    check 'local IPU7 userspace/DKMS RPM installed' rpm -q xps-ipu7-camera-stack
    camera_manifest=$(run_as_root cat /usr/share/xps-ipu7-camera-stack/input-manifest 2>/dev/null || true)
    camera_rpm_version=$(rpm -q --qf '%{VERSION}' xps-ipu7-camera-stack 2>/dev/null || true)
    if [[ $camera_manifest =~ ^[[:xdigit:]]{64}$ && -n $camera_rpm_version ]]; then
      camera_dkms_version="$camera_rpm_version.input${camera_manifest:0:16}"
      pass 'camera input manifest selects an exact DKMS package identity'
    else
      camera_dkms_version=invalid-camera-input-manifest
      fail 'camera RPM has no valid input-derived DKMS identity'
    fi
    check 'unused generic camera relay generator trigger is absent' bash -c \
      '[[ ! -e /etc/v4l2-relayd.d/icamerasrc.conf && ! -L /etc/v4l2-relayd.d/icamerasrc.conf ]]'
    check 'unused generic camera relay instance is not failed' bash -c \
      '! systemctl is-failed --quiet v4l2-relayd@icamerasrc.service'
    check 'managed camera resume service is installed' \
      systemctl cat xps-ipu7-camera-resume.service
    check 'camera sleep hook restarts the managed resume service' \
      grep -q 'systemctl --no-block restart xps-ipu7-camera-resume.service' \
      /usr/lib/systemd/system-sleep/xps-ipu7-camera
    check 'IPU7 PSYS DKMS built for the running kernel' bash -c \
      'dkms status -m ipu7-drivers -v "$1" -k "$(uname -r)" 2>/dev/null | grep -q ": installed$"' _ "$camera_dkms_version"
    check 'Intel CVS DKMS built for the running kernel' bash -c \
      'dkms status -m vision-drivers -v "$1" -k "$(uname -r)" 2>/dev/null | grep -q ": installed$"' _ "$camera_dkms_version"
    if [[ -r /var/lib/xps-hardware/ipu7/reboot-required ]] &&
       grep -q "^boot_id=$(cat /proc/sys/kernel/random/boot_id) " \
         /var/lib/xps-hardware/ipu7/reboot-required; then
      pass 'camera DKMS upgrade is safely awaiting one normal reboot'
      check 'camera transaction remains uncommitted until post-reboot validation' \
        test -r /var/lib/xps-hardware/ipu7/transaction.in-progress
      check 'pending camera relay remains hidden' \
        test ! -e /etc/v4l2-relayd.d/ipu7.conf
      check 'pending camera service remains disabled' bash -c \
        '! systemctl is-enabled --quiet xps-ipu7-camera.service && ! systemctl is-active --quiet xps-ipu7-camera.service'
      check_diagnostic 'stock IPU7 ABI guard before pending reboot' \
        /usr/local/libexec/xps-ipu7-abi-check "$(uname -r)"
      check_diagnostic 'installed IPU75XA userspace dependency closure' \
        /usr/local/libexec/xps-ipu7-userspace-check
    else
      check_diagnostic 'HAL camera integration and endpoint health' /usr/local/libexec/xps-ipu7-camera-check
    fi
    check 'WirePlumber suppresses only the duplicate IPU7 paths' bash -c \
      'grep -q "monitor.libcamera.*disabled" /etc/wireplumber/wireplumber.conf.d/90-xps-ipu7-v4l2.conf && grep -Fq "pci-$1" /etc/wireplumber/wireplumber.conf.d/90-xps-ipu7-v4l2.conf' _ "$ipu7_bdf"
    check 'Brave enables PipeWire camera capture' bash -c \
      'grep -q "PipeWireCamera" "$HOME/.local/share/cybexos/runtime/hypr/bindings.lua" && grep -q "PipeWireCamera" "$HOME/.local/share/applications/brave-origin.desktop"'

    if mokutil --sb-state 2>/dev/null | grep -qi enabled; then
      check 'camera module signing key is enrolled for Secure Boot' \
        mokutil --test-key /etc/pki/akmods/certs/public_key.der
      check 'IPU7 PSYS module carries a signature' bash -c \
        '[[ -n $(modinfo -F signer intel_ipu7_psys 2>/dev/null) ]]'
      check 'Intel CVS module carries a signature' bash -c \
        '[[ -n $(modinfo -F signer intel_cvs 2>/dev/null) ]]'
    else
      warn 'Secure Boot is disabled; camera modules are signed but MOK enforcement was not exercised'
    fi
  else
    skip 'OVTI08F4/8086:b05d pair absent; IPU7 camera checks'
  fi

  if command_exists iw && iw dev 2>/dev/null | grep -q '^Interface\|^[[:space:]]*Interface'; then
    regulatory=$(iw reg get 2>/dev/null || true)
    countries=$(sed -n 's/^[[:space:]]*country \([A-Z0-9][A-Z0-9]\):.*/\1/p' <<<"$regulatory")
    if [[ -n $countries ]] && ! grep -qvE '^[A-Z0-9]{2}$' <<<"$countries"; then
      pass 'effective wireless regulatory domains are well formed'
    else
      fail "wireless regulatory domain is unavailable or malformed: ${countries//$'\n'/,}"
    fi
    check 'Fedora timezone-driven regulatory helper is installed' command -v setregdomain
  else
    skip 'wireless interface absent; effective regulatory-domain check'
  fi
else
  skip 'precise Dell XPS 2026 SKU gate not matched; new hardware-role checks'
fi

