#!/usr/bin/env bash
# Boot the pinned official Fedora Cloud image, apply the desktop roles twice,
# and require a zero-change second pass plus rendered service/config checks.
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
image_url=${FEDORA_VM_IMAGE_URL:-https://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-44-1.7.x86_64.qcow2}
image_sha256=${FEDORA_VM_IMAGE_SHA256:-28680fe5b371a5a82ebf43a31926e086a168e59949d03969c5093e7071f90b7f}
image_cache=${FEDORA_VM_IMAGE_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/cybexos/Fedora-Cloud-Base-Generic-44-1.7.x86_64.qcow2}
convergence_tags=${FEDORA_VM_TAGS:-all}
scratch=$(mktemp -d "${TMPDIR:-/tmp}/cybexos-vm.XXXXXX")
qemu_pid=''
temporary_image=''

cleanup() {
  if [[ -n $qemu_pid ]]; then
    kill "$qemu_pid" 2>/dev/null || true
    wait "$qemu_pid" 2>/dev/null || true
  fi
  if [[ -n $temporary_image && $temporary_image == "$image_cache".download.* ]]; then
    rm -f -- "$temporary_image"
  fi
  [[ $scratch == "${TMPDIR:-/tmp}"/cybexos-vm.* ]] && rm -rf -- "$scratch"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

for command in cloud-localds curl git python3 qemu-img qemu-system-x86_64 sha256sum ssh ssh-keygen tar timeout; do
  command -v "$command" >/dev/null 2>&1 || {
    printf 'fedora-vm-convergence: missing required command: %s\n' "$command" >&2
    exit 2
  }
done

mkdir -p -- "$(dirname -- "$image_cache")"
if [[ ! -f $image_cache ]] ||
    ! printf '%s  %s\n' "$image_sha256" "$image_cache" | sha256sum --check --status; then
  temporary_image=$image_cache.download.$$
  rm -f -- "$temporary_image"
  curl --fail --location --retry 4 --retry-all-errors \
    --output "$temporary_image" "$image_url"
  printf '%s  %s\n' "$image_sha256" "$temporary_image" | sha256sum --check
  mv -f -- "$temporary_image" "$image_cache"
  temporary_image=''
fi

ssh-keygen -q -t ed25519 -N '' -f "$scratch/id_ed25519"
public_key=$(<"$scratch/id_ed25519.pub")
cat >"$scratch/user-data" <<EOF
#cloud-config
users:
  - name: fedora
    gecos: Fedora convergence
    groups: [wheel]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - $public_key
ssh_pwauth: false
disable_root: true
runcmd:
  - [loginctl, enable-linger, fedora]
  - [systemctl, start, user@1000.service]
  - [systemctl, enable, --now, sshd.service]
EOF
cat >"$scratch/meta-data" <<'EOF'
instance-id: cybexos-convergence
local-hostname: cybexos-ci
EOF
cloud-localds "$scratch/seed.iso" "$scratch/user-data" "$scratch/meta-data"
qemu-img create -q -f qcow2 -F qcow2 -b "$image_cache" "$scratch/system.qcow2" 40G

ssh_port=$(python3 - <<'PY'
import socket

with socket.socket() as sock:
    sock.bind(("127.0.0.1", 0))
    print(sock.getsockname()[1])
PY
)

if [[ -r /dev/kvm && -w /dev/kvm ]]; then
  accelerator=kvm
  cpu=host
else
  accelerator=tcg,thread=multi
  cpu=max
fi

qemu-system-x86_64 \
  -name cybexos-convergence \
  -machine q35 -accel "$accelerator" \
  -cpu "$cpu" -smp 4 -m 6144 \
  -smbios type=1,manufacturer=QEMU,product='Fedora Convergence' \
  -drive "if=virtio,format=qcow2,file=$scratch/system.qcow2" \
  -drive "if=virtio,format=raw,readonly=on,file=$scratch/seed.iso" \
  -device virtio-net-pci,netdev=network \
  -netdev "user,id=network,hostfwd=tcp:127.0.0.1:$ssh_port-:22" \
  -display none -serial "file:$scratch/console.log" -monitor none \
  -no-reboot &
qemu_pid=$!

ssh_args=(
  -i "$scratch/id_ed25519"
  -p "$ssh_port"
  -o BatchMode=yes
  -o ConnectTimeout=5
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o LogLevel=ERROR
)

ready=false
for _ in {1..120}; do
  if ! kill -0 "$qemu_pid" 2>/dev/null; then
    printf 'Fedora VM exited before SSH became ready\n' >&2
    tail -n 100 "$scratch/console.log" >&2 || true
    exit 1
  fi
  if ssh "${ssh_args[@]}" fedora@127.0.0.1 true 2>/dev/null; then
    ready=true
    break
  fi
  sleep 5
done
$ready || {
  printf 'Fedora VM did not become reachable within 10 minutes\n' >&2
  tail -n 100 "$scratch/console.log" >&2 || true
  exit 1
}

ssh "${ssh_args[@]}" fedora@127.0.0.1 \
  'cloud-init status --wait >/dev/null; mkdir -p /home/fedora/cybexos'
# Transfer precisely the checked-out and intentional untracked source set.
# Besides avoiding generated caches, this respects future .gitignore entries
# for local credentials instead of copying an arbitrary working directory into
# the guest. Filter tracked paths deleted in this working tree just as the
# Quickshell deployment manifest does.
(
  cd -- "$repo_root"
  git ls-files -z --cached --others --exclude-standard |
    while IFS= read -r -d '' source_path; do
      [[ -f $source_path || -L $source_path ]] || continue
      [[ $source_path == *.qcow2 ]] && continue
      printf '%s\0' "$source_path"
    done |
    tar --create --file=- --null --verbatim-files-from --files-from=-
) | \
  ssh "${ssh_args[@]}" fedora@127.0.0.1 \
    'tar -C /home/fedora/cybexos -xf -'

# Optional public download reuse. The inventory contract and checksums are
# checked on both hosts; Ansible still runs every download/extraction task.
# Import before firewall adoption closes fresh SSH connections to the guest.
if [[ -n ${FEDORA_VM_DOWNLOAD_CACHE:-} ]]; then
  python3 -B - "$repo_root" "$FEDORA_VM_DOWNLOAD_CACHE" "$scratch/download-cache" <<'CACHE'
from pathlib import Path
import sys

root, source, destination = map(Path, sys.argv[1:])
sys.path.insert(0, str(root / 'image'))
from download_cache import merge_cache, pins

contract = [entry for entry in pins(root)
            if entry[1].startswith(('/var/cache/cybexos-upstream/', '/usr/local/share/fonts/'))]
merge_cache(source, destination, contract)
CACHE
  tar --create --file=- --directory="$scratch/download-cache" . |
    ssh "${ssh_args[@]}" fedora@127.0.0.1 \
      'mkdir /home/fedora/cybexos-download-cache; tar -C /home/fedora/cybexos-download-cache -xf -'
fi

# Both passes and all assertions run inside an already-established session,
# preserving the strict network policy that blocks fresh SSH connections.
timeout --signal=TERM --kill-after=30 100m \
  ssh "${ssh_args[@]}" fedora@127.0.0.1 bash -s -- "$convergence_tags" <<'GUEST'
set -euo pipefail
tags=$1
sudo dnf install -y ansible-core firewalld git python3-pyyaml
cd /home/fedora/cybexos
export ANSIBLE_FORCE_COLOR=0
export PYTHONDONTWRITEBYTECODE=1
if [[ -d /home/fedora/cybexos-download-cache ]]; then
  sudo python3 -B - <<'CACHE'
from pathlib import Path
import sys

sys.path.insert(0, str(Path.cwd() / 'image'))
from download_cache import import_cache, pins

contract = [entry for entry in pins(Path.cwd())
            if entry[1].startswith(('/var/cache/cybexos-upstream/', '/usr/local/share/fonts/'))]
import_cache(Path('/home/fedora/cybexos-download-cache'), contract)
CACHE
  rm -rf -- /home/fedora/cybexos-download-cache
fi

# Exercise first-adoption rollback with real collisions, not only an empty
# cloud-user home. User-owned desktop roots must survive convergence itself;
# adopted integration files must be recovered byte-for-byte on uninstall.
install -d -m 0755 /home/fedora/.config/hypr \
  /home/fedora/.config/quickshell /home/fedora/.config/distrobox \
  /home/fedora/.config/cybexos/hypr \
  /home/fedora/.local/share/cybexos/themes \
  /home/fedora/.local/share/cybexos/plugins \
  /home/fedora/.config/noctalia /home/fedora/.local/state/noctalia \
  /home/fedora/.cache/noctalia /home/fedora/.local/bin \
  /home/fedora/.config/systemd/user \
  /home/fedora/.agents/skills/unrelated \
  /home/fedora/.claude/skills/cybexos/nested \
  /home/fedora/.claude/skills/unrelated \
  /home/fedora/.codex/skills/unrelated \
  /home/fedora/original-codex-skill
printf 'original Hyprland bindings\n' >/home/fedora/.config/hypr/bindings.lua
printf 'original Quickshell root\n' >/home/fedora/.config/quickshell/shell.qml
printf '{"wall":"~/Pictures/personal-wallpaper.jpg","fixture":"original shell settings"}\n' \
  >/home/fedora/.config/cybexos/shell.json
printf 'original user override\n' >/home/fedora/.config/cybexos/hypr/user.lua
printf 'original user theme\n' >/home/fedora/.local/share/cybexos/themes/personal.theme
printf 'original user plugin\n' >/home/fedora/.local/share/cybexos/plugins/personal.qml
printf 'original Spotify helper\n' >/home/fedora/.local/bin/spotify
printf 'original user unit\n' >/home/fedora/.config/systemd/user/quickshell.service
printf 'original sccache helper\n' >/home/fedora/.local/bin/sccache
printf 'original Distrobox configuration\n' >/home/fedora/.config/distrobox/distrobox.conf
printf 'original Noctalia configuration\n' >/home/fedora/.config/noctalia/config.json
printf 'original Noctalia state\n' >/home/fedora/.local/state/noctalia/state.json
printf 'original Noctalia cache\n' >/home/fedora/.cache/noctalia/cache
printf 'original agents skill\n' >/home/fedora/.agents/skills/cybexos
printf 'original claude skill\n' \
  >/home/fedora/.claude/skills/cybexos/nested/value
printf 'original codex target\n' >/home/fedora/original-codex-skill/SKILL.md
ln -s /home/fedora/original-codex-skill \
  /home/fedora/.codex/skills/cybexos
printf 'unrelated agents skill\n' \
  >/home/fedora/.agents/skills/unrelated/SKILL.md
printf 'unrelated claude skill\n' \
  >/home/fedora/.claude/skills/unrelated/SKILL.md
printf 'unrelated codex skill\n' \
  >/home/fedora/.codex/skills/unrelated/SKILL.md
sudo install -d -m 0755 /etc/gdm /etc/sudoers.d /etc/polkit-1/rules.d
sudo install -d -m 0755 /etc/sddm.conf.d /etc/pam.d /etc/cybexos /etc/systemd/system/sddm.service.d
printf '[Theme]\nCurrent=original\n' | sudo tee /etc/sddm.conf >/dev/null
printf '# original SDDM autologin PAM\n' | sudo tee /etc/pam.d/sddm-autologin >/dev/null
printf '# original SDDM drop-in\n' | sudo tee /etc/systemd/system/sddm.service.d/50-cybexos.conf >/dev/null
printf '# original personal drop-in\n' | sudo tee /etc/systemd/system/sddm.service.d/99-personal.conf >/dev/null
printf '{"original":true}\n' | sudo tee /etc/cybexos/login.json >/dev/null
printf '[Unit]\nDescription=Previous login manager fixture\n[Service]\nExecStart=/usr/bin/true\n' |
  sudo tee /etc/systemd/system/cybexos-original-display-manager.service >/dev/null
sudo ln -s /etc/systemd/system/cybexos-original-display-manager.service \
  /etc/systemd/system/display-manager.service
printf '[daemon]\n# original GDM configuration\n' | sudo tee /etc/gdm/custom.conf >/dev/null
printf '# original sudo policy\n' | sudo tee /etc/sudoers.d/10-wheel-nopasswd >/dev/null
printf '// original Polkit policy\n' | sudo tee /etc/polkit-1/rules.d/49-wheel-local.rules >/dev/null
printf 'original awww command\n' | sudo tee /usr/local/bin/awww >/dev/null
printf 'original awww daemon\n' | sudo tee /usr/local/bin/awww-daemon >/dev/null
printf 'original wayfreeze command\n' | sudo tee /usr/local/bin/wayfreeze >/dev/null
printf 'original Noctalia launcher\n' | sudo tee /usr/local/bin/hyprland-noctalia >/dev/null
printf 'original Noctalia session\n' | sudo tee /usr/share/wayland-sessions/hyprland-noctalia.desktop >/dev/null

# Prove uninstall restores both the default zone and every profile-specific
# binding rather than leaving references to the removed project zone.
sudo systemctl enable --now firewalld
sudo firewall-cmd --set-default-zone=home
while IFS=: read -r uuid type; do
  case "$type" in
    802-3-ethernet|802-11-wireless)
      sudo nmcli connection modify "$uuid" connection.zone work
      ;;
  esac
done < <(nmcli -t -f UUID,TYPE connection show)

playbook=(ansible-playbook -i inventory/hosts.yml site.yml
  -e @tests/vm/convergence-vars.yml --tags "$tags")
"${playbook[@]}" | tee /tmp/cybexos-first.log
"${playbook[@]}" | tee /tmp/cybexos-second.log
grep -F 'no configuration changes' /tmp/cybexos-second.log >/dev/null || {
  printf 'Second Fedora VM convergence pass was not idempotent\n' >&2
  tail -n 120 /tmp/cybexos-second.log >&2
  exit 1
}
sudo tests/vm/assert-converged
ansible-playbook -i inventory/hosts.yml uninstall.yml \
  -e @tests/vm/convergence-vars.yml | tee /tmp/cybexos-uninstall.log
sudo tests/vm/assert-uninstalled
GUEST

printf 'Fedora 44 VM converged twice, then restored first-adoption files on uninstall\n'
