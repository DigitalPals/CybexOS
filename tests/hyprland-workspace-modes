#!/usr/bin/env bash
set -euo pipefail
cd -- "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
task_dir=$(mktemp -d)
trap 'rm -rf -- "$task_dir"' EXIT
export XDG_CONFIG_HOME="$task_dir/config" XDG_STATE_HOME="$task_dir/state" XDG_RUNTIME_DIR="$task_dir/runtime"
export HYPRLAND_INSTANCE_SIGNATURE=cybexos-workspace-fixture
mkdir -p -- "$XDG_RUNTIME_DIR"
if command -v luajit >/dev/null; then
  luajit tests/fixtures/hyprland-workspace-modes.lua
elif command -v lua >/dev/null; then
  lua tests/fixtures/hyprland-workspace-modes.lua
elif command -v rpmlua >/dev/null; then
  rpmlua -e 'dofile("tests/fixtures/hyprland-workspace-modes.lua")'
else
  echo 'Lua interpreter required (luajit, lua or rpmlua)' >&2
  exit 1
fi
