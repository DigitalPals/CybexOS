#!/usr/bin/env bash
# Isolated contract test for the durable updater backend. All state, user-unit
# queries, and transient-unit launches are confined to a temporary fixture.

set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
backend="$repo_root/assets/scripts/cybexos-update-run"
fixture=$(mktemp -d)

# Stop a process and every descendant. Background clients and the gated mocks
# they launch inherit this script's stderr, so an orphan would keep the source
# gate's output capture open forever after a failed assertion.
kill_tree() {
  local pid=$1 child
  for child in $(pgrep -P "$pid" 2>/dev/null); do
    kill_tree "$child"
  done
  kill "$pid" 2>/dev/null || true
}

cleanup() {
  local rc=$? file pid
  trap - EXIT
  for pid in $(jobs -p); do
    kill_tree "$pid"
  done
  wait 2>/dev/null || true
  if ((rc != 0)); then
    printf 'cybexos-update-run fixture failed; retained diagnostics follow\n' >&2
    while IFS= read -r -d '' file; do
      printf '%s\n' "--- ${file#"$fixture"/}" >&2
      sed -n '1,160p' "$file" >&2
    done < <(find "$fixture" -type f \
      \( -name 'status.json' -o -name '*.err' -o -name '*.rc' \
         -o -name 'run.log' -o -name 'snapshot.log' -o -name 'dnf.log' \
         -o -name 'firmware.log' -o -name 'firmware-events.log' \) \
      -print0 | LC_ALL=C sort -z)
  fi
  rm -rf -- "$fixture"
  exit "$rc"
}
trap cleanup EXIT

mock_bin="$fixture/bin"
active_dir="$fixture/active"
mock_libexec="$fixture/libexec"
mkdir -p -- "$mock_bin" "$mock_libexec" "$active_dir" "$fixture/home" \
  "$fixture/state" "$fixture/runtime"

apply_mock() {
  local target=$1
  shift
  printf '%s\n' '#!/usr/bin/env bash' "$@" >"$mock_bin/$target"
  chmod 0755 "$mock_bin/$target"
}

apply_mock systemctl \
  'set -euo pipefail' \
  'unit=""' \
  'for arg in "$@"; do [[ $arg == *.service ]] && unit=$arg; done' \
  'if [[ " $* " == *" show "* ]]; then' \
  '  [[ -z ${MOCK_SHOW_FAIL:-} ]] || exit 1' \
  '  state=inactive' \
  '  [[ -n $unit && -e $MOCK_ACTIVE_DIR/$unit ]] && state=active' \
  '  if [[ -n ${MOCK_SHOW_GATE:-} && ! -e $MOCK_SHOW_GATE.used ]]; then' \
  '    : >"$MOCK_SHOW_GATE.used"; : >"$MOCK_SHOW_GATE.entered"' \
  '    while [[ ! -e $MOCK_SHOW_GATE.release ]]; do' \
  '      [[ -d ${MOCK_SHOW_GATE%/*} ]] || exit 1' \
  '      sleep 0.01' \
  '    done' \
  '  fi' \
  '  printf "%s\n" "$state"' \
  'elif [[ " $* " == *" stop "* ]]; then' \
  '  printf "%s\n" "$*" >>"$MOCK_STOP_LOG"' \
  '  [[ -z ${MOCK_STOP_FAIL:-} ]] || exit 1' \
  '  [[ -z ${MOCK_STOP_DEFER:-} ]] || exit 0' \
  '  [[ -z $unit ]] || rm -f -- "$MOCK_ACTIVE_DIR/$unit"' \
  'fi'

apply_mock systemd-run \
  'set -euo pipefail' \
  'unit=""' \
  'for arg in "$@"; do [[ $arg == --unit=* ]] && unit=${arg#--unit=}; done' \
  '[[ -n $unit ]]' \
  'if [[ -n ${MOCK_BLOCK_GATE:-} ]]; then' \
  '  : >"$MOCK_BLOCK_GATE.entered"' \
  '  while [[ ! -e $MOCK_BLOCK_GATE.release ]]; do' \
  '    [[ -d ${MOCK_BLOCK_GATE%/*} ]] || exit 1' \
  '    sleep 0.01' \
  '  done' \
  'fi' \
  ': >"$MOCK_ACTIVE_DIR/$unit"' \
  'printf "%s\n" "$*" >>"$MOCK_SYSTEMD_ARGS_LOG"' \
  'printf "%s\n" "$unit" >>"$MOCK_SYSTEMD_LOG"'

# The worker holds a logind inhibitor through this helper; never take a real
# one from the fixture.
apply_mock systemd-inhibit \
  'set -euo pipefail' \
  'printf "%s\n" "$*" >>"$MOCK_INHIBIT_LOG"' \
  'if [[ -n ${MOCK_INHIBIT_FAIL:-} ]]; then' \
  '  echo "Failed to inhibit: Access denied" >&2' \
  '  exit 1' \
  'fi' \
  'while [[ ${1:-} == --* ]]; do shift; done' \
  'exec "$@"'

# MOCK_SUDO_TTY_ONLY models sudo's default tty-scoped timestamp: the cached
# ticket does not apply to a process that has left the terminal's session.
apply_mock sudo \
  'set -euo pipefail' \
  'printf "%s\n" "$*" >>"$MOCK_PACKAGE_LOG"' \
  'if [[ -n ${MOCK_SUDO_V_TICKET:-} ]]; then' \
  '  if [[ $* == -v ]]; then : >"$MOCK_SUDO_V_TICKET"; exit 0; fi' \
  '  [[ -e $MOCK_SUDO_V_TICKET ]] || exit 1' \
  '  read -r -a stat_fields </proc/$$/stat' \
  '  [[ ${stat_fields[5]} != "$$" ]] || exit 1' \
  '  [[ ${1:-} != -n ]] || shift' \
  '  exec "$@"' \
  'fi' \
  '[[ -n ${MOCK_PACKAGE_SUCCESS:-} ]] || exit 99' \
  'if [[ -n ${MOCK_SUDO_TTY_ONLY:-} ]]; then' \
  '  read -r -a stat_fields </proc/$$/stat' \
  '  [[ ${stat_fields[5]} != "$$" ]] || exit 1' \
  'fi' \
  '[[ ${1:-} != -n ]] || shift' \
  'exec "$@"'

apply_mock dnf \
  'set -euo pipefail' \
  'printf "%s\n" "$*" >>"$MOCK_DNF_LOG"' \
  'if [[ " $* " == *" upgrade "* ]]; then' \
  '  umask >>"$MOCK_DNF_UMASK_LOG"' \
  '  if [[ -n ${MOCK_DNF_GATE:-} ]]; then' \
  '    : >"$MOCK_DNF_GATE.entered"' \
  '    while [[ ! -e $MOCK_DNF_GATE.release ]]; do' \
  '      [[ -d ${MOCK_DNF_GATE%/*} ]] || exit 1' \
  '      sleep 0.01' \
  '    done' \
  '    : >"$MOCK_DNF_GATE.finished"' \
  '  fi' \
  '  printf "Repositories loaded.\nNothing to do.\n"' \
  '  exit "${MOCK_DNF_UPGRADE_RC:-0}"' \
  'fi' \
  'if [[ " $* " == *" needs-restarting "* ]]; then' \
  '  if [[ -n ${MOCK_REBOOT_GATE:-} ]]; then' \
  '    : >"$MOCK_REBOOT_GATE.entered"' \
  '    while [[ ! -e $MOCK_REBOOT_GATE.release ]]; do' \
  '      [[ -d ${MOCK_REBOOT_GATE%/*} ]] || exit 1' \
  '      sleep 0.01' \
  '    done' \
  '  fi' \
  '  printf "%s\n" "${MOCK_REBOOT_JSON:-[]}"' \
  '  exit "${MOCK_REBOOT_RC:-2}"' \
  'fi' \
  'exit 98'

apply_mock ansible-playbook \
  'set -euo pipefail' \
  'cat "$MOCK_RELEASE_CONFIG" >"$MOCK_ANSIBLE_CONFIG_LOG"' \
  'printf "%s\n" "$*" >"$MOCK_ANSIBLE_ARGS_LOG"' \
  'exit "${MOCK_ANSIBLE_RC:-0}"'

# The snapshot helper has its own Btrfs fixture. Keep the durable-update test
# on the supported non-Btrfs path so it never inspects or mutates the host FS.
apply_mock findmnt 'printf "ext4\n"'

# A pre-rename installation has only this root-owned helper. Its compatible
# contract must bridge the first run of the renamed updater.
printf '%s\n' '#!/usr/bin/env bash' \
  'printf "%s\n" "$*" >>"$MOCK_LEGACY_SNAPSHOT_LOG"' \
  'printf "skipped: fixture recovery helper\n"' \
  >"$mock_libexec/xps-system-snapshot"
chmod 0755 "$mock_libexec/xps-system-snapshot"

# The firmware helper drives fwupd; the fixture never reaches the real daemon.
# This stub records how it was invoked, appends the events a case supplies,
# and exits with the status it is given.
firmware_helper="$fixture/firmware-helper"
printf '%s\n' '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  'printf "%s\n" "$*" >>"$MOCK_FIRMWARE_LOG"' \
  'umask >>"$MOCK_FIRMWARE_UMASK_LOG"' \
  '[[ ${1:-} == install && ${2:-} == --events && -n ${3:-} ]] || exit 64' \
  'if [[ -n ${MOCK_FIRMWARE_GATE:-} ]]; then' \
  '  : >"$MOCK_FIRMWARE_GATE.entered"' \
  '  while [[ ! -e $MOCK_FIRMWARE_GATE.release ]]; do' \
  '    [[ -d ${MOCK_FIRMWARE_GATE%/*} ]] || exit 1' \
  '    sleep 0.01' \
  '  done' \
  'fi' \
  '[[ -z ${MOCK_FIRMWARE_EVENTS:-} ]] || printf "%s\n" "$MOCK_FIRMWARE_EVENTS" >>"$3"' \
  'printf "System Firmware 0x01060200 → 0x01070000: writing 40%%\n"' \
  'exit "${MOCK_FIRMWARE_RC:-0}"' \
  >"$firmware_helper"
chmod 0755 "$firmware_helper"

export HOME="$fixture/home"
export XDG_STATE_HOME="$fixture/state"
export XDG_RUNTIME_DIR="$fixture/runtime"
export MOCK_ACTIVE_DIR="$active_dir"
export MOCK_SYSTEMD_LOG="$fixture/systemd.log"
export MOCK_SYSTEMD_ARGS_LOG="$fixture/systemd-args.log"
export MOCK_STOP_LOG="$fixture/stop.log"
export MOCK_INHIBIT_LOG="$fixture/inhibit.log"
export MOCK_PACKAGE_LOG="$fixture/package.log"
export MOCK_DNF_LOG="$fixture/dnf.log"
export MOCK_DNF_UMASK_LOG="$fixture/dnf-umask.log"
export MOCK_ANSIBLE_CONFIG_LOG="$fixture/ansible-config.log"
export MOCK_ANSIBLE_ARGS_LOG="$fixture/ansible-args.log"
export MOCK_LEGACY_SNAPSHOT_LOG="$fixture/legacy-snapshot.log"
export MOCK_FIRMWARE_LOG="$fixture/firmware-helper.log"
export MOCK_FIRMWARE_UMASK_LOG="$fixture/firmware-umask.log"
export CYBEXOS_UPDATE_FIRMWARE_HELPER="$firmware_helper"
export CYBEXOS_UPDATE_BOOT_ID_FILE="$fixture/boot-id"
export CYBEXOS_UPDATE_ASSUME_USER_UNIT=1
export CYBEXOS_UPDATE_TESTING=1
export CYBEXOS_UPDATE_TEST_LIBEXEC="$mock_libexec"
export PATH="$mock_bin:$PATH"
printf 'boot-a\n' >"$CYBEXOS_UPDATE_BOOT_ID_FILE"
: >"$MOCK_PACKAGE_LOG"

current_run_id() { cat "$XDG_STATE_HOME/cybexos/update/current"; }

idle=$($backend status --json)
[[ $(jq -r .state <<<"$idle") == idle ]]
[[ $(jq -r .bootId <<<"$idle") == boot-a ]]
[[ $(jq -r .rebootRecommendation <<<"$idle") == unavailable ]]

# A graphical client explicitly requests a system unit without an interactive
# sudo timestamp. Both launch and cancellation must call the system manager
# directly, allowing its native Polkit action to reach the desktop agent.
polkit_start=$($backend start --json --system-unit --no-flatpak)
polkit_id=$(jq -er .id <<<"$polkit_start")
polkit_unit=$(jq -er .unit <<<"$polkit_start")
[[ $(jq -r .systemUnit <<<"$polkit_start") == true ]]
[[ -e $active_dir/$polkit_unit ]]
$backend cancel "$polkit_id" >/dev/null
[[ $(jq -r .state <<<"$($backend status --json "$polkit_id")") == cancelled ]]
[[ ! -e $active_dir/$polkit_unit ]]
expected_auth_probes=2
((EUID == 0)) && expected_auth_probes=0
[[ $(grep -Fxc -- '-n true' "$MOCK_PACKAGE_LOG") -eq $expected_auth_probes ]]
! grep -Eq 'systemd-run|systemctl' "$MOCK_PACKAGE_LOG"
# The worker yields CPU and I/O to the desktop, and a stop reaches only the
# worker process so it can finish a running transaction first.
for property in Type=exec KillMode=mixed TimeoutStopSec=30min Nice=10 \
    IOWeight=20 CPUWeight=20; do
  grep -Fq -- "--property=$property" "$MOCK_SYSTEMD_ARGS_LOG"
done
grep -Fq -- "stop --no-block $polkit_unit" "$MOCK_STOP_LOG"
: >"$MOCK_PACKAGE_LOG"
: >"$MOCK_SYSTEMD_LOG"

# A terminal's sudo ticket is keyed to that terminal and cannot authorize a
# detached user-unit worker. Only sudo that works without any terminal keeps
# the user unit; otherwise the client launches a system unit while its own
# ticket is still valid.
unset CYBEXOS_UPDATE_ASSUME_USER_UNIT
export MOCK_PACKAGE_SUCCESS=1 MOCK_SUDO_TTY_ONLY=1
tty_ticket_start=$($backend start --json --no-flatpak)
[[ $(jq -r .systemUnit <<<"$tty_ticket_start") == true ]]
$backend cancel "$(jq -er .id <<<"$tty_ticket_start")" >/dev/null
unset MOCK_SUDO_TTY_ONLY
nopasswd_start=$($backend start --json --no-flatpak)
[[ $(jq -r .systemUnit <<<"$nopasswd_start") == false ]]
$backend cancel "$(jq -er .id <<<"$nopasswd_start")" >/dev/null
unset MOCK_PACKAGE_SUCCESS
set +e
$backend start --json --no-flatpak >"$fixture/unauthenticated.json" \
  2>"$fixture/unauthenticated.err"
unauthenticated_rc=$?
set -e
[[ $unauthenticated_rc -eq 77 ]]
# The terminal client cannot prompt from inside start_run's command
# substitution, so it authenticates first and then launches a system unit.
# A pty stands in for the terminal; attach is cut short by the timeout.
: >"$MOCK_PACKAGE_LOG"
set +e
MOCK_SUDO_V_TICKET="$fixture/sudo-ticket" timeout 5 python3 -c \
  'import pty, sys; pty.spawn(sys.argv[1:])' "$backend" run --no-flatpak \
  </dev/null >"$fixture/terminal-run.out" 2>&1
set -e
grep -Fxq -- '-v' "$MOCK_PACKAGE_LOG"
grep -Fq 'Authenticate once' "$fixture/terminal-run.out"
terminal_id=$(current_run_id)
[[ $(jq -r .systemUnit "$XDG_STATE_HOME/cybexos/update/logs/$terminal_id/status.json") == true ]]
export MOCK_PACKAGE_SUCCESS=1
$backend cancel "$terminal_id" >/dev/null
unset MOCK_PACKAGE_SUCCESS
export CYBEXOS_UPDATE_ASSUME_USER_UNIT=1
: >"$MOCK_PACKAGE_LOG"
: >"$MOCK_SYSTEMD_LOG"

# Hold the first launch inside mocked systemd-run. The run is published before
# registration, so a second start must resolve it immediately instead of
# blocking behind the lock and launching a redundant transaction afterward.
export MOCK_BLOCK_GATE="$fixture/launch"
$backend start --json --no-flatpak >"$fixture/first.json" &
first_pid=$!
for _ in {1..1000}; do
  [[ -e $MOCK_BLOCK_GATE.entered ]] && break
  sleep 0.01
done
[[ -e $MOCK_BLOCK_GATE.entered ]]

# The blocked first client never releases the lock by itself, so a second
# client that waited instead of resolving the published run would still time
# out. The bound only has to survive a loaded machine.
set +e
timeout 10 "$backend" start --json --no-flatpak \
  >"$fixture/second.json" 2>"$fixture/second.err"
second_rc=$?
set -e
[[ $second_rc -eq 3 ]]
first_id=$(jq -er .id "$fixture/second.json")
[[ $(jq -r .existing "$fixture/second.json") == true ]]

# Force registration to win after cancellation has already observed an
# inactive unit. The intent marker must still make the eventual worker exit
# before any package command, and the cancelling process must not overwrite a
# newer worker result with a synthetic state.
export MOCK_SHOW_GATE="$fixture/show"
$backend cancel "$first_id" >"$fixture/cancel-race.out" \
  2>"$fixture/cancel-race.err" &
cancel_pid=$!
for _ in {1..1000}; do
  [[ -e $MOCK_SHOW_GATE.entered ]] && break
  sleep 0.01
done
[[ -e $MOCK_SHOW_GATE.entered ]]
[[ -e $XDG_STATE_HOME/cybexos/update/logs/$first_id/cancel.requested ]]
: >"$MOCK_BLOCK_GATE.release"
wait "$first_pid"
[[ $(jq -r .existing "$fixture/first.json") == false ]]
[[ $(wc -l <"$MOCK_SYSTEMD_LOG") -eq 1 ]]
set +e
$backend _worker "$first_id" --no-flatpak >"$fixture/cancelled-worker.out" \
  2>"$fixture/cancelled-worker.err"
cancelled_worker_rc=$?
set -e
: >"$MOCK_SHOW_GATE.release"
wait "$cancel_pid"
[[ $cancelled_worker_rc -eq 130 ]]
[[ $(jq -r .state <<<"$($backend status --json "$first_id")") == cancelled ]]
[[ ! -s $MOCK_PACKAGE_LOG ]]
rm -f -- "$active_dir/cybexos-update-$first_id.service"
unset MOCK_SHOW_GATE

# A just-published unit gets a short registration grace. Once the same record
# is old, an absent unit is atomically converted to an abandoned failure and
# no longer blocks future updates.
unset MOCK_BLOCK_GATE
stale_run=$($backend start --json --no-flatpak)
stale_id=$(jq -er .id <<<"$stale_run")
unit=$(jq -er .unit <<<"$stale_run")
rm -f -- "$active_dir/$unit"
grace=$($backend status --json "$stale_id")
[[ $(jq -r .state <<<"$grace") == queued ]]
status_file="$XDG_STATE_HOME/cybexos/update/logs/$stale_id/status.json"
jq '.startedAt = 0' "$status_file" >"$status_file.old"
mv -f -- "$status_file.old" "$status_file"
stale=$($backend status --json "$stale_id")
[[ $(jq -r .state <<<"$stale") == failed ]]
[[ $(jq -r .phase <<<"$stale") == abandoned ]]
[[ $(jq -r .exitCode <<<"$stale") -eq 125 ]]

next=$($backend start --json --no-flatpak)
next_id=$(jq -er .id <<<"$next")
[[ $next_id != "$stale_id" ]]
next_dir=$(jq -er .logDir <<<"$next")
next_unit=$(jq -er .unit <<<"$next")

# A registered worker whose stop fails must remain visibly active. Claiming a
# synthetic cancellation here would let package work continue behind a terminal
# UI state. Once stop succeeds and the unit is proven inactive, cancellation is
# safe even if the mock worker never ran a TERM trap.
next_status="$next_dir/status.json"
jq '.state = "running" | .phase = "packages"' "$next_status" >"$next_status.new"
mv -f -- "$next_status.new" "$next_status"

# A transient DBus/user-manager query failure is not evidence that the worker
# died. Status reads must preserve the active record instead of publishing a
# false abandoned terminal state while package work may still be running.
export MOCK_SHOW_FAIL=1
$backend status --json "$next_id" >"$fixture/show-failed.json" \
  2>"$fixture/show-failed.err"
[[ $(jq -r .state "$fixture/show-failed.json") == running ]]
[[ -e $active_dir/$next_unit ]]
grep -q 'preserving running status' "$fixture/show-failed.err"
set +e
$backend cancel "$next_id" >"$fixture/cancel-inspect-failed.out" \
  2>"$fixture/cancel-inspect-failed.err"
cancel_inspect_failed_rc=$?
set -e
[[ $cancel_inspect_failed_rc -ne 0 ]]
[[ $(jq -r .state "$next_status") == running ]]
[[ -e $next_dir/cancel.requested ]]
grep -q 'outcome is not yet verified' "$fixture/cancel-inspect-failed.err"
unset MOCK_SHOW_FAIL

export MOCK_STOP_FAIL=1
set +e
$backend cancel "$next_id" >"$fixture/cancel-failed.out" \
  2>"$fixture/cancel-failed.err"
cancel_failed_rc=$?
set -e
[[ $cancel_failed_rc -ne 0 ]]
[[ -e $active_dir/$next_unit ]]
[[ $(jq -r .state "$next_status") == running ]]
[[ ! -s $fixture/cancel-failed.out ]]
grep -q 'update remains active' "$fixture/cancel-failed.err"
unset MOCK_STOP_FAIL
$backend cancel "$next_id" >/dev/null
[[ ! -e $active_dir/$next_unit ]]
[[ $(jq -r .state "$next_status") == cancelled ]]

# A status reader cannot declare an active run abandoned while its worker owns
# the lifecycle lock. This is the fast-terminal-write race that used to replace
# a precise worker failure with the generic "worker disappeared" result.
lock_race_start=$($backend start --json --no-flatpak)
lock_race_id=$(jq -er .id <<<"$lock_race_start")
lock_race_dir=$(jq -er .logDir <<<"$lock_race_start")
lock_race_unit=$(jq -er .unit <<<"$lock_race_start")
lock_race_status="$lock_race_dir/status.json"
jq '.state = "running" | .phase = "snapshot" | .startedAt = 0' \
  "$lock_race_status" >"$lock_race_status.new"
mv -f -- "$lock_race_status.new" "$lock_race_status"
rm -f -- "$active_dir/$lock_race_unit"
exec {worker_lock_fd}>"$XDG_RUNTIME_DIR/update.lock"
flock "$worker_lock_fd"
locked_status=$($backend status --json "$lock_race_id")
[[ $(jq -r .state <<<"$locked_status") == running ]]
flock -u "$worker_lock_fd"
exec {worker_lock_fd}>&-
unlocked_status=$($backend status --json "$lock_race_id")
[[ $(jq -r .state <<<"$unlocked_status") == failed ]]
[[ $(jq -r .phase <<<"$unlocked_status") == abandoned ]]

# A worker finishing its step keeps running after the stop request. The
# client returns at once, and status reports the pending cancellation until
# the worker records it at the next boundary.
defer_status_start=$($backend start --json --no-flatpak)
defer_status_id=$(jq -er .id <<<"$defer_status_start")
defer_status_dir=$(jq -er .logDir <<<"$defer_status_start")
defer_status_unit=$(jq -er .unit <<<"$defer_status_start")
defer_status_file="$defer_status_dir/status.json"
jq '.state = "running" | .phase = "packages"' "$defer_status_file" \
  >"$defer_status_file.new"
mv -f -- "$defer_status_file.new" "$defer_status_file"
[[ $(jq -r .deferredCancel "$defer_status_file") == true ]]
[[ $(jq -r .cancelRequested <<<"$($backend status --json "$defer_status_id")") == false ]]
export MOCK_STOP_DEFER=1
: >"$MOCK_STOP_LOG"
deferred_out=$($backend cancel "$defer_status_id")
grep -q 'finishes first' <<<"$deferred_out"
grep -Fq -- "stop --no-block $defer_status_unit" "$MOCK_STOP_LOG"
[[ -e $active_dir/$defer_status_unit ]]
deferred_status=$($backend status --json "$defer_status_id")
[[ $(jq -r .state <<<"$deferred_status") == running ]]
[[ $(jq -r .cancelRequested <<<"$deferred_status") == true ]]
unset MOCK_STOP_DEFER

# A worker launched before deferred cancellation existed would be killed
# together with dnf; refuse rather than interrupt its package transaction.
jq 'del(.deferredCancel)' "$defer_status_file" >"$defer_status_file.new"
mv -f -- "$defer_status_file.new" "$defer_status_file"
rm -f -- "$defer_status_dir/cancel.requested"
: >"$MOCK_STOP_LOG"
set +e
$backend cancel "$defer_status_id" >"$fixture/legacy-cancel.out" \
  2>"$fixture/legacy-cancel.err"
legacy_cancel_rc=$?
set -e
[[ $legacy_cancel_rc -eq 1 ]]
grep -q 'cannot be interrupted safely' "$fixture/legacy-cancel.err"
[[ ! -s $MOCK_STOP_LOG ]]
[[ ! -e $defer_status_dir/cancel.requested ]]
[[ -e $active_dir/$defer_status_unit ]]
jq '.deferredCancel = true' "$defer_status_file" >"$defer_status_file.new"
mv -f -- "$defer_status_file.new" "$defer_status_file"
$backend cancel "$defer_status_id" >/dev/null
[[ $(jq -r .state "$defer_status_file") == cancelled ]]
[[ $(jq -r .cancelRequested <<<"$($backend status --json "$defer_status_id")") == false ]]

# SIGTERM never interrupts the package transaction: dnf runs to completion,
# then the worker records the cancellation instead of starting the test gate
# or Ansible, and keeps the reboot advice for what was installed. The worker
# holds a shutdown/sleep block inhibitor while it runs.
export MOCK_PACKAGE_SUCCESS=1
export MOCK_DNF_GATE="$fixture/dnf-gate"
export MOCK_TESTS_RAN="$fixture/defer-tests-ran"
defer_repo="$fixture/defer-repo"
mkdir -p "$defer_repo/tests"
printf '%s\n' '---' >"$defer_repo/site.yml"
printf '%s\n' '#!/usr/bin/env bash' ': >"$MOCK_TESTS_RAN"' >"$defer_repo/tests/run"
chmod 0755 "$defer_repo/tests/run"
rm -f -- "$MOCK_ANSIBLE_ARGS_LOG"
