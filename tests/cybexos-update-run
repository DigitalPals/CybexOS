#!/usr/bin/env bash
# Isolated contract test for the durable updater backend. All state, user-unit
# queries, and transient-unit launches are confined to a temporary fixture.

set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
backend="$repo_root/assets/scripts/cybexos-update-run"
fixture=$(mktemp -d)

# Stop a process and every descendant. Background clients and the gated mocks
# they launch inherit this script's stderr, so an orphan would keep the source
# gate's output capture open forever after a failed assertion.
kill_tree() {
  local pid=$1 child
  for child in $(pgrep -P "$pid" 2>/dev/null); do
    kill_tree "$child"
  done
  kill "$pid" 2>/dev/null || true
}

cleanup() {
  local rc=$? file pid
  trap - EXIT
  for pid in $(jobs -p); do
    kill_tree "$pid"
  done
  wait 2>/dev/null || true
  if ((rc != 0)); then
    printf 'cybexos-update-run fixture failed; retained diagnostics follow\n' >&2
    while IFS= read -r -d '' file; do
      printf '%s\n' "--- ${file#"$fixture"/}" >&2
      sed -n '1,160p' "$file" >&2
    done < <(find "$fixture" -type f \
      \( -name 'status.json' -o -name '*.err' -o -name '*.rc' \
         -o -name 'run.log' -o -name 'snapshot.log' -o -name 'dnf.log' \) \
      -print0 | LC_ALL=C sort -z)
  fi
  rm -rf -- "$fixture"
  exit "$rc"
}
trap cleanup EXIT

mock_bin="$fixture/bin"
active_dir="$fixture/active"
mock_libexec="$fixture/libexec"
mkdir -p -- "$mock_bin" "$mock_libexec" "$active_dir" "$fixture/home" \
  "$fixture/state" "$fixture/runtime"

apply_mock() {
  local target=$1
  shift
  printf '%s\n' '#!/usr/bin/env bash' "$@" >"$mock_bin/$target"
  chmod 0755 "$mock_bin/$target"
}

apply_mock systemctl \
  'set -euo pipefail' \
  'unit=""' \
  'for arg in "$@"; do [[ $arg == *.service ]] && unit=$arg; done' \
  'if [[ " $* " == *" show "* ]]; then' \
  '  [[ -z ${MOCK_SHOW_FAIL:-} ]] || exit 1' \
  '  state=inactive' \
  '  [[ -n $unit && -e $MOCK_ACTIVE_DIR/$unit ]] && state=active' \
  '  if [[ -n ${MOCK_SHOW_GATE:-} && ! -e $MOCK_SHOW_GATE.used ]]; then' \
  '    : >"$MOCK_SHOW_GATE.used"; : >"$MOCK_SHOW_GATE.entered"' \
  '    while [[ ! -e $MOCK_SHOW_GATE.release ]]; do' \
  '      [[ -d ${MOCK_SHOW_GATE%/*} ]] || exit 1' \
  '      sleep 0.01' \
  '    done' \
  '  fi' \
  '  printf "%s\n" "$state"' \
  'elif [[ " $* " == *" stop "* ]]; then' \
  '  printf "%s\n" "$*" >>"$MOCK_STOP_LOG"' \
  '  [[ -z ${MOCK_STOP_FAIL:-} ]] || exit 1' \
  '  [[ -z ${MOCK_STOP_DEFER:-} ]] || exit 0' \
  '  [[ -z $unit ]] || rm -f -- "$MOCK_ACTIVE_DIR/$unit"' \
  'fi'

apply_mock systemd-run \
  'set -euo pipefail' \
  'unit=""' \
  'for arg in "$@"; do [[ $arg == --unit=* ]] && unit=${arg#--unit=}; done' \
  '[[ -n $unit ]]' \
  'if [[ -n ${MOCK_BLOCK_GATE:-} ]]; then' \
  '  : >"$MOCK_BLOCK_GATE.entered"' \
  '  while [[ ! -e $MOCK_BLOCK_GATE.release ]]; do' \
  '    [[ -d ${MOCK_BLOCK_GATE%/*} ]] || exit 1' \
  '    sleep 0.01' \
  '  done' \
  'fi' \
  ': >"$MOCK_ACTIVE_DIR/$unit"' \
  'printf "%s\n" "$*" >>"$MOCK_SYSTEMD_ARGS_LOG"' \
  'printf "%s\n" "$unit" >>"$MOCK_SYSTEMD_LOG"'


apply_mock sudo \
  'set -euo pipefail' \
  'printf "%s\n" "$*" >>"$MOCK_PACKAGE_LOG"' \
  '[[ -n ${MOCK_PACKAGE_SUCCESS:-} ]] || exit 99' \
  '[[ ${1:-} != -n ]] || shift' \
  'exec "$@"'

apply_mock dnf \
  'set -euo pipefail' \
  'printf "%s\n" "$*" >>"$MOCK_DNF_LOG"' \
  'if [[ " $* " == *" upgrade "* ]]; then' \
  '  umask >>"$MOCK_DNF_UMASK_LOG"' \
  '  if [[ -n ${MOCK_DNF_GATE:-} ]]; then' \
  '    : >"$MOCK_DNF_GATE.entered"' \
  '    while [[ ! -e $MOCK_DNF_GATE.release ]]; do' \
  '      [[ -d ${MOCK_DNF_GATE%/*} ]] || exit 1' \
  '      sleep 0.01' \
  '    done' \
  '    : >"$MOCK_DNF_GATE.finished"' \
  '  fi' \
  '  printf "Repositories loaded.\nNothing to do.\n"' \
  '  exit "${MOCK_DNF_UPGRADE_RC:-0}"' \
  'fi' \
  'if [[ " $* " == *" needs-restarting "* ]]; then' \
  '  if [[ -n ${MOCK_REBOOT_GATE:-} ]]; then' \
  '    : >"$MOCK_REBOOT_GATE.entered"' \
  '    while [[ ! -e $MOCK_REBOOT_GATE.release ]]; do' \
  '      [[ -d ${MOCK_REBOOT_GATE%/*} ]] || exit 1' \
  '      sleep 0.01' \
  '    done' \
  '  fi' \
  '  printf "%s\n" "${MOCK_REBOOT_JSON:-[]}"' \
  '  exit "${MOCK_REBOOT_RC:-2}"' \
  'fi' \
  'exit 98'

apply_mock ansible-playbook \
  'set -euo pipefail' \
  'cat "$MOCK_RELEASE_CONFIG" >"$MOCK_ANSIBLE_CONFIG_LOG"' \
  'printf "%s\n" "$*" >"$MOCK_ANSIBLE_ARGS_LOG"' \
  'exit "${MOCK_ANSIBLE_RC:-0}"'

# The snapshot helper has its own Btrfs fixture. Keep the durable-update test
# on the supported non-Btrfs path so it never inspects or mutates the host FS.
apply_mock findmnt 'printf "ext4\n"'

# A pre-rename installation has only this root-owned helper. Its compatible
# contract must bridge the first run of the renamed updater.
printf '%s\n' '#!/usr/bin/env bash' \
  'printf "%s\n" "$*" >>"$MOCK_LEGACY_SNAPSHOT_LOG"' \
  'printf "skipped: fixture recovery helper\n"' \
  >"$mock_libexec/xps-system-snapshot"
chmod 0755 "$mock_libexec/xps-system-snapshot"

export HOME="$fixture/home"
export XDG_STATE_HOME="$fixture/state"
export XDG_RUNTIME_DIR="$fixture/runtime"
export MOCK_ACTIVE_DIR="$active_dir"
export MOCK_SYSTEMD_LOG="$fixture/systemd.log"
export MOCK_SYSTEMD_ARGS_LOG="$fixture/systemd-args.log"
export MOCK_STOP_LOG="$fixture/stop.log"
export MOCK_PACKAGE_LOG="$fixture/package.log"
export MOCK_DNF_LOG="$fixture/dnf.log"
export MOCK_DNF_UMASK_LOG="$fixture/dnf-umask.log"
export MOCK_ANSIBLE_CONFIG_LOG="$fixture/ansible-config.log"
export MOCK_ANSIBLE_ARGS_LOG="$fixture/ansible-args.log"
export MOCK_LEGACY_SNAPSHOT_LOG="$fixture/legacy-snapshot.log"
export CYBEXOS_UPDATE_BOOT_ID_FILE="$fixture/boot-id"
export CYBEXOS_UPDATE_ASSUME_USER_UNIT=1
export CYBEXOS_UPDATE_TESTING=1
export CYBEXOS_UPDATE_TEST_LIBEXEC="$mock_libexec"
export PATH="$mock_bin:$PATH"
printf 'boot-a\n' >"$CYBEXOS_UPDATE_BOOT_ID_FILE"
: >"$MOCK_PACKAGE_LOG"

idle=$($backend status --json)
[[ $(jq -r .state <<<"$idle") == idle ]]
[[ $(jq -r .bootId <<<"$idle") == boot-a ]]
[[ $(jq -r .rebootRecommendation <<<"$idle") == unavailable ]]

# A graphical client explicitly requests a system unit without an interactive
# sudo timestamp. Both launch and cancellation must call the system manager
# directly, allowing its native Polkit action to reach the desktop agent.
polkit_start=$($backend start --json --system-unit --no-flatpak)
polkit_id=$(jq -er .id <<<"$polkit_start")
polkit_unit=$(jq -er .unit <<<"$polkit_start")
[[ $(jq -r .systemUnit <<<"$polkit_start") == true ]]
[[ -e $active_dir/$polkit_unit ]]
$backend cancel "$polkit_id" >/dev/null
[[ $(jq -r .state <<<"$($backend status --json "$polkit_id")") == cancelled ]]
[[ ! -e $active_dir/$polkit_unit ]]
expected_auth_probes=2
((EUID == 0)) && expected_auth_probes=0
[[ $(grep -Fxc -- '-n true' "$MOCK_PACKAGE_LOG") -eq $expected_auth_probes ]]
! grep -Eq 'systemd-run|systemctl' "$MOCK_PACKAGE_LOG"
# A stop reaches only the worker process so it can finish a running
# transaction first.
for property in Type=exec KillMode=mixed TimeoutStopSec=30min; do
  grep -Fq -- "--property=$property" "$MOCK_SYSTEMD_ARGS_LOG"
done
grep -Fq -- "stop --no-block $polkit_unit" "$MOCK_STOP_LOG"
: >"$MOCK_PACKAGE_LOG"
: >"$MOCK_SYSTEMD_LOG"

# Hold the first launch inside mocked systemd-run. The run is published before
# registration, so a second start must resolve it immediately instead of
# blocking behind the lock and launching a redundant transaction afterward.
export MOCK_BLOCK_GATE="$fixture/launch"
$backend start --json --no-flatpak >"$fixture/first.json" &
first_pid=$!
for _ in {1..1000}; do
  [[ -e $MOCK_BLOCK_GATE.entered ]] && break
  sleep 0.01
done
[[ -e $MOCK_BLOCK_GATE.entered ]]

# The blocked first client never releases the lock by itself, so a second
# client that waited instead of resolving the published run would still time
# out. The bound only has to survive a loaded machine.
set +e
timeout 10 "$backend" start --json --no-flatpak \
  >"$fixture/second.json" 2>"$fixture/second.err"
second_rc=$?
set -e
[[ $second_rc -eq 3 ]]
first_id=$(jq -er .id "$fixture/second.json")
[[ $(jq -r .existing "$fixture/second.json") == true ]]

# Force registration to win after cancellation has already observed an
# inactive unit. The intent marker must still make the eventual worker exit
# before any package command, and the cancelling process must not overwrite a
# newer worker result with a synthetic state.
export MOCK_SHOW_GATE="$fixture/show"
$backend cancel "$first_id" >"$fixture/cancel-race.out" \
  2>"$fixture/cancel-race.err" &
cancel_pid=$!
for _ in {1..1000}; do
  [[ -e $MOCK_SHOW_GATE.entered ]] && break
  sleep 0.01
done
[[ -e $MOCK_SHOW_GATE.entered ]]
[[ -e $XDG_STATE_HOME/cybexos/update/logs/$first_id/cancel.requested ]]
: >"$MOCK_BLOCK_GATE.release"
wait "$first_pid"
[[ $(jq -r .existing "$fixture/first.json") == false ]]
[[ $(wc -l <"$MOCK_SYSTEMD_LOG") -eq 1 ]]
set +e
$backend _worker "$first_id" --no-flatpak >"$fixture/cancelled-worker.out" \
  2>"$fixture/cancelled-worker.err"
cancelled_worker_rc=$?
set -e
: >"$MOCK_SHOW_GATE.release"
wait "$cancel_pid"
[[ $cancelled_worker_rc -eq 130 ]]
[[ $(jq -r .state <<<"$($backend status --json "$first_id")") == cancelled ]]
[[ ! -s $MOCK_PACKAGE_LOG ]]
rm -f -- "$active_dir/cybexos-update-$first_id.service"
unset MOCK_SHOW_GATE

# A just-published unit gets a short registration grace. Once the same record
# is old, an absent unit is atomically converted to an abandoned failure and
# no longer blocks future updates.
unset MOCK_BLOCK_GATE
stale_run=$($backend start --json --no-flatpak)
stale_id=$(jq -er .id <<<"$stale_run")
unit=$(jq -er .unit <<<"$stale_run")
rm -f -- "$active_dir/$unit"
grace=$($backend status --json "$stale_id")
[[ $(jq -r .state <<<"$grace") == queued ]]
status_file="$XDG_STATE_HOME/cybexos/update/logs/$stale_id/status.json"
jq '.startedAt = 0' "$status_file" >"$status_file.old"
mv -f -- "$status_file.old" "$status_file"
stale=$($backend status --json "$stale_id")
[[ $(jq -r .state <<<"$stale") == failed ]]
[[ $(jq -r .phase <<<"$stale") == abandoned ]]
[[ $(jq -r .exitCode <<<"$stale") -eq 125 ]]

next=$($backend start --json --no-flatpak)
next_id=$(jq -er .id <<<"$next")
[[ $next_id != "$stale_id" ]]
next_dir=$(jq -er .logDir <<<"$next")
next_unit=$(jq -er .unit <<<"$next")

# A registered worker whose stop fails must remain visibly active. Claiming a
# synthetic cancellation here would let package work continue behind a terminal
# UI state. Once stop succeeds and the unit is proven inactive, cancellation is
# safe even if the mock worker never ran a TERM trap.
next_status="$next_dir/status.json"
jq '.state = "running" | .phase = "packages"' "$next_status" >"$next_status.new"
mv -f -- "$next_status.new" "$next_status"

# A transient DBus/user-manager query failure is not evidence that the worker
# died. Status reads must preserve the active record instead of publishing a
# false abandoned terminal state while package work may still be running.
export MOCK_SHOW_FAIL=1
$backend status --json "$next_id" >"$fixture/show-failed.json" \
  2>"$fixture/show-failed.err"
[[ $(jq -r .state "$fixture/show-failed.json") == running ]]
[[ -e $active_dir/$next_unit ]]
grep -q 'preserving running status' "$fixture/show-failed.err"
set +e
$backend cancel "$next_id" >"$fixture/cancel-inspect-failed.out" \
  2>"$fixture/cancel-inspect-failed.err"
cancel_inspect_failed_rc=$?
set -e
[[ $cancel_inspect_failed_rc -ne 0 ]]
[[ $(jq -r .state "$next_status") == running ]]
[[ -e $next_dir/cancel.requested ]]
grep -q 'outcome is not yet verified' "$fixture/cancel-inspect-failed.err"
unset MOCK_SHOW_FAIL

export MOCK_STOP_FAIL=1
set +e
$backend cancel "$next_id" >"$fixture/cancel-failed.out" \
  2>"$fixture/cancel-failed.err"
cancel_failed_rc=$?
set -e
[[ $cancel_failed_rc -ne 0 ]]
[[ -e $active_dir/$next_unit ]]
[[ $(jq -r .state "$next_status") == running ]]
[[ ! -s $fixture/cancel-failed.out ]]
grep -q 'update remains active' "$fixture/cancel-failed.err"
unset MOCK_STOP_FAIL
$backend cancel "$next_id" >/dev/null
[[ ! -e $active_dir/$next_unit ]]
[[ $(jq -r .state "$next_status") == cancelled ]]

# A status reader cannot declare an active run abandoned while its worker owns
# the lifecycle lock. This is the fast-terminal-write race that used to replace
# a precise worker failure with the generic "worker disappeared" result.
lock_race_start=$($backend start --json --no-flatpak)
lock_race_id=$(jq -er .id <<<"$lock_race_start")
lock_race_dir=$(jq -er .logDir <<<"$lock_race_start")
lock_race_unit=$(jq -er .unit <<<"$lock_race_start")
lock_race_status="$lock_race_dir/status.json"
jq '.state = "running" | .phase = "snapshot" | .startedAt = 0' \
  "$lock_race_status" >"$lock_race_status.new"
mv -f -- "$lock_race_status.new" "$lock_race_status"
rm -f -- "$active_dir/$lock_race_unit"
exec {worker_lock_fd}>"$XDG_RUNTIME_DIR/update.lock"
flock "$worker_lock_fd"
locked_status=$($backend status --json "$lock_race_id")
[[ $(jq -r .state <<<"$locked_status") == running ]]
flock -u "$worker_lock_fd"
exec {worker_lock_fd}>&-
unlocked_status=$($backend status --json "$lock_race_id")
[[ $(jq -r .state <<<"$unlocked_status") == failed ]]
[[ $(jq -r .phase <<<"$unlocked_status") == abandoned ]]

# A worker finishing its step keeps running after the stop request. The
# client returns at once, and status reports the pending cancellation until
# the worker records it at the next boundary.
defer_status_start=$($backend start --json --no-flatpak)
defer_status_id=$(jq -er .id <<<"$defer_status_start")
defer_status_dir=$(jq -er .logDir <<<"$defer_status_start")
defer_status_unit=$(jq -er .unit <<<"$defer_status_start")
defer_status_file="$defer_status_dir/status.json"
jq '.state = "running" | .phase = "packages"' "$defer_status_file" \
  >"$defer_status_file.new"
mv -f -- "$defer_status_file.new" "$defer_status_file"
[[ $(jq -r .deferredCancel "$defer_status_file") == true ]]
[[ $(jq -r .cancelRequested <<<"$($backend status --json "$defer_status_id")") == false ]]
export MOCK_STOP_DEFER=1
: >"$MOCK_STOP_LOG"
deferred_out=$($backend cancel "$defer_status_id")
grep -q 'finishes first' <<<"$deferred_out"
grep -Fq -- "stop --no-block $defer_status_unit" "$MOCK_STOP_LOG"
[[ -e $active_dir/$defer_status_unit ]]
deferred_status=$($backend status --json "$defer_status_id")
[[ $(jq -r .state <<<"$deferred_status") == running ]]
[[ $(jq -r .cancelRequested <<<"$deferred_status") == true ]]
unset MOCK_STOP_DEFER

# A worker launched before deferred cancellation existed would be killed
# together with dnf; refuse rather than interrupt its package transaction.
jq 'del(.deferredCancel)' "$defer_status_file" >"$defer_status_file.new"
mv -f -- "$defer_status_file.new" "$defer_status_file"
rm -f -- "$defer_status_dir/cancel.requested"
: >"$MOCK_STOP_LOG"
set +e
$backend cancel "$defer_status_id" >"$fixture/legacy-cancel.out" \
  2>"$fixture/legacy-cancel.err"
legacy_cancel_rc=$?
set -e
[[ $legacy_cancel_rc -eq 1 ]]
grep -q 'cannot be interrupted safely' "$fixture/legacy-cancel.err"
[[ ! -s $MOCK_STOP_LOG ]]
[[ ! -e $defer_status_dir/cancel.requested ]]
[[ -e $active_dir/$defer_status_unit ]]
jq '.deferredCancel = true' "$defer_status_file" >"$defer_status_file.new"
mv -f -- "$defer_status_file.new" "$defer_status_file"
$backend cancel "$defer_status_id" >/dev/null
[[ $(jq -r .state "$defer_status_file") == cancelled ]]
[[ $(jq -r .cancelRequested <<<"$($backend status --json "$defer_status_id")") == false ]]

# SIGTERM never interrupts the package transaction: dnf runs to completion,
# then the worker records the cancellation instead of starting the test gate
# or Ansible, and keeps the reboot advice for what was installed.
export MOCK_PACKAGE_SUCCESS=1
export MOCK_DNF_GATE="$fixture/dnf-gate"
export MOCK_TESTS_RAN="$fixture/defer-tests-ran"
defer_repo="$fixture/defer-repo"
mkdir -p "$defer_repo/tests"
printf '%s\n' '---' >"$defer_repo/site.yml"
printf '%s\n' '#!/usr/bin/env bash' ': >"$MOCK_TESTS_RAN"' >"$defer_repo/tests/run"
chmod 0755 "$defer_repo/tests/run"
rm -f -- "$MOCK_ANSIBLE_ARGS_LOG"
defer_start=$($backend start --json --full --no-flatpak --repo "$defer_repo")
defer_id=$(jq -er .id <<<"$defer_start")
$backend _worker "$defer_id" --full --no-flatpak --repo "$defer_repo" \
  >"$fixture/defer-worker.out" 2>"$fixture/defer-worker.err" &
defer_worker=$!
for _ in {1..1000}; do
  [[ -e $MOCK_DNF_GATE.entered ]] && break
  sleep 0.01
done
[[ -e $MOCK_DNF_GATE.entered ]]
# Signal again after a pause so at least one TERM arrives while the worker is
# blocked in `wait`, which a trapped signal interrupts early.
kill -TERM "$defer_worker"
sleep 0.3
kill -TERM "$defer_worker"
sleep 0.3
kill -0 "$defer_worker"
[[ ! -e $MOCK_DNF_GATE.finished ]]
[[ $(jq -r .phase <<<"$($backend status --json "$defer_id")") == packages ]]
: >"$MOCK_DNF_GATE.release"
set +e
wait "$defer_worker"
defer_worker_rc=$?
set -e
[[ $defer_worker_rc -eq 130 ]]
[[ -e $MOCK_DNF_GATE.finished ]]
unset MOCK_DNF_GATE
deferred_run=$($backend status --json "$defer_id")
[[ $(jq -r .state <<<"$deferred_run") == cancelled ]]
[[ $(jq -r .dnfDone <<<"$deferred_run") == true ]]
[[ $(jq -r .dnfRc <<<"$deferred_run") -eq 0 ]]
[[ $(jq -r .message <<<"$deferred_run") \
    == 'Update cancelled after the package transaction finished' ]]
[[ $(jq -r .rebootRecommendation <<<"$deferred_run") != pending ]]
[[ ! -e $MOCK_TESTS_RAN ]]
[[ ! -e $MOCK_ANSIBLE_ARGS_LOG ]]
grep -Fq 'timeout --kill-after=1m 30m ./tests/run' "$backend"
unset MOCK_PACKAGE_SUCCESS

printf 'abcdefghi' >"$next_dir/dnf.log"
[[ $($backend read-log "$next_id" dnf 2 4) == cdef ]]
[[ $($backend read-log "$next_id" dnf 2) == cdefghi ]]
window_status=$($backend status --json "$next_id")
[[ $(jq -r .dnfBytes <<<"$window_status") -eq 9 ]]

# Legacy records have no boot-scoped authority. They stay readable, but must
# never manufacture either a positive or negative recommendation.
jq 'del(.bootId, .rebootRecommendation)' "$next_status" >"$next_status.legacy"
mv -f -- "$next_status.legacy" "$next_status"
legacy=$($backend status --json "$next_id")
[[ $(jq -r .rebootRecommendation <<<"$legacy") == unavailable ]]

# A successful transaction publishes `checking` while the Fedora plugin is
# running, then accepts exit 1 only alongside a JSON true result.
export MOCK_PACKAGE_SUCCESS=1
export MOCK_REBOOT_RC=1
export MOCK_REBOOT_JSON='[{"type":"reboot","reboot_required":true,"packages":["kernel-core"]}]'
export MOCK_REBOOT_GATE="$fixture/reboot-check"
recommended_start=$($backend start --json --no-flatpak)
recommended_id=$(jq -er .id <<<"$recommended_start")
[[ $(jq -r .rebootRecommendation <<<"$recommended_start") == pending ]]
$backend _worker "$recommended_id" --no-flatpak &
recommended_worker=$!
for _ in {1..1000}; do
  [[ -e $MOCK_REBOOT_GATE.entered ]] && break
  sleep 0.01
done
[[ -e $MOCK_REBOOT_GATE.entered ]]
checking=$($backend status --json "$recommended_id")
[[ $(jq -r .state <<<"$checking") == running ]]
[[ $(jq -r .phase <<<"$checking") == reboot-check ]]
[[ $(jq -r .rebootRecommendation <<<"$checking") == checking ]]
: >"$MOCK_REBOOT_GATE.release"
wait "$recommended_worker"
unset MOCK_REBOOT_GATE
recommended=$($backend status --json "$recommended_id")
[[ $(jq -r .state <<<"$recommended") == done ]]
[[ $(jq -r .bootId <<<"$recommended") == boot-a ]]
[[ $(jq -r .rebootRecommendation <<<"$recommended") == recommended ]]
[[ $(tail -n 1 "$MOCK_DNF_UMASK_LOG") =~ ^0?022$ ]]
[[ $(stat -c %a "$XDG_STATE_HOME/cybexos/update/logs/$recommended_id/dnf.log") == 600 ]]
[[ $(grep -Fc '"${privileged_package[@]}"' "$backend") -eq 4 ]]
grep -q -- '--quiet --cacheonly needs-restarting --json' "$MOCK_DNF_LOG"
grep -Fxq 'create update '"$recommended_id" "$MOCK_LEGACY_SNAPSHOT_LOG"

# Dismissing the transcript does not dismiss a positive same-boot result. A
# subsequent run inherits it, and malformed plugin output cannot erase it.
$backend dismiss "$recommended_id"
dismissed=$($backend status --json "$recommended_id")
[[ $(jq -r .state <<<"$dismissed") == dismissed ]]
[[ $(jq -r .rebootRecommendation <<<"$dismissed") == recommended ]]
export MOCK_REBOOT_RC=1
export MOCK_REBOOT_JSON='not-json'
carry_start=$($backend start --json --no-flatpak)
carry_id=$(jq -er .id <<<"$carry_start")
[[ $(jq -r .rebootRecommendation <<<"$carry_start") == recommended ]]
$backend _worker "$carry_id" --no-flatpak
carried=$($backend status --json "$carry_id")
[[ $(jq -r .state <<<"$carried") == done ]]
[[ $(jq -r .rebootRecommendation <<<"$carried") == recommended ]]

# A new boot clears the positive at the JSON boundary. The next valid exit
# 0/false result records an explicit no-reboot confirmation for that boot.
printf 'boot-b\n' >"$CYBEXOS_UPDATE_BOOT_ID_FILE"
after_boot=$($backend status --json "$carry_id")
[[ $(jq -r .bootId <<<"$after_boot") == boot-b ]]
[[ $(jq -r .rebootRecommendation <<<"$after_boot") == unavailable ]]
export MOCK_REBOOT_RC=0
export MOCK_REBOOT_JSON='[{"type":"reboot","reboot_required":false,"packages":[]}]'
not_needed_start=$($backend start --json --no-flatpak)
not_needed_id=$(jq -er .id <<<"$not_needed_start")
[[ $(jq -r .rebootRecommendation <<<"$not_needed_start") == pending ]]
$backend _worker "$not_needed_id" --no-flatpak
not_needed=$($backend status --json "$not_needed_id")
[[ $(jq -r .state <<<"$not_needed") == done ]]
[[ $(jq -r .rebootRecommendation <<<"$not_needed") == not-needed ]]

# Malformed JSON and a plugin/tool failure are unavailable, but neither turns
# the already-completed update into a failed run.
export MOCK_REBOOT_RC=0
export MOCK_REBOOT_JSON='{"reboot_required":false}'
malformed_start=$($backend start --json --no-flatpak)
malformed_id=$(jq -er .id <<<"$malformed_start")
$backend _worker "$malformed_id" --no-flatpak
malformed=$($backend status --json "$malformed_id")
[[ $(jq -r .state <<<"$malformed") == done ]]
[[ $(jq -r .rebootRecommendation <<<"$malformed") == unavailable ]]

export MOCK_REBOOT_RC=2
export MOCK_REBOOT_JSON='[]'
failed_check_start=$($backend start --json --no-flatpak)
failed_check_id=$(jq -er .id <<<"$failed_check_start")
$backend _worker "$failed_check_id" --no-flatpak
failed_check=$($backend status --json "$failed_check_id")
[[ $(jq -r .state <<<"$failed_check") == done ]]
[[ $(jq -r .rebootRecommendation <<<"$failed_check") == unavailable ]]

# Release migration, apply, activation, agent-skill adoption, and pruning
# belong to the durable worker. Failed apply or activation restores the prior
# configuration and active release.
release_data="$HOME/.local/share/cybexos"
release_config="$fixture/cybexos.yml"
mkdir -p "$release_data/releases/1.0.0" "$release_data/releases/1.1.0" \
  "$release_data/releases/1.2.0"
ln -s releases/1.2.0 "$release_data/current"
printf 'schema: old\n' >"$release_config"
export MOCK_RELEASE_CONFIG="$release_config"

agent_skill_canonical="$release_data/current/agent-skills/cybexos"
agent_backup_root="$HOME/.local/state/cybexos/backups/agent-skills"
mkdir -p "$HOME/.agents/skills" \
  "$HOME/.claude/skills/cybexos/nested" \
  "$HOME/.codex/skills" "$HOME/original-codex-skill"
for root in .agents .claude .codex; do
  mkdir -p "$HOME/$root/skills/unrelated"
  printf 'unrelated %s\n' "$root" >"$HOME/$root/skills/unrelated/SKILL.md"
done
printf 'original agents skill\n' >"$HOME/.agents/skills/cybexos"
printf 'original claude skill\n' \
  >"$HOME/.claude/skills/cybexos/nested/value"
printf 'original codex target\n' >"$HOME/original-codex-skill/SKILL.md"
ln -s "$HOME/original-codex-skill" "$HOME/.codex/skills/cybexos"

assert_agent_skill_links() {
  local root path
  for root in .agents .claude .codex; do
    path=$HOME/$root/skills/cybexos
    [[ -L $path ]]
    [[ $(readlink -- "$path") == "$agent_skill_canonical" ]]
    [[ $(readlink -f -- "$path") == $(readlink -f -- "$agent_skill_canonical") ]]
  done
}

assert_unrelated_skills() {
  local root
  for root in .agents .claude .codex; do
    [[ $(<"$HOME/$root/skills/unrelated/SKILL.md") == "unrelated $root" ]]
  done
}

make_candidate() {
  local version=$1 candidate="$release_data/releases/$1"
  mkdir -p "$candidate/scripts" "$candidate/tests"
  cp -a "$repo_root/agent-skills" "$candidate/"
  printf '%s\n' '---' >"$candidate/site.yml"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"$candidate/tests/run"
  printf '%s\n' '#!/usr/bin/env bash' \
    'printf "%s\n" "${MOCK_MIGRATED_CONFIG:?}"' >"$candidate/scripts/migrate-config"
  printf '%s\n' "$version" >"$candidate/VERSION"
  cp "$repo_root/scripts/manage-agent-skills" \
    "$candidate/scripts/manage-agent-skills"
  cp "$repo_root/scripts/semver" "$candidate/scripts/semver"
  chmod 0755 "$candidate/tests/run" "$candidate/scripts/migrate-config" \
    "$candidate/scripts/manage-agent-skills" "$candidate/scripts/semver"
}

make_candidate 2.0.0
release_stage="$release_data/releases/.stage.2.0.0.ABC123"
mv -- "$release_data/releases/2.0.0" "$release_stage"
export MOCK_MIGRATED_CONFIG='schema: committed'
release_start=$($backend start --json --full --skip-tests --no-packages \
  --repo "$release_stage" --release-version 2.0.0 \
  --release-data-root "$release_data" --release-config "$release_config" \
  -- -e "@$release_config")
release_id=$(jq -er .id <<<"$release_start")
$backend _worker "$release_id" --full --skip-tests --no-packages \
  --repo "$release_stage" --release-version 2.0.0 \
  --release-data-root "$release_data" --release-config "$release_config" \
  -- -e "@$release_config"
[[ $(<"$release_config") == 'schema: committed' ]]
[[ $(<"$MOCK_ANSIBLE_CONFIG_LOG") == 'schema: committed' ]]
[[ $(readlink "$release_data/current") == releases/2.0.0 ]]
[[ ! -d $release_data/releases/1.0.0 ]]
assert_agent_skill_links
assert_unrelated_skills
for root in .agents .claude .codex; do
  [[ $(stat -c %u "$HOME/$root/skills/cybexos") == "$(id -u)" ]]
done
[[ $(stat -c %u "$agent_backup_root") == "$(id -u)" ]]
[[ $(<"$agent_backup_root/agents/original") == 'original agents skill' ]]
[[ $(<"$agent_backup_root/claude/original/nested/value") \
    == 'original claude skill' ]]
[[ -L $agent_backup_root/codex/original ]]
[[ $(readlink -- "$agent_backup_root/codex/original") \
    == "$HOME/original-codex-skill" ]]
release_status=$($backend status --json "$release_id")
[[ $(jq -r .state <<<"$release_status") == done ]]
[[ $(jq -r .releaseVersion <<<"$release_status") == 2.0.0 ]]

# A failure while reconciling adopted skill slots rolls every slot back to its
# exact pre-call object, restores current, and triggers configuration rollback.
rm -f -- "$HOME/.agents/skills/cybexos" \
  "$HOME/.codex/skills/cybexos"
rm -rf -- "$HOME/.claude/skills/cybexos"
printf 'owned agents before failed activation\n' \
  >"$HOME/.agents/skills/cybexos"
mkdir -p "$HOME/.claude/skills/cybexos"
printf 'owned claude before failed activation\n' \
  >"$HOME/.claude/skills/cybexos/value"
ln -s missing-before-failed-activation \
  "$HOME/.codex/skills/cybexos"
make_candidate 2.1.0
export MOCK_MIGRATED_CONFIG='schema: activation-must-rollback'
export CYBEXOS_AGENT_SKILLS_TESTING=1
export CYBEXOS_AGENT_SKILLS_TEST_FAIL=after:agents
activation_failure_start=$($backend start --json --full --skip-tests --no-packages \
  --repo "$release_data/releases/2.1.0" --release-version 2.1.0 \
  --release-data-root "$release_data" --release-config "$release_config")
activation_failure_id=$(jq -er .id <<<"$activation_failure_start")
set +e
$backend _worker "$activation_failure_id" --full --skip-tests --no-packages \
  --repo "$release_data/releases/2.1.0" --release-version 2.1.0 \
  --release-data-root "$release_data" --release-config "$release_config"
activation_failure_rc=$?
set -e
unset CYBEXOS_AGENT_SKILLS_TESTING \
  CYBEXOS_AGENT_SKILLS_TEST_FAIL
[[ $activation_failure_rc -eq 1 ]]
[[ $(<"$release_config") == 'schema: committed' ]]
[[ $(readlink "$release_data/current") == releases/2.0.0 ]]
[[ -f $HOME/.agents/skills/cybexos \
    && ! -L $HOME/.agents/skills/cybexos ]]
[[ $(<"$HOME/.agents/skills/cybexos") \
    == 'owned agents before failed activation' ]]
[[ $(<"$HOME/.claude/skills/cybexos/value") \
    == 'owned claude before failed activation' ]]
[[ -L $HOME/.codex/skills/cybexos ]]
[[ $(readlink -- "$HOME/.codex/skills/cybexos") \
    == missing-before-failed-activation ]]
assert_unrelated_skills
activation_failure=$($backend status --json "$activation_failure_id")
[[ $(jq -r .state <<<"$activation_failure") == failed ]]
[[ $(jq -r .phase <<<"$activation_failure") == activation ]]
grep -F '[release] agent skill provisioning failed; restoring prior activation' \
  "$XDG_STATE_HOME/cybexos/update/logs/$activation_failure_id/run.log" \
  >/dev/null
grep -F '[release] restored the pre-update installer configuration' \
  "$XDG_STATE_HOME/cybexos/update/logs/$activation_failure_id/run.log" \
  >/dev/null

make_candidate 2.2.0
export MOCK_MIGRATED_CONFIG='schema: ansible-must-rollback'
export MOCK_ANSIBLE_RC=42
failed_release_start=$($backend start --json --full --skip-tests --no-packages \
  --repo "$release_data/releases/2.2.0" --release-version 2.2.0 \
  --release-data-root "$release_data" --release-config "$release_config")
failed_release_id=$(jq -er .id <<<"$failed_release_start")
set +e
$backend _worker "$failed_release_id" --full --skip-tests --no-packages \
  --repo "$release_data/releases/2.2.0" --release-version 2.2.0 \
  --release-data-root "$release_data" --release-config "$release_config"
failed_release_rc=$?
set -e
unset MOCK_ANSIBLE_RC
[[ $failed_release_rc -eq 42 ]]
[[ $(<"$release_config") == 'schema: committed' ]]
[[ $(readlink "$release_data/current") == releases/2.0.0 ]]
failed_release=$($backend status --json "$failed_release_id")
[[ $(jq -r .state <<<"$failed_release") == failed ]]
[[ $(jq -r .phase <<<"$failed_release") == ansible ]]
grep -F '[release] restored the pre-update installer configuration' \
  "$XDG_STATE_HOME/cybexos/update/logs/$failed_release_id/run.log" >/dev/null

# Uninstall remains authoritative even after adopted slots drifted between
# releases: restore the immutable first-adoption objects, not later collisions.
"$release_data/releases/2.0.0/scripts/manage-agent-skills" uninstall \
  --home "$HOME" >/dev/null
[[ $(<"$HOME/.agents/skills/cybexos") == 'original agents skill' ]]
[[ $(<"$HOME/.claude/skills/cybexos/nested/value") \
    == 'original claude skill' ]]
[[ -L $HOME/.codex/skills/cybexos ]]
[[ $(readlink -- "$HOME/.codex/skills/cybexos") \
    == "$HOME/original-codex-skill" ]]
assert_unrelated_skills

! grep -q 'set +e;.*set -e' "$backend"

printf 'Durable updater serializes starts, defers cancellation past package transactions, owns release and agent-skill activation rollback, preserves boot-scoped reboot advice, and reads exact log windows\n'
