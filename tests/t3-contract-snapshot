#!/usr/bin/env bash
# Dump the observable T3Code contract from the running shell, as JSON on stdout.
#
# Common/T3Code.qml is a façade over six singletons (T3Connection, T3Rpc,
# T3Threads, T3Detail, T3Drafts, T3Git). The failure mode that split has is specific and nasty: the shell
# comes up looking completely normal — connected chip, popover header, thread
# list — while something behind it is broken. It happened in WP5.1 (every send
# throwing ReferenceError) and again in WP5.2 (two properties moved but never
# declared), and neither was visible on screen.
#
# So: snapshot before the change, snapshot after, diff. Any difference is either
# a regression or something you can explain.
#
#   tests/t3-contract-snapshot > /tmp/before.json     # on a known-good tree
#   …make the change, then deploy it…
#   tests/t3-contract-snapshot > /tmp/after.json
#   diff /tmp/before.json /tmp/after.json
#
# The property and function lists are derived from what the popover and chip
# actually read off T3Code, so they track the real contract instead of going
# stale. Requires a running quickshell (`systemctl --user status quickshell`).
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
shell_src="$repo/roles/desktop/files/quickshell"
deployed="${QS_CONFIG_DIR:-$HOME/.local/share/cybexos/runtime/quickshell}"
snapshot_timeout=${T3_SNAPSHOT_TIMEOUT:-30}

# shellcheck source=tests/lib/quickshell-live
source "$repo/tests/lib/quickshell-live"

if ! command -v qs >/dev/null; then
  echo "qs not on PATH — is quickshell installed?" >&2
  exit 1
fi

# What consumers actually touch, split into readable properties and functions.
#
# Deliberately excludes Common/T3*.qml: those are the implementation, and while
# Phase 5 is in flight they still reference T3Code themselves. Counting those
# would grow the "contract" every time a split leaves a reach-back behind —
# which is exactly the thing worth noticing, not absorbing.
mapfile -t members < <(
  grep -rho 'T3Code\.[a-zA-Z_][a-zA-Z0-9_]*' --include='*.qml' \
      "$shell_src/Bar" "$shell_src/Popovers" "$shell_src/Settings" "$shell_src" \
      --exclude-dir=Common \
    | sed 's/T3Code\.//' | sort -u \
    | grep -vx qml)   # prose mentioning the filename, not a member

props=() funcs=()
for m in "${members[@]}"; do
  if grep -rqE "^\s*function $m\b" "$shell_src"/Common/T3*.qml; then
    funcs+=("$m")
  elif grep -rqE "^\s*(readonly )?property \w+(<[^>]*>)? $m\b" "$shell_src"/Common/T3*.qml; then
    props+=("$m")
  else
    echo "warning: $m resolves to neither a property nor a function" >&2
  fi
done

json_list() { printf '%s\n' "$@" | sed 's/.*/"&"/' | paste -sd, - ; }

probe=$(cat <<EOF
    // Injected by tests/t3-contract-snapshot. Not part of the shell.
    IpcHandler {
        target: "t3contract"

        function ready(): string {
            // An offline shell is settled immediately. A connected shell is
            // only meaningful after its initial subscription has populated
            // T3Threads; polling this contract avoids a fixed startup sleep.
            return T3Code.state !== "connecting"
                && (T3Code.state !== "connected" || T3Code.shellReady)
                ? "ready" : "waiting";
        }

        function snapshot(): string {
            const out = {};
            for (const name of [$(json_list "${props[@]}")]) {
                let v;
                try { v = T3Code[name]; } catch (e) { v = "<throw>"; }
                if (v === undefined) { out[name] = "<undefined>"; continue; }
                if (v === null) { out[name] = null; continue; }
                if (Array.isArray(v)) { out[name] = "array[" + v.length + "]"; continue; }
                if (typeof v === "object") {
                    out[name] = "object{" + Object.keys(v).sort().join(",") + "}";
                    continue;
                }
                out[name] = v;
            }
            const missing = [];
            for (const name of [$(json_list "${funcs[@]}")]) {
                if (typeof T3Code[name] !== "function")
                    missing.push(name);
            }
            out["__missingFunctions"] = missing;
            return JSON.stringify(out, Object.keys(out).sort(), 1);
        }
    }

EOF
)

# The deployed tree is disposable (the Ansible role is the source of truth), so
# the probe goes there and is rsynced away again on the way out. The shared
# harness proves that this test never creates a second shell and that the
# restored managed instance is healthy before returning.
qs_live_begin

cleanup() {
  local rc=$? restore_rc=0 live_rc=0
  trap - EXIT INT TERM
  set +e
  rsync -a --delete --delete-excluded \
    --exclude='__pycache__/' --exclude='*.py[co]' \
    "$shell_src/" "$deployed/" || restore_rc=$?
  if ((restore_rc == 0)); then
    qs_live_wait_ipc "$snapshot_timeout" popouts close >/dev/null || restore_rc=$?
  fi
  qs_live_end || live_rc=$?
  if ((rc == 0 && (restore_rc != 0 || live_rc != 0))); then
    rc=1
  fi
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

rsync -a --delete --delete-excluded \
  --exclude='__pycache__/' --exclude='*.py[co]' \
  "$shell_src/" "$deployed/"
python3 - "$deployed/shell.qml" <<PY
import io, sys
path = sys.argv[1]
s = io.open(path, encoding="utf-8").read()
anchor = '    IpcHandler {\n        target: "popouts"\n'
assert anchor in s, "shell.qml has no popouts IpcHandler to anchor against"
io.open(path, "w", encoding="utf-8").write(s.replace(anchor, """$probe""" + anchor, 1))
PY

# Quickshell reloads on file change; wait for both the IPC registration and,
# when connected, the initial T3 subscription rather than guessing a delay.
qs_live_wait_value "$snapshot_timeout" t3contract ready ready >/dev/null
qs ipc call t3contract snapshot
