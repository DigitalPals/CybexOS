#!/usr/bin/env bash
# Snapshot a known-good managed shell before deployment, then verify the live
# hot reload and automatically restore that snapshot on failure.
set -euo pipefail

usage() {
  printf 'usage: %s <snapshot|verify-or-rollback> <home> [deployment-id]\n' "${0##*/}" >&2
  exit 2
}

[[ $# -ge 2 && $# -le 3 ]] || usage
action=$1
primary_home=$2
deployment_id=${3:-unknown}
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=tests/lib/quickshell-live
source "$repo_root/tests/lib/quickshell-live"

account_home=$(getent passwd "$(id -un)" | cut -d: -f6)
[[ -n $account_home && -d $primary_home ]] || {
  printf 'invalid home directory: %s\n' "$primary_home" >&2
  exit 2
}
resolved_home=$(cd -- "$primary_home" && pwd -P)
resolved_account_home=$(cd -- "$account_home" && pwd -P)
if [[ ${QUICKSHELL_DEPLOY_TESTING:-0} == 1 ]]; then
  test_root=${QUICKSHELL_DEPLOY_TEST_ROOT:-}
  [[ -n $test_root && -d $test_root ]] || {
    printf 'test mode requires an existing QUICKSHELL_DEPLOY_TEST_ROOT\n' >&2
    exit 2
  }
  resolved_test_root=$(cd -- "$test_root" && pwd -P)
  [[ $resolved_home == "$resolved_test_root" &&
      $(stat -c %u -- "$resolved_home") == "$(id -u)" &&
      $resolved_home == "${TMPDIR:-/tmp}"/cybexos-quickshell-deploy.* ]] || {
    printf 'refusing an unbounded Quickshell deployment test root\n' >&2
    exit 2
  }
elif [[ $resolved_home != "$resolved_account_home" ]]; then
  printf 'refusing deployment state outside the current account home\n' >&2
  exit 2
fi

config_dir=$resolved_home/.local/share/cybexos/runtime/quickshell
legacy_config_dir=$resolved_home/.config/quickshell
dev_source_file=$resolved_home/.config/cybexos/dev-source
state_dir=$resolved_home/.local/state/cybexos
archive=$state_dir/quickshell-last-good.tar
pending=$state_dir/quickshell-deploy-pending
health=$state_dir/quickshell-health.json
mkdir -p -- "$state_dir"
chmod 700 "$state_dir"

write_health() {
  local status=$1 detail=$2 tmp=$health.tmp.$$
  python3 - "$tmp" "$status" "$detail" "$deployment_id" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone

path, status, detail, deployment_id = sys.argv[1:]
with open(path, "w", encoding="utf-8") as stream:
    json.dump({
        "status": status,
        "detail": detail,
        "deploymentId": deployment_id,
        "checkedAt": datetime.now(timezone.utc).isoformat(),
        "service": "quickshell.service",
    }, stream, separators=(",", ":"))
    stream.write("\n")
os.chmod(path, 0o600)
PY
  mv -f -- "$tmp" "$health"
}

snapshot() {
  local tmp=$archive.tmp.$$ snapshot_source=$config_dir
  : >"$pending"
  if [[ -e $dev_source_file || -L $dev_source_file ]]; then
    printf 'development\n' >"$pending"
    printf 'Development runtime is active; vendor live verification will be skipped.\n'
    return 0
  fi
  if [[ ! -d $snapshot_source
        && -f $state_dir/quickshell-manifest.txt
        && -d $legacy_config_dir && ! -L $legacy_config_dir ]]; then
    snapshot_source=$legacy_config_dir
  fi
  if [[ ! -d $snapshot_source ]] || ! qs_live_begin; then
    systemctl --user is-active --quiet "$QS_LIVE_SERVICE" && qs_live_end || true
    printf 'No healthy live Quickshell to snapshot; post-deploy live verification will be skipped.\n'
    return 0
  fi
  trap 'rm -f -- "$tmp"; qs_live_end >/dev/null 2>&1 || true' RETURN
  tar --create --file "$tmp" --directory "$snapshot_source" .
  tar --list --file "$tmp" >/dev/null
  chmod 600 "$tmp"
  mv -f -- "$tmp" "$archive"
  printf 'verify\n' >"$pending"
  qs_live_end
  trap - RETURN
}

restore_last_good() {
  [[ -f $archive ]] || {
    printf 'No known-good Quickshell archive is available for rollback.\n' >&2
    return 1
  }
  mkdir -p -- "$config_dir"
  find "$config_dir" -mindepth 1 -delete
  tar --extract --file "$archive" --directory "$config_dir" --no-same-owner
  systemctl --user restart "$QS_LIVE_SERVICE"
  qs_live_wait_service && qs_live_end
}

verify_or_rollback() {
  local mode=skip
  # An empty marker means snapshot() deliberately skipped a headless or
  # inactive shell. read(1) returns non-zero at EOF, which must not trip
  # errexit and turn that normal first-install state into a failed deploy.
  if [[ -s $pending ]]; then
    read -r mode <"$pending" || mode=skip
  fi
  if [[ $mode == development ]]; then
    write_health skipped 'Development source is active; vendor runtime was not live-tested'
    return 0
  fi
  if [[ $mode != verify ]]; then
    write_health skipped 'No live shell was active before deployment'
    return 0
  fi

  # Sequential file copies can cause rejected intermediate hot reloads while
  # a module index and its new type briefly disagree. Restart once from the
  # complete final tree so the invocation journal describes the deployable
  # configuration, then verify IPC, identity, and that entire invocation.
  local healthy=false
  if systemctl --user restart "$QS_LIVE_SERVICE" \
      && qs_live_wait_service \
      && sleep "${QUICKSHELL_DEPLOY_SETTLE_SECS:-1}" \
      && qs_live_begin; then
    healthy=true
    qs_live_wait_ipc "$QS_LIVE_TIMEOUT" settings close >/dev/null || healthy=false
    qs_live_end || healthy=false
  else
    systemctl --user is-active --quiet "$QS_LIVE_SERVICE" && qs_live_end || true
  fi
  if $healthy; then
    write_health healthy 'Deployment restarted and passed live checks'
    printf 'Quickshell deployment reload is healthy.\n'
    return 0
  fi

  printf 'Quickshell health check failed; restoring the last-known-good tree.\n' >&2
  if restore_last_good; then
    write_health rolled-back 'Deployment failed live checks; last-known-good tree restored'
    printf 'Rollback restored a healthy managed Quickshell.\n' >&2
  else
    write_health failed 'Deployment and automatic rollback both failed live checks'
    printf 'Automatic rollback did not restore a healthy shell.\n' >&2
  fi
  return 1
}

case $action in
  snapshot) snapshot ;;
  verify-or-rollback) verify_or_rollback ;;
  *) usage ;;
esac
