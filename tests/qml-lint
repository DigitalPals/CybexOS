#!/usr/bin/env bash
# Static QML analysis for the quickshell config: catches syntax errors and
# unresolved references before a shell reload, complementing the runtime
# journal grep in tests/verify-system.
#
# One batched qmllint invocation over the whole tree (spawning it per file
# costs ~4x as much). What fails the check is decided by qmllint's own exit
# status, driven by the category levels in the shell's .qmllint.ini — nothing
# here parses human-readable output to make that call. Remaining warnings are
# only counted by category, so the number stays visible while it is worked
# down without burying a real failure; --verbose prints them in full.
#
# The test harnesses that the real-engine tests install as shell.qml over a
# copy of the tree are linted too, each from its own scratch copy so relative
# and qs.* imports resolve exactly as they do at runtime. Those tests only run
# where no managed qs is active (CI), so without this a harness that drifted
# from the components it drives failed nowhere else.
set -uo pipefail

verbose=false
case ${1:-} in
  -v|--verbose) verbose=true ;;
  '') ;;
  *) printf 'usage: %s [-v|--verbose]\n' "${BASH_SOURCE[0]##*/}" >&2; exit 2 ;;
esac

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
shell_dir="$repo_root/roles/desktop/files/quickshell"

# Fedora installs the binary as qmllint-qt6.
qmllint=$(command -v qmllint-qt6 || command -v qmllint || true)
if [[ -z $qmllint ]]; then
  printf '\033[31mFAIL\033[0m  qmllint not installed (dnf install qt6-qtdeclarative-devel)\n' >&2
  exit 1
fi

# Ask Qt where its QML modules live rather than hardcoding a lib64 path.
qml_import_path=$(qtpaths6 --query QT_INSTALL_QML 2>/dev/null \
  || qtpaths --query QT_INSTALL_QML 2>/dev/null || true)
[[ -d ${qml_import_path:-} ]] || qml_import_path=/usr/lib64/qt6/qml

harnesses=(
  tests/qml-lifecycle/shell.qml
  tests/user-widgets/shell.qml
  tests/omarchy-plugins/shell.qml
)

# Quickshell provides qs.* as a virtual import of the configuration root.
# Reproduce that mapping for Qt's standalone linter without modifying source.
work=$(mktemp -d "${TMPDIR:-/tmp}/cybexos-qml-imports.XXXXXX") || exit 1
lint_pids=()
cleanup() {
  ((${#lint_pids[@]})) && kill -- "${lint_pids[@]}" 2>/dev/null
  wait
  rm -rf -- "$work"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir -- "$work/imports" && ln -s "$shell_dir" "$work/imports/qs" || exit 1

cd -- "$shell_dir" || exit 1
mapfile -t -d '' files < <(find . -name '*.qml' -print0 | sort -z)
if ((${#files[@]} == 0)); then
  printf '\033[31mFAIL\033[0m  no QML files under %s\n' "$shell_dir"
  exit 1
fi

# Every invocation writes its own report, so parallel runs never interleave
# and the combined output keeps the tree's file order.
"$qmllint" -I "$qml_import_path" -I "$work/imports" -I . "${files[@]}" \
  >"$work/tree.out" 2>&1 &
lint_pids+=("$!")
reports=("$work/tree.out")

for index in "${!harnesses[@]}"; do
  harness=$work/harness.$index
  (
    mkdir -p -- "$harness/imports" &&
      cp -a -- "$shell_dir" "$harness/tree" &&
      cp -- "$repo_root/${harnesses[index]}" "$harness/tree/shell.qml" &&
      ln -s "$harness/tree" "$harness/imports/qs" &&
      cd -- "$harness/tree" || exit 1
    # Findings name the tracked harness, not the throwaway copy.
    "$qmllint" -I "$qml_import_path" -I "$harness/imports" -I . ./shell.qml 2>&1 \
      | sed "s#\\./shell\\.qml:#${harnesses[index]}:#g"
  ) >"$harness.out" 2>&1 &
  lint_pids+=("$!")
  reports+=("$harness.out")
done

status=0
for pid in "${lint_pids[@]}"; do
  wait "$pid" || status=1
done
lint_pids=()
output=$(cat -- "${reports[@]}")

# "[category]" suffixes, most frequent first — e.g. "421 unqualified".
summary=$(grep -oE '\[[a-z-]+\]$' <<<"$output" \
  | sort | uniq -c | sort -rn \
  | awk '{ gsub(/[][]/, "", $2); printf "%s%s %s", sep, $1, $2; sep = ", " }')

# What actually failed the run: diagnostics raised to error level, plus syntax
# errors (which qmllint still labels "Warning" while exiting nonzero). Printed
# on their own so the standing warnings cannot bury them. Display only — the
# verdict is qmllint's exit status, and anything unrecognized falls back to
# the whole report rather than being hidden.
fatal_findings() {
  local all fatal others
  all=$(grep -E '^(Error|Warning|Info): ' <<<"$output") || { printf '%s\n' "$output"; return; }
  fatal=$(grep -E '^Error: |\[syntax\]$' <<<"$all")
  if [[ -z $fatal ]]; then
    printf '%s\n' "$all"
    return
  fi
  printf '%s\n' "$fatal"
  others=$(grep -cvE '^Error: |\[syntax\]$' <<<"$all")
  ((others > 0)) && printf '(%d other findings suppressed — rerun with --verbose)\n' "$others"
  return 0
}

if ((status != 0)); then
  $verbose && printf '%s\n' "$output" || fatal_findings
  printf '\033[31mFAIL\033[0m  qmllint rejected %d QML files and %d test harnesses (%s)\n' \
    "${#files[@]}" "${#harnesses[@]}" "${summary:-no categories reported}"
  exit 1
fi

$verbose && printf '%s\n' "$output"
if [[ -n $summary ]]; then
  printf '\033[32mPASS\033[0m  %d QML files and %d test harnesses, no qmllint errors (warnings: %s)\n' \
    "${#files[@]}" "${#harnesses[@]}" "$summary"
else
  printf '\033[32mPASS\033[0m  %d QML files and %d test harnesses, no qmllint errors\n' \
    "${#files[@]}" "${#harnesses[@]}"
fi
