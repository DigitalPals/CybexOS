#!/usr/bin/env bash
# Brightness has two backends and picking the wrong one is silent: writing a
# sysfs backlight while an Apple display is the screen in front of you moves
# the laptop's closed panel and looks exactly like a control that does
# nothing. That is the bug this fixture exists to keep out — every caller goes
# through brightness-control, and brightness-control picks by focused monitor.
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
script="$repo_root/roles/dotfiles/templates/brightness-control.j2"
fixture=$(mktemp -d)
trap 'rm -rf "$fixture"' EXIT

mock_bin="$fixture/bin"
log_dir="$fixture/log"
nodes="$fixture/dev"
mkdir -p "$mock_bin" "$log_dir" "$nodes"
: > "$nodes/hiddev0"
: > "$nodes/hiddev1"

write_mock() {
  local name=$1
  shift
  printf '%s\n' '#!/usr/bin/env bash' "$@" > "$mock_bin/$name"
  chmod +x "$mock_bin/$name"
}

write_mock hyprctl \
  'printf "%s\n" "$*" >> "$BRIGHTNESS_TEST_LOG/hyprctl"' \
  'printf "%s\n" "{\"focused\": true, \"make\": \"$BRIGHTNESS_TEST_MAKE\"}" | sed "s/^/[/;s/$/]/"'

write_mock asdcontrol \
  'printf "%s\n" "$*" >> "$BRIGHTNESS_TEST_LOG/asdcontrol"' \
  'detect=false dev="" value=""' \
  'for arg in "$@"; do' \
  '  case $arg in' \
  '    --silent|-s|--brief|-b|--) ;;' \
  '    --detect|-d) detect=true ;;' \
  '    *) if [[ -z $dev ]]; then dev=$arg; else value=$arg; fi ;;' \
  '  esac' \
  'done' \
  'if $detect; then' \
  '  [[ $dev == "$BRIGHTNESS_TEST_DEVICE" ]] && printf "%s: USB Monitor - SUPPORTED.\n" "$dev"' \
  '  exit 0' \
  'fi' \
  '[[ $dev == "$BRIGHTNESS_TEST_DEVICE" ]] || exit 1' \
  'if [[ -n $value ]]; then' \
  '  printf "%s\n" "$value" >> "$BRIGHTNESS_TEST_LOG/asd-writes"' \
  '  exit 0' \
  'fi' \
  'printf "%s\n" "${BRIGHTNESS_TEST_RAW:-60000}"'

write_mock brightnessctl \
  'printf "%s\n" "$*" >> "$BRIGHTNESS_TEST_LOG/brightnessctl"' \
  '[[ ${1:-} == -m ]] && printf "intel_backlight,backlight,317,62%%,512\n"' \
  'exit 0'

# The OSD ping goes through $HOME/.local/bin/cybexos-runtime. HOME is a
# fixture so no run can reach the desktop running this suite, and it has no
# resolver at all unless a case installs one: the ping must stay optional.
home="$fixture/home"
mkdir -p "$home"
install_runtime() {
  mkdir -p "$home/.local/bin"
  printf '%s\n' '#!/usr/bin/env bash' \
    'printf "%s\n" "$*" >> "$BRIGHTNESS_TEST_LOG/cybexos-runtime"' \
    > "$home/.local/bin/cybexos-runtime"
  chmod +x "$home/.local/bin/cybexos-runtime"
}

run() {
  local make=$1 runtime=$2
  shift 2
  BRIGHTNESS_TEST_MAKE="$make" \
  BRIGHTNESS_TEST_LOG="$log_dir" \
  BRIGHTNESS_TEST_DEVICE="$nodes/hiddev1" \
  BRIGHTNESS_TEST_RAW="${raw:-60000}" \
  BRIGHTNESS_HID_NODES="$nodes/hiddev*" \
  XDG_RUNTIME_DIR="$runtime" \
  HOME="$home" \
  PATH="$mock_bin:$PATH" \
    bash "$script" "$@"
}

fresh() {
  rm -rf "$log_dir" "$fixture/run"
  mkdir -p "$log_dir" "$fixture/run"
}

fail() { printf '%s\n' "$1" >&2; exit 1; }

# ---- an Apple display takes HID, never the backlight ----------------------
raw=60000
fresh
run 'Apple Computer Inc' "$fixture/run" set 40
[[ -f $log_dir/asd-writes ]] || fail 'set did not reach asdcontrol on an Apple display'
grep -Fxq '40%' "$log_dir/asd-writes" || fail 'set 40 must ask asdcontrol for 40%'
[[ ! -f $log_dir/brightnessctl ]] || fail 'the laptop backlight must not be touched while docked'

fresh
run 'Apple Computer Inc' "$fixture/run" up 5
grep -Fxq '+5%' "$log_dir/asd-writes" || fail 'up must raise by a relative percent'
fresh
run 'Apple Computer Inc' "$fixture/run" down 5
grep -Fxq -- '-5%' "$log_dir/asd-writes" || fail 'down must lower by a relative percent'

# 0%..100% maps onto 400..60000, so a raw level converts back the same way.
fresh
raw=30200
[[ $(run 'Apple Computer Inc' "$fixture/run" get) == 50 ]] \
  || fail 'get must report the HID level as a percent of the Apple range'
fresh
raw=400
[[ $(run 'Apple Computer Inc' "$fixture/run" get) == 0 ]] || fail 'the Apple floor is 0 percent'
fresh
raw=60000
[[ $(run 'Apple Computer Inc' "$fixture/run" get) == 100 ]] || fail 'the Apple ceiling is 100 percent'

# ---- anything else is the sysfs backlight --------------------------------
fresh
run 'Dell Inc.' "$fixture/run" set 40
grep -Fxq 'set 40%' "$log_dir/brightnessctl" || fail 'set must reach brightnessctl off an Apple display'
[[ ! -f $log_dir/asd-writes ]] || fail 'asdcontrol must not drive a laptop panel'

# A backlight at zero is a black screen with no way back from this control.
fresh
run 'Dell Inc.' "$fixture/run" set 0
grep -Fxq 'set 1%' "$log_dir/brightnessctl" || fail 'the backlight floor is one percent, not none'

fresh
[[ $(run 'Dell Inc.' "$fixture/run" get) == 62 ]] || fail 'get must read the backlight percent'

fresh
run 'Dell Inc.' "$fixture/run" up 5
grep -Fxq 'set 5%+' "$log_dir/brightnessctl" || fail 'up must still step the backlight'

# ---- detection is cached, because it is far too slow for a held key -------
runtime="$fixture/cache-run"
mkdir -p "$runtime"
fresh
run 'Apple Computer Inc' "$runtime" get > /dev/null
grep -q -- '--detect' "$log_dir/asdcontrol" || fail 'a cold run must detect the display'
[[ -s $runtime/brightness-control.hiddev ]] || fail 'detection must be cached'
fresh
run 'Apple Computer Inc' "$runtime" get > /dev/null
grep -q -- '--detect' "$log_dir/asdcontrol" && fail 'a warm run must trust the cached node'

# A cached node that stopped answering is re-detected rather than written to.
fresh
printf '%s' "$nodes/hiddev0" > "$runtime/brightness-control.hiddev"
[[ $(run 'Apple Computer Inc' "$runtime" get) == 100 ]] || fail 'a stale cache must recover'
[[ $(<"$runtime/brightness-control.hiddev") == "$nodes/hiddev1" ]] \
  || fail 'recovery must rewrite the cache to the node that answered'

# ---- without asdcontrol, a held key starts nothing it cannot use ----------
# The keys repeat ~40 times a second. With no HID tool the answer is the
# backlight whatever the focused monitor is, so hyprctl and jq never start.
plain_bin="$fixture/plain-bin"
mkdir -p "$plain_bin"
cp "$mock_bin/hyprctl" "$mock_bin/brightnessctl" "$plain_bin/"
fresh
BRIGHTNESS_TEST_MAKE='Apple Computer Inc' \
BRIGHTNESS_TEST_LOG="$log_dir" \
XDG_RUNTIME_DIR="$fixture/run" \
HOME="$home" \
PATH="$plain_bin:/usr/bin:/bin" \
  bash "$script" up 5
grep -Fxq 'set 5%+' "$log_dir/brightnessctl" || fail 'without asdcontrol the backlight must still step'
[[ ! -e $log_dir/hyprctl ]] || fail 'without asdcontrol, hyprctl must not run on every key repeat'

# ---- the OSD hears about writes through the runtime resolver --------------
# The shell runs by path, so a bare `qs ipc call` finds no configuration.
install_runtime
for verb in 'set 40' 'up 5' 'down 5'; do
  fresh
  # shellcheck disable=SC2086 # the verb and its argument are two words
  run 'Dell Inc.' "$fixture/run" $verb
  [[ -f $log_dir/cybexos-runtime \
      && $(<"$log_dir/cybexos-runtime") == 'ipc osd brightness' ]] \
    || fail "$verb must ping the OSD through cybexos-runtime ipc"
done
fresh
run 'Dell Inc.' "$fixture/run" get > /dev/null
[[ ! -e $log_dir/cybexos-runtime ]] || fail 'get must not ping the OSD: the shell calls it'

printf 'Brightness routes by focused monitor: HID for Apple displays, sysfs backlight otherwise\n'
