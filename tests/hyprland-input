#!/usr/bin/env bash
# Runs the production data loader with a recording compositor; no live reload.
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/cybexos-input-lua.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT
mkdir -p "$scratch/config/cybexos"
cat > "$scratch/test.lua" <<'LUA'
local repo = assert(os.getenv("CYBEXOS_INPUT_TEST_REPO"))
package.path = repo .. "/roles/desktop/files/?.lua;" .. package.path
local calls = {}
hl = {config = function(value) calls[#calls + 1] = value end}
_G.__cybexos_vendor_keyboard_options = "compose:caps,lv3:ralt_switch,future:vendor"
local input = require("input_preferences")
local json = require("displays")
assert(#calls == 0, "missing preferences must not reset defaults")
input.apply(assert(json.decode([[{"v":1,"future":true,"keyboard":{"layouts":[{"layout":"us","variant":"intl"},{"layout":"nl"}],"shortcut":"grp:alt_shift_toggle"},"touchpad":{"tap":false,"naturalScroll":true,"sensitivity":0.25}}]])))
local value = calls[#calls].input
assert(value.kb_layout == "us,nl" and value.kb_variant == "intl,")
assert(value.kb_options == "compose:caps,lv3:ralt_switch,future:vendor,grp:alt_shift_toggle", "shared defaults survive")
assert(value.touchpad.tap_to_click == false and value.touchpad.natural_scroll == true and value.sensitivity == 0.25)
input.apply(assert(json.decode('{"v":1,"keyboard":{"shortcut":"grp:caps_toggle"}}')))
assert(not calls[#calls].input.kb_options:find("compose:caps", 1, true), "Caps shortcut cannot also be Compose")
local count = #calls
for _, text in ipairs({
  '{"v":1,"keyboard":false}', '{"v":1,"touchpad":[]}', '{"v":2}',
  '{"v":1,"keyboard":{"layouts":[]}}', '{"v":1,"touchpad":{"tap":1}}',
  '{"v":1,"touchpad":{"sensitivity":2}}', '{"v":1,"keyboard":{"shortcut":"bad"}}',
  '{"v":1,"keyboard":{"layouts":[{"layout":"us\\\";os.execute(1)"}]}}'
}) do
  local ok = pcall(input.apply, assert(json.decode(text)))
  assert(not ok, "invalid document accepted: " .. text)
  assert(#calls == count, "invalid preferences partially applied")
end
local path = assert(os.getenv("XDG_CONFIG_HOME")) .. "/cybexos/input.json"
local file = assert(io.open(path, "w")); file:write('{"v":1,"touchpad":{"tap":false}}'); file:close()
package.loaded.input_preferences = nil
require("input_preferences")
assert(calls[#calls].input.touchpad.tap_to_click == false, "saved preferences load at startup")
assert(_G.__cybexos_input_error == nil)
file = assert(io.open(path, "w")); file:write('{"v":1,"touchpad":'); file:close()
count = #calls
package.loaded.input_preferences = nil
require("input_preferences")
assert(#calls == count and type(_G.__cybexos_input_error) == "string", "corrupt preferences are contained")
print("PASS input preferences: persistence, validation, shared defaults and corruption recovery")
LUA
CYBEXOS_INPUT_TEST_REPO="$repo" XDG_CONFIG_HOME="$scratch/config" luajit "$scratch/test.lua"

# Touchpad gestures: the rendered vendor input.lua against a compositor double
# that rejects overshadowed gestures the way Hyprland 0.56 does.
sed -e 's/{{ machine_keyboard_layout | to_json }}/"us"/' \
    -e 's/{{ machine_keyboard_variant | to_json }}/""/' \
    "$repo/roles/desktop/templates/input.lua.j2" >"$scratch/input.lua"
rm -f -- "$scratch/config/cybexos/input.json"
cat > "$scratch/gestures.lua" <<'LUA'
local repo = assert(os.getenv("CYBEXOS_INPUT_TEST_REPO"))
local scratch = assert(os.getenv("CYBEXOS_INPUT_TEST_SCRATCH"))
package.path = scratch .. "/?.lua;" .. repo .. "/roles/desktop/files/?.lua;" .. package.path
local registered, errors, executed = {}, {}, {}
local AXIS = { left = "horizontal", right = "horizontal", horizontal = "horizontal",
  up = "vertical", down = "vertical", vertical = "vertical", swipe = "swipe" }
local ALIASES = { horiz = "horizontal", vert = "vertical", l = "left", r = "right", u = "up", d = "down" }
local function fresh_compositor()
  registered, errors, executed = {}, {}, {}
  hl = { config = function() end, exec_cmd = function(command) executed[#executed + 1] = command end }
  -- Hyprland's CTrackpadGestures::addGesture/removeGesture, reduced to swipes.
  function hl.gesture(spec)
    local direction, mods = ALIASES[spec.direction] or spec.direction, spec.mods or ""
    if spec.action == "unset" then
      for index, entry in ipairs(registered) do
        if entry.fingers == spec.fingers and entry.direction == direction and entry.mods == mods then
          table.remove(registered, index)
          return
        end
      end
      errors[#errors + 1] = "Can't remove a non-existent gesture"
      return
    end
    local axis = AXIS[direction]
    for _, entry in ipairs(registered) do
      if entry.fingers == spec.fingers and entry.mods == mods and (entry.direction == axis
          or entry.direction == direction
          or ((axis == "vertical" or axis == "horizontal") and entry.direction == "swipe")) then
        errors[#errors + 1] = "Gesture will be overshadowed by a previous gesture"
        return
      end
    end
    registered[#registered + 1] = { fingers = spec.fingers, direction = direction, mods = mods, action = spec.action }
  end
end
local function find(fingers, direction)
  for _, entry in ipairs(registered) do
    if entry.fingers == fingers and entry.direction == direction then return entry end
  end
end
local function load_vendor()
  package.loaded.input, package.loaded.input_preferences = nil, nil
  require("input")
end

fresh_compositor()
load_vendor()
assert(#errors == 0, tostring(errors[1]))
assert(find(3, "horizontal") and find(3, "horizontal").action == "workspace", "three-finger sideways switches workspace")
local overview = find(3, "up")
assert(overview and type(overview.action) == "function", "three-finger up opens the overview")
overview.action()
assert(executed[1] == assert(os.getenv("HOME")) .. "/.local/bin/cybexos-runtime ipc overview toggle",
  "the overview gesture reaches the shell through cybexos-runtime: " .. tostring(executed[1]))

-- A personal gesture on the same fingers and axis replaces ours instead of
-- being rejected; an unrelated one leaves both of ours in place.
hl.gesture({ fingers = 4, direction = "horizontal", action = "workspace" })
assert(#errors == 0 and find(3, "horizontal") and find(4, "horizontal"))
hl.gesture({ fingers = 3, direction = "left", action = "close" })
assert(#errors == 0, "user gesture was rejected: " .. tostring(errors[1]))
assert(not find(3, "horizontal") and find(3, "left") and find(3, "up"))
hl.gesture({ fingers = 3, direction = "swipe", mods = "SUPER", action = "move" })
assert(#errors == 0 and find(3, "up"), "a modified gesture does not overlap ours")
hl.gesture({ fingers = 3, direction = "vertical", action = "special" })
assert(#errors == 0 and not find(3, "up") and find(3, "vertical"))

-- A user's own unset of a vendor gesture is passed on once.
fresh_compositor()
load_vendor()
hl.gesture({ fingers = 3, direction = "horiz", action = "unset" })
assert(#errors == 0 and not find(3, "horizontal"))
assert(_G.__cybexos_gestures.remove("workspace") == false, "an unset gesture is not unset twice")
assert(#errors == 0)

-- Settings -> Touchpad -> Swipe between workspaces.
local json = require("displays")
fresh_compositor()
load_vendor()
local preferences = require("input_preferences")
preferences.apply(assert(json.decode('{"v":1,"touchpad":{"workspaceSwipe":true}}')))
assert(find(3, "horizontal") and #errors == 0, "the default keeps the swipe")
preferences.apply(assert(json.decode('{"v":1,"touchpad":{"workspaceSwipe":false,"tap":false}}')))
assert(not find(3, "horizontal") and find(3, "up") and #errors == 0, "turning it off keeps the overview gesture")
preferences.apply(assert(json.decode('{"v":1,"touchpad":{"workspaceSwipe":false}}')))
assert(#errors == 0, "applying the same preference again is harmless")
fresh_compositor()
load_vendor()
local ok = pcall(preferences.apply, assert(json.decode('{"v":1,"touchpad":{"workspaceSwipe":1,"tap":false}}')))
assert(not ok and find(3, "horizontal"), "an invalid switch changes nothing")

-- A saved preference reaches the compositor at startup through the loader.
local path = assert(os.getenv("XDG_CONFIG_HOME")) .. "/cybexos/input.json"
local file = assert(io.open(path, "w")); file:write('{"v":1,"touchpad":{"workspaceSwipe":false}}'); file:close()
fresh_compositor()
load_vendor()
package.loaded.input_preferences = nil
require("input_preferences")
assert(_G.__cybexos_input_error == nil and not find(3, "horizontal") and #errors == 0)

-- A compositor without gesture support still loads the input configuration.
registered, errors = {}, {}
hl = { config = function() end }
load_vendor()
assert(_G.__cybexos_gestures.remove("workspace") == false)
print("PASS touchpad gestures: vendor swipes, user override, saved switch and older compositors")
LUA
CYBEXOS_INPUT_TEST_REPO="$repo" CYBEXOS_INPUT_TEST_SCRATCH="$scratch" HOME="$scratch/home" \
  XDG_CONFIG_HOME="$scratch/config" luajit "$scratch/gestures.lua"
