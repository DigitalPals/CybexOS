#!/usr/bin/env python3
"""Classify legacy managed desktop trees without mutating user-owned paths."""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path, PurePosixPath
import shutil
import stat
import sys
from typing import Any


LEGACY_HYPR_FILES = (
    "features.lua",
    "monitors.lua",
    "input.lua",
    "looknfeel.lua",
    "bindings.lua",
    "autostart.lua",
    "hyprland.lua",
    "hypridle.conf",
    "hyprlock.conf",
)
STATIC_HYPR_FILES = {"bindings.lua", "autostart.lua", "hyprland.lua"}


def within(path: Path, parent: Path) -> bool:
    try:
        path.relative_to(parent)
    except ValueError:
        return False
    return True


def safe_relative(value: str) -> Path | None:
    pure = PurePosixPath(value)
    if not value or pure.is_absolute() or ".." in pure.parts or "." in pure.parts:
        return None
    return Path(*pure.parts)


def same_entry(current: Path, baseline: Path) -> bool:
    try:
        current_stat = current.lstat()
        baseline_stat = baseline.lstat()
    except OSError:
        return False
    if stat.S_ISREG(current_stat.st_mode) and stat.S_ISREG(baseline_stat.st_mode):
        return current.read_bytes() == baseline.read_bytes()
    if stat.S_ISLNK(current_stat.st_mode) and stat.S_ISLNK(baseline_stat.st_mode):
        return os.readlink(current) == os.readlink(baseline)
    return False


def copy_entry(source: Path, destination: Path) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    source_stat = source.lstat()
    if stat.S_ISLNK(source_stat.st_mode):
        destination.symlink_to(os.readlink(source))
    elif stat.S_ISREG(source_stat.st_mode):
        shutil.copy2(source, destination, follow_symlinks=False)


def copy_missing(source: Path, destination: Path) -> bool:
    """Copy legacy user state only when the new namespaced path is absent."""
    if destination.exists() or destination.is_symlink():
        return False
    try:
        source_stat = source.lstat()
    except OSError:
        return False
    destination.parent.mkdir(parents=True, exist_ok=True)
    if stat.S_ISDIR(source_stat.st_mode) and not stat.S_ISLNK(source_stat.st_mode):
        shutil.copytree(source, destination, symlinks=True)
    else:
        copy_entry(source, destination)
    return True


def walk_leaf_entries(root: Path) -> set[Path]:
    found: set[Path] = set()
    if not root.is_dir() or root.is_symlink():
        return found
    for directory, directories, files in os.walk(root, followlinks=False):
        current = Path(directory)
        linked_directories = [name for name in directories if (current / name).is_symlink()]
        directories[:] = [name for name in directories if name not in linked_directories]
        for name in [*linked_directories, *files]:
            found.add((current / name).relative_to(root))
    return found


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--home", required=True, type=Path)
    parser.add_argument("--previous-source", required=True, type=Path)
    parser.add_argument("--runtime-root", required=True, type=Path)
    args = parser.parse_args()

    home = args.home.resolve(strict=True)
    if not home.is_dir() or home.stat().st_uid != os.getuid():
        raise SystemExit("layering migration: home is not owned by the current user")

    state_root = home / ".local/state/cybexos"
    marker = state_root / "migrations/ownership-v1.complete"
    legacy_manifest = state_root / "quickshell-manifest.txt"
    for guarded in (state_root, state_root / "migrations"):
        if guarded.is_symlink():
            raise SystemExit(f"layering migration: refusing linked state path: {guarded}")
    if marker.is_file() and not marker.is_symlink():
        print("Layering migration already completed.")
        return 0

    state_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    marker.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(state_root, 0o700)
    os.chmod(marker.parent, 0o700)

    # This manifest was written only by the legacy deployment. Its absence on
    # a fresh install means ~/.config/{quickshell,hypr} belongs wholly to the
    # user and must not even be interpreted as an earlier CybexOS tree.
    if not legacy_manifest.is_file() or legacy_manifest.is_symlink():
        marker.write_text("no-legacy-deployment\n", encoding="utf-8")
        os.chmod(marker, 0o600)
        print("Layering migration found no legacy CybexOS deployment.")
        return 0

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    migration_root = marker.parent / f"ownership-v1-{stamp}"
    suffix = 0
    while migration_root.exists():
        suffix += 1
        migration_root = marker.parent / f"ownership-v1-{stamp}-{suffix}"
    backup_root = migration_root / "preserved"
    migration_root.mkdir(mode=0o700)

    previous_source = args.previous_source.resolve(strict=False)
    runtime_root = args.runtime_root.resolve(strict=False)
    entries: list[dict[str, Any]] = []
    backed_up: set[str] = set()

    legacy_state_moves = (
        (home / ".local/state/quickshell/shell-settings.json", home / ".config/cybexos/shell.json"),
        (home / ".local/state/quickshell/notes.json", state_root / "shell/notes.json"),
        (home / ".local/state/quickshell/t3-model-favorites.json", state_root / "shell/t3-model-favorites.json"),
        (home / ".local/state/quickshell/wallpaper-palette.json", state_root / "shell/wallpaper-palette.json"),
        (home / ".local/state/quickshell/reminders", state_root / "shell/reminders"),
        (home / ".local/state/quickshell-github.json", state_root / "shell/github.json"),
    )
    for old_path, new_path in legacy_state_moves:
        if copy_missing(old_path, new_path):
            entries.append({
                "path": str(new_path.relative_to(home)),
                "classification": "legacy-state-copied",
                "baseline": str(old_path),
            })

    def classify(relative_home: str, baseline: Path | None, *, managed: bool) -> None:
        current = home / relative_home
        try:
            current.lstat()
        except OSError:
            return
        if baseline is not None and same_entry(current, baseline):
            classification = "vendor-unchanged"
        elif managed and baseline is not None and baseline.exists():
            classification = "user-modified"
        elif managed:
            classification = "baseline-unavailable"
        else:
            classification = "user-added"
        if classification != "vendor-unchanged":
            copy_entry(current, backup_root / relative_home)
            backed_up.add(relative_home)
        entries.append({
            "path": relative_home,
            "classification": classification,
            "baseline": str(baseline) if baseline is not None else "",
        })

    quickshell_root = home / ".config/quickshell"
    if quickshell_root.is_symlink() or (quickshell_root.exists() and not quickshell_root.is_dir()):
        classify(".config/quickshell", None, managed=False)
    else:
        quickshell_entries = walk_leaf_entries(quickshell_root)
        linked_directories = {
            relative
            for relative in quickshell_entries
            if (quickshell_root / relative).is_symlink()
        }
        managed_quickshell: set[Path] = set()
        for line in legacy_manifest.read_text(encoding="utf-8").splitlines():
            relative = safe_relative(line.strip())
            if relative is None:
                continue
            managed_quickshell.add(relative)
            # Never follow a user-inserted directory link while inspecting a
            # formerly managed descendant. The link itself is preserved below.
            if any(parent in linked_directories for parent in relative.parents):
                continue
            classify(
                str(Path(".config/quickshell") / relative),
                previous_source / "roles/desktop/files/quickshell" / relative,
                managed=True,
            )
        for relative in sorted(quickshell_entries - managed_quickshell):
            classify(str(Path(".config/quickshell") / relative), None, managed=False)

    hypr_root = home / ".config/hypr"
    if hypr_root.is_symlink() or (hypr_root.exists() and not hypr_root.is_dir()):
        classify(".config/hypr", None, managed=False)
    else:
        for name in LEGACY_HYPR_FILES:
            if name in STATIC_HYPR_FILES:
                baseline = previous_source / "roles/desktop/files" / name
            else:
                baseline = runtime_root / "hypr" / name
            classify(str(Path(".config/hypr") / name), baseline, managed=True)

    counts: dict[str, int] = {}
    for entry in entries:
        key = str(entry["classification"])
        counts[key] = counts.get(key, 0) + 1
    report = {
        "schemaVersion": 1,
        "createdAt": datetime.now(timezone.utc).isoformat(),
        "policy": "classify-and-preserve; legacy paths were not modified",
        "previousSource": str(previous_source),
        "runtimeRoot": str(runtime_root),
        "preservedRoot": str(backup_root) if backed_up else "",
        "counts": counts,
        "entries": entries,
    }
    report_path = migration_root / "report.json"
    report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(report_path, 0o600)
    marker.write_text(str(report_path) + "\n", encoding="utf-8")
    os.chmod(marker, 0o600)

    if not within(report_path, home):
        raise SystemExit("layering migration: report escaped the user home")
    print(f"CHANGED: legacy desktop layering classified; report: {report_path}")
    if backed_up:
        print(f"Preserved {len(backed_up)} customized entries under {backup_root}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
