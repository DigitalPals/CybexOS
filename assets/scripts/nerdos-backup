#!/usr/bin/python3 -I
"""Encrypted personal-file backups with restic.

`nerd backup` and Settings -> Backup & recovery both drive this helper:

  nerdos-backup setup local PATH [--existing] [--json]
  nerdos-backup setup sftp HOST [PATH] [--existing] [--json]
  nerdos-backup confirm-key
  nerdos-backup recovery-key [--json]
  nerdos-backup now [--notify]
  nerdos-backup scheduled
  nerdos-backup status [--json]
  nerdos-backup snapshots [--json]
  nerdos-backup restore [SNAPSHOT] [--path PATH] [--open] [--notify]
  nerdos-backup automatic on|off
  nerdos-backup excludes

The repository is always encrypted. A random password kept in the GNOME
Keyring opens it on this computer; a separate recovery key, shown once at
setup, opens it anywhere. Losing both loses the backups, so setup asks the
user to save the key before the first backup.

A restore always goes into a new folder under ~/Restored and never writes
over the home folder. `scheduled` runs from a user timer during the desktop
session: it backs up at most once a day, quietly skips while the destination
is unreachable, on battery below 30 % or on a metered network, and reminds
once a day when the last backup is more than a week old.

Invoked as app-backup or browser-backup it is the earlier opt-in browser
profile export: an age-encrypted tarball for the recipient in AGE_RECIPIENT.

The interpreter runs in isolated mode so a backup never imports modules from
the user's site directory or the working directory.
"""

from __future__ import annotations

import argparse
import collections
import contextlib
import fcntl
import getpass
import json
import os
import re
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import uuid
from datetime import datetime, timedelta, timezone
from pathlib import Path

EXIT_OK = 0
EXIT_FAILED = 1
EXIT_USAGE = 2
EXIT_NOT_CONFIGURED = 3
# The destination already holds backups; connecting needs their recovery key.
EXIT_EXISTING = 4
EXIT_BUSY = 75

TAG = "nerdos"
REPOSITORY_FOLDER = "nerdos-backup"
KEYRING_APPLICATION = "nerdos-backup"
# restic forget: what the history keeps.
RETENTION = (("--keep-daily", "7"), ("--keep-weekly", "4"), ("--keep-monthly", "6"))
# Daily, with an hour's slack so the hourly check does not push each day's
# backup an hour later than the last.
DUE_AFTER = timedelta(hours=23)
REMIND_AFTER = timedelta(days=7)
MAINTAIN_AFTER = timedelta(days=7)
BATTERY_THRESHOLD = 30
POWER_SUPPLY = Path("/sys/class/power_supply")
# Crockford's base32: no I, L, O or U, so a written-down key reads back.
RECOVERY_ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
RECOVERY_GROUPS = 6
RECOVERY_GROUP_LENGTH = 5
# The same trust rules as the Remote Server widget: the user's SSH keys and
# ~/.ssh/config, never a password prompt, never an unknown host key.
SSH_ARGS = ("-o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=15 "
            "-o ServerAliveInterval=60 -o ServerAliveCountMax=240")
HOST_PATTERN = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.@%-]{0,253}")
REMOTE_PATH_PATTERN = re.compile(r"/?[A-Za-z0-9_][A-Za-z0-9_. +/-]{0,250}")
SNAPSHOT_PATTERN = re.compile(r"latest|[0-9a-f]{8,64}")
# Top-level folders that never take a backup unless a drive is mounted there.
SYSTEM_FOLDERS = frozenset(("bin", "boot", "dev", "etc", "lib", "lib64", "proc", "root", "run",
                            "sbin", "sys", "usr"))

# Relative to the home folder: caches, the trash and everything that is
# downloaded or rebuilt rather than made by the user. Personal files,
# settings and application data stay in. Add more, one restic pattern per
# line, in ~/.config/nerdos/backup-exclude.
HOME_EXCLUDES = (
    ".cache",
    ".local/share/Trash",
    ".var/app/*/cache",
    # Image/build stores include disposable writable layers; named volumes
    # remain personal data when readable by this user. Private subordinate-UID
    # data needs a readable export; live databases also need consistency.
    ".local/share/containers/storage/overlay",
    ".local/share/containers/storage/overlay-images",
    ".local/share/containers/storage/overlay-layers",
    ".local/share/containers/storage/vfs",
    ".local/share/containers/storage/vfs-images",
    ".local/share/containers/storage/vfs-layers",
    ".local/share/containers/cache",
    ".local/share/docker/overlay2",
    ".local/share/docker/image",
    ".local/share/docker/buildkit",
    ".local/share/docker/containerd",
    ".local/share/flatpak",
    ".local/share/nvim/lazy",
    ".local/share/nvim/mason",
    ".local/share/voxtype/models",
    ".cargo/registry",
    ".cargo/git",
    ".rustup",
    ".npm",
    ".npm-global",
    ".bun/install/cache",
    "go/pkg/mod",
    ".m2/repository",
    ".gradle/caches",
    ".gradle/wrapper/dists",
    "Android/Sdk",
    ".android/avd",
    ".ollama/models",
    # Chromium, Brave, Chrome and Electron applications keep their caches
    # beside the profile instead of under ~/.cache.
    ".config/**/Cache",
    ".config/**/Code Cache",
    ".config/**/GPUCache",
    ".config/**/DawnCache",
    ".config/**/GrShaderCache",
    ".config/**/ShaderCache",
    ".config/**/Service Worker/CacheStorage",
    ".config/**/component_crx_cache",
) + tuple(
    root + "/" + relative
    for root in (".local/share/Steam", ".steam", ".steam/steam", ".steam/root",
                 ".var/app/com.valvesoftware.Steam/.local/share/Steam")
    for relative in ("appcache", "depotcache", "package", "logs", "config/htmlcache",
                     "steamapps/common", "steamapps/downloading", "steamapps/shadercache",
                     "steamapps/temp", "steamapps/workshop/downloads")
)
BACKUP_COVERAGE = (
    "Includes readable home files, Steam userdata and Proton saves, and readable rootless container volumes. "
    "Skips caches, downloaded games, container images and writable layers, and mounted filesystems. "
    "Run nerd backup excludes for all exclusions."
)
BACKUP_CONSISTENCY = (
    "Live database files may be inconsistent. Export databases to a home folder readable by your account "
    "before backup (for example pg_dump or mysqldump), or stop the database for the whole backup. "
    "Private container volumes owned by subordinate UIDs require readable exports; stopping the database "
    "alone does not make those files readable. "
    "Keep persistent container data in volumes or home bind mounts; system paths and mounts "
    "outside the home filesystem are not included."
)
# Dependency trees and build output, wherever a project keeps them. Cargo's
# target/ and most tool caches carry CACHEDIR.TAG, which --exclude-caches
# already honours.
ANYWHERE_EXCLUDES = (
    "node_modules",
    "__pycache__",
    ".tox",
    ".nox",
    ".next",
    ".nuxt",
    ".svelte-kit",
    ".turbo",
    ".parcel-cache",
    ".zig-cache",
    "zig-cache",
)
BROWSER_PROFILES = (
    ".config/mozilla/firefox", ".mozilla/firefox", ".config/BraveSoftware/Brave",
    ".config/BraveSoftware/Brave-Browser", ".config/BraveSoftware/Brave-Origin",
    ".config/google-chrome",
)


class Failure(Exception):
    """A failure to report in plain words, with its exit status."""

    def __init__(self, message, status=EXIT_FAILED, *, result="failed"):
        super().__init__(message)
        self.message = message
        self.status = status
        self.result = result


class Context:
    """Where this account keeps its backup configuration and state."""

    def __init__(self, environ=None):
        environ = os.environ if environ is None else environ
        self.home = Path(environ.get("HOME") or Path.home())
        config = Path(environ.get("XDG_CONFIG_HOME") or self.home / ".config")
        state = Path(environ.get("XDG_STATE_HOME") or self.home / ".local/state")
        runtime = Path(environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
        self.config_path = config / "nerdos/backup.json"
        self.user_excludes = config / "nerdos/backup-exclude"
        self.state_path = state / "nerdos/backup.json"
        self.runtime = runtime / "nerdos"
        self.lock_path = self.runtime / "backup.lock"
        self.progress_path = self.runtime / "backup-progress.json"


def utcnow():
    return datetime.now(timezone.utc)


def stamp(moment):
    return moment.astimezone(timezone.utc).isoformat(timespec="seconds")


def parse_time(value):
    if not isinstance(value, str) or not value:
        return None
    # restic writes nanoseconds; datetime takes at most microseconds.
    value = re.sub(r"(\.\d{6})\d+", r"\1", value.strip())
    try:
        moment = datetime.fromisoformat(value)
    except ValueError:
        return None
    return moment if moment.tzinfo else moment.replace(tzinfo=timezone.utc)


def read_json(path, default):
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return default
    return data if isinstance(data, type(default)) else default


def write_json(path, data, mode=0o600):
    """Replace a file atomically, so a reader never sees half of it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix="." + path.name + ".")
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(data, stream, indent=2)
            stream.write("\n")
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(temporary)
        raise


def load_config(context):
    config = read_json(context.config_path, {})
    if config.get("version") != 1 or not isinstance(config.get("destination"), dict) \
            or not isinstance(config.get("repository"), str) or not config.get("keyId"):
        return None
    return config


def require_config(context):
    config = load_config(context)
    if config is None:
        raise Failure("Backups are not set up. Run nerd backup setup, or open Settings, "
                      "Backup & recovery.", EXIT_NOT_CONFIGURED)
    return config


def load_state(context):
    return read_json(context.state_path, {})


def save_state(context, state):
    write_json(context.state_path, state)


def update_state(context, **changes):
    state = load_state(context)
    state.update(changes)
    save_state(context, state)
    return state


# ---- Destinations -----------------------------------------------------------

def is_repository(path):
    path = Path(path)
    return (path / "config").is_file() and (path / "keys").is_dir() and (path / "data").is_dir()


def mount_point(path):
    """The mount point holding `path`, or its nearest existing ancestor."""
    path = Path(os.path.abspath(path))
    while not path.exists():
        path = path.parent
    while not os.path.ismount(path):
        path = path.parent
    return path


def drive_label(mount):
    """A removable drive's name: udisks mounts it at /run/media/USER/LABEL."""
    parts = Path(mount).parts
    if len(parts) == 5 and parts[1:3] == ("run", "media"):
        return parts[4]
    if len(parts) == 3 and parts[1] == "media":
        return parts[2]
    return ""


def local_destination(context, chosen):
    """Validate a folder chosen for backups and name the repository in it."""
    if not isinstance(chosen, str) or not chosen.strip() or "\n" in chosen or "\0" in chosen:
        raise Failure("Choose a folder for the backups.", EXIT_USAGE)
    text = chosen.strip()
    if text == "~" or text.startswith("~/"):
        text = str(context.home) + text[1:]
    path = Path(os.path.normpath(text))
    if not path.is_absolute():
        raise Failure("Choose the backup folder by its full path.", EXIT_USAGE)
    if path == Path("/") or (path.parts[1] in SYSTEM_FOLDERS and not drive_label(mount_point(path))):
        raise Failure(f"{path} is a system folder. Choose a folder on a backup drive.", EXIT_USAGE)
    nearest = path
    while not nearest.exists():
        nearest = nearest.parent
    if not nearest.is_dir():
        raise Failure(f"{nearest} is not a folder.", EXIT_USAGE)
    if is_repository(path) or path.name == REPOSITORY_FOLDER:
        repository = path
    else:
        repository = path / REPOSITORY_FOLDER
    mount = mount_point(repository)
    home = context.home.resolve()
    inside_home = repository == home or home in repository.parents
    # A backup inside the home folder would back itself up and share the
    # disk it is meant to survive. A separately mounted drive is fine.
    if inside_home and mount == mount_point(home):
        raise Failure("Choose a folder outside your home folder, such as an external drive.",
                      EXIT_USAGE)
    label = drive_label(mount)
    display = label if label else str(repository)
    if label and repository != mount:
        display = label + " · " + str(repository.relative_to(mount))
    destination = {"type": "local", "path": str(repository), "mount": str(mount),
                   "label": label, "display": display}
    return destination, str(repository)


def remote_destination(host, path):
    host = (host or "").strip()
    path = (path or REPOSITORY_FOLDER).strip().rstrip("/") or REPOSITORY_FOLDER
    if not HOST_PATTERN.fullmatch(host):
        raise Failure("Enter an SSH alias or user@hostname; set ports in ~/.ssh/config.",
                      EXIT_USAGE)
    if not REMOTE_PATH_PATTERN.fullmatch(path) or ".." in Path(path).parts:
        raise Failure("Enter the folder on the server as a plain path, such as "
                      "backups/laptop.", EXIT_USAGE)
    destination = {"type": "sftp", "host": host, "path": path, "label": "",
                   "display": host + ":" + path}
    return destination, f"sftp:{host}:{path}"


def destination_reachable(destination):
    """(reachable, reason) without touching the repository's contents.

    A removable drive must still be mounted where it was: an unmounted drive
    leaves an empty directory behind on the root filesystem, and a backup
    written there would fill the system disk instead.
    """
    if destination.get("type") == "local":
        mount = destination.get("mount") or "/"
        name = destination.get("label") or destination.get("display") or mount
        if not os.path.ismount(mount):
            return False, f"{name} is not connected."
        if not is_repository(destination.get("path", "")):
            return False, f"The backup folder on {name} is missing."
        return True, ""
    return None, ""


def ssh_endpoint(host):
    """Hostname and port from the user's SSH configuration, or None when
    a proxy decides how the connection is made."""
    try:
        result = subprocess.run(["ssh", "-G", "--", host], capture_output=True, text=True,
                                timeout=10, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    options = {}
    for line in result.stdout.splitlines():
        key, _, value = line.partition(" ")
        options.setdefault(key.lower(), value.strip())
    for proxy in ("proxyjump", "proxycommand"):
        if options.get(proxy, "none") not in ("", "none"):
            return None
    try:
        return options["hostname"], int(options.get("port") or 22)
    except (KeyError, ValueError):
        return None


def remote_reachable(host, timeout=8):
    """False only when the server's SSH port certainly does not answer."""
    endpoint = ssh_endpoint(host)
    if endpoint is None:
        return None
    try:
        with socket.create_connection(endpoint, timeout=timeout):
            return True
    except OSError:
        return False


def low_battery(root=None, threshold=BATTERY_THRESHOLD):
    """Running on battery below the threshold. Device batteries (a mouse, a
    headset) report scope Device and say nothing about this computer."""
    root = POWER_SUPPLY if root is None else root
    capacities = []
    external = False
    try:
        supplies = sorted(Path(root).iterdir())
    except OSError:
        return False

    def read(path):
        try:
            return path.read_text().strip()
        except OSError:
            return ""

    for supply in supplies:
        kind = read(supply / "type")
        if kind == "Battery":
            if read(supply / "scope") == "Device":
                continue
            if read(supply / "status") == "Charging":
                external = True
            with contextlib.suppress(ValueError):
                capacities.append(int(read(supply / "capacity")))
        elif read(supply / "online") == "1":
            external = True
    if external or not capacities:
        return False
    return sum(capacities) / len(capacities) < threshold


def metered_network():
    """NetworkManager's verdict: 1 is metered, 3 guessed metered."""
    try:
        result = subprocess.run(
            ["busctl", "--system", "get-property", "org.freedesktop.NetworkManager",
             "/org/freedesktop/NetworkManager", "org.freedesktop.NetworkManager", "Metered"],
            capture_output=True, text=True, timeout=5, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return False
    parts = result.stdout.split()
    return result.returncode == 0 and len(parts) == 2 and parts[1] in ("1", "3")


# ---- Keyring ----------------------------------------------------------------

def keyring_attributes(key_id):
    return ["application", KEYRING_APPLICATION, "repository", key_id]


def keyring_store(key_id, password, display):
    try:
        result = subprocess.run(
            ["secret-tool", "store", "--label=NerdOS backup (" + display + ")",
             *keyring_attributes(key_id)],
            input=password, capture_output=True, text=True, timeout=120, check=False)
    except FileNotFoundError as error:
        raise Failure("secret-tool is not installed (package libsecret).") from error
    except subprocess.TimeoutExpired as error:
        raise Failure("The keyring did not answer. Unlock it and try again.") from error
    if result.returncode != 0:
        raise Failure("The backup password could not be saved in the keyring. "
                      "Unlock the keyring and try again.")


def keyring_clear(key_id):
    with contextlib.suppress(OSError, subprocess.TimeoutExpired):
        subprocess.run(["secret-tool", "clear", *keyring_attributes(key_id)],
                       capture_output=True, timeout=30, check=False)


class KeyringLocked(Failure):
    pass


def keyring_password(key_id, interactive):
    """The repository password from the keyring.

    `lookup` asks to unlock a locked keyring. A scheduled run must not put
    that prompt in front of the user, so it searches without unlocking: a
    locked item is listed without its secret, and the run is skipped.
    """
    try:
        if interactive:
            result = subprocess.run(["secret-tool", "lookup", *keyring_attributes(key_id)],
                                    capture_output=True, text=True, timeout=120, check=False)
            if result.returncode == 0 and result.stdout:
                return result.stdout
        # A declined or impossible unlock prompt also ends here, and the
        # search tells a locked keyring apart from a missing password.
        result = subprocess.run(["secret-tool", "search", *keyring_attributes(key_id)],
                                capture_output=True, text=True, timeout=30, check=False)
    except FileNotFoundError as error:
        raise Failure("secret-tool is not installed (package libsecret).") from error
    except subprocess.TimeoutExpired as error:
        raise KeyringLocked("The keyring did not answer. Unlock it and try again.") from error
    listed = False
    for line in result.stdout.splitlines():
        if line.startswith("["):
            listed = True
        elif line.startswith("secret = "):
            return line[len("secret = "):]
    if listed:
        raise KeyringLocked("The keyring is locked. Unlock it and try again.")
    raise Failure("The backup password is missing from the keyring. Connect the backup "
                  "again with its recovery key.")


def new_password():
    return secrets.token_urlsafe(32)


def new_recovery_key():
    characters = "".join(secrets.choice(RECOVERY_ALPHABET)
                         for _ in range(RECOVERY_GROUPS * RECOVERY_GROUP_LENGTH))
    return format_recovery_key(characters)


def format_recovery_key(characters):
    size = RECOVERY_GROUP_LENGTH
    return "-".join(characters[i:i + size] for i in range(0, len(characters), size))


def normalize_recovery_key(text):
    """A typed key in its canonical form; anything else is used as typed,
    so a restic repository made elsewhere can still be connected."""
    raw = (text or "").strip()
    compact = re.sub(r"[\s-]", "", raw).upper().translate(str.maketrans("OIL", "011"))
    if len(compact) == RECOVERY_GROUPS * RECOVERY_GROUP_LENGTH \
            and all(character in RECOVERY_ALPHABET for character in compact):
        return format_recovery_key(compact)
    return raw


# ---- restic -----------------------------------------------------------------

def restic_environment():
    """restic must not pick up a repository or password from the session."""
    environment = {key: value for key, value in os.environ.items()
                   if not key.startswith(("RESTIC_", "AWS_", "B2_", "AZURE_", "GOOGLE_"))}
    environment["RESTIC_PROGRESS_FPS"] = "1"
    return environment


class Restic:
    """One repository; secrets reach restic through pipes, never argv or the
    environment, where other processes could read them."""

    def __init__(self, config):
        self.repository = config["repository"]
        self.remote = config["destination"].get("type") == "sftp"
        self.host = config["destination"].get("host", "")

    def command(self, arguments, password_path, new_password_path=None):
        command = ["restic", "--repo", self.repository, "--password-file", password_path,
                   "--retry-lock", "1m"]
        if self.remote:
            command += ["-o", "sftp.args=" + SSH_ARGS]
        command += list(arguments)
        if new_password_path:
            command += ["--new-password-file", new_password_path]
        return command

    def run(self, arguments, password, *, new_password=None, on_line=None):
        """(status, stdout lines, stderr tail)."""
        descriptors = []

        def secret(value):
            read, write = os.pipe()
            os.write(write, value.encode())
            os.close(write)
            descriptors.append(read)
            return f"/dev/fd/{read}"

        try:
            command = self.command(arguments, secret(password),
                                   secret(new_password) if new_password is not None else None)
            try:
                process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                           stdin=subprocess.DEVNULL, text=True,
                                           env=restic_environment(), pass_fds=descriptors)
            except FileNotFoundError as error:
                raise Failure("restic is not installed.") from error
        finally:
            for descriptor in descriptors:
                os.close(descriptor)
        errors = collections.deque(maxlen=40)
        lines = []
        # restic --json emits error records on stderr, beside its plain-text
        # diagnostics. Deliver both streams without concurrently mutating Progress.
        stream_lock = threading.Lock()

        def report(line):
            with stream_lock:
                on_line(line.rstrip("\n"))

        def read_errors():
            for line in process.stderr:
                errors.append(line)
                if on_line is not None:
                    report(line)

        with process:
            # stderr drains beside stdout, so neither pipe can fill and stall restic.
            drain = threading.Thread(target=read_errors, daemon=True)
            drain.start()
            for line in process.stdout:
                line = line.rstrip("\n")
                if on_line is None:
                    lines.append(line)
                else:
                    report(line)
            status = process.wait()
            drain.join()
        return status, lines, "".join(errors)

    def explain(self, status, stderr):
        return explain(status, stderr, self.host)


def explain(status, stderr, host=""):
    """restic's failure in plain words."""
    text = stderr or ""
    lowered = text.lower()
    server = host or "The server"
    if status == 10 or "repository does not exist" in lowered:
        return "No backup was found at the destination. Set up backups again."
    if status == 11 or "unable to create lock" in lowered:
        return "The backup is in use by another backup. Try again later."
    if status == 12 or "wrong password" in lowered:
        return "The saved password does not open this backup. Connect it again with its recovery key."
    if "no space left on device" in lowered:
        return "The backup destination is full."
    if "host key verification failed" in lowered:
        return f"This computer does not trust {server} yet. Connect once with ssh {host} in a terminal."
    if "permission denied (publickey" in lowered or "permission denied, please try again" in lowered:
        return f"{server} refused your SSH key."
    if "could not resolve hostname" in lowered:
        return f"{server} could not be found."
    if any(phrase in lowered for phrase in ("connection refused", "connection timed out",
                                            "no route to host", "network is unreachable",
                                            "connection closed", "subsystem request failed")):
        return f"{server} could not be reached."
    if "read-only file system" in lowered:
        return "The backup destination is read-only."
    if "permission denied" in lowered:
        return "NerdOS cannot write to the backup destination."
    for line in reversed(text.splitlines()):
        line = line.strip()
        if line.startswith("Fatal: "):
            line = line[len("Fatal: "):]
            return line[:1].upper() + line[1:].rstrip(".") + "."
    if status == 130 or status < 0:
        return "The backup was interrupted."
    return f"The backup failed (restic exit {status})."


def exclude_arguments(context, config):
    home = str(context.home)
    arguments = ["--exclude-caches", "--one-file-system"]
    for pattern in HOME_EXCLUDES:
        arguments += ["--exclude", home + "/" + pattern]
    for pattern in ANYWHERE_EXCLUDES:
        arguments += ["--exclude", pattern]
    destination = config["destination"]
    if destination.get("type") == "local":
        arguments += ["--exclude", destination["path"]]
    if context.user_excludes.is_file():
        arguments += ["--exclude-file", str(context.user_excludes)]
    return arguments


def backup_arguments(context, config):
    return ["backup", "--json", "--tag", TAG, "--host", config["host"], "--skip-if-unchanged",
            *exclude_arguments(context, config), str(context.home)]


def forget_arguments(config):
    arguments = ["forget", "--tag", TAG, "--host", config["host"]]
    for flag, count in RETENTION:
        arguments += [flag, count]
    return arguments + ["--prune"]


# ---- Progress, lock and notifications -------------------------------------

@contextlib.contextmanager
def exclusive(context):
    """One backup or restore at a time per account."""
    context.runtime.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor = os.open(context.lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise Failure("A backup or restore is already running.", EXIT_BUSY) from error
        try:
            yield
        finally:
            # The progress file belongs to the holder of the lock.
            with contextlib.suppress(OSError):
                context.progress_path.unlink()
    finally:
        os.close(descriptor)


def busy(context):
    try:
        descriptor = os.open(context.lock_path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return False
    try:
        fcntl.flock(descriptor, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except BlockingIOError:
        return True
    finally:
        os.close(descriptor)
    return False


class Progress:
    """restic's JSON stream, summarized at most once a second for Settings."""

    def __init__(self, context, operation, echo=False):
        self.context = context
        self.operation = operation
        self.echo = echo
        self.started = stamp(utcnow())
        self.last_write = 0.0
        self.summary = None
        self.errors = collections.deque(maxlen=40)
        self.error_count = 0
        self.write({"percent": 0})

    def write(self, values):
        data = {"operation": self.operation, "started": self.started, "pid": os.getpid(), **values}
        with contextlib.suppress(OSError):
            write_json(self.context.progress_path, data)

    def __call__(self, line):
        try:
            message = json.loads(line)
        except ValueError:
            return
        if not isinstance(message, dict):
            return
        kind = message.get("message_type")
        if kind == "summary":
            self.summary = message
        elif kind == "error":
            error = message.get("error") or {}
            detail = error.get("message", "") if isinstance(error, dict) else str(error)
            self.error_count += 1
            self.errors.append(f"{message.get('item', '')}: {detail}".strip(": ")
                               or "restic reported an unspecified read error")
        elif kind == "status" and time.monotonic() - self.last_write >= 1:
            self.last_write = time.monotonic()
            percent = message.get("percent_done") or 0
            self.write({"percent": round(float(percent), 4),
                        "bytesDone": message.get("bytes_done", message.get("bytes_restored", 0)),
                        "totalBytes": message.get("total_bytes", 0)})
            if self.echo:
                print(f"\r{self.operation.capitalize()}: {float(percent) * 100:5.1f} %",
                      end="", file=sys.stderr, flush=True)

    def finish(self):
        if self.echo and self.last_write:
            print(file=sys.stderr)


def runtime_command(context):
    installed = Path(shutil.which("nerdos-runtime") or "/run/current-system/sw/bin/nerdos-runtime")
    return str(installed) if installed.exists() else shutil.which("nerdos-runtime")


def notify(context, title, body, urgency="normal"):
    """One notification; clicking it opens Settings at Backup & recovery."""
    if not shutil.which("notify-send"):
        return
    command = ["notify-send", "--app-name=Backups", "--urgency=" + urgency,
               "--action=default=Open backup settings", title, body]
    try:
        # notify-send waits while it offers an action; bound that wait.
        result = subprocess.run(command, capture_output=True, text=True, timeout=600, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return
    runtime = runtime_command(context)
    if result.stdout.strip() == "default" and runtime:
        with contextlib.suppress(OSError, subprocess.TimeoutExpired):
            subprocess.run([runtime, "ipc", "settings", "open", "backup"],
                           capture_output=True, timeout=10, check=False)


def start_timer():
    """The session target starts the timer at login; after an update or a
    first setup in a running session, start it now. Best effort: outside a
    session there is no user manager to ask."""
    with contextlib.suppress(OSError, subprocess.TimeoutExpired):
        subprocess.run(["systemctl", "--user", "start", "--no-block", "nerdos-backup.timer"],
                       capture_output=True, timeout=10, check=False)


def human_size(count):
    value = float(count or 0)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if value < 1000 or unit == "TB":
            return f"{value:.0f} {unit}" if unit == "B" else f"{value:.1f} {unit}"
        value /= 1000
    return f"{value:.1f} TB"


# ---- Setup ------------------------------------------------------------------

def destination_from(context, arguments):
    if arguments.kind == "local":
        return local_destination(context, arguments.target)
    return remote_destination(arguments.target, arguments.path)


def key_ids(repository, password):
    status, lines, stderr = repository.run(["key", "list", "--json"], password)
    if status != 0:
        raise Failure(repository.explain(status, stderr))
    try:
        keys = json.loads("\n".join(lines))
    except ValueError as error:
        raise Failure("restic listed its keys in an unexpected form.") from error
    current = [key.get("id") for key in keys if isinstance(key, dict) and key.get("current")]
    return current[0] if current else None


def existing_message():
    return Failure("This destination already holds NerdOS backups. Enter their recovery key to "
                   "use them.", EXIT_EXISTING)


def create_repository(config, repository):
    """A new repository: the keyring password opens it here, the recovery key
    anywhere. Returns the recovery key, or None when it could not be added."""
    password = new_password()
    keyring_store(config["keyId"], password, config["destination"]["display"])
    try:
        status, _, stderr = repository.run(["init"], password)
        if status != 0:
            if re.search(r"already (exists|initialized)", stderr, re.IGNORECASE):
                raise existing_message()
            raise Failure(repository.explain(status, stderr))
    except BaseException:
        keyring_clear(config["keyId"])
        raise
    recovery = new_recovery_key()
    config["recoveryKeyConfirmed"] = False
    status, _, _ = repository.run(["key", "add"], password, new_password=recovery)
    if status != 0:
        # The backups still work from this computer; Settings offers a new key.
        return None
    config["recoveryKeyId"] = key_ids(repository, recovery)
    return recovery


def connect_repository(config, repository, recovery_text):
    """Existing backups: their recovery key adds a new keyring password."""
    recovery_key = normalize_recovery_key(recovery_text)
    if not recovery_key:
        raise Failure("Enter the recovery key for these backups.", EXIT_USAGE)
    status, _, stderr = repository.run(["cat", "config"], recovery_key)
    if status == 12:
        raise Failure("That recovery key does not open these backups.")
    if status != 0:
        raise Failure(repository.explain(status, stderr))
    password = new_password()
    keyring_store(config["keyId"], password, config["destination"]["display"])
    status, _, stderr = repository.run(["key", "add"], recovery_key, new_password=password)
    if status != 0:
        keyring_clear(config["keyId"])
        raise Failure(repository.explain(status, stderr))
    config["recoveryKeyId"] = key_ids(repository, recovery_key)
    config["recoveryKeyConfirmed"] = True


def setup(context, arguments, read_key):
    """Point backups at a destination. Returns (config, recovery key or None)."""
    destination, url = destination_from(context, arguments)
    previous = load_config(context)
    if previous and previous["repository"] == url:
        # Already backing up there; the keyring password still opens it.
        return previous, None
    config = {"version": 1, "destination": destination, "repository": url,
              "host": socket.gethostname() or "localhost", "keyId": uuid.uuid4().hex,
              "automatic": previous.get("automatic", True) if previous else True,
              "created": stamp(utcnow())}
    repository = Restic(config)
    local = destination["type"] == "local"
    exists = is_repository(destination["path"]) if local else None
    recovery = None
    if arguments.existing:
        if exists is False:
            raise Failure("No NerdOS backups were found in that folder.")
        connect_repository(config, repository, read_key())
    else:
        if exists:
            raise existing_message()
        if local and not Path(destination["path"]).parent.is_dir():
            raise Failure(f"{Path(destination['path']).parent} does not exist.")
        recovery = create_repository(config, repository)
    write_json(context.config_path, config)
    if previous:
        keyring_clear(previous["keyId"])
        save_state(context, {})
    return config, recovery


def rotate_recovery_key(context):
    config = require_config(context)
    repository = Restic(config)
    password = keyring_password(config["keyId"], interactive=True)
    recovery = new_recovery_key()
    status, _, stderr = repository.run(["key", "add"], password, new_password=recovery)
    if status != 0:
        raise Failure(repository.explain(status, stderr))
    new_id = key_ids(repository, recovery)
    old_id = config.get("recoveryKeyId")
    if old_id and old_id != new_id:
        status, _, stderr = repository.run(["key", "remove", old_id], password)
        if status != 0:
            raise Failure("The new recovery key works, but the old one could not be removed: "
                          + repository.explain(status, stderr))
    config["recoveryKeyId"] = new_id
    config["recoveryKeyConfirmed"] = False
    write_json(context.config_path, config)
    return recovery


# ---- Backing up -------------------------------------------------------------

def due(state, now):
    last = parse_time(state.get("lastSuccess"))
    return last is None or now - last >= DUE_AFTER


def next_due(config, state, now):
    if not config.get("automatic", True):
        return None
    last = parse_time(state.get("lastSuccess"))
    return now if last is None else max(now, last + DUE_AFTER)


def reminder_due(config, state, now):
    """A week without a finished backup, reminded at most once a day."""
    since = parse_time(state.get("lastSuccess")) or parse_time(config.get("created"))
    if since is None or now - since < REMIND_AFTER:
        return False
    return state.get("lastReminder") != now.astimezone().date().isoformat()


def reminder_text(config, state, now, reason=""):
    last = parse_time(state.get("lastSuccess"))
    if last is None:
        since = parse_time(config.get("created")) or now
        days = max(7, (now - since).days)
        text = f"No backup has finished since you set up backups {days} days ago."
    else:
        days = max(7, (now - last).days)
        text = f"Your last backup was {days} days ago."
    if not config.get("automatic", True):
        return text + " Automatic backups are off."
    if reason:
        return text + " " + reason
    return text


def failure_notice_due(state, message, now):
    """One notification per distinct failure and day; the hourly retries of
    a failing backup must not repeat it."""
    notice = state.get("failureNotice") or {}
    return not (notice.get("date") == now.astimezone().date().isoformat()
                and notice.get("message") == message)


def run_backup(context, config, password, echo=False):
    """Back up and, at most weekly, apply retention. Returns a summary line."""
    repository = Restic(config)
    progress = Progress(context, "backup", echo=echo)
    status, _, stderr = repository.run(backup_arguments(context, config), password,
                                       on_line=progress)
    progress.finish()
    # 3: a snapshot can be saved, but files/directories were omitted. A denied
    # directory can hide any number of files; count reported read errors only.
    if status not in (0, 3):
        raise Failure(repository.explain(status, stderr))
    summary = progress.summary or {}
    now = utcnow()
    incomplete = status == 3 or progress.error_count > 0
    errors = list(progress.errors)
    if incomplete:
        if progress.error_count:
            detail = (f"{progress.error_count} read error(s) were reported. "
                      "Files or directories were omitted; the total number of missing files is unknown.")
        else:
            detail = "Some files or directories could not be read; the unreadable count is unknown."
            if stderr.strip():
                errors = [stderr.strip()]
        message = "Backup incomplete. " + detail
        if summary.get("snapshot_id"):
            message += " A partial snapshot was saved; its readable files can be restored."
        else:
            message += " Check the available snapshots for saved files."
        if errors:
            message += " Restic: " + errors[0]
    else:
        message = ""
    state = update_state(context, lastAttempt=stamp(now),
                         lastResult="partial" if incomplete else "ok", lastError=message, lastSkip="",
                         lastSnapshot=summary.get("snapshot_id", ""),
                         lastSummary={"files": summary.get("total_files_processed", 0),
                                      "bytes": summary.get("total_bytes_processed", 0),
                                      "added": summary.get("data_added", 0),
                                      "unreadable": (progress.error_count or None) if incomplete else 0,
                                      "errors": errors})
    if incomplete:
        # Preserve the last complete success and all snapshots. Do not apply
        # retention after an incomplete run or suppress the next scheduled retry.
        raise Failure(message, result="partial")
    update_state(context, lastSuccess=stamp(now))
    line = (f"Backed up {summary.get('total_files_processed', 0):,} files "
            f"({human_size(summary.get('data_added', 0))} new) to {config['destination']['display']}.")
    last_maintenance = parse_time(state.get("lastMaintenance"))
    if last_maintenance is None or now - last_maintenance >= MAINTAIN_AFTER:
        maintenance = Progress(context, "cleanup")
        status, _, stderr = repository.run(forget_arguments(config), password)
        if status == 0:
            status, _, stderr = repository.run(["check"], password)
        maintenance.finish()
        if status != 0:
            raise Failure("The backup finished, but cleaning up old backups failed: "
                          + repository.explain(status, stderr))
        update_state(context, lastMaintenance=stamp(utcnow()))
    return line


def record_failure(context, message, notify_user, now=None, *, result="failed"):
    now = now or utcnow()
    state = update_state(context, lastAttempt=stamp(now), lastResult=result, lastError=message)
    if notify_user and failure_notice_due(state, message, now):
        update_state(context, failureNotice={"date": now.astimezone().date().isoformat(),
                                             "message": message})
        return True
    return False


def back_up_now(context, notify_user):
    """A backup the user asked for: no schedule, battery or network rules."""
    config = require_config(context)
    with exclusive(context):
        try:
            reachable, reason = destination_reachable(config["destination"])
            if reachable is False:
                raise Failure(reason)
            password = keyring_password(config["keyId"], interactive=True)
            return run_backup(context, config, password, echo=sys.stderr.isatty())
        except Failure as error:
            failure = error
            record_failure(context, error.message, False, result=error.result)
    # Notified after the lock is released, so Settings already shows the result.
    if notify_user:
        notify(context, "Backup incomplete" if failure.result == "partial" else "Backup failed",
               failure.message, "normal" if failure.result == "partial" else "critical")
    raise failure


def skip_reason(config):
    """Why a due scheduled backup waits: (skip code, words for a reminder)."""
    destination = config["destination"]
    reachable, reason = destination_reachable(destination)
    if reachable is False:
        if destination.get("label") and not os.path.ismount(destination.get("mount") or "/"):
            reason = f"Connect {destination['label']} to back up."
        return "unreachable", reason
    if low_battery():
        return "battery", ""
    if destination["type"] == "sftp":
        if metered_network():
            return "metered", ""
        if remote_reachable(destination["host"]) is False:
            return "unreachable", f"{destination['host']} could not be reached."
    return "", ""


def scheduled(context, now=None):
    """The timer's hourly check. Quiet unless something needs the user."""
    config = load_config(context)
    if config is None:
        return EXIT_OK
    now = now or utcnow()
    notice = None
    reason = ""
    try:
        with exclusive(context):
            if config.get("automatic", True) and due(load_state(context), now):
                skip, reason = skip_reason(config)
                if not skip:
                    try:
                        password = keyring_password(config["keyId"], interactive=False)
                        run_backup(context, config, password)
                    except KeyringLocked:
                        skip, reason = "keyring", "Unlock the keyring to back up."
                    except Failure as error:
                        if record_failure(context, error.message, True, now, result=error.result):
                            notice = (("Backup incomplete", error.message, "normal")
                                      if error.result == "partial" else
                                      ("Backup failed", error.message, "critical"))
                if skip:
                    update_state(context, lastSkip=skip, lastSkipAt=stamp(now))
            state = load_state(context)
            if notice is None and reminder_due(config, state, now):
                update_state(context, lastReminder=now.astimezone().date().isoformat())
                notice = ("Back up your files", reminder_text(config, state, now, reason), "normal")
    except Failure as error:
        if error.status != EXIT_BUSY:
            raise
        return EXIT_OK
    if notice:
        notify(context, *notice)
    return EXIT_OK


# ---- Status -----------------------------------------------------------------

def progress_info(context):
    if not busy(context):
        return None
    progress = read_json(context.progress_path, {})
    return {"operation": progress.get("operation", "backup"),
            "percent": progress.get("percent", 0),
            "started": progress.get("started", "")}


def media_root():
    """Where Settings starts browsing for a backup drive."""
    user = getpass.getuser()
    for candidate in (f"/run/media/{user}", "/media", "/mnt"):
        if os.path.isdir(candidate):
            return candidate
    return "/"


def status_report(context, now=None):
    now = now or utcnow()
    config = load_config(context)
    state = load_state(context)
    progress = progress_info(context)
    report = {"configured": config is not None, "running": progress is not None,
              "progress": progress, "lastRestore": state.get("lastRestore"),
              "mediaRoot": media_root(), "coverage": BACKUP_COVERAGE,
              "consistency": BACKUP_CONSISTENCY}
    if config is None:
        return report
    reachable, reason = destination_reachable(config["destination"])
    upcoming = next_due(config, state, now)
    report.update({
        "destination": {key: config["destination"].get(key, "")
                        for key in ("type", "display", "label", "path", "host")},
        "automatic": bool(config.get("automatic", True)),
        "reachable": reachable,
        "unreachableReason": reason,
        "recoveryKeyConfirmed": bool(config.get("recoveryKeyConfirmed")),
        "created": config.get("created", ""),
        "lastSuccess": state.get("lastSuccess", ""),
        "lastAttempt": state.get("lastAttempt", ""),
        "lastResult": state.get("lastResult", ""),
        "lastError": state.get("lastError", ""),
        "lastSkip": state.get("lastSkip", ""),
        "lastSummary": state.get("lastSummary"),
        "nextDue": stamp(upcoming) if upcoming else "",
        "stale": bool(config and reminder_due(config, {**state, "lastReminder": ""}, now)),
    })
    return report


def print_status(report):
    print(report["coverage"])
    print(report["consistency"])
    if not report["configured"]:
        print("Backups are not set up. Run: nerd backup setup local PATH, or "
              "nerd backup setup sftp HOST [PATH].")
        return
    destination = report["destination"]
    print("Destination:  " + destination["display"]
          + ("" if report["reachable"] is not False else " (" + report["unreachableReason"] + ")"))
    print("Automatic:    " + ("daily" if report["automatic"] else "off"))
    last = parse_time(report["lastSuccess"])
    print("Last complete backup: " + (last.astimezone().strftime("%Y-%m-%d %H:%M") if last else "never"))
    if report["lastResult"] in ("failed", "partial"):
        print("Last attempt: " + report["lastResult"] + ": " + report["lastError"])
    if report["running"]:
        progress = report["progress"]
        print(f"Running:      {progress['operation']} {progress['percent'] * 100:.0f} %")
    upcoming = parse_time(report["nextDue"])
    if upcoming:
        print("Next backup:  after " + upcoming.astimezone().strftime("%Y-%m-%d %H:%M"))
    if not report["recoveryKeyConfirmed"]:
        print("Recovery key: not saved. Run nerd backup recovery-key to make a new one.")


# ---- Restoring --------------------------------------------------------------

def snapshot_list(context, config, password):
    repository = Restic(config)
    status, lines, stderr = repository.run(["snapshots", "--json", "--tag", TAG], password)
    if status != 0:
        raise Failure(repository.explain(status, stderr))
    try:
        snapshots = json.loads("\n".join(lines) or "[]")
    except ValueError as error:
        raise Failure("restic listed the backups in an unexpected form.") from error
    result = []
    for snapshot in snapshots if isinstance(snapshots, list) else []:
        if not isinstance(snapshot, dict) or not SNAPSHOT_PATTERN.fullmatch(snapshot.get("id", "")):
            continue
        paths = snapshot.get("paths") or []
        summary = snapshot.get("summary") or {}
        result.append({"id": snapshot["id"], "time": snapshot.get("time", ""),
                       "host": snapshot.get("hostname", ""),
                       "path": paths[0] if paths else "",
                       "files": summary.get("total_files_processed", 0),
                       "bytes": summary.get("total_bytes_processed", 0)})
    result.sort(key=lambda entry: parse_time(entry["time"]) or datetime.min.replace(
        tzinfo=timezone.utc), reverse=True)
    return result


def restore_path(text):
    """A path inside the backed-up home folder, relative to it."""
    if not text:
        return ""
    if "\n" in text or "\0" in text or any(character in text for character in "*?[\\"):
        raise Failure("Enter a plain path inside your home folder, such as Documents/Taxes.",
                      EXIT_USAGE)
    text = text.strip()
    if text == "~" or text.startswith("~/"):
        text = text[2:]
    parts = [part for part in Path(text).parts if part not in ("/", ".")]
    if ".." in parts:
        raise Failure("Enter a path inside your home folder.", EXIT_USAGE)
    return "/".join(parts)


def restore_target(context, moment):
    """A folder that did not exist before, under ~/Restored, named by when the
    backup was made. Created here, so a restore can never land in place."""
    parent = context.home / "Restored"
    try:
        parent.mkdir(mode=0o700)
    except FileExistsError:
        pass
    if parent.is_symlink() or not parent.is_dir():
        raise Failure(f"{parent} must be a folder.")
    name = moment.astimezone().strftime("%Y-%m-%d-%H%M")
    for attempt in range(1, 100):
        target = parent / (name if attempt == 1 else f"{name}-{attempt}")
        try:
            target.mkdir(mode=0o700)
        except FileExistsError:
            continue
        return target
    raise Failure("Too many restored folders share this name. Tidy up ~/Restored.")


def open_folder(path):
    with contextlib.suppress(OSError):
        subprocess.Popen(["xdg-open", str(path)], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)


def restore(context, snapshot_id, relative, open_files, notify_user):
    config = require_config(context)
    if not SNAPSHOT_PATTERN.fullmatch(snapshot_id or ""):
        raise Failure("Choose a backup to restore.", EXIT_USAGE)
    relative = restore_path(relative)
    try:
        with exclusive(context):
            reachable, reason = destination_reachable(config["destination"])
            if reachable is False:
                raise Failure(reason)
            password = keyring_password(config["keyId"], interactive=True)
            snapshots = snapshot_list(context, config, password)
            if snapshot_id == "latest":
                own = [entry for entry in snapshots if entry["host"] == config["host"]]
                chosen = (own or snapshots or [None])[0]
            else:
                chosen = next((entry for entry in snapshots
                               if entry["id"].startswith(snapshot_id)), None)
            if chosen is None or not chosen["path"].startswith("/"):
                raise Failure("That backup was not found.")
            if not relative:
                free = shutil.disk_usage(context.home).free
                if chosen["bytes"] and chosen["bytes"] > free:
                    raise Failure(f"Restoring everything needs {human_size(chosen['bytes'])}, "
                                  f"but only {human_size(free)} is free. Restore a folder instead.")
            moment = parse_time(chosen["time"]) or utcnow()
            target = restore_target(context, moment)
            arguments = ["restore", chosen["id"] + ":" + chosen["path"], "--target", str(target),
                         "--overwrite", "never", "--json"]
            if relative:
                arguments += ["--include", "/" + relative]
            progress = Progress(context, "restore", echo=sys.stderr.isatty())
            repository = Restic(config)
            status, _, stderr = repository.run(arguments, password, on_line=progress)
            progress.finish()
            if status != 0:
                with contextlib.suppress(OSError):
                    target.rmdir()
                raise Failure(repository.explain(status, stderr).replace("backup failed",
                                                                         "restore failed"))
            restored = (progress.summary or {}).get("total_files", 0)
            if progress.summary is not None and not restored:
                with contextlib.suppress(OSError):
                    target.rmdir()
                raise Failure(f"Nothing at {relative or 'that path'} is in that backup.")
            update_state(context, lastRestore={"time": stamp(utcnow()), "ok": True,
                                               "target": str(target), "error": ""})
    except Failure as error:
        if error.status != EXIT_BUSY:
            update_state(context, lastRestore={"time": stamp(utcnow()), "ok": False,
                                               "target": "", "error": error.message})
            if notify_user:
                notify(context, "Restore failed", error.message, "critical")
        raise
    shown = target
    if relative and (target / relative).exists():
        shown = target / relative if (target / relative).is_dir() else (target / relative).parent
    if open_files:
        open_folder(shown)
    return shown


# ---- Compatibility: app-backup ---------------------------------------------

def browser_profiles(context, output, environ):
    """The earlier app-backup: an age-encrypted tar of the browser profiles."""
    recipient = environ.get("AGE_RECIPIENT", "")
    if not recipient:
        print("Set AGE_RECIPIENT to an age public recipient.", file=sys.stderr)
        return 2
    if not shutil.which("age"):
        print("age is required", file=sys.stderr)
        return 1
    home = context.home
    output = output or str(home / "Downloads" / time.strftime("browser-profiles-%Y%m%d-%H%M%S.tar.age"))
    paths = [path for path in BROWSER_PROFILES if os.path.lexists(home / path)]
    if not paths:
        print("No browser profiles found", file=sys.stderr)
        return 1
    previous = os.umask(0o077)
    try:
        tar = subprocess.Popen(["tar", "-C", str(home), "-cf", "-", *paths], stdout=subprocess.PIPE)
        age = subprocess.run(["age", "-r", recipient, "-o", output], stdin=tar.stdout, check=False)
        tar.stdout.close()
        if tar.wait() != 0 or age.returncode != 0:
            return 1
    finally:
        os.umask(previous)
    print("Encrypted opt-in browser backup: " + output)
    return 0


# ---- Command line -----------------------------------------------------------

def parser():
    parser = argparse.ArgumentParser(
        prog="nerd backup", description="Encrypted backups of your home folder.")
    commands = parser.add_subparsers(dest="command")
    setup_command = commands.add_parser("setup", help="choose where backups go")
    setup_command.add_argument("kind", choices=("local", "sftp"))
    setup_command.add_argument("target", help="a folder, or an SSH alias or user@host")
    setup_command.add_argument("path", nargs="?", help="the folder on the SSH server")
    setup_command.add_argument("--existing", action="store_true",
                               help="connect backups already there; the recovery key is read "
                                    "from standard input")
    setup_command.add_argument("--json", action="store_true")
    commands.add_parser("confirm-key", help="record that the recovery key is saved")
    key_command = commands.add_parser("recovery-key", help="replace the recovery key")
    key_command.add_argument("--json", action="store_true")
    now_command = commands.add_parser("now", help="back up now")
    now_command.add_argument("--notify", action="store_true", help="report a failure as a notification")
    commands.add_parser("scheduled", help="the timer's daily backup and weekly reminder")
    status_command = commands.add_parser("status", help="show the last and next backup")
    status_command.add_argument("--json", action="store_true")
    snapshots_command = commands.add_parser("snapshots", help="list the backups")
    snapshots_command.add_argument("--json", action="store_true")
    restore_command = commands.add_parser("restore", help="restore into a new folder in ~/Restored")
    restore_command.add_argument("snapshot", nargs="?", default="latest")
    restore_command.add_argument("--path", default="", help="a file or folder inside your home folder")
    restore_command.add_argument("--open", action="store_true", help="open the restored folder in Files")
    restore_command.add_argument("--notify", action="store_true")
    automatic_command = commands.add_parser("automatic", help="turn daily backups on or off")
    automatic_command.add_argument("state", choices=("on", "off"))
    commands.add_parser("excludes", help="list what backups leave out")
    commands.add_parser("browser-profiles", help="the earlier app-backup browser export") \
        .add_argument("output", nargs="?")
    return parser


def read_recovery_key():
    if sys.stdin.isatty():
        return getpass.getpass("Recovery key: ")
    # One line: Settings keeps the pipe open after writing it.
    return sys.stdin.readline()


def emit(arguments, data, text):
    if getattr(arguments, "json", False):
        print(json.dumps(data))
    elif text:
        print(text)


def main(argv=None, environ=None, program=None):
    environ = os.environ if environ is None else environ
    argv = sys.argv[1:] if argv is None else argv
    context = Context(environ)
    if Path(program or sys.argv[0]).name in ("app-backup", "browser-backup"):
        return browser_profiles(context, argv[0] if argv else "", environ)
    arguments = parser().parse_args(argv or ["status"])
    try:
        if arguments.command == "setup":
            config, recovery = setup(context, arguments, read_recovery_key)
            start_timer()
            if getattr(arguments, "json", False):
                print(json.dumps({"ok": True, "destination": config["destination"]["display"],
                                  "recoveryKey": recovery or "", "coverage": BACKUP_COVERAGE,
                                  "consistency": BACKUP_CONSISTENCY}))
            elif recovery:
                print(f"Backups go to {config['destination']['display']}.\n\nRecovery key:\n\n"
                      f"    {recovery}\n\nSave it somewhere safe, such as a password manager. It "
                      "opens these backups on any computer.\nIf you lose both this computer's "
                      "keyring and this key, the backups cannot be opened.\nThen run: "
                      "nerd backup confirm-key")
            else:
                print(f"Connected the backups at {config['destination']['display']}.")
            if not getattr(arguments, "json", False):
                print(BACKUP_COVERAGE)
                print(BACKUP_CONSISTENCY)
        elif arguments.command == "confirm-key":
            config = require_config(context)
            config["recoveryKeyConfirmed"] = True
            write_json(context.config_path, config)
        elif arguments.command == "recovery-key":
            recovery = rotate_recovery_key(context)
            emit(arguments, {"ok": True, "recoveryKey": recovery},
                 f"New recovery key:\n\n    {recovery}\n\nThe previous key no longer opens these "
                 "backups. Save this one, then run: nerd backup confirm-key")
        elif arguments.command == "now":
            print(back_up_now(context, arguments.notify))
        elif arguments.command == "scheduled":
            return scheduled(context)
        elif arguments.command == "status":
            report = status_report(context)
            if arguments.json:
                print(json.dumps(report))
            else:
                print_status(report)
        elif arguments.command == "snapshots":
            config = require_config(context)
            password = keyring_password(config["keyId"], interactive=True)
            snapshots = snapshot_list(context, config, password)
            if arguments.json:
                print(json.dumps({"snapshots": snapshots}))
            for entry in [] if arguments.json else snapshots:
                moment = parse_time(entry["time"])
                when = moment.astimezone().strftime("%Y-%m-%d %H:%M") if moment else entry["time"]
                print(f"{entry['id'][:8]}  {when}  {entry['host']}  {human_size(entry['bytes'])}")
        elif arguments.command == "restore":
            shown = restore(context, arguments.snapshot, arguments.path, arguments.open,
                            arguments.notify)
            print(f"Restored to {shown}")
        elif arguments.command == "automatic":
            config = require_config(context)
            config["automatic"] = arguments.state == "on"
            write_json(context.config_path, config)
            if config["automatic"]:
                start_timer()
        elif arguments.command == "excludes":
            print(BACKUP_COVERAGE)
            print(BACKUP_CONSISTENCY)
            config = load_config(context) or {"destination": {}}
            arguments_list = exclude_arguments(context, config)
            for flag, value in zip(arguments_list, arguments_list[1:]):
                if flag in ("--exclude", "--exclude-file"):
                    print(value if flag == "--exclude" else "patterns in " + value)
        elif arguments.command == "browser-profiles":
            return browser_profiles(context, arguments.output or "", environ)
    except Failure as error:
        if getattr(arguments, "json", False):
            print(json.dumps({"ok": False, "error": error.message,
                              "existing": error.status == EXIT_EXISTING}))
        print("nerdos-backup: " + error.message, file=sys.stderr)
        return error.status
    return EXIT_OK


if __name__ == "__main__":
    # A stopped unit or session ends a run through the cleanup paths.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    sys.exit(main())
