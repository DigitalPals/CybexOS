#!/usr/bin/env bash
# Resolve, verify, stage, and activate immutable CybexOS GitHub releases.
set -euo pipefail
umask 077

readonly updater_version=0.1.0
github_repo=${CYBEXOS_GITHUB_REPO:-DigitalPals/CybexOS}
channel=${CYBEXOS_CHANNEL:-stable}
channel_explicit=false
[[ -n ${CYBEXOS_CHANNEL:-} ]] && channel_explicit=true
source_dir=${CYBEXOS_SOURCE_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)}
semver_helper=${CYBEXOS_SEMVER_HELPER:-$source_dir/scripts/semver}
config_file=${CYBEXOS_CONFIG_FILE:-/etc/cybexos/config.yml}
data_root=${XDG_DATA_HOME:-$HOME/.local/share}/cybexos
releases_root=$data_root/releases
backend=${CYBEXOS_UPDATE_BACKEND:-$HOME/.local/bin/cybexos-update-run}
command_name=run
with_packages=true
with_flatpak=true
with_firmware=false
json=false
start_only=false
backend_args=()

usage() {
  cat <<'EOF'
Usage: cybex update [--check] [--channel stable|beta] [--system-only]
                            [--no-packages] [--no-flatpak] [--firmware]
                            [--start] [--json]

By default, check GitHub for a verified CybexOS release, stage and apply
it when newer, and then update Fedora packages and system Flatpaks. No GitHub
account or login is needed. When no release has been published on the channel
yet, the project step is skipped and the command succeeds. When a release
cannot be checked, verified, or staged (offline, a GitHub error or rate limit),
packages are still updated and the command exits 69 after a successful package
run; --start reports the reason as projectError.

  --check        Only report whether a compatible project release is available
  --channel      Save and use the stable or beta release channel
  --system-only  Skip the project release check and update system packages only
  --no-packages  Apply only a project release; do not update Fedora/Flatpak
  --no-flatpak   Skip system Flatpak updates
  --firmware     Also install available device firmware through fwupd after
                 the package phase
  --start        Start the durable worker and return without attaching
  --json         Emit machine-readable output for --check/--start
EOF
}

while (($#)); do
  case $1 in
    --check) command_name=check ;;
    --channel)
      shift
      [[ $# -gt 0 ]] || { echo 'update: --channel needs stable or beta' >&2; exit 2; }
      channel=$1
      channel_explicit=true
      ;;
    --system-only) command_name=system-only ;;
    --no-packages) with_packages=false ;;
    --no-flatpak) with_flatpak=false ;;
    --firmware) with_firmware=true ;;
    --start) start_only=true; json=true ;;
    --json) json=true ;;
    -h|--help) usage; exit 0 ;;
    --) shift; backend_args+=("$@"); break ;;
    *) backend_args+=("$1") ;;
  esac
  shift
done

if [[ $command_name == check && $start_only == true ]]; then
  echo 'update: --check and --start cannot be combined' >&2
  exit 2
fi

if [[ $command_name == system-only ]]; then
  if [[ $start_only == true ]]; then
    args=(start --json --system-unit)
  else
    args=(run)
  fi
  [[ $with_flatpak == true ]] || args+=(--no-flatpak)
  [[ $with_firmware != true ]] || args+=(--firmware)
  exec "$backend" "${args[@]}" "${backend_args[@]}"
fi

# The project release needs GitHub and gh (verification only, never a login);
# Fedora and Flatpak updates must not. Only tools every path needs are hard
# requirements here.
for required_command in curl jq python3 sha256sum tar; do
  command -v "$required_command" >/dev/null 2>&1 || {
    printf 'update: required command is missing: %s\n' "$required_command" >&2
    exit 2
  }
done
[[ -x $semver_helper ]] || {
  printf 'update: Semantic Version helper is missing: %s\n' "$semver_helper" >&2
  exit 2
}
[[ -r $config_file ]] || {
  printf 'update: saved installer configuration is missing: %s\n' "$config_file" >&2
  [[ ! -d /etc/fedora-config ]] ||
    printf 'update: run ./install from a CybexOS checkout to migrate this fedora-config installation\n' >&2
  exit 2
}

mkdir -p -- "$releases_root" "$data_root"
if [[ $channel_explicit == false && -r $data_root/channel ]]; then
  channel=$(tr -d '[:space:]' <"$data_root/channel")
fi
[[ $channel == stable || $channel == beta ]] || {
  printf 'update: unsupported channel %s\n' "$channel" >&2
  exit 2
}
if [[ $channel_explicit == true || ! -e $data_root/channel ]]; then
  printf '%s\n' "$channel" >"$data_root/channel"
fi

current_version=0.0.0
[[ -r $source_dir/VERSION ]] && current_version=$(tr -d '[:space:]' <"$source_dir/VERSION")
"$semver_helper" validate "$current_version" || {
  printf 'update: installed VERSION is not strict SemVer: %s\n' "$current_version" >&2
  exit 2
}

release_json=$(mktemp)
archive=$(mktemp --suffix=.tar.zst)
# gh recognizes a bundle file by its extension.
bundle_file=$(mktemp --suffix=.jsonl)
stage=
cleanup() {
  rm -f -- "$release_json" "$archive" "$bundle_file"
  [[ -z $stage ]] || rm -rf -- "$stage"
}
trap cleanup EXIT

# Bound the connection and abort a stalled transfer. The installed release
# tree does not ship the system helper library, so the limits are local here.
release_curl() {
  curl --connect-timeout 15 --speed-limit 1024 --speed-time 60 \
    --retry 3 --retry-connrefused --fail --silent --show-error --location "$@"
}

# Every step that depends on GitHub or on the downloaded candidate records why
# it could not continue instead of exiting, so that being offline, an API
# error, or a rate limit still leaves package updates working. These
# functions run in conditional context, where `set -e` does not apply; each
# step checks its own status.
project_error=
project_unavailable() {
  project_error=$1
  return 1
}

# Anonymous GitHub API request: no login and no token. The response body goes
# to the output file and the final HTTP status to http_status ("000" without
# a response). A transport failure returns curl's status and leaves its own
# message on stderr, which is what an offline check shows.
http_status=000
github_api() {
  local url=$1 output=$2 status rc=0
  status=$(curl --connect-timeout 15 --speed-limit 1024 --speed-time 60 \
    --max-time 60 --retry 3 --retry-connrefused --retry-max-time 60 \
    --silent --show-error --location \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    -w '%{http_code}' -o "$output" "$url") || rc=$?
  http_status=${status:-000}
  return "$rc"
}

# Turn a GitHub HTTP error into the reason the panel and terminal show.
github_http_error() {
  local what=$1 message
  message=$(jq -r '.message // empty' "$release_json" 2>/dev/null || true)
  case $http_status in
    403|429)
      if [[ $http_status == 429 || ${message,,} == *"rate limit"* ]]; then
        project_unavailable "GitHub's API rate limit for anonymous requests was reached; try again later"
      else
        project_unavailable "GitHub refused the $what request (HTTP $http_status)"
      fi
      ;;
    *) project_unavailable "GitHub returned HTTP $http_status for the $what request" ;;
  esac
}

# "no-release" when the channel has nothing published yet. That is not an
# error: the project step is skipped and package updates run normally.
project_status=

fetch_release() {
  local api="https://api.github.com/repos/$github_repo" rc=0 selected
  if [[ $channel == stable ]]; then
    github_api "$api/releases/latest" "$release_json" || rc=$?
  else
    github_api "$api/releases?per_page=30" "$release_json" || rc=$?
  fi
  if ((rc != 0)); then
    project_unavailable "could not fetch the $channel release from GitHub"
    return "$rc"
  fi
  if [[ $channel == stable && $http_status == 404 ]]; then
    # GitHub answers 404 both when no release is published and when the
    # repository does not exist; only the repository itself tells them apart.
    rc=0
    github_api "$api" "$release_json" || rc=$?
    if ((rc != 0)); then
      project_unavailable "could not fetch the $channel release from GitHub"
      return "$rc"
    fi
    case $http_status in
      200) project_status=no-release; return 0 ;;
      404) project_unavailable "the GitHub repository $github_repo was not found"; return ;;
      *) github_http_error 'repository'; return ;;
    esac
  fi
  if [[ $http_status == 404 ]]; then
    project_unavailable "the GitHub repository $github_repo was not found"
    return
  fi
  [[ $http_status == 200 ]] || { github_http_error "$channel release"; return; }
  if [[ $channel == beta ]]; then
    selected=$(jq -c '[.[] | select(.draft == false and .prerelease == true)] | first // empty' \
      "$release_json") || { project_unavailable 'GitHub returned invalid release data'; return; }
    if [[ -z $selected ]]; then
      project_status=no-release
      return 0
    fi
    printf '%s\n' "$selected" >"$release_json" \
      || { project_unavailable 'could not record the beta release'; return; }
  fi

  tag=$(jq -er '.tag_name | strings | select(startswith("v"))' "$release_json") \
    || { project_unavailable 'GitHub returned no usable release tag'; return; }
  release_version=${tag#v}
  "$semver_helper" validate "$release_version" \
    || { project_unavailable "release tag is not strict SemVer: $tag"; return; }
  asset_name="cybexos-$release_version.tar.zst"
  asset_url=$(jq -er --arg name "$asset_name" \
    '.assets[] | select(.name == $name) | .browser_download_url' "$release_json") \
    || { project_unavailable "release $tag has no $asset_name asset"; return; }
  asset_digest=$(jq -er --arg name "$asset_name" \
    '.assets[] | select(.name == $name) | .digest | select(test("^sha256:[0-9a-f]{64}$"))' "$release_json") \
    || { project_unavailable "release $tag publishes no SHA-256 digest for $asset_name"; return; }
  # The provenance bundle lets gh verify the archive offline, without the
  # GitHub API and therefore without a login.
  bundle_url=$(jq -er --arg name "$asset_name.sigstore.jsonl" \
    '.assets[] | select(.name == $name) | .browser_download_url' "$release_json") \
    || { project_unavailable "release $tag has no $asset_name.sigstore.jsonl provenance bundle"; return; }
  immutable=$(jq -r '.immutable // false' "$release_json")
  [[ $immutable == true ]] \
    || { project_unavailable "refusing mutable GitHub release $tag"; return; }
}

# gh verifies the release workflow's provenance attestation from the bundle
# published beside the archive. That is offline verification against the
# Sigstore trust root: it needs neither the GitHub API nor a login.
attestation_ready() {
  local help
  command -v gh >/dev/null 2>&1 || {
    project_unavailable 'the GitHub CLI (gh) is not installed; it verifies CybexOS releases'
    return
  }
  help=$(gh attestation verify --help 2>/dev/null) || help=
  [[ $help == *--bundle* && $help == *--signer-workflow* && $help == *--source-ref* ]] || {
    project_unavailable 'this GitHub CLI is too old to verify CybexOS releases; upgrade gh'
    return
  }
}

version_newer() {
  "$semver_helper" newer "$1" "$2"
}

compatible_manifest() {
  local tree=$1 expected_version=$2 fedora architecture schema minimum_updater
  fedora=$(source /etc/os-release; printf '%s' "$VERSION_ID")
  architecture=$(uname -m)
  schema=$(python3 -c 'import sys,yaml; print(yaml.safe_load(open(sys.argv[1])).get("config_schema_version", 0))' "$config_file") \
    || return 1
  jq -e --arg version "$expected_version" --arg fedora "$fedora" \
    --arg architecture "$architecture" --argjson schema "$schema" \
    '.product == "cybexos"
     and .version == $version
     and (.configSchema | type == "number") and .configSchema >= $schema
     and (.supportedFedora | index($fedora)) != null
     and (.architectures | index($architecture)) != null' \
    "$tree/release-manifest.json" >/dev/null || return 1
  minimum_updater=$(jq -er '.minimumUpdater | strings' \
    "$tree/release-manifest.json") || return 1
  "$semver_helper" validate "$minimum_updater" || return 1
  [[ $minimum_updater == "$updater_version" ]] \
    || version_newer "$updater_version" "$minimum_updater"
}

# Download, verify, and extract the candidate into a hidden stage directory.
stage_release() {
  local actual_digest
  attestation_ready || return
  if [[ $start_only == true ]]; then
    printf 'Downloading CybexOS %s...\n' "$release_version" >&2
  else
    printf 'Downloading CybexOS %s...\n' "$release_version"
  fi
  release_curl "$asset_url" -o "$archive" \
    || { project_unavailable "could not download CybexOS $release_version"; return; }
  actual_digest=sha256:$(sha256sum "$archive" | awk '{print $1}')
  [[ $actual_digest == "$asset_digest" ]] || {
    project_unavailable "the downloaded CybexOS $release_version archive does not match GitHub's digest"
    return
  }
  release_curl "$bundle_url" -o "$bundle_file" \
    || { project_unavailable "could not download the CybexOS $release_version provenance bundle"; return; }
  # Only this repository's release workflow, building this tag on a
  # GitHub-hosted runner, can have produced an accepted archive.
  timeout 120 env -u GH_HOST -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN \
    GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 \
    gh attestation verify "$archive" --bundle "$bundle_file" --repo "$github_repo" \
      --signer-workflow "$github_repo/.github/workflows/release.yml" \
      --source-ref "refs/tags/$tag" --deny-self-hosted-runners >/dev/null \
    || {
      project_unavailable "the CybexOS $release_version provenance attestation could not be verified"
      return
    }

  stage=$(mktemp -d "$releases_root/.stage.$release_version.XXXXXX") \
    || { project_unavailable 'could not create a release staging directory'; return; }
  tar --extract --zstd --file "$archive" --directory "$stage" --strip-components=1 \
    || { project_unavailable "could not extract CybexOS $release_version"; return; }
  [[ -x $stage/install && -x $stage/verify \
      && -x $stage/scripts/manage-agent-skills \
      && -r $stage/agent-skills/cybexos/SKILL.md \
      && -r $stage/release-manifest.json ]] || {
    project_unavailable "the CybexOS $release_version archive is incomplete"
    return
  }
  [[ $(tr -d '[:space:]' <"$stage/VERSION") == "$release_version" ]] || {
    project_unavailable "the CybexOS $release_version archive does not match its tag"
    return
  }
  compatible_manifest "$stage" "$release_version" || {
    project_unavailable "CybexOS $release_version is incompatible with this system or saved configuration"
    return
  }
  [[ $stage == "$releases_root/.stage.$release_version."* ]] \
    && "$semver_helper" validate "$release_version" || {
    project_unavailable 'unsafe release staging path'
    return
  }
}

available=false
fetch_rc=0
release_version=
fetch_release || fetch_rc=$?
if ((fetch_rc == 0)) && [[ $project_status != no-release ]]; then
  version_newer "$release_version" "$current_version" && available=true
fi
no_release="No CybexOS release has been published on the $channel channel yet"

if [[ $command_name == check ]]; then
  # A failed check keeps its reason as the last stderr line for the panel:
  # curl's own error when GitHub could not be reached, otherwise ours.
  if ((fetch_rc != 0)); then
    [[ $http_status == 000 || -z $project_error ]] \
      || printf 'update: %s\n' "$project_error" >&2
    exit "$fetch_rc"
  fi
  # A release that this machine cannot verify is still reported, with the
  # reason, so the panel can say what is needed before it can be applied.
  if [[ $available == true ]]; then
    attestation_ready || true
  fi
  status=current
  [[ $available != true ]] || status=available
  [[ $project_status != no-release ]] || status=no-release
  if [[ $json == true ]]; then
    jq -cn --arg current "$current_version" --arg availableVersion "$release_version" \
      --arg channel "$channel" --argjson available "$available" \
      --arg projectError "$project_error" --arg status "$status" \
      '{currentVersion:$current,availableVersion:$availableVersion,channel:$channel,
        available:$available,status:$status,projectError:$projectError}'
  elif [[ $status == no-release ]]; then
    printf '%s (installed: %s).\n' "$no_release" "$current_version"
  elif [[ $available == true ]]; then
    printf 'CybexOS %s is available (installed: %s, channel: %s).\n' \
      "$release_version" "$current_version" "$channel"
    [[ -z $project_error ]] || printf 'To apply it: %s.\n' "$project_error"
  else
    printf 'CybexOS %s is current on the %s channel.\n' "$current_version" "$channel"
  fi
  exit 0
fi

candidate=
if [[ $available == true ]] && stage_release; then
  candidate=$stage
  # Transfer cleanup ownership before asking the backend to launch. The worker
  # promotes this unique verified tree to its canonical version path while it
  # owns the global update lock; no competing client can replace a tree already
  # being applied. An interruption during launch may leave a harmless hidden
  # stage for explicit maintenance, but can never remove a worker-owned tree.
  stage=
fi
if [[ -n $stage ]]; then
  rm -rf -- "$stage"
  stage=
fi

if [[ -n $project_error ]]; then
  printf 'update: CybexOS release skipped: %s\n' "$project_error" >&2
elif [[ $project_status == no-release && $with_packages == true ]]; then
  # Informational, not a skipped release: --start keeps stdout for its JSON.
  if [[ $start_only == true ]]; then
    printf '%s; updating Fedora packages and system Flatpaks.\n' "$no_release" >&2
  else
    printf '%s; updating Fedora packages and system Flatpaks.\n' "$no_release"
  fi
fi

if [[ -n $candidate ]]; then
  update_args=(start --json --system-unit --full --skip-tests --repo "$candidate"
    --release-version "$release_version" --release-data-root "$data_root"
    --release-config "$config_file")
  [[ $with_packages == true ]] || update_args+=(--no-packages)
  [[ $with_flatpak == true ]] || update_args+=(--no-flatpak)
  [[ $with_firmware != true ]] || update_args+=(--firmware)
  update_args+=(-- -e "@$config_file")
elif [[ $with_packages == true ]]; then
  [[ -z $project_error ]] \
    || printf 'update: updating Fedora packages and system Flatpaks only\n' >&2
  if [[ $start_only == true ]]; then
    update_args=(start --json --system-unit)
  else
    update_args=(run)
  fi
  [[ $with_flatpak == true ]] || update_args+=(--no-flatpak)
  [[ $with_firmware != true ]] || update_args+=(--firmware)
else
  [[ -z $project_error ]] || exit 1
  if [[ $start_only == true ]]; then
    echo 'update: no project or package work was requested' >&2
    exit 4
  fi
  if [[ $project_status == no-release ]]; then
    printf '%s; nothing to apply.\n' "$no_release"
  else
    echo 'CybexOS is already current.'
  fi
  exit 0
fi

if [[ -z $candidate ]]; then
  if [[ $start_only == true ]]; then
    set +e
    backend_output=$("$backend" "${update_args[@]}" "${backend_args[@]}")
    backend_rc=$?
    set -e
    # The panel reads one JSON record. Carry the skipped release's reason in
    # it, so a started package-only run can say why CybexOS was not updated.
    if [[ -n $project_error ]] \
        && merged=$(jq -c --arg projectError "$project_error" \
          '. + {projectError: $projectError}' <<<"$backend_output" 2>/dev/null); then
      backend_output=$merged
    fi
    printf '%s\n' "$backend_output"
    exit "$backend_rc"
  fi
  # Stream the attached package run directly to the terminal.
  set +e
  "$backend" "${update_args[@]}" "${backend_args[@]}"
  backend_rc=$?
  set -e
  if [[ -n $project_error ]] && ((backend_rc == 0)); then
    printf 'update: system packages were updated, but CybexOS was not: %s\n' \
      "$project_error" >&2
    exit 69
  fi
  exit "$backend_rc"
fi

set +e
backend_output=$("$backend" "${update_args[@]}" "${backend_args[@]}")
backend_rc=$?
set -e
if ((backend_rc == 3)); then
  active_id=$(jq -r '.id // empty' <<<"$backend_output" 2>/dev/null || true)
  printf 'update: another update is active%s; retry after it finishes\n' \
    "${active_id:+ ($active_id)}" >&2
  [[ $candidate == "$releases_root/.stage.$release_version."* ]] && rm -rf -- "$candidate"
  exit 75
fi
if ((backend_rc != 0)); then
  [[ -z $backend_output ]] || printf '%s\n' "$backend_output" >&2
  [[ $candidate == "$releases_root/.stage.$release_version."* ]] && rm -rf -- "$candidate"
  exit "$backend_rc"
fi
run_id=$(jq -er 'select(.existing == false) | .id' <<<"$backend_output") || {
  echo 'update: backend did not return a new durable transaction' >&2
  exit 1
}
if [[ $start_only == true ]]; then
  printf '%s\n' "$backend_output"
  exit 0
fi
printf 'Started durable release update %s. Ctrl+C detaches without cancelling it.\n' "$run_id"
set +e
"$backend" attach "$run_id"
backend_rc=$?
set -e
exit "$backend_rc"
