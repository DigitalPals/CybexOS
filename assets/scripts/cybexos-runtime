#!/usr/bin/env bash
# Resolve the active CybexOS runtime without making a checkout mutable.
set -euo pipefail
umask 077

config_root=${XDG_CONFIG_HOME:-$HOME/.config}/cybexos
data_root=${XDG_DATA_HOME:-$HOME/.local/share}/cybexos
runtime_root=$data_root/runtime
dev_source_file=$config_root/dev-source

usage() {
  cat <<'EOF'
Usage:
  cybexos-runtime path quickshell|hypr-source|hypr-generated|hypr-config
  cybexos-runtime exec quickshell|hypridle|hyprlock
  cybexos-runtime ipc TARGET FUNCTION [ARGUMENT...]
  cybexos-runtime dev enable CHECKOUT
  cybexos-runtime dev disable
  cybexos-runtime dev status
  cybexos-runtime plugin add|update|clone|remove|list|enable|disable|set|reload|restart [arguments]

The development switch only records a validated checkout. It never fetches,
resets, merges, or otherwise changes that checkout.

ipc calls an IpcHandler function on the running shell of the selected
runtime. It never starts a shell.
EOF
}

validate_checkout() {
  local requested=${1:-} canonical top mode
  [[ -n $requested && $requested == /* && -d $requested ]] || return 1
  canonical=$(readlink -f -- "$requested") || return 1
  [[ -n $canonical && $canonical == /* && -d $canonical ]] || return 1
  [[ $canonical != *$'\n'* && $canonical != *$'\r'* ]] || return 1
  [[ $(stat -c %u -- "$canonical") == "$(id -u)" ]] || return 1
  mode=$(stat -c %a -- "$canonical") || return 1
  # A runtime sourced from a world-writable checkout lets another account
  # replace code immediately before the desktop starts.
  (( (8#$mode & 0002) == 0 )) || return 1
  [[ -e $canonical/.git ]] || return 1
  top=$(git -C "$canonical" rev-parse --show-toplevel 2>/dev/null) || return 1
  top=$(readlink -f -- "$top") || return 1
  [[ $top == "$canonical" ]] || return 1
  [[ -f $canonical/roles/desktop/files/quickshell/shell.qml
      && -f $canonical/roles/desktop/files/hyprland.lua
      && -f $canonical/roles/desktop/files/bindings.lua
      && -f $canonical/roles/desktop/files/autostart.lua ]] || return 1
  printf '%s\n' "$canonical"
}

configured_dev_source() {
  local value
  local -a values=()
  [[ -f $dev_source_file && ! -L $dev_source_file ]] || return 1
  mapfile -t values <"$dev_source_file"
  [[ ${#values[@]} -eq 1 ]] || return 1
  value=${values[0]}
  [[ -n $value ]] || return 1
  validate_checkout "$value"
}

active_source() {
  local source
  if source=$(configured_dev_source); then
    printf '%s\n' "$source"
    return 0
  fi
  if [[ -e $dev_source_file || -L $dev_source_file ]]; then
    printf 'cybexos-runtime: ignoring invalid development source: %s\n' \
      "$dev_source_file" >&2
  fi
  return 1
}

runtime_path() {
  local kind=$1 source
  case $kind in
    quickshell)
      if source=$(active_source); then
        printf '%s/roles/desktop/files/quickshell\n' "$source"
      else
        printf '%s/quickshell\n' "$runtime_root"
      fi
      ;;
    hypr-source)
      if source=$(active_source); then
        printf '%s/roles/desktop/files\n' "$source"
      else
        printf '%s/hypr\n' "$runtime_root"
      fi
      ;;
    hypr-generated) printf '%s/hypr\n' "$runtime_root" ;;
    hypr-config) printf '%s/hypr/hyprland.lua\n' "$runtime_root" ;;
    *) printf 'cybexos-runtime: unknown runtime path %s\n' "$kind" >&2; return 2 ;;
  esac
}

restart_desktop() {
  [[ ${CYBEXOS_RUNTIME_TESTING:-0} == 1 ]] && return 0
  systemctl --user try-restart quickshell.service || {
    printf 'cybexos-runtime: Quickshell could not be restarted\n' >&2
    return 1
  }
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null; then
    hyprctl reload >/dev/null || {
      printf 'cybexos-runtime: Hyprland could not reload the selected source\n' >&2
      return 1
    }
  fi
}

dev_command() {
  local action=${1:-} source temporary
  shift || true
  case $action in
    enable)
      [[ $# -eq 1 ]] || { usage >&2; return 2; }
      source=$(validate_checkout "$1") || {
        printf 'cybex dev: %s is not a safe CybexOS checkout\n' "$1" >&2
        return 2
      }
      if [[ -e $config_root || -L $config_root ]]; then
        [[ -d $config_root && ! -L $config_root ]] || {
          printf 'cybex dev: refusing linked or non-directory config root: %s\n' \
            "$config_root" >&2
          return 2
        }
      else
        mkdir -p -- "$config_root"
      fi
      if [[ -e $dev_source_file || -L $dev_source_file ]]; then
        [[ -f $dev_source_file && ! -L $dev_source_file ]] || {
          printf 'cybex dev: refusing linked or non-file switch: %s\n' \
            "$dev_source_file" >&2
          return 2
        }
      fi
      temporary=$(mktemp "$config_root/.dev-source.XXXXXX")
      trap 'rm -f -- "${temporary:-}"' RETURN
      printf '%s\n' "$source" >"$temporary"
      chmod 0600 "$temporary"
      mv -f -- "$temporary" "$dev_source_file"
      temporary=
      restart_desktop
      printf 'Development runtime enabled: %s\n' "$source"
      ;;
    disable)
      [[ $# -eq 0 ]] || { usage >&2; return 2; }
      if [[ -e $dev_source_file || -L $dev_source_file ]]; then
        rm -f -- "$dev_source_file"
        restart_desktop
        printf 'Development runtime disabled.\n'
      else
        printf 'Development runtime is already disabled.\n'
      fi
      ;;
    status)
      [[ $# -eq 0 ]] || { usage >&2; return 2; }
      if source=$(configured_dev_source); then
        printf 'enabled\t%s\n' "$source"
      elif [[ -e $dev_source_file || -L $dev_source_file ]]; then
        printf 'invalid\t%s\n' "$dev_source_file"
        return 1
      else
        printf 'disabled\t%s\n' "$runtime_root"
      fi
      ;;
    *) usage >&2; return 2 ;;
  esac
}

# Applies the shell's idle timeouts (shell.json) to the vendor hypridle
# configuration. Prints the rendered file, or the vendor file when rendering is
# impossible, so a broken settings file never leaves the session without idle
# locking.
render_hypridle_config() {
  local vendor=$1 script output_dir output temporary session_action
  script=$(runtime_path quickshell)/scripts/hypridle-config.py
  session_action=/usr/local/libexec/cybexos-session-action
  [[ -x $session_action || ! -x /usr/libexec/cybexos-session-action ]] ||
    session_action=/usr/libexec/cybexos-session-action
  output_dir=${XDG_RUNTIME_DIR:-}/cybexos
  output=$output_dir/hypridle.conf
  if [[ -z ${XDG_RUNTIME_DIR:-} || ! -f $script ]] ||
      ! mkdir -p -- "$output_dir" ||
      ! temporary=$(mktemp "$output_dir/.hypridle.conf.XXXXXX"); then
    printf 'cybexos-runtime: using default idle timeouts\n' >&2
    printf '%s\n' "$vendor"
    return 0
  fi
  if python3 "$script" "$config_root/shell.json" "$session_action" >"$temporary" &&
      mv -f -- "$temporary" "$output"; then
    printf '%s\n' "$output"
  else
    rm -f -- "$temporary"
    printf 'cybexos-runtime: could not apply idle settings; using defaults\n' >&2
    printf '%s\n' "$vendor"
  fi
}

# Prints the lock screen the system theme rendered in the shell's colours
# (docs/system-theme.md), or fails so the vendor file is used. Only a regular
# file whose first line is the renderer's header counts: the renderer replaces
# it atomically, and hyprlock skips entries it cannot parse rather than
# refusing to lock, so a damaged file costs the look, never the lock.
themed_hyprlock_config() {
  local file first
  file=${XDG_STATE_HOME:-$HOME/.local/state}/cybexos/theme/hyprlock.conf
  [[ -f $file && ! -L $file && -s $file ]] || return 1
  IFS= read -r first <"$file" || return 1
  [[ $first == '# CybexOS lock screen, rendered by the system theme (theme_hyprlock.py).' ]] ||
    return 1
  printf '%s\n' "$file"
}

exec_runtime() {
  local kind=$1 selected user_config themed
  case $kind in
    quickshell)
      selected=$(runtime_path quickshell)
      [[ -f $selected/shell.qml ]] || {
        printf 'cybexos-runtime: Quickshell runtime is incomplete: %s\n' \
          "$selected" >&2
        return 1
      }
      export CYBEXOS_USER_CONFIG_ROOT=$config_root
      export CYBEXOS_THEME_ROOT=$data_root/themes
      export CYBEXOS_PLUGIN_ROOT=$data_root/plugins
      export OMARCHY_PATH=$selected/compat/omarchy
      export PATH=$OMARCHY_PATH/bin:$PATH
      exec /usr/bin/qs -p "$selected"
      ;;
    hypridle|hyprlock)
      user_config=$config_root/hypr/$kind.conf
      selected=$runtime_root/hypr/$kind.conf
      [[ ! -f $user_config || -L $user_config ]] || selected=$user_config
      if [[ $kind == hyprlock && $selected != "$user_config" ]] &&
          themed=$(themed_hyprlock_config); then
        selected=$themed
      fi
      [[ -f $selected ]] || {
        printf 'cybexos-runtime: %s configuration is missing: %s\n' \
          "$kind" "$selected" >&2
        return 1
      }
      if [[ $kind == hypridle && $selected != "$user_config" ]]; then
        selected=$(render_hypridle_config "$selected")
      fi
      if [[ $kind == hypridle ]]; then
        exec /usr/bin/hypridle --config "$selected"
      else
        exec /usr/bin/hyprlock --config "$selected" \
          --immediate-render --no-fade-in --quiet
      fi
      ;;
    *) printf 'cybexos-runtime: unknown executable %s\n' "$kind" >&2; return 2 ;;
  esac
}

# The shell runs as `qs -p <runtime>`, not as a named configuration, so a bare
# `qs ipc call` finds no "default" config and reaches nothing. Instances are
# matched by config path, which must be the one exec_runtime selected, the
# development checkout included. The timeout keeps a hung shell from
# stranding one client per key press; with no shell running, qs fails at once.
ipc_call() {
  local selected
  selected=$(runtime_path quickshell)
  # --any-display: a caller started by systemd (a reminder timer) need not
  # carry the session's display. The -- keeps function names that shadow qs
  # subcommands (e.g. show) positional.
  exec timeout --kill-after=1s 2s \
    qs ipc --any-display -p "$selected" call -- "$@"
}

command_name=${1:-}
[[ $# -eq 0 ]] || shift
case $command_name in
  path)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    runtime_path "$1"
    ;;
  exec)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    exec_runtime "$1"
    ;;
  ipc)
    [[ $# -ge 2 ]] || { usage >&2; exit 2; }
    ipc_call "$@"
    ;;
  dev) dev_command "$@" ;;
  plugin)
    selected=$(runtime_path quickshell)
    if [[ ${1:-} == reload ]]; then
      exec "$selected/compat/omarchy/bin/omarchy-shell" shell rescanPlugins
    fi
    if [[ ${1:-} == restart ]]; then
      exec systemctl --user restart quickshell.service
    fi
    exec python3 "$selected/scripts/user-plugins.py" "$@"
    ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
