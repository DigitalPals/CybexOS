#!/usr/bin/env python3
"""Collect a redacted Cybex OS diagnostic bundle for a bug report.

cybex report gathers read-only health checks, versions, a hardware summary, recent
journal excerpts and shell health into one local archive, removes personal
data, shows what it collected, and can open a prefilled GitHub issue. It
never uploads anything: the user reviews the archive and attaches it.
"""
import argparse
import datetime
import gzip
import hashlib
import io
import ipaddress
import json
import os
from pathlib import Path
import pwd
import re
import shutil
import socket
import subprocess
import sys
import tarfile
import urllib.parse

ISSUE_URL = 'https://github.com/DigitalPals/CybexOS/issues/new'
# GitHub accepts .gz/.tgz/.zip attachments but not .zst, so the default
# archive is a gzip tarball the user can attach directly.
DEFAULT_SUFFIX = '.tar.gz'
COMMAND_TIMEOUT = 20
JOURNAL_LINES = 300
# Hostnames that identify nothing; redacting them would erase "NixOS".
GENERIC_HOSTS = {'localhost', 'localhost.localdomain', 'nixos', 'cybexos', 'linux', 'host'}


# ---- redaction ---------------------------------------------------------

SECRET_PATTERNS = (
    ('key', re.compile(r'-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----.*?-----END [A-Z0-9 ]*PRIVATE KEY-----', re.S),
     '[private key]'),
    ('token', re.compile(r'\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{22,})\b'), '[token]'),
    ('token', re.compile(r'\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}'), '[token]'),
    ('token', re.compile(r'\b(?:AKIA|ASIA)[0-9A-Z]{16}\b'), '[token]'),
    ('token', re.compile(r'\bAIza[0-9A-Za-z_-]{35}\b'), '[token]'),
    ('token', re.compile(r'\bxox[abposr]-[A-Za-z0-9-]{10,}'), '[token]'),
    ('token', re.compile(r'\bglpat-[A-Za-z0-9_-]{20,}'), '[token]'),
    ('token', re.compile(r'\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}'), '[token]'),
    ('token', re.compile(r'(?i)(\bbearer\s+)[A-Za-z0-9._~+/=-]{8,}'), r'\1[token]'),
    ('token', re.compile(r'(?i)(\b[a-z][a-z0-9+.-]*://)[^/\s:@]+:[^/\s@]+@'), r'\1[credentials]@'),
    ('token', re.compile(r'(?i)([?&](?:access_token|token|key|api_key|code|sig|signature|secret)=)[^&\s"\']+'),
     r'\1[token]'),
    # name = value / name: value / "name": "value" for secret-bearing names.
    ('token', re.compile(r'(?i)(\b[\w.-]*(?:password|passwd|passphrase|secret|token|api[_-]?key|access[_-]?key'
                         r'|private[_-]?key|credentials?|cookie|session[_-]?id|auth(?:orization)?)["\']?\s*[:=]\s*'
                         r'["\']?)(?!\[)([^\s"\',;&}]+)'), r'\1[token]'),
)
# user@1000.service and friends are systemd unit instances, not addresses.
EMAIL = re.compile(r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.(?!(?:service|socket|target|timer|mount|slice|scope'
                   r'|path|device|swap)\b)[A-Za-z]{2,}\b')
MAC = re.compile(r'(?<![0-9A-Fa-f:-])(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}(?![0-9A-Fa-f:-])')
IPV4 = re.compile(r'(?<![\w.])(?:\d{1,3}\.){3}\d{1,3}(?![\w.]*\d)(?:/\d{1,2})?')
IPV6 = re.compile(r'(?<![\w:.])(?:[0-9A-Fa-f]{0,4}:){2,7}(?:[0-9A-Fa-f]{0,4}|(?:\d{1,3}\.){3}\d{1,3})'
                  r'(?:%[\w.-]+)?(?![\w:])')
UUID = re.compile(r'\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b')
SERIAL = re.compile(r'(?i)((?:["\']?\b(?:serial(?:[ _-]?(?:number|no))?|s/n|serialnumber|board_serial'
                    r'|product_serial|chassis_serial)\b["\']?\s*[:=]\s*["\']?|\biSerial\s+\d+\s+))'
                    r'(?!\[)([A-Za-z0-9][\w./-]{2,})')
SSID = re.compile(r'(?i)(\bssid\b["\']?\s*[:=]\s*|\bssid\s+)(["\'])(.{1,32}?)\2')


class Redactor:
    """Replaces personal and secret values; counts what it removed by kind."""

    def __init__(self, users=(), names=(), hosts=(), homes=(), ssids=(), machine_ids=(), serials=()):
        self.counts = {}
        self.homes = sorted({str(home).rstrip('/') for home in homes if str(home) not in ('', '/')},
                            key=len, reverse=True)
        self.literals = []
        for kind, values, label in (('serial', serials, '[serial]'), ('ssid', ssids, '[ssid]'),
                                    ('serial', machine_ids, '[machine-id]'), ('host', hosts, '[hostname]'),
                                    ('user', names, '[name]'), ('user', users, '[user]')):
            for value in sorted({str(value).strip() for value in values if value}, key=len, reverse=True):
                if len(value) < 3 or (kind == 'host' and value.lower() in GENERIC_HOSTS):
                    continue
                # Brackets keep a placeholder such as [user] from matching again.
                self.literals.append((kind, re.compile(r'(?<![\w\[-])' + re.escape(value) + r'(?![\w\]-])'),
                                      label))

    def count(self, kind, number=1):
        if number:
            self.counts[kind] = self.counts.get(kind, 0) + number

    def sub(self, kind, pattern, replacement, text):
        text, number = pattern.subn(replacement, text)
        self.count(kind, number)
        return text

    def address(self, kind, pattern, text):
        def replace(match):
            candidate = match.group(0)
            try:
                address = ipaddress.ip_interface(candidate.split('%', 1)[0]).ip
            except ValueError:
                return candidate
            # Loopback and unspecified addresses identify nothing.
            if address.is_loopback or address.is_unspecified:
                return candidate
            self.count(kind)
            return f'[{kind}]'
        return pattern.sub(replace, text)

    def __call__(self, text):
        for kind, pattern, replacement in SECRET_PATTERNS:
            text = self.sub(kind, pattern, replacement, text)
        text = self.sub('email', EMAIL, '[email]', text)
        text = self.sub('mac', MAC, '[mac]', text)
        text = self.address('ipv6', IPV6, text)
        text = self.address('ipv4', IPV4, text)
        text = self.sub('serial', SERIAL, r'\1[serial]', text)
        text = self.sub('serial', UUID, '[uuid]', text)
        text = self.sub('ssid', SSID, r'\1\2[ssid]\2', text)
        for home in self.homes:
            text = self.sub('home', re.compile(re.escape(home) + r'(?=/|\b|$)'), '/home/[user]', text)
        for kind, pattern, replacement in self.literals:
            text = self.sub(kind, pattern, replacement, text)
        return text


# ---- collection --------------------------------------------------------

def run(argv, timeout=COMMAND_TIMEOUT):
    """(exit code, output) with a C locale; never raises for a missing tool."""
    try:
        result = subprocess.run(argv, text=True, capture_output=True, timeout=timeout, check=False,
                                stdin=subprocess.DEVNULL, env={**os.environ, 'LC_ALL': 'C', 'SYSTEMD_COLORS': '0',
                                                               'SYSTEMD_PAGER': ''})
        return result.returncode, (result.stdout + (result.stderr if result.returncode else '')).strip()
    except FileNotFoundError:
        return 127, f'{argv[0]}: not installed'
    except subprocess.TimeoutExpired:
        return 124, f'{argv[0]}: timed out after {timeout} seconds'
    except OSError as error:
        return 126, f'{argv[0]}: {error}'


def read(path, limit=None):
    try:
        text = Path(path).read_text(errors='replace')
    except OSError:
        return ''
    return '\n'.join(text.splitlines()[-limit:]) if limit else text


def tool(name):
    """Resolve a packaged Cybex OS helper in the current user's environment."""
    for candidate in (shutil.which(name), Path.home() / '.local/bin' / name, Path('/run/current-system/sw/bin') / name):
        if candidate and os.access(candidate, os.X_OK):
            return str(candidate)
    return name


def installation():
    return 'nixos' if Path('/etc/cybexos/release.json').is_file() else 'unknown'


def os_release():
    values = {}
    for line in read('/etc/os-release').splitlines():
        key, _, value = line.partition('=')
        values[key] = value.strip().strip('"')
    return values


def identities():
    """The values a report must not reveal, gathered from this machine."""
    users, names, homes = set(), set(), {str(Path.home())}
    for entry in pwd.getpwall():
        if entry.pw_uid >= 1000 and entry.pw_name not in ('nobody', 'nfsnobody'):
            users.add(entry.pw_name)
            homes.add(entry.pw_dir)
            full = entry.pw_gecos.split(',', 1)[0].strip()
            if full:
                names.add(full)
                names.update(part for part in full.split() if len(part) >= 3)
    users.add(os.environ.get('USER', ''))
    hosts = {socket.gethostname(), read('/etc/hostname').strip()}
    hosts |= {host.split('.', 1)[0] for host in hosts if host}
    for line in read('/etc/machine-info').splitlines():
        if line.startswith('PRETTY_HOSTNAME='):
            hosts.add(line.split('=', 1)[1].strip().strip('"'))
    ssids = set()
    rc, output = run(['nmcli', '-t', '-f', 'NAME,TYPE', 'connection', 'show'])
    if rc == 0:
        for line in output.splitlines():
            name, _, kind = line.rpartition(':')
            if kind == '802-11-wireless' and name:
                ssids.add(name.replace('\\:', ':'))
                code, ssid = run(['nmcli', '-g', '802-11-wireless.ssid', 'connection', 'show', name.replace('\\:', ':')])
                if code == 0 and ssid:
                    ssids.add(ssid)
    machine = {read('/etc/machine-id').strip(), read('/proc/sys/kernel/random/boot_id').strip()}
    # Hyprland's monitor descriptions end in the panel's serial number.
    serials = set()
    rc, output = run(['hyprctl', 'monitors', 'all', '-j'])
    monitors = json_or_text(output) if rc == 0 else None
    for monitor in monitors if isinstance(monitors, list) else []:
        if isinstance(monitor, dict) and isinstance(monitor.get('serial'), str):
            serials.add(monitor['serial'])
    return {'users': users, 'names': names, 'hosts': hosts, 'homes': homes, 'ssids': ssids,
            'machine_ids': {value for value in machine if value}, 'serials': serials}


def json_or_text(output):
    try:
        return json.loads(output)
    except ValueError:
        return None


def hardware_summary():
    """Model and devices; DMI serial numbers and UUIDs are never read."""
    lines = []
    for field in ('sys_vendor', 'product_name', 'product_version', 'board_vendor', 'board_name', 'bios_version'):
        value = read(f'/sys/class/dmi/id/{field}').strip()
        if value:
            lines.append(f'{field}: {value}')
    model = next((line.split(':', 1)[1].strip() for line in read('/proc/cpuinfo').splitlines()
                  if line.startswith('model name')), '')
    lines.append(f'cpu: {model}')
    memory = next((line.split(':', 1)[1].strip() for line in read('/proc/meminfo').splitlines()
                   if line.startswith('MemTotal')), '')
    lines.append(f'memory: {memory}')
    sections = ['\n'.join(lines)]
    for title, argv in (('UEFI and Secure Boot', ['bootctl', 'status', '--no-pager']),
                        ('PCI devices', ['lspci', '-nnk']),
                        ('USB devices', ['lsusb']),
                        ('Block devices', ['lsblk', '-o', 'NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS']),
                        ('Monitors', ['hyprctl', 'monitors', 'all']),
                        ('Kernel command line', ['cat', '/proc/cmdline'])):
        rc, output = run(argv)
        sections.append(f'## {title}\n{output if rc == 0 else f"unavailable ({output})"}')
    for path in ('/etc/cybexos/hardware.json', '/var/lib/cybexos/hardware-status.json',
                 '/var/lib/cybexos/nvidia-status.json'):
        if Path(path).is_file():
            sections.append(f'## {path}\n{read(path).strip()}')
    return '\n\n'.join(sections) + '\n'


def gpu_summary():
    rc, output = run(['lspci', '-nnk'])
    gpus, current = [], None
    if rc == 0:
        for line in output.splitlines():
            if not line.startswith(('\t', ' ')):
                current = None
                if re.search(r'(VGA compatible|3D|Display) controller', line):
                    current = {'name': line.split(': ', 1)[-1], 'driver': ''}
                    gpus.append(current)
            elif current is not None and 'Kernel driver in use:' in line:
                current['driver'] = line.split(':', 1)[1].strip()
    return [f"{gpu['name']} ({gpu['driver'] or 'no driver'})" for gpu in gpus]


def journal(arguments, user=False):
    argv = ['journalctl'] + (['--user'] if user else []) + ['-b', '--no-pager', '-o', 'short-iso',
                                                            '-n', str(JOURNAL_LINES)] + arguments
    rc, output = run(argv)
    return output if rc == 0 else f'unavailable ({output})'


def diagnostics():
    """Read-only observations, without changing or accepting deployment health."""
    checks = []

    def record(name, state, detail):
        checks.append({'name': name, 'state': state, 'detail': detail})

    code, output = run(['systemctl', 'is-system-running'])
    record('boot', 'ok' if code == 0 and output == 'running' else 'warning', output)
    declaration = json_or_text(read('/etc/cybexos/health-services.json'))
    if (not isinstance(declaration, dict) or declaration.get('schema') != 1
            or not isinstance(declaration.get('units'), list) or not declaration['units']
            or not isinstance(declaration.get('userUnits'), list)):
        record('services', 'warning', 'Health service declaration is missing or invalid')
    else:
        for scope, units in (('system', declaration['units']), ('user', declaration['userUnits'])):
            for unit in units:
                if not isinstance(unit, str) or not re.fullmatch(r'[A-Za-z0-9_.@:-]+\.(service|target)', unit):
                    record('services', 'warning', 'Invalid health service declaration')
                    continue
                code, output = run(['systemctl', *(['--user'] if scope == 'user' else []), 'is-active', unit])
                record(unit, 'ok' if code == 0 and output == 'active' else 'warning', output)
    code, output = run([tool('cybex'), 'update', 'status'])
    deployment = json_or_text(output)
    state = deployment.get('state') if isinstance(deployment, dict) else None
    record('deployment', 'ok' if code == 0 and state in ('idle', 'done', 'ready') else 'warning',
           output[-4000:])
    code, output = run(['hyprctl', '-j', 'configerrors'])
    errors = json_or_text(output)
    healthy = code == 0 and isinstance(errors, list) and all(isinstance(error, str) and not error.strip() for error in errors)
    record('hyprland', 'ok' if healthy else 'warning', output[-4000:])
    code, output = run([tool('cybex'), 'shell', 'status'])
    shell = json_or_text(output)
    healthy = code == 0 and isinstance(shell, dict) and shell.get('safe') is False
    record('shell', 'ok' if healthy else 'warning', output[-4000:])
    code, output = run(['systemctl', '--user', 'is-active', 'quickshell.service'])
    record('quickshell.service', 'ok' if code == 0 and output == 'active' else 'warning', output)
    return {'version': 1, 'overall': 'warning' if any(check['state'] != 'ok' for check in checks) else 'ok',
            'checks': checks, 'scope': 'Read-only diagnostics; these do not confirm a trial deployment or qualify hardware'}


def collect():
    """Unredacted sections, by archive member name. Redaction happens once."""
    cybex = tool('cybex')
    sections = {}
    sections['health.json'] = json.dumps(diagnostics())
    release = os_release()
    version_lines = [f'installation: {installation()}', f"os: {release.get('PRETTY_NAME', 'unknown')}",
                     f'kernel: {os.uname().release}', f'architecture: {os.uname().machine}',
                     f"session: {os.environ.get('XDG_CURRENT_DESKTOP', '')} {os.environ.get('XDG_SESSION_TYPE', '')}".strip()]
    rc, version = run([cybex, 'version'])
    version_lines.insert(0, f"cybexos: {version if rc == 0 else 'unknown'}")
    rc, packages = run(['nix', 'path-info', '/run/current-system'])
    version_lines += ['', '## Packages', packages]
    for title, argv in (('Hyprland', ['hyprctl', 'version']), ('Quickshell', ['qs', '--version'])):
        rc, output = run(argv)
        version_lines += ['', f'## {title}', output if rc == 0 else f'unavailable ({output})']
    sections['versions.txt'] = '\n'.join(version_lines) + '\n'
    sections['hardware.txt'] = hardware_summary()
    rc, shell = run([cybex, 'shell', 'status'])
    sections['shell-health.json'] = shell if rc == 0 and json_or_text(shell) is not None else json.dumps(
        {'available': False, 'output': shell[-2000:]})
    failed = []
    for scope, argv in (('system', ['systemctl', '--failed', '--plain', '--no-legend']),
                        ('user', ['systemctl', '--user', '--failed', '--plain', '--no-legend'])):
        rc, output = run(argv)
        failed.append(f'## {scope}\n{output if rc == 0 else f"unavailable ({output})"}'.rstrip())
    sections['failed-units.txt'] = '\n\n'.join(failed) + '\n'
    rc, errors = run(['hyprctl', 'configerrors'])
    session_log = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'hyprland/session.log'
    sections['journal/hyprland.txt'] = (f'## hyprctl configerrors\n{errors}\n\n## {session_log}\n'
                                        f'{read(session_log, JOURNAL_LINES)}\n')
    sections['journal/quickshell.txt'] = journal(['-u', 'quickshell.service'], user=True) + '\n'
    sections['journal/sddm.txt'] = journal(['-u', 'sddm.service']) + '\n'
    rc, update = run([cybex, 'update', 'status'])
    update_units = ('cybexos-stage@*.service', 'cybexos-apply@*.service',
                    'cybexos-rollback.service', 'cybexos-confirm.service',
                    'cybexos-recover.service', 'cybexos-region.service')
    sections['journal/update-worker.txt'] = (f'## cybex update status\n{update}\n\n## system units\n'
                                             f"{journal([arg for unit in update_units for arg in ('-u', unit)])}\n")
    sections['journal/hardware-setup.txt'] = '\n\n'.join(
        f'## {unit}\n{journal(["-u", unit])}' for unit in
        ('xps-haptic-touchpad.service', 'xps-ipu7-abi.service', 'v4l2-relayd-ipu7.service', 'nvidia-persistenced.service')) + '\n'
    return sections


def summary(sections, redactions, name):
    release = os_release()
    health = json_or_text(sections.get('health.json', '')) or {}
    failing = [check.get('name', '') for check in health.get('checks', [])
               if isinstance(check, dict) and check.get('state') in ('fail', 'warning', 'pending')]
    version = next((line.split(': ', 1)[1] for line in sections['versions.txt'].splitlines()
                    if line.startswith('cybexos: ')), 'unknown')
    return {
        'version': 1,
        'archive': name,
        'cybexos': version,
        'installation': installation(),
        'nixos': release.get('VERSION_ID', 'unknown'),
        'kernel': os.uname().release,
        'gpus': gpu_summary(),
        'health': health.get('overall', 'unavailable') if isinstance(health, dict) else 'unavailable',
        'attention': failing[:12],
        'members': sorted(sections),
        'redactions': dict(sorted(redactions.items())),
    }


def issue_url(info, redact):
    """A short, redacted environment block; the logs stay in the archive."""
    lines = [f"- Cybex OS: {info['cybexos']} ({info['installation']} installation)",
             f"- NixOS {info['nixos']}, kernel {info['kernel']}"]
    lines += [f'- GPU: {gpu}' for gpu in info['gpus'][:3]]
    attention = ', '.join(info['attention']) if info['attention'] else 'none'
    lines += [f"- System diagnostics: {info['health']} (needs attention: {attention})",
              f"- Diagnostic bundle: {info['archive']} (attach it to this issue)"]
    query = {'template': 'bug_report.yml', 'labels': 'bug', 'environment': redact('\n'.join(lines))}
    return ISSUE_URL + '?' + urllib.parse.urlencode(query, quote_via=urllib.parse.quote)


def default_directory():
    """The XDG download folder, where a browser's file picker starts."""
    home = Path.home()
    for line in read(Path(os.environ.get('XDG_CONFIG_HOME', home / '.config')) / 'user-dirs.dirs').splitlines():
        if line.startswith('XDG_DOWNLOAD_DIR='):
            path = Path(line.split('=', 1)[1].strip().strip('"').replace('$HOME', str(home)))
            if path.is_dir():
                return path
    return home / 'Downloads' if (home / 'Downloads').is_dir() else home


def output_path(requested, stamp):
    name = f'cybexos-report-{stamp}{DEFAULT_SUFFIX}'
    if not requested:
        return default_directory() / name
    path = Path(requested).expanduser()
    if path.is_dir():
        return path / name
    if not path.name.endswith(('.tar.gz', '.tgz', '.tar.zst')):
        raise SystemExit('cybex report: --output must be a directory or end in .tar.gz, .tgz or .tar.zst')
    return path


def write_archive(path, members, stamp):
    """Owner-only archive with fixed metadata; .tar.zst needs the zstd tool."""
    root = path.name.split('.tar', 1)[0].removesuffix('.tgz')
    buffer = io.BytesIO()
    with tarfile.open(fileobj=buffer, mode='w', format=tarfile.PAX_FORMAT) as archive:
        for name, text in sorted(members.items()):
            data = text.encode()
            info = tarfile.TarInfo(f'{root}/{name}')
            info.size, info.mode, info.mtime = len(data), 0o600, int(stamp.timestamp())
            archive.addfile(info, io.BytesIO(data))
    raw = buffer.getvalue()
    if path.name.endswith('.tar.zst'):
        result = subprocess.run(['zstd', '-q', '-19', '-c'], input=raw, capture_output=True, check=False)
        if result.returncode:
            raise SystemExit('cybex report: zstd is needed for a .tar.zst archive')
        data = result.stdout
    else:
        data = gzip.compress(raw, mtime=int(stamp.timestamp()))
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, 'wb') as stream:
        stream.write(data)
    os.chmod(path, 0o600)
    return hashlib.sha256(data).hexdigest(), len(data)


def readme(info):
    return ('Cybex OS diagnostic bundle\n\n'
            'Created by `cybex report`. Personal data was replaced with placeholders such as\n'
            '[user], [hostname], /home/[user], [mac], [ipv4], [ipv6], [serial], [uuid], [ssid],\n'
            '[email] and [token]. Review the files before attaching the archive to a public issue;\n'
            'automatic redaction cannot recognize every private value.\n\n'
            f"Redactions by kind: {json.dumps(info['redactions'], sort_keys=True)}\n")


def main(argv=None):
    parser = argparse.ArgumentParser(prog='cybex report', description=__doc__.splitlines()[0])
    parser.add_argument('--output', help='archive path (.tar.gz, .tgz or .tar.zst) or a directory')
    parser.add_argument('--json', action='store_true', help='print a machine-readable summary; never prompt')
    parser.add_argument('--no-browser', action='store_true', help='do not offer to open a GitHub issue')
    args = parser.parse_args(argv)

    stamp = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
    path = output_path(args.output, stamp.strftime('%Y%m%d-%H%M%S'))
    if not args.json:
        print('Collecting read-only system and desktop diagnostics…', file=sys.stderr, flush=True)
    found = identities()
    redact = Redactor(**found)
    members = {name: redact(text) for name, text in collect().items()}
    info = summary(members, redact.counts, path.name)
    members['summary.json'] = json.dumps(info, indent=2, sort_keys=True) + '\n'
    members['README.txt'] = readme(info)
    digest, size = write_archive(path, members, stamp)
    url = issue_url(info, redact)
    if args.json:
        print(json.dumps({'path': str(path), 'sha256': digest, 'bytes': size, 'issueUrl': url,
                          'summary': info}, sort_keys=True))
        return 0
    print(f'Diagnostic bundle: {path} ({size} bytes)')
    print(f"Cybex OS {info['cybexos']} ({info['installation']}), NixOS {info['nixos']}, kernel {info['kernel']}")
    for gpu in info['gpus']:
        print(f'GPU: {gpu}')
    print(f"System diagnostics: {info['health']}" + (f" (needs attention: {', '.join(info['attention'])})"
                                                if info['attention'] else ''))
    print('Files: ' + ', '.join(info['members']))
    removed = ', '.join(f'{count} {kind}' for kind, count in info['redactions'].items()) or 'nothing found'
    print(f'Redacted: {removed}')
    print('Review the archive before sharing it; nothing has been uploaded.')
    if args.no_browser or not sys.stdin.isatty():
        print(f'Report the issue at {ISSUE_URL} and attach {path}.')
        return 0
    try:
        answer = input('Open a prefilled GitHub issue in your browser? [y/N] ').strip().lower()
    except EOFError:
        answer = ''
    if answer in ('y', 'yes'):
        rc, output = run(['xdg-open', url])
        if rc:
            print(f'Could not open the browser ({output}). Open this address instead:\n{url}')
        else:
            print(f'Attach {path.name} to the issue; the browser does not upload it for you.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
