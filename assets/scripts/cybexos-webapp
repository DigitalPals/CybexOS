#!/usr/bin/python3 -I
"""Install, remove, list, and launch Cybex OS web apps.

  cybexos-webapp install --url URL [--name NAME] [--id ID] [--offline] [--notify]
  cybexos-webapp remove ID [--notify]
  cybexos-webapp list [--json]
  cybexos-webapp launch ID
  cybexos-webapp refresh [ID...]
  cybexos-webapp seed

A web app is a website in its own browser window with an entry in the
application launcher. Each one is a desktop entry,
~/.local/share/applications/cybexos-webapp-ID.desktop, whose command is
`cybexos-webapp launch ID`, plus its name, address, and icon under
~/.local/share/cybexos/webapps/ID/. Launching picks the browser each time:
Brave Origin in app mode when it is installed (the proprietary applications
choice), otherwise Firefox.

Installing fetches the site's own icon: an https page's apple-touch-icon or
icon link, else /favicon.ico, within strict size and time limits, converted
to PNG by ImageMagick. Offline, or for an http address, the app gets a
generated monogram, and the real icon is fetched on a later launch.

`seed` installs the Cybex OS defaults (Slack, WhatsApp, YouTube, Google Photos
and X) once per account, offline. Every default it has seeded is recorded, so
one the user removes is never added back. The shared NixOS personal-init
service runs it for both the live desktop and installed accounts.

The site address is data. It never reaches a shell, a desktop-entry Exec
line, or a command-line option position.
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import hashlib
import html.parser
import ipaddress
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time
from urllib.parse import urljoin, urlsplit

ID_PATTERN = re.compile(r"[a-z0-9][a-z0-9-]{0,39}")
MAX_URL = 2048
MAX_NAME = 80
PAGE_LIMIT = 512 * 1024
ICON_LIMIT = 1024 * 1024
REQUEST_TIMEOUT = 6
FETCH_BUDGET = 20
MAGICK_TIMEOUT = 20
ICON_SIZE = 128
# A failed icon fetch is retried on launch at most once a day.
ICON_RETRY_SECONDS = 24 * 3600
USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64) CybexOS-webapp/1"

# The defaults Cybex OS has always offered on Super+M, Super+W, Super+Y,
# Super+Shift+P and Super+Shift+X. Their bindings launch them by these ids.
# The managed personal-init service calls `seed` at login. Recorded deletions
# remain absent; newly declared defaults are seeded once.
DEFAULTS = (
    ("slack", "Slack", "https://app.slack.com/"),
    ("whatsapp", "WhatsApp", "https://web.whatsapp.com/"),
    ("youtube", "YouTube", "https://youtube.com/"),
    ("google-photos", "Google Photos", "https://photos.google.com/"),
    ("x", "X", "https://x.com/"),
)

MONOGRAM_COLORS = ("#3b6fd8", "#6a4fc9", "#b2457b", "#c4572f", "#2f8f6b",
                   "#2f7f9f", "#7d6a2f", "#55607a")

# Raster formats only, recognized by their bytes. SVG is refused: an icon is
# rendered, and a vector file can reference other resources.
FORMATS = (
    (b"\x89PNG\r\n\x1a\n", "png"),
    (b"\x00\x00\x01\x00", "ico"),
    (b"\xff\xd8\xff", "jpeg"),
    (b"GIF87a", "gif"),
    (b"GIF89a", "gif"),
    (b"BM", "bmp"),
)


class WebAppError(Exception):
    """A failure with a message meant for the user."""


# ---- Locations --------------------------------------------------------------

def home() -> Path:
    return Path(os.environ.get("HOME") or Path.home())


def data_home() -> Path:
    return Path(os.environ.get("XDG_DATA_HOME") or home() / ".local/share")


def apps_root() -> Path:
    return data_home() / "cybexos/webapps"


def applications_dir() -> Path:
    return data_home() / "applications"


def desktop_path(identifier: str) -> Path:
    return applications_dir() / f"cybexos-webapp-{identifier}.desktop"


def helper_path() -> Path:
    # The shared NixOS package provides this stable selected-system entry point.
    return Path("/run/current-system/sw/bin/cybexos-webapp")


def directory(path: Path) -> Path:
    """Create a directory without following or replacing a user's symlink."""
    if path.is_symlink():
        raise WebAppError(f"{path} is a symbolic link; leaving it alone")
    path.mkdir(parents=True, exist_ok=True)
    if not path.is_dir():
        raise WebAppError(f"{path} is not a directory")
    return path


def write_atomic(path: Path, data: bytes, mode: int = 0o644) -> None:
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(data)
            output.flush()
            os.fchmod(output.fileno(), mode)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


@contextlib.contextmanager
def locked():
    root = directory(apps_root())
    descriptor = os.open(root / ".lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield root


# ---- Validation -------------------------------------------------------------

def validate_url(value: str) -> str:
    """Return a canonical http(s) URL, or raise WebAppError.

    http and https only, a host, no user name or password, no whitespace or
    control characters, and a valid port.
    """
    if not isinstance(value, str):
        raise WebAppError("The web address must be text")
    text = value.strip()
    if not text or len(text) > MAX_URL:
        raise WebAppError("Enter a web address of at most 2048 characters")
    if any(character.isspace() or ord(character) < 0x20 or ord(character) == 0x7F
           for character in text):
        raise WebAppError("A web address cannot contain spaces or control characters")
    parts = urlsplit(text)
    if parts.scheme.lower() not in ("http", "https"):
        raise WebAppError("Only http and https web addresses are supported")
    if "@" in parts.netloc or parts.username is not None or parts.password is not None:
        raise WebAppError("Web addresses with a user name or password are not allowed")
    host = parts.hostname or ""
    if not host:
        raise WebAppError("The web address has no host name")
    try:
        port = parts.port
    except ValueError as error:
        raise WebAppError("The web address has an invalid port") from error
    if port == 0:
        raise WebAppError("The web address has an invalid port")
    with contextlib.suppress(ValueError):
        ipaddress.ip_address(host)
        return parts._replace(scheme=parts.scheme.lower(), path=parts.path or "/").geturl()
    try:
        ascii_host = host.encode("idna").decode("ascii")
    except UnicodeError as error:
        raise WebAppError("The web address has an invalid host name") from error
    labels = ascii_host.rstrip(".").split(".")
    if not all(re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", label) for label in labels):
        raise WebAppError("The web address has an invalid host name")
    return parts._replace(scheme=parts.scheme.lower(), path=parts.path or "/").geturl()


def validate_id(value: str) -> str:
    if not isinstance(value, str) or not ID_PATTERN.fullmatch(value):
        raise WebAppError("A web app id is 1-40 lowercase letters, digits, or dashes")
    return value


def clean_name(value: str) -> str:
    name = " ".join(str(value or "").split())
    name = "".join(character for character in name if character.isprintable())
    return name[:MAX_NAME].strip()


def slug(value: str) -> str:
    text = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return text[:40].strip("-")


def name_from_host(url: str) -> str:
    host = (urlsplit(url).hostname or "").lower()
    with contextlib.suppress(ValueError):
        ipaddress.ip_address(host)
        return host
    labels = [label for label in host.split(".") if label]
    while len(labels) > 2 and labels[0] in ("www", "app", "web", "m", "mobile"):
        labels.pop(0)
    core = labels[-2] if len(labels) >= 2 else (labels[0] if labels else "Web app")
    return core[:1].upper() + core[1:]


# ---- Desktop entry ------------------------------------------------------------

def desktop_string(value: str) -> str:
    """Escape a value for a desktop-entry string key."""
    return (value.replace("\\", "\\\\").replace("\n", "\\n")
            .replace("\t", "\\t").replace("\r", "\\r"))


def exec_argument(value: str) -> str:
    """Quote one Exec argument per the Desktop Entry specification."""
    if re.fullmatch(r"[A-Za-z0-9_@+=:,./-]+", value):
        return value
    quoted = re.sub(r'(["`$\\])', r"\\\1", value).replace("%", "%%")
    return f'"{quoted}"'


def desktop_entry(record: dict, icon: Path) -> str:
    host = urlsplit(record["url"]).hostname or ""
    command = " ".join(exec_argument(part) for part in
                       (str(helper_path()), "launch", record["id"]))
    lines = [
        "[Desktop Entry]",
        "Type=Application",
        "Version=1.0",
        f"Name={desktop_string(record['name'])}",
        f"Comment={desktop_string('Web app · ' + host)}",
        f"Exec={desktop_string(command)}",
        f"Icon={desktop_string(str(icon))}",
        "Terminal=false",
        "Categories=Network;WebBrowser;",
        "StartupNotify=true",
        f"X-CybexOS-WebApp={record['id']}",
    ]
    return "\n".join(lines) + "\n"


# ---- Icons --------------------------------------------------------------------

def monogram(name: str, identifier: str) -> bytes:
    letter = next((character for character in name if character.isalnum()), "?").upper()
    letter = letter.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    color = MONOGRAM_COLORS[int(hashlib.sha256(identifier.encode()).hexdigest(), 16)
                            % len(MONOGRAM_COLORS)]
    return (
        '<svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" '
        'viewBox="0 0 128 128">\n'
        f'  <rect width="128" height="128" rx="28" fill="{color}"/>\n'
        '  <text x="64" y="86" text-anchor="middle" font-family="sans-serif" '
        f'font-size="62" font-weight="bold" fill="#ffffff">{letter}</text>\n'
        '</svg>\n'
    ).encode()


def image_format(data: bytes) -> str:
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "webp"
    for magic, name in FORMATS:
        if data.startswith(magic):
            return name
    return ""


def largest_ico_frame(data: bytes) -> int:
    """The index of the largest image in an ICO directory."""
    if len(data) < 6:
        return 0
    count = int.from_bytes(data[4:6], "little")
    best, best_size = 0, -1
    for index in range(min(count, 64)):
        entry = data[6 + index * 16: 22 + index * 16]
        if len(entry) < 16:
            break
        size = (entry[0] or 256) * (entry[1] or 256)
        if size > best_size:
            best, best_size = index, size
    return best


def to_png(data: bytes) -> bytes:
    """Convert a fetched raster icon to a square PNG with ImageMagick."""
    kind = image_format(data)
    if not kind:
        raise WebAppError("The site icon is not a supported image")
    if shutil.which("magick") is None:
        if kind == "png":
            return data
        raise WebAppError("ImageMagick is not installed")
    frame = largest_ico_frame(data) if kind == "ico" else 0
    with tempfile.TemporaryDirectory(prefix="cybexos-webapp-") as scratch:
        output = Path(scratch) / "icon.png"
        result = subprocess.run(
            ["magick", "-limit", "memory", "64MiB", "-limit", "map", "128MiB",
             "-limit", "width", "4096", "-limit", "height", "4096",
             "-limit", "time", "15", f"{kind}:-[{frame}]",
             "-background", "none", "-thumbnail", f"{ICON_SIZE}x{ICON_SIZE}",
             "-gravity", "center", "-extent", f"{ICON_SIZE}x{ICON_SIZE}",
             "-strip", f"png:{output}"],
            input=data, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=MAGICK_TIMEOUT, check=False)
        if result.returncode != 0 or not output.is_file():
            raise WebAppError("The site icon could not be converted")
        return output.read_bytes()


class IconLinks(html.parser.HTMLParser):
    """Collect <link rel=...icon...> and the page's own name for itself."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.icons: list[tuple[int, str]] = []
        self.name = ""

    def handle_starttag(self, tag, attrs):
        values = {key.lower(): value or "" for key, value in attrs}
        if tag == "link":
            rel = values.get("rel", "").lower().split()
            href = values.get("href", "").strip()
            if not href or href.startswith("data:") or "mask-icon" in rel:
                return
            if "svg" in values.get("type", "").lower() or href.lower().split("?")[0].endswith(".svg"):
                return
            if "apple-touch-icon" in rel or "apple-touch-icon-precomposed" in rel:
                self.icons.append((10_000, href))
            elif "icon" in rel:
                size = 0
                for token in values.get("sizes", "").lower().split():
                    match = re.fullmatch(r"(\d+)x(\d+)", token)
                    if match:
                        size = max(size, int(match.group(1)))
                self.icons.append((min(size, 1024) or 16, href))
        elif tag == "meta" and not self.name:
            key = (values.get("name") or values.get("property") or "").lower()
            if key in ("application-name", "og:site_name", "apple-mobile-web-app-title"):
                self.name = clean_name(values.get("content", ""))


class Fetcher:
    """https-only GET with a byte limit and an overall time budget."""

    def __init__(self, budget: float = FETCH_BUDGET):
        self.deadline = time.monotonic() + budget

    def get(self, url: str, limit: int) -> tuple[bytes, str]:
        import urllib.error
        import urllib.request

        remaining = self.deadline - time.monotonic()
        if remaining <= 0:
            raise WebAppError("Fetching the site took too long")
        if urlsplit(url).scheme != "https":
            raise WebAppError("Only https addresses are fetched")

        class HttpsOnly(urllib.request.HTTPRedirectHandler):
            max_redirections = 5

            def redirect_request(self, request, fp, code, message, headers, new_url):
                if urlsplit(new_url).scheme != "https" or "@" in urlsplit(new_url).netloc:
                    raise urllib.error.HTTPError(new_url, code, "insecure redirect",
                                                 headers, fp)
                return super().redirect_request(request, fp, code, message, headers, new_url)

        opener = urllib.request.build_opener(HttpsOnly())
        request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
        try:
            with opener.open(request, timeout=min(REQUEST_TIMEOUT, remaining)) as response:
                data = response.read(limit + 1)
                final = response.geturl()
        except (OSError, ValueError, urllib.error.URLError) as error:
            raise WebAppError(f"Could not fetch {urlsplit(url).hostname}: {error}") from error
        if len(data) > limit:
            raise WebAppError("The site sent more data than allowed")
        return data, final


def discover(url: str, fetcher: Fetcher | None = None) -> tuple[bytes | None, str]:
    """Fetch the site's best raster icon as PNG, and the name it gives itself.

    Returns (None, name) when no usable icon was found.
    """
    if urlsplit(url).scheme != "https":
        return None, ""
    fetcher = fetcher or Fetcher()
    candidates: list[str] = []
    name = ""
    page_url = url
    try:
        page, page_url = fetcher.get(url, PAGE_LIMIT)
        parser = IconLinks()
        with contextlib.suppress(Exception):
            parser.feed(page.decode("utf-8", "replace"))
        name = parser.name
        for _size, href in sorted(parser.icons, key=lambda item: -item[0]):
            candidates.append(urljoin(page_url, href))
    except WebAppError:
        pass
    parts = urlsplit(page_url)
    candidates.append(f"https://{parts.netloc}/favicon.ico")
    seen = set()
    for candidate in candidates:
        if candidate in seen or urlsplit(candidate).scheme != "https":
            continue
        seen.add(candidate)
        try:
            data, _final = fetcher.get(candidate, ICON_LIMIT)
            return to_png(data), name
        except WebAppError:
            continue
    return None, name


# ---- Records ------------------------------------------------------------------

def record_path(identifier: str) -> Path:
    return apps_root() / identifier / "app.json"


def read_record(identifier: str) -> dict | None:
    try:
        value = json.loads(record_path(identifier).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(value, dict) or value.get("id") != identifier:
        return None
    try:
        value["url"] = validate_url(value.get("url", ""))
    except WebAppError:
        return None
    value["name"] = clean_name(value.get("name", "")) or identifier
    if value.get("icon") not in ("icon.png", "icon.svg"):
        value["icon"] = "icon.svg"
    return value


def installed() -> list[dict]:
    root = apps_root()
    if not root.is_dir():
        return []
    records = []
    for entry in sorted(root.iterdir()):
        if entry.is_dir() and not entry.is_symlink() and ID_PATTERN.fullmatch(entry.name):
            record = read_record(entry.name)
            if record is not None and desktop_path(entry.name).is_file():
                records.append(record)
    return sorted(records, key=lambda record: record["name"].lower())


def publish(record: dict, icon: bytes, icon_name: str) -> None:
    """Write the icon, metadata and desktop entry of one app."""
    folder = directory(apps_root() / record["id"])
    for stale in ("icon.png", "icon.svg"):
        if stale != icon_name:
            (folder / stale).unlink(missing_ok=True)
    write_atomic(folder / icon_name, icon)
    record = {**record, "icon": icon_name}
    payload = json.dumps(record, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
    write_atomic(folder / "app.json", payload.encode())
    directory(applications_dir())
    write_atomic(desktop_path(record["id"]), desktop_entry(record, folder / icon_name).encode())


def install(url: str, name: str = "", identifier: str = "", offline: bool = False,
            fetcher: Fetcher | None = None) -> dict:
    url = validate_url(url)
    name = clean_name(name)
    icon = None
    discovered = ""
    if not offline:
        icon, discovered = discover(url, fetcher)
    name = name or discovered or name_from_host(url)
    explicit = bool(identifier)
    identifier = validate_id(identifier) if explicit else validate_id(
        slug(name) or slug(name_from_host(url)) or "web-app")
    record = {
        "version": 1,
        "id": identifier,
        "name": name,
        "url": url,
        "default": False,
        "iconSource": "favicon" if icon else "monogram",
        # Seeded and offline installs record no attempt, so the first launch
        # fetches the real icon; a failed fetch waits a day.
        "iconAttempt": 0 if offline else int(time.time()),
    }
    with locked():
        if not explicit:
            # Another site that happens to share the name gets its own id;
            # the same address again updates the app in place.
            base, number = identifier, 1
            while True:
                current = read_record(identifier)
                if current is None or current["url"] == url:
                    break
                number += 1
                identifier = f"{base[:37].rstrip('-')}-{number}"
            record["id"] = identifier
        existing = desktop_path(identifier)
        if existing.exists() and read_record(identifier) is None:
            raise WebAppError(f"{existing} exists and is not a Cybex OS web app")
        if icon:
            publish(record, icon, "icon.png")
        else:
            publish(record, monogram(name, identifier), "icon.svg")
    return {**record, "icon": str(apps_root() / identifier /
                                  ("icon.png" if icon else "icon.svg"))}


def remove(identifier: str) -> dict:
    identifier = validate_id(identifier)
    with locked() as root:
        record = read_record(identifier)
        desktop = desktop_path(identifier)
        if record is None and not desktop.exists():
            raise WebAppError(f"No web app named {identifier} is installed")
        if desktop.exists():
            # Only a desktop entry this helper wrote is removed.
            text = desktop.read_text(encoding="utf-8", errors="replace")
            if f"X-CybexOS-WebApp={identifier}\n" not in text:
                raise WebAppError(f"{desktop} is not a Cybex OS web app")
            desktop.unlink()
        folder = root / identifier
        if folder.is_dir() and not folder.is_symlink():
            shutil.rmtree(folder)
    return record or {"id": identifier, "name": identifier}


# ---- Defaults -----------------------------------------------------------------

def seeded_path() -> Path:
    return apps_root() / "defaults.json"


def seeded_ids() -> set[str]:
    try:
        value = json.loads(seeded_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return set()
    ids = value.get("seeded") if isinstance(value, dict) else None
    return {item for item in ids if isinstance(item, str)} if isinstance(ids, list) else set()


def record_seeded(ids: set[str]) -> None:
    payload = json.dumps({"version": 1, "seeded": sorted(ids)}, indent=2) + "\n"
    write_atomic(seeded_path(), payload.encode())


def seed_default(identifier: str) -> bool:
    """Install one default once; False when it was seeded before."""
    default = next((entry for entry in DEFAULTS if entry[0] == identifier), None)
    if default is None:
        return False
    with locked():
        seeded = seeded_ids()
        if identifier in seeded:
            return False
        # A file of the user's own at that name is kept, and counts as seeded.
        if not desktop_path(identifier).exists():
            record = {"version": 1, "id": identifier, "name": default[1], "url": default[2],
                      "default": True, "iconSource": "monogram", "iconAttempt": 0}
            publish(record, monogram(default[1], identifier), "icon.svg")
        record_seeded(seeded | {identifier})
    return True


def seed() -> list[str]:
    """Seed every default that was never seeded; never re-add a removed one."""
    already = seeded_ids()
    return [identifier for identifier, _name, _url in DEFAULTS
            if identifier not in already and seed_default(identifier)]


# ---- Launching ----------------------------------------------------------------

def browser_command(url: str) -> list[str]:
    return ["cybexos-apps", "webapp", url]


def spawn(argv: list[str]) -> None:
    subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)


def refresh_icon(identifier: str, fetcher: Fetcher | None = None) -> bool:
    record = read_record(identifier)
    if record is None:
        raise WebAppError(f"No web app named {identifier} is installed")
    with locked():
        record["iconAttempt"] = int(time.time())
        payload = json.dumps(record, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
        write_atomic(record_path(identifier), payload.encode())
    icon, _name = discover(record["url"], fetcher)
    if icon is None:
        return False
    with locked():
        current = read_record(identifier)
        if current is None or not desktop_path(identifier).exists():
            return False
        publish({**current, "iconSource": "favicon"}, icon, "icon.png")
    return True


def launch(identifier: str) -> None:
    identifier = validate_id(identifier)
    record = read_record(identifier)
    if record is None or not desktop_path(identifier).exists():
        if seed_default(identifier):
            record = read_record(identifier)
        if record is None:
            default = next((entry for entry in DEFAULTS if entry[0] == identifier), None)
            hint = (f"cybexos-webapp install --name {default[1]} --url {default[2]}"
                    if default else "cybexos-webapp install --url ADDRESS")
            raise WebAppError(
                f"The {default[1] if default else identifier} web app was removed. "
                f"Reinstall it with Install web app… in the launcher, or {hint}")
    try:
        spawn(browser_command(record["url"]))
    except OSError as error:
        raise WebAppError(f"No browser could open {record['name']}: {error}") from error
    # The first launch of a seeded or offline install fetches its real icon
    # in the background; a failed fetch waits a day.
    if (record.get("iconSource") != "favicon" and record["url"].startswith("https://")
            and time.time() - int(record.get("iconAttempt") or 0) > ICON_RETRY_SECONDS):
        spawn([sys.executable, "-I", os.path.realpath(__file__), "refresh", "--quiet",
               identifier])


# ---- Command line ---------------------------------------------------------------

def notify(summary: str, body: str = "", urgency: str = "normal") -> None:
    if shutil.which("notify-send") is None:
        return
    with contextlib.suppress(OSError, subprocess.SubprocessError):
        subprocess.run(["notify-send", "--app-name=Cybex OS", f"--urgency={urgency}",
                        summary, body], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=3, check=False)


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="cybexos-webapp", description=__doc__.split("\n")[0])
    commands = root.add_subparsers(dest="command", required=True)
    add = commands.add_parser("install", help="install a web app")
    add.add_argument("--url", required=True)
    add.add_argument("--name", default="")
    add.add_argument("--id", default="")
    add.add_argument("--offline", action="store_true", help="skip fetching the site icon")
    add.add_argument("--notify", action="store_true", help="report the outcome as a notification")
    drop = commands.add_parser("remove", help="remove a web app")
    drop.add_argument("id")
    drop.add_argument("--notify", action="store_true")
    listing = commands.add_parser("list", help="list installed web apps")
    listing.add_argument("--json", action="store_true")
    start = commands.add_parser("launch", help="open a web app")
    start.add_argument("id")
    refresh = commands.add_parser("refresh", help="fetch site icons again")
    refresh.add_argument("ids", nargs="*")
    refresh.add_argument("--quiet", action="store_true")
    commands.add_parser("seed", help="install the Cybex OS default web apps once")
    return root


def main(argv: list[str] | None = None) -> int:
    arguments = parser().parse_args(argv)
    announce = getattr(arguments, "notify", False)
    try:
        if arguments.command == "install":
            record = install(arguments.url, arguments.name, arguments.id, arguments.offline)
            print(record["id"])
            if announce:
                notify(f"{record['name']} is installed", "Find it in the launcher.")
        elif arguments.command == "remove":
            record = remove(arguments.id)
            if announce:
                notify(f"{record.get('name', arguments.id)} was removed")
        elif arguments.command == "list":
            records = [{"id": record["id"], "name": record["name"], "url": record["url"],
                        "icon": str(apps_root() / record["id"] / record["icon"]),
                        "default": bool(record.get("default"))} for record in installed()]
            if arguments.json:
                print(json.dumps(records, ensure_ascii=False))
            else:
                for record in records:
                    print(f"{record['id']}\t{record['name']}\t{record['url']}")
        elif arguments.command == "launch":
            launch(arguments.id)
        elif arguments.command == "refresh":
            for identifier in arguments.ids or [record["id"] for record in installed()]:
                updated = refresh_icon(validate_id(identifier))
                if not arguments.quiet:
                    print(f"{identifier}: {'icon updated' if updated else 'no icon found'}")
        elif arguments.command == "seed":
            added = seed()
            if added:
                print("CHANGED: seeded " + ", ".join(added))
    except WebAppError as error:
        print(f"cybexos-webapp: {error}", file=sys.stderr)
        if announce or arguments.command == "launch":
            notify("Web apps", str(error), "normal")
        return 1
    except OSError as error:
        print(f"cybexos-webapp: {error}", file=sys.stderr)
        if announce or arguments.command == "launch":
            notify("Web apps", "The web app could not be changed. Run cybexos-webapp in a "
                   "terminal for details.")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
