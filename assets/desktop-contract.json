{
  "version": 1,
  "shell": {
    "font": "mono",
    "wall": "moon-mountains.png",
    "wallDir": "~/Pictures/Wallpapers"
  },
  "userHelpers": [
    "screenshot", "screen-record", "quickshell-reminder", "screen-ocr",
    "clipboard-copy-image", "clipboard-image-to-file", "clipboard-history-store",
    "localsend", "localsend-share", "nerdos-agent", "nerdos-firmware-update",
    "nerdos-webapp",
    "game-mode",
    "nerdos-report",
    "nerdos-backup",
    "nerdos-theme",
    "color-picker", "screenshot-stitch"
  ],
  "essentialPaths": [
    ".config/nerdos/shell.json", ".config/fastfetch", ".config/fish",
    ".config/kitty", ".config/oh-my-posh", ".config/voxtype/config.toml",
    ".config/mimeapps.list", ".local/share/applications", ".local/libexec",
    ".local/share/nautilus-python", "Pictures/Wallpapers",
    ".npmrc"
  ],
  "activationPaths": [".config/nvim", ".cargo", ".local/bin", ".npm-global/bin"]
}
